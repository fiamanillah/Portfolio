generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model ContactSubmission {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String
  subject    String?
  message    String
  subscribed Boolean  @default(false)
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model Subscriber {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  name         String?
  status       String   @default("subscribed")
  source       String   @default("hero_section")
  subscribedAt DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model EmailTemplate {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String    @unique
  name        String
  description String?
  subject     String
  body        String    @db.Text
  from        String?
  fromName    String?
  replyTo     String?
  type        String    @default("TRANSACTIONAL")
  plunkId     String?
  isSystem    Boolean   @default(false)
  syncedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

enum Role {
  ADMIN
  MODERATOR
  AUTHOR
  USER
}

enum OtpType {
  REGISTER_EMAIL_VERIFY
  PASSWORD_RESET
  LOGIN_2FA
}

model User {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String            @unique
  username               String            @unique
  name                   String
  password               String
  avatar                 String?
  role                   Role              @default(USER)
  headline               String?
  badge                  String?
  bio                    String?           @db.Text
  location               String?
  website                String?
  githubUrl              String?
  twitterUrl             String?
  linkedinUrl            String?
  pronouns               String?
  customStatus           String?
  isEmailVerified        Boolean           @default(false)
  subscribedToNewsletter Boolean           @default(true)
  twoFactorEnabled       Boolean           @default(false)
  lastLoginAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @default(now()) @updatedAt

  otps                   OtpVerification[]
  refreshTokens          RefreshToken[]

  @@index([email])
  @@index([username])
}

model OtpVerification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  code      String
  type      OtpType
  payload   String?  @db.Text
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, type])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

