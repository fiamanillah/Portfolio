generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model ContactSubmission {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String
  subject    String?
  message    String
  subscribed Boolean  @default(false)
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model Subscriber {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  name         String?
  status       String   @default("subscribed")
  source       String   @default("hero_section")
  subscribedAt DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model EmailTemplate {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String    @unique
  name        String
  description String?
  subject     String
  body        String    @db.Text
  from        String?
  fromName    String?
  replyTo     String?
  type        String    @default("TRANSACTIONAL")
  plunkId     String?
  isSystem    Boolean   @default(false)
  syncedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

enum Role {
  ADMIN
  MODERATOR
  AUTHOR
  USER
}

enum OtpType {
  REGISTER_EMAIL_VERIFY
  PASSWORD_RESET
  LOGIN_2FA
}

model User {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String            @unique
  username               String            @unique
  name                   String
  password               String
  avatar                 String?
  role                   Role              @default(USER)
  headline               String?
  badge                  String?
  bio                    String?           @db.Text
  location               String?
  website                String?
  githubUrl              String?
  twitterUrl             String?
  linkedinUrl            String?
  pronouns               String?
  customStatus           String?
  isEmailVerified        Boolean           @default(false)
  subscribedToNewsletter Boolean           @default(true)
  twoFactorEnabled       Boolean           @default(false)
  lastLoginAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @default(now()) @updatedAt

  otps                   OtpVerification[]
  refreshTokens          RefreshToken[]
  posts                  BlogPost[]
  blogReactions          BlogReaction[]
  comments               Comment[]
  commentReactions       CommentReaction[]
  commentReports         CommentReport[]   @relation("ReportedByUser")
  reviewedReports        CommentReport[]   @relation("ReviewedByUser")
  uploadedMedia          MediaFile[]

  @@index([email])
  @@index([username])
}

model OtpVerification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  code      String
  type      OtpType
  payload   String?  @db.Text
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, type])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

model BlogCategory {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String     @unique
  name        String     @unique
  description String?
  color       String?    @default("blue")
  icon        String?
  order       Int        @default(0)
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@index([slug])
}

model BlogTag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([slug])
}

model BlogPost {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String        @unique
  title              String
  subtitle           String?
  summary            String        @db.Text
  content            String        @db.Text
  thumbnail          String?
  status             BlogStatus    @default(DRAFT)
  featured           Boolean       @default(false)
  pinned             Boolean       @default(false)
  readTime           String?       @default("5 MIN READ")
  readTimeMinutes    Int           @default(5)
  wordCount          Int           @default(0)
  date               String?
  publishedAt        DateTime?
  scheduledAt        DateTime?
  modifiedAt         DateTime?
  views              Int           @default(0)
  likesCount         Int           @default(0)
  commentsCount      Int           @default(0)
  keyTakeaways       String[]      @default([])
  tags               String[]      @default([])

  // Category Relation
  categoryId         String?       @db.Uuid
  category           BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Author Relations & Override Personas
  authorId           String?       @db.Uuid
  author             User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName         String?
  authorRole         String?
  authorAvatar       String?
  authorTwitter      String?
  authorLinkedin     String?
  authorGithub       String?

  // SEO & Social Media Metadata Engine
  metaTitle          String?
  metaDescription    String?       @db.Text
  metaKeywords       String[]      @default([])
  ogTitle            String?
  ogDescription      String?       @db.Text
  ogImage            String?
  ogType             String        @default("article")
  twitterCard        String        @default("summary_large_image")
  twitterTitle       String?
  twitterDescription String?       @db.Text
  twitterImage       String?
  canonicalUrl       String?
  articleType        String        @default("TechArticle")
  noIndex            Boolean       @default(false)
  noFollow           Boolean       @default(false)
  structuredData     Json?

  reactions          BlogReaction[]
  comments           Comment[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt

  @@index([slug])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([featured])
  @@index([authorId])
  @@index([createdAt])
}

model BlogReaction {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId       String    @db.Uuid
  post         BlogPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId       String?   @db.Uuid
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactionType String    @default("like")
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@unique([postId, userId, reactionType])
  @@index([postId, reactionType])
}

enum CommentStatus {
  APPROVED
  PENDING
  SPAM
  REJECTED
}

enum CommentReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  INAPPROPRIATE
  MISINFORMATION
  OTHER
}

enum CommentReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

model Comment {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId       String             @db.Uuid
  post         BlogPost           @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId     String?            @db.Uuid
  author       User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // Guest / fallback metadata
  guestName    String?
  guestEmail   String?
  guestAvatar  String?

  content      String             @db.Text
  status       CommentStatus      @default(APPROVED)
  isPinned     Boolean            @default(false)
  likesCount   Int                @default(0)

  // Nested self-relation for threaded replies
  parentId     String?            @db.Uuid
  parent       Comment?           @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]          @relation("CommentReplies")

  reactions    CommentReaction[]
  reports      CommentReport[]

  ipAddress    String?
  userAgent    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt

  @@index([postId, status, createdAt])
  @@index([parentId])
  @@index([authorId])
  @@index([status])
  @@index([createdAt])
}

model CommentReaction {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commentId    String    @db.Uuid
  comment      Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId       String?   @db.Uuid
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactionType String    @default("like")
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@unique([commentId, userId, reactionType])
  @@index([commentId, reactionType])
}

model CommentReport {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commentId       String              @db.Uuid
  comment         Comment             @relation(fields: [commentId], references: [id], onDelete: Cascade)

  reporterId      String?             @db.Uuid
  reporter        User?               @relation("ReportedByUser", fields: [reporterId], references: [id], onDelete: SetNull)
  reporterName    String?
  reporterEmail   String?

  reason          CommentReportReason @default(INAPPROPRIATE)
  details         String?             @db.Text
  status          CommentReportStatus @default(PENDING)

  reviewedById    String?             @db.Uuid
  reviewedBy      User?               @relation("ReviewedByUser", fields: [reviewedById], references: [id], onDelete: SetNull)
  resolutionNotes String?             @db.Text

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt

  @@index([commentId])
  @@index([status])
  @@index([reporterId])
  @@index([reviewedById])
  @@index([createdAt])
}

model MediaFile {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String    @unique
  bucket         String
  fileName       String
  fileExtension  String?
  mimeType       String
  size           BigInt
  url            String
  etag           String?
  source         String    @default("API")
  folder         String    @default("general")
  entityType     String?
  entityId       String?   @db.Uuid
  tags           String[]  @default([])
  altText        String?
  caption        String?
  metadata       Json?
  isPublic       Boolean   @default(true)
  uploaderId     String?   @db.Uuid
  uploader       User?     @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([folder])
  @@index([source])
  @@index([mimeType])
  @@index([entityType, entityId])
  @@index([uploaderId])
  @@index([createdAt])
}

