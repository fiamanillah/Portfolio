{
  "name": "@workspace/env",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api.ts",
      "import": "./src/api.ts",
      "default": "./src/api.ts"
    },
    "./web": {
      "types": "./src/web.ts",
      "import": "./src/web.ts",
      "default": "./src/web.ts"
    },
    "./dashboard": {
      "types": "./src/dashboard.ts",
      "import": "./src/dashboard.ts",
      "default": "./src/dashboard.ts"
    },
    "./db": {
      "types": "./src/db.ts",
      "import": "./src/db.ts",
      "default": "./src/db.ts"
    },
    "./loader": {
      "types": "./src/loader.ts",
      "import": "./src/loader.ts",
      "default": "./src/loader.ts"
    },
    "./redis": {
      "types": "./src/redis.ts",
      "import": "./src/redis.ts",
      "default": "./src/redis.ts"
    },
    "./cache": {
      "types": "./src/redis.ts",
      "import": "./src/redis.ts",
      "default": "./src/redis.ts"
    }
  },

  "bin": {
    "check-env": "./src/check.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "bun src/check.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "zod": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3"
  }
}
