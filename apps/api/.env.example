# Server
PORT=3040
NODE_ENV=development
REQUEST_TIMEOUT=30000

# Database
DATABASE_URL=postgresql://fiamanillah:fiamanillah@localhost:5445/portfolio_db?schema=public
DB_LOGGING=true

# Security & CORS
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000,http://localhost:5173,http://127.0.0.1:4321
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=1d
JWT_ISSUER=ignitor-app

# Default Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-immediately

# Public Site Domain
PUBLIC_WEB_URL=http://localhost:4321

# Email Delivery Stack (Plunk)
PLUNK_SECRET_KEY=plunk_sk_your_key_here
PLUNK_API_URL=https://next-api.useplunk.com

# Email Routing & Domain Sender Identity
PERSONAL_EMAIL=fi@amanillah.com
DEFAULT_REPLY_TO_EMAIL=fi@amanillah.com
TRANSACTIONAL_FROM_EMAIL=hello@mail.amanillah.com
SYSTEM_FROM_EMAIL=system@mail.amanillah.com
AUTH_FROM_EMAIL=auth@mail.amanillah.com
BOOKING_FROM_EMAIL=bookings@mail.amanillah.com
NEWSLETTER_FROM_EMAIL=newsletter@newsletter.amanillah.com
BOOKING_NOTIFICATION_EMAIL=fi@amanillah.com

# Anti-Spam / Cloudflare Turnstile
TURNSTILE_SECRET_KEY=0x4AAAAAAAYourTurnstileSecretKeyHere

# Contact Form
CONTACT_RECIPIENT_EMAIL=fi@amanillah.com
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_RATE_LIMIT_MAX=5

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=logs/app.log

# Cloudflare R2 / S3 Compatible Object Storage Configuration
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=portfolio-assets
R2_PUBLIC_DOMAIN=https://assets.fi.amanillah.com
R2_REGION=auto
R2_ENDPOINT=
STORAGE_MAX_FILE_SIZE=52428800
STORAGE_PRESIGNED_EXPIRES_IN=900
STORAGE_ALLOWED_MIME_TYPES=

# ==========================================
# Google Calendar & Booking Engine Integration
# ==========================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3040/booking/v1/google/callback
PUBLIC_DASHBOARD_URL=http://localhost:3001
BOOKING_NOTIFICATION_EMAIL=fi@amanillah.dev
BOOKING_RATE_LIMIT_WINDOW_MS=3600000
BOOKING_RATE_LIMIT_MAX=10

