# ==============================================================================
# Web Frontend (Astro 5 SSG) - Development Environment Variables
# Note: Astro inlines PUBLIC_* variables at BUILD TIME into client JavaScript.
# ==============================================================================

# Local Frontend Website URL
PUBLIC_WEB_URL=http://localhost:4321

# Local Backend API Endpoint URL
PUBLIC_API_URL=http://localhost:3040

# Cloudflare Turnstile Site Key (Public Key for client-side captcha widget)
# You can use '1x00000000000000000000AA' for Cloudflare Turnstile Always Pass test key in development
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Environment
NODE_ENV=development
