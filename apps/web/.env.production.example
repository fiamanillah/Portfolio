# ==============================================================================
# Web Frontend (Astro 5 SSG) - Production Environment Variables
# Note: In Astro SSG, PUBLIC_* variables must be provided as Docker Build ARGs
# because the site is compiled into pure static HTML/JS and served via Nginx.
# ==============================================================================

# Production Public Website URL (Used in canonical links, sitemaps, RSS, SEO)
PUBLIC_WEB_URL=https://fi.amanillah.com

# Production Public Backend API Endpoint
PUBLIC_API_URL=https://api.fi.amanillah.com

# Cloudflare Turnstile Production Site Key (Public Key)
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAYourProductionTurnstileSiteKey

# Environment
NODE_ENV=production
