---
import "@workspace/ui/globals.css"
import GridLines from "@/components/GridLines.astro"
import SiteNav from "@/components/site-nav.astro"
import ThemeScript from "@/components/ThemeScript.astro"
import Footer from "@/components/footer.astro"
import { Toaster } from "@workspace/ui/components/sonner"
import { AuthModal } from "@/components/auth/AuthModal"
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Fi Amanillah | Engineering Blog"
      href="/rss.xml"
    />
    <ThemeScript />
    <slot name="head">
      <title>Fi Amanillah | Full Stack Developer</title>
      <meta
        name="description"
        content="Portfolio & Engineering Blog of Fi Amanillah — Full Stack Developer."
      />
    </slot>
  </head>
  <body class="min-h-svh overflow-x-hidden bg-background text-foreground">
    <!-- GridLines renders a fixed full-viewport canvas — no wrapper needed -->
    <div id="mouse-glow" class="pointer-events-none fixed inset-0 -z-20">
      <div id="glow-ball" class="mouse-glow-ball"></div>
    </div>

    <GridLines lines={[-0.04, 0, 1, 1.04]} />

    <div class="relative mx-[4%]">
      <header
        class="sticky top-0 z-50 container mx-auto border-b border-border/40 bg-background/80 backdrop-blur-md transition-colors duration-200 supports-backdrop-filter:bg-background/60"
      >
        <SiteNav />
      </header>
      <main class="relative container mx-auto">
        <slot />
      </main>
    </div>

    <Toaster client:load />
    <AuthModal client:load />
    <Footer />

    <script>
      const glowBall = document.getElementById("glow-ball")
      const mouseGlow = document.getElementById("mouse-glow")

      if (glowBall && mouseGlow) {
        window.addEventListener("pointermove", (event) => {
          glowBall.style.left = `${event.clientX}px`
          glowBall.style.top = `${event.clientY + window.scrollY}px`
          glowBall.style.opacity = "1"
        })

        window.addEventListener("pointerleave", () => {
          glowBall.style.opacity = "0"
        })
      }
    </script>
  </body>
</html>
