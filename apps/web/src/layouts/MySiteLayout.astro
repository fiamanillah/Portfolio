---
import "@workspace/ui/globals.css"
import GridLines from "@/components/GridLines.astro"
import MouseGlow from "@/components/MouseGlow.astro"
import SiteNav from "@/components/site-nav.astro"
import ThemeScript from "@/components/ThemeScript.astro"
import Footer from "@/components/footer.astro"
import { Toaster } from "@workspace/ui/components/sonner"
import { AuthModal } from "@/components/auth/AuthModal"
import { CookieConsent } from "@/components/Legal/CookieConsent"
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Fi Amanillah | Tech, AI & Engineering Journal"
      href="/rss.xml"
    />
    <ThemeScript />
    <slot name="head">
      <title>Fi Amanillah | Software Engineer & Tech Explorer</title>
      <meta
        name="description"
        content="Portfolio, Tech Stories & Engineering Journal of Fi Amanillah — Software Engineer & Technology Enthusiast."
      />
    </slot>
  </head>
  <body class="min-h-svh overflow-x-hidden bg-background text-foreground">
    <!-- Smooth hardware-accelerated viewport-tracked cursor glow -->
    <MouseGlow />

    <GridLines lines={[-0.04, 0, 1, 1.04]} />

    <div class="relative mx-[4%]">
      <header
        class="sticky top-0 z-50 container mx-auto border-b border-border/40 bg-background/80 backdrop-blur-md transition-colors duration-200 supports-backdrop-filter:bg-background/60"
      >
        <SiteNav />
      </header>
      <main class="relative container mx-auto">
        <slot />
      </main>
    </div>

    <Toaster client:load />
    <AuthModal client:load />
    <CookieConsent client:load />
    <Footer />
  </body>
</html>
