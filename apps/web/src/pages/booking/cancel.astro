---
import MySiteLayout from "@/layouts/MySiteLayout.astro"
import BookingCancelContainer from "@/components/Booking/BookingCancelContainer"
import SEO from "@/components/SEO/SEO.astro"
---

<MySiteLayout>
  <Fragment slot="head">
    <SEO
      title="Manage Consultation Session | Fi Amanillah"
      description="Review and manage or cancel your scheduled consultation session with Fi Amanillah."
      url="/booking/cancel"
      noIndex={true}
    />
  </Fragment>

  <section class="relative z-10 min-h-[calc(100svh-14rem)] py-16 sm:py-24">
    <!-- Ambient glow behind card -->
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div
        class="absolute top-1/3 left-1/2 h-80 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/6 blur-[120px]"
      >
      </div>
    </div>

    <div class="container mx-auto px-4">
      {/* Section Header */}
      <div class="mx-auto mb-10 max-w-xl text-center">
        <p
          class="mb-3 inline-block border border-primary/20 bg-primary/5 px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-widest text-primary"
        >
          [ SESSION_MANAGEMENT // 1-ON-1 ]
        </p>
        <h1 class="font-mono text-2xl font-black uppercase tracking-tight text-foreground sm:text-3xl">
          Manage Consultation
        </h1>
        <p class="mt-2 font-mono text-xs text-muted-foreground">
          Review your appointment details, update status, or cancel and release your reserved time slot.
        </p>
      </div>

      {/* Interactive React Cancellation Portal Island */}
      <BookingCancelContainer client:load />
    </div>
  </section>
</MySiteLayout>
