---
import MySiteLayout from "@/layouts/MySiteLayout.astro"
import BlogHeader from "@/components/Blog/hero/BlogHeader.astro"
import BlogFeaturedGrid from "@/components/Blog/featured/BlogFeaturedGrid.astro"
import BlogCard from "@/components/Blog/cards/BlogCard.astro"
import BlogCategoryFilter from "@/components/Blog/explorer/BlogCategoryFilter.astro"
import NewsletterSection from "@/components/Newsletter/NewsletterSection.astro"
import SectionDivider from "@/components/SectionDivider.astro"
import BlogSEO from "@/components/SEO/BlogSEO.astro"
import { Button } from "@workspace/ui/components/button"
import {
  getAllBlogPostsAsync,
  getBlogCategoriesAsync,
  getBlogTagsAsync,
  getFeaturedBlogPostsAsync,
} from "@/data/blogPosts"

// Fetch published posts, categories, tags, and featured stories directly from DB / API
const posts = await getAllBlogPostsAsync()
const categories = await getBlogCategoriesAsync()
const tags = await getBlogTagsAsync()
let featuredPosts = await getFeaturedBlogPostsAsync()

// Graceful fallback for featured section when database has no explicit featured items
if (featuredPosts.length === 0 && posts.length > 0) {
  const markedFeatured = posts.filter((p) => p.featured)
  featuredPosts =
    markedFeatured.length > 0 ? markedFeatured.slice(0, 4) : posts.slice(0, 4)
}

// Show the most recent 9 articles for the landing showcase
const recentPosts = posts.slice(0, 9)
const postsPerPage = 9
const totalPages = Math.max(1, Math.ceil(posts.length / postsPerPage))
const totalTopics = tags.length > 0 ? tags.length : new Set(posts.flatMap((p) => p.tags)).size
---

<MySiteLayout>
  <!-- SEO & Schema markup for Blog Index -->
  <Fragment slot="head">
    <BlogSEO
      title="Technology Journal, AI Stories & Engineering Insights"
      description="In-depth technology writeups, AI breakthroughs, semiconductor & hardware market trends, and software engineering deep dives by Fi Amanillah."
      type="website"
      url="/blog"
      tags={[
        "Technology",
        "Artificial Intelligence",
        "Semiconductors",
        "Hardware Market",
        "Software Engineering",
        "System Architecture",
        "Tech Trends",
      ]}
    />
  </Fragment>

  <!-- Hero Header with live aggregated database metrics -->
  <BlogHeader
    totalPosts={posts.length}
    totalCategories={Math.max(
      1,
      categories.filter((c) => c.name.toLowerCase() !== "all").length
    )}
    totalTopics={totalTopics}
  />

  <SectionDivider />

  <main class="w-full">
    <!-- Featured Stories Section -->
    {
      featuredPosts.length > 0 && (
        <section id="featured-stories" class="relative z-10 mx-auto">
          <div class="container mx-auto">
            <BlogFeaturedGrid featuredPosts={featuredPosts} />
          </div>
        </section>
        <SectionDivider />
      )
    }

    <!-- Recent Articles & Explore Section -->
    <section id="recent-articles" class="relative z-10 mx-auto">
      <div class="container mx-auto">
        <!-- Section Header -->
        <div class="relative overflow-hidden text-center">
          <div
            class="diagonal-stripes pointer-events-none absolute inset-0 z-10 bg-background"
            aria-hidden="true"
          >
          </div>
          <div class="relative z-10 py-3">
            <p class="section-label mb-1">Latest Insights &amp; Publications</p>
            <h2 class="section-title text-foreground">
              Recent <span class="text-primary">/</span> Articles
            </h2>
            <div class="accent-bar mx-auto mt-2 mb-0 w-48"></div>
          </div>
        </div>

        <!-- Category Explore Bar -->
        <BlogCategoryFilter
          categories={categories}
          activeCategory=""
          baseUrl="/blog/category"
          showAllOption={true}
          allUrl="/blog/page/1"
        />

        <!-- 3-Column Responsive Recent Posts Grid (Zero Gap Seamless Bento Grid) -->
        {
          recentPosts.length > 0 ? (
            <div class="grid grid-cols-1 border-t border-l border-border sm:grid-cols-2 lg:grid-cols-3">
              {recentPosts.map((post) => (
                <BlogCard post={post} class="border-r border-b border-border" />
              ))}
            </div>
          ) : (
            <div class="border border-border/80 bg-background/50 p-8 text-center font-mono text-sm text-muted-foreground">
              No published articles found yet. Check back soon!
            </div>
          )
        }

        <!-- Dedicated Archive CTA -->
        <div class="mt-8 text-center">
          <a href="/blog/page/1" class="inline-block">
            <Button
              variant="outline"
              size="lg"
              className="border-primary/40 font-mono text-xs tracking-wider text-primary transition-all duration-200 hover:bg-primary/10 hover:shadow-[0_0_16px_oklch(var(--primary)/20%)]"
            >
              Explore All Articles
              <span class="ml-1.5 transition-transform duration-200 hover:translate-x-0.5">
                →
              </span>
            </Button>
          </a>
        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- Newsletter Section -->
    <NewsletterSection
      title="Stay Ahead in Tech, AI & Engineering"
      subtitle="Subscribe to get tech stories, AI breakthroughs, semiconductor & hardware market updates, and engineering insights delivered directly to your inbox."
      source="blog_index"
      idPrefix="blog-page-newsletter"
    />
  </main>
</MySiteLayout>
