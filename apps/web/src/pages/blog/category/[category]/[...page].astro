---
import MySiteLayout from "@/layouts/MySiteLayout.astro"
import BlogCard from "@/components/Blog/cards/BlogCard.astro"
import BlogCategoryFilter from "@/components/Blog/explorer/BlogCategoryFilter.astro"
import BlogPagination from "@/components/Blog/explorer/BlogPagination.astro"
import NewsletterSection from "@/components/Newsletter/NewsletterSection.astro"
import SectionDivider from "@/components/SectionDivider.astro"
import BlogSEO from "@/components/SEO/BlogSEO.astro"
import {
  getAllBlogPostsAsync,
  getBlogCategoriesAsync,
  getCategorySlug,
  type BlogPost,
} from "@/data/blogPosts"

export async function getStaticPaths() {
  const posts = await getAllBlogPostsAsync()
  const categories = await getBlogCategoriesAsync()
  const postsPerPage = 9

  const knownSlugs = new Set<string>()
  const paths: any[] = []

  // Collect unique category definitions
  const allCategoryDefs: Array<{
    name: string
    color: string
    slug: string
  }> = []

  for (const cat of categories.filter((c) => c.name.toLowerCase() !== "all")) {
    const slug = getCategorySlug(cat)
    if (!slug || knownSlugs.has(slug)) continue
    knownSlugs.add(slug)
    allCategoryDefs.push({
      name: cat.name,
      color: cat.color || "#3b82f6",
      slug,
    })
  }

  for (const post of posts) {
    const slug = getCategorySlug(post.categorySlug || post.category)
    if (!slug || knownSlugs.has(slug)) continue
    knownSlugs.add(slug)
    allCategoryDefs.push({
      name: post.category,
      color: post.categoryColor || "#3b82f6",
      slug,
    })
  }

  // Generate paginated paths for each category
  for (const catDef of allCategoryDefs) {
    const matchingPosts = posts.filter(
      (p) =>
        p.category.toLowerCase() === catDef.name.toLowerCase() ||
        getCategorySlug(p.categorySlug || p.category) === catDef.slug
    )

    const totalPages = Math.max(1, Math.ceil(matchingPosts.length / postsPerPage))

    for (let pageNum = 1; pageNum <= totalPages; pageNum++) {
      const start = (pageNum - 1) * postsPerPage
      const pagePosts = matchingPosts.slice(start, start + postsPerPage)

      paths.push({
        params: {
          category: catDef.slug,
          page: pageNum === 1 ? undefined : String(pageNum),
        },
        props: {
          categoryName: catDef.name,
          categoryColor: catDef.color,
          categorySlug: catDef.slug,
          categoryPosts: pagePosts,
          currentPage: pageNum,
          totalPages,
          totalCategoryPosts: matchingPosts.length,
          postsPerPage,
        },
      })
    }
  }

  return paths
}

interface Props {
  categoryName?: string
  categoryColor?: string
  categorySlug?: string
  categoryPosts?: BlogPost[]
  currentPage?: number
  totalPages?: number
  totalCategoryPosts?: number
  postsPerPage?: number
}

const { category: paramCategory, page: paramPage } = Astro.params
const pageNum = parseInt(paramPage || "1", 10) || 1
const postsPerPage = Astro.props.postsPerPage || 9

const categories = await getBlogCategoriesAsync()
const allPosts = await getAllBlogPostsAsync()

const categorySlug = Astro.props.categorySlug || paramCategory || ""
const foundCategory = categories.find(
  (c) =>
    getCategorySlug(c) === categorySlug ||
    c.name.toLowerCase() === categorySlug.toLowerCase()
)

const categoryName =
  Astro.props.categoryName ||
  foundCategory?.name ||
  categorySlug
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ")

const categoryColor =
  Astro.props.categoryColor || foundCategory?.color || "#3b82f6"

const allMatchingPosts = allPosts.filter(
  (p) =>
    p.category.toLowerCase() === categoryName.toLowerCase() ||
    getCategorySlug(p.categorySlug || p.category) === categorySlug
)

const totalCategoryPosts =
  Astro.props.totalCategoryPosts ?? allMatchingPosts.length
const totalPages =
  Astro.props.totalPages ??
  Math.max(1, Math.ceil(totalCategoryPosts / postsPerPage))
const currentPage = Astro.props.currentPage ?? pageNum

const start = (currentPage - 1) * postsPerPage
const posts =
  Astro.props.categoryPosts ??
  allMatchingPosts.slice(start, start + postsPerPage)

// Format category description helper
const categoryDescriptions: Record<string, string> = {
  "ai-intelligence":
    "Explorations into modern AI architectures, Large Language Models, autonomous agents, and intelligence systems.",
  "hardware-chips":
    "Semiconductor engineering, GPU architectures, custom silicon, memory bandwidth, and deep hardware analyses.",
  "software-engineering":
    "Practical software engineering principles, robust fullstack patterns, testing paradigms, and maintainable codebases.",
  "system-architecture":
    "High-throughput distributed systems, event-driven pipelines, database internals, and zero-downtime scalability.",
  "tech-trends":
    "Industry shifts, technical deep dives, emerging tools, and strategic insights shaping modern computing.",
  "devops-cloud":
    "Cloud infrastructure, Kubernetes, CI/CD automation, edge compute networks, and observability.",
  security:
    "Application security, vulnerability mitigations, encryption protocols, and zero-trust engineering.",
}

const baseDescription =
  categoryDescriptions[categorySlug] ||
  `In-depth technical writeups, systems architecture deep dives, and expert analysis on ${categoryName} by Fi Amanillah.`

const description =
  currentPage === 1
    ? baseDescription
    : `Browse page ${currentPage} of ${totalPages} for ${categoryName} articles and insights by Fi Amanillah.`

const canonicalPath =
  currentPage === 1
    ? `/blog/category/${categorySlug}`
    : `/blog/category/${categorySlug}/${currentPage}`

const prevPageUrl =
  currentPage > 1
    ? currentPage === 2
      ? `/blog/category/${categorySlug}`
      : `/blog/category/${categorySlug}/${currentPage - 1}`
    : undefined

const nextPageUrl =
  currentPage < totalPages
    ? `/blog/category/${categorySlug}/${currentPage + 1}`
    : undefined

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Blog", url: "/blog" },
  { name: categoryName, url: `/blog/category/${categorySlug}` },
  ...(currentPage > 1
    ? [{ name: `Page ${currentPage}`, url: canonicalPath }]
    : []),
]
---

<MySiteLayout>
  <!-- Dedicated Category SEO & Schema with Pagination Links -->
  <Fragment slot="head">
    <BlogSEO
      title={
        currentPage === 1
          ? `${categoryName} Articles & Engineering Insights | Fi Amanillah`
          : `${categoryName} Articles — Page ${currentPage} of ${totalPages} | Fi Amanillah`
      }
      description={description}
      type="website"
      url={canonicalPath}
      category={categoryName}
      prevPageUrl={prevPageUrl}
      nextPageUrl={nextPageUrl}
      breadcrumbs={breadcrumbs}
    />
  </Fragment>

  <!-- Breadcrumbs -->
  <nav
    aria-label="Breadcrumbs"
    class="border-b border-border/60 bg-background/50 py-2.5"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div
        class="flex flex-wrap items-center gap-2 font-mono text-xs text-muted-foreground"
      >
        <a href="/" class="transition-colors hover:text-foreground">Home</a>
        <span>/</span>
        <a href="/blog" class="transition-colors hover:text-foreground">Blog</a>
        <span>/</span>
        <span class="text-muted-foreground">Category</span>
        <span>/</span>
        <span class="font-semibold text-primary">{categoryName}</span>
        {
          currentPage > 1 && (
            <>
              <span>/</span>
              <span class="font-semibold text-foreground">Page {currentPage}</span>
            </>
          )
        }
      </div>
    </div>
  </nav>

  <main class="w-full">
    <!-- Category Hero Header (Compact padding) -->
    <header class="relative overflow-hidden border-b border-border py-8 sm:py-12">
      <!-- Ambient Glow themed to category color -->
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div
          class="absolute top-1/2 left-1/2 h-72 w-72 -translate-x-1/2 -translate-y-1/2 rounded-full blur-[90px] opacity-15"
          style={{ backgroundColor: categoryColor }}
        >
        </div>
      </div>

      <div
        class="diagonal-stripes pointer-events-none absolute inset-0 z-0 bg-background opacity-80"
        aria-hidden="true"
      >
      </div>

      <div class="relative z-10 mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
        <!-- Category Badge Pill -->
        <div class="flex justify-center">
          <span
            style={{
              borderColor: `${categoryColor}60`,
              backgroundColor: `${categoryColor}15`,
              color: categoryColor,
              boxShadow: `0 0 14px ${categoryColor}25`,
            }}
            class="mb-3 inline-flex items-center gap-2 border px-3 py-1 font-mono text-xs font-bold uppercase backdrop-blur-md"
          >
            <span
              class="h-2 w-2 rounded-full"
              style={{
                backgroundColor: categoryColor,
                boxShadow: `0 0 6px ${categoryColor}`,
              }}
            >
            </span>
            TOPIC // {categoryName.toUpperCase()}
          </span>
        </div>

        <h1 class="section-title text-foreground">
          {categoryName} <span class="text-primary italic">Articles</span>
          {currentPage > 1 && <span class="text-muted-foreground text-2xl sm:text-3xl font-normal ml-2">— Page {currentPage}</span>}
        </h1>

        <div class="accent-bar mx-auto mt-3 mb-3 w-48"></div>

        <p class="mx-auto max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">
          {description}
        </p>

        <!-- Stats Bar -->
        <div class="mt-4 flex items-center justify-center gap-4 font-mono text-xs text-muted-foreground">
          <span class="inline-flex items-center gap-1.5 border border-border/80 bg-card/60 px-3 py-1 backdrop-blur-sm">
            <span class="font-bold text-foreground">{totalCategoryPosts}</span>
            <span>{totalCategoryPosts === 1 ? "Article" : "Articles"} Published</span>
          </span>
          <a
            href="/blog/page/1"
            class="text-primary transition-colors hover:underline"
          >
            View All Topics →
          </a>
        </div>
      </div>
    </header>

    <!-- Category Filter Bar (to jump to other categories) -->
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <BlogCategoryFilter
        categories={categories}
        activeCategory={categorySlug}
        baseUrl="/blog/category"
        showAllOption={true}
        allUrl="/blog/page/1"
      />
    </div>

    <!-- Category Articles Grid Section (9 posts per page) -->
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      {
        posts.length > 0 ? (
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <BlogCard post={post} class="border border-border" />
            ))}
          </div>
        ) : (
          <div class="border border-border/80 bg-background/50 p-8 text-center">
            <p class="font-mono text-base font-semibold text-foreground">
              No articles found in {categoryName} yet.
            </p>
            <p class="mt-2 font-mono text-xs text-muted-foreground">
              New writeups are actively in progress. Check back soon or explore other topics!
            </p>
            <div class="mt-6">
              <a
                href="/blog/page/1"
                class="inline-flex items-center border border-primary/40 bg-primary/10 px-4 py-2 font-mono text-xs font-semibold text-primary transition-colors hover:bg-primary/20"
              >
                Browse All Articles →
              </a>
            </div>
          </div>
        )
      }

      <!-- Reusable Smart Category Pagination Navigation -->
      <BlogPagination
        currentPage={currentPage}
        totalPages={totalPages}
        totalCount={totalCategoryPosts}
        basePath={`/blog/category/${categorySlug}`}
        isCategoryRoute={true}
      />
    </div>

    <SectionDivider />

    <!-- Newsletter Section -->
    <NewsletterSection
      title={`Follow ${categoryName} Deep-Dives`}
      subtitle={`Subscribe to get notified as soon as new writeups and breakthroughs in ${categoryName} are published.`}
      source={`blog_category_${categorySlug}`}
      idPrefix="blog-category-newsletter"
    />
  </main>
</MySiteLayout>
