---
import MySiteLayout from "@/layouts/MySiteLayout.astro"
import BlogContentBody from "@/components/Blog/article/BlogContentBody.astro"
import BlogArticleNav from "@/components/Blog/article/BlogArticleNav.astro"
import BlogCard from "@/components/Blog/cards/BlogCard.astro"
import NewsletterSection from "@/components/Newsletter/NewsletterSection.astro"
import SectionDivider from "@/components/SectionDivider.astro"
import BlogSEO from "@/components/SEO/BlogSEO.astro"
import {
  getAllBlogPostsAsync,
  getBlogPostBySlugAsync,
  getCategorySlug,
  type BlogPost,
} from "@/data/blogPosts"

export async function getStaticPaths() {
  const posts = await getAllBlogPostsAsync()
  const fullDetails = await Promise.all(
    posts.map(async (post) => {
      const details = await getBlogPostBySlugAsync(post.slug)
      return {
        params: { slug: post.slug },
        props: {
          post: details?.post || post,
          prevPost: details?.prevPost || null,
          nextPost: details?.nextPost || null,
          relatedPosts: details?.relatedPosts || [],
        },
      }
    })
  )
  return fullDetails
}

interface Props {
  post?: BlogPost
  prevPost?: BlogPost | null
  nextPost?: BlogPost | null
  relatedPosts?: BlogPost[]
}

const { slug: rawSlug } = Astro.params
const propPost = Astro.props.post
const slug = rawSlug || propPost?.slug

let currentPost: BlogPost | undefined = propPost
let prevPost = Astro.props.prevPost || null
let nextPost = Astro.props.nextPost || null
let relatedPosts = Astro.props.relatedPosts || []

if (!slug && !currentPost) {
  return Astro.redirect("/404")
}

// On-demand fetch fallback for dynamic rendering or when props are not pre-populated
if ((!currentPost || !currentPost.content) && slug) {
  const postData = await getBlogPostBySlugAsync(slug)

  // If post has moved to a new URL, perform a 301 Permanent Redirect
  if (postData?.redirected && postData.destination) {
    return Astro.redirect(
      postData.destination,
      (postData.statusCode as 301 | 302 | 307 | 308) || 301
    )
  }

  if (postData?.post) {
    currentPost = postData.post
    prevPost = postData.prevPost || prevPost
    nextPost = postData.nextPost || nextPost
    if (postData.relatedPosts && postData.relatedPosts.length > 0) {
      relatedPosts = postData.relatedPosts
    }
  }
}

if (!currentPost) {
  return Astro.redirect("/404")
}

if (relatedPosts.length === 0 && slug) {
  const all = await getAllBlogPostsAsync()
  relatedPosts = all.filter((p) => p.slug !== slug).slice(0, 3)
}
---

<MySiteLayout>
  <!-- SEO & Structured Data Schema Injection -->
  <Fragment slot="head">
    <BlogSEO post={currentPost} />
  </Fragment>

  <!-- Top Reading Progress Bar (fixed under navbar) -->
  <div
    id="top-progress-track"
    class="fixed right-0 left-0 z-40 h-[3px] bg-border/20"
    style="top: 0; opacity: 0;"
  >
    <div
      id="top-reading-progress"
      class="h-full bg-primary transition-[width] duration-150 ease-out"
      style="width: 0%"
    >
    </div>
  </div>

  <!-- Centered Breadcrumbs Bar -->
  <nav
    aria-label="Breadcrumbs"
    class="border-b border-border/60 bg-background/50 py-3.5"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div
        class="flex flex-wrap items-center gap-2 font-mono text-xs text-muted-foreground"
      >
        <a href="/" class="transition-colors hover:text-foreground">Home</a>
        <span>/</span>
        <a href="/blog" class="transition-colors hover:text-foreground">Blog</a>
        <span>/</span>
        <a
          href={`/blog/category/${getCategorySlug(currentPost.categorySlug || currentPost.category)}`}
          class="text-primary hover:underline"
        >
          {currentPost.category}
        </a>
        <span>/</span>
        <span class="max-w-xs truncate font-semibold text-foreground"
          >{currentPost.title}</span
        >
      </div>
    </div>
  </nav>

  <main class="w-full py-4" data-post-slug={currentPost.slug}>
    {/* Reader Body (Main Article + Sticky Right TOC) */}
    <BlogContentBody post={currentPost} />

    {/* Previous & Next Article Navigation Container */}
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {/* Decorative section divider */}
      <div class="my-4 flex items-center gap-4">
        <div
          class="h-px flex-1 bg-gradient-to-r from-transparent via-primary/20 to-transparent"
        >
        </div>
        <span
          class="font-mono text-[10px] tracking-widest text-primary/40 uppercase"
          >CONTINUE</span
        >
        <div
          class="h-px flex-1 bg-gradient-to-r from-transparent via-primary/20 to-transparent"
        >
        </div>
      </div>

      {/* Previous & Next Article Navigation */}
      <BlogArticleNav prevPost={prevPost} nextPost={nextPost} />
    </div>

    {
      /* Related Articles — Dedicated Full-Width Section with SectionDivider & Gridline Alignment */
    }
    {
      relatedPosts.length > 0 && (
        <>
          <SectionDivider />
          <section
            class="blog-bottom-animate relative z-10 w-full"
            data-grid-cross
          >
            <div class="overflow-hidden border-r border-l border-border bg-background">
              {/* Section Header Bar */}
              <div class="flex items-center justify-between border-b border-border bg-card/60 px-4 py-3 sm:px-6">
                <div class="flex items-center gap-2 font-mono text-xs font-bold tracking-wider text-primary uppercase">
                  <span class="inline-block h-1.5 w-1.5 rounded-full bg-primary shadow-[0_0_6px_oklch(var(--primary))]" />
                  <span>// CONTINUE READING RELATED ARTICLES</span>
                </div>
                <a
                  href="/blog/page/1"
                  class="group/link inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground transition-colors hover:text-primary"
                >
                  <span>View All Articles</span>
                  <span class="transition-transform duration-200 group-hover/link:translate-x-0.5">
                    →
                  </span>
                </a>
              </div>

              {/* Zero-Gap 3-Column Responsive Grid */}
              <div class="grid grid-cols-1 divide-y divide-border md:grid-cols-3 md:divide-x md:divide-y-0">
                {relatedPosts.map((relatedPost) => (
                  <BlogCard
                    post={relatedPost}
                    class="rounded-none border-0 bg-transparent shadow-none"
                  />
                ))}
              </div>
            </div>
          </section>
          <SectionDivider />
        </>
      )
    }

    {/* Newsletter Subscription Section */}
    <div class="blog-bottom-animate pb-10">
      <NewsletterSection
        title="Enjoyed this Article?"
        subtitle="Get notified as soon as new tech deep dives, AI analyses, semiconductor market stories, and engineering guides are published."
        source="blog_detail"
        idPrefix="blog-detail-newsletter"
      />
    </div>
  </main>
</MySiteLayout>

<style>
  /* Bottom section entrance animations */
  @keyframes blog-bottom-fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .blog-bottom-animate {
    opacity: 0;
    animation: blog-bottom-fade-in 0.6s ease-out forwards;
    animation-play-state: paused;
  }

  .blog-bottom-animate.is-visible {
    animation-play-state: running;
  }
</style>

<script>
  import { BlogApi } from "@/lib/api/blogApi"

  // Top reading progress bar
  function initTopProgress() {
    const track = document.getElementById("top-progress-track")
    const bar = document.getElementById("top-reading-progress")
    if (!track || !bar) return

    // Position the bar below the sticky nav header
    const nav = document.querySelector("header.sticky")
    if (nav) {
      const navHeight = nav.getBoundingClientRect().height
      track.style.top = `${navHeight}px`
    }
    track.style.opacity = "1"

    let ticking = false
    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const scrollY = window.scrollY
          const docHeight =
            document.documentElement.scrollHeight - window.innerHeight
          const progress =
            docHeight > 0 ? Math.min(100, (scrollY / docHeight) * 100) : 0
          bar.style.width = `${progress}%`
          ticking = false
        })
        ticking = true
      }
    })
  }

  // Bottom sections entrance animation
  function initBottomAnimations() {
    const elements = document.querySelectorAll(".blog-bottom-animate")
    if (!elements.length) return

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible")
            observer.unobserve(entry.target)
          }
        })
      },
      { rootMargin: "0px 0px -60px 0px", threshold: 0.1 }
    )

    elements.forEach((el) => observer.observe(el))
  }

  // Real-time View Counter & Telemetry Trigger
  function initViewCounter() {
    const mainEl = document.querySelector<HTMLElement>("main[data-post-slug]")
    if (!mainEl) return
    const slug = mainEl.dataset.postSlug
    if (!slug) return

    // Avoid duplicate increments in the same page view session
    const sessionKey = `view_recorded_${slug}`
    if (!sessionStorage.getItem(sessionKey)) {
      sessionStorage.setItem(sessionKey, "true")
      BlogApi.recordPostView(slug)
        .then((result) => {
          if (result && typeof result.views === "number") {
            const viewSpans = document.querySelectorAll<HTMLElement>(
              "[data-post-views-count]"
            )
            const formatted =
              result.views >= 1000
                ? `${(result.views / 1000).toFixed(result.views % 1000 === 0 ? 0 : 1)}k`
                : `${result.views}`
            viewSpans.forEach((span) => {
              span.textContent = `${formatted} Views`
            })
          }
        })
        .catch(() => {})
    }
  }

  // Real-time Likes Counter Sync
  function initLikesSync() {
    const mainEl = document.querySelector<HTMLElement>("main[data-post-slug]")
    if (!mainEl) return
    const slug = mainEl.dataset.postSlug
    if (!slug) return

    const updateLikesDisplay = () => {
      const raw = localStorage.getItem(`portfolio_reactions_${slug}`)
      if (raw) {
        try {
          const parsed = JSON.parse(raw)
          if (typeof parsed.likes === "number") {
            const likeSpans = document.querySelectorAll<HTMLElement>(
              "[data-post-likes-count]"
            )
            likeSpans.forEach((span) => {
              span.textContent = String(parsed.likes)
            })
          }
        } catch (_) {}
      }
    }

    // Update on custom engagement event and storage event
    window.addEventListener("portfolio:engagement-change", ((e: Event) => {
      const customEvent = e as CustomEvent<{ slug?: string }>
      if (!customEvent.detail || customEvent.detail.slug === slug) {
        updateLikesDisplay()
      }
    }) as EventListener)
    window.addEventListener("storage", (e) => {
      if (e.key === `portfolio_reactions_${slug}`) {
        updateLikesDisplay()
      }
    })
    updateLikesDisplay()
  }

  function initAll() {
    initTopProgress()
    initBottomAnimations()
    initViewCounter()
    initLikesSync()
  }

  document.addEventListener("DOMContentLoaded", initAll)
  document.addEventListener("astro:page-load", initAll)
</script>
