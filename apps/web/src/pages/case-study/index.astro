---
import MySiteLayout from "@/layouts/MySiteLayout.astro"
import CaseStudyHeader from "@/components/CaseStudy/hero/CaseStudyHeader.astro"
import CaseStudyExplorer from "@/components/CaseStudy/explorer/CaseStudyExplorer.astro"
import NewsletterSection from "@/components/Newsletter/NewsletterSection.astro"
import SectionDivider from "@/components/SectionDivider.astro"
import { getProjectsWithoutCaseStudy } from "@/data/projects"
import { CaseStudyApi } from "@/lib/api/caseStudyApi"

// Fetch published case studies directly from PostgreSQL API (with local fallback)
const fetchedCaseStudies = await CaseStudyApi.fetchAllCaseStudies()

const caseStudies = fetchedCaseStudies.map((study, idx) => {
  const metaObj = (study.metadata || []).reduce((acc: any, item: any) => {
    acc[item.label] = item.value
    return acc
  }, {})

  return {
    id: study.slug,
    slug: study.slug,
    title: study.title.includes("—")
      ? study.title.split("—")[0]?.trim()
      : study.title,
    subtitle: study.title.includes("—")
      ? study.title.split("—")[1]?.trim()
      : undefined,
    description: study.description,
    role: metaObj["Role"] || "Full-Stack Architect",
    impact:
      study.description.length > 130
        ? study.description.slice(0, 130) + "..."
        : study.description,
    tech: study.techStack || [],
    links: {
      live: study.liveUrl || undefined,
      github: study.githubUrl || undefined,
      caseStudy: `/case-study/${study.slug}`,
    },
    img: study.image,
    index: String(idx + 1).padStart(2, "0"),
    status: (study.status || "Completed").replace(/^Status:\s*/i, ""),
    year: metaObj["Timeline"] || "2026",
    hasCaseStudy: true,
    featured: true,
    metrics: (study.metrics || []).slice(0, 3).map((m) => ({
      value: m.value,
      label: m.label,
    })),
    highlights: (study.features || [])
      .flatMap((f) => f.highlights || [])
      .slice(0, 3),
  }
})

const standardProjects = getProjectsWithoutCaseStudy()
const allProjects = [...caseStudies, ...standardProjects]
const totalTechCount = new Set(allProjects.flatMap((p) => p.tech)).size
---

<MySiteLayout>
  <!-- SEO Head Slot -->
  <Fragment slot="head">
    <title>Technical Case Studies & System Architecture | Fi Amanillah</title>
    <meta
      name="description"
      content="In-depth architectural breakdowns, database schema designs, event-driven pipelines, and production engineering post-mortems across full-stack applications."
    />
    <meta property="og:title" content="Technical Case Studies & Architecture | Fi Amanillah" />
    <meta
      property="og:description"
      content="Explore full-stack architectural deep dives, real-time microservices, database optimizations, and system post-mortems."
    />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Technical Case Studies & Architecture | Fi Amanillah" />
    <meta
      name="twitter:description"
      content="Explore full-stack architectural deep dives, real-time microservices, database optimizations, and system post-mortems."
    />
  </Fragment>

  <!-- Hero Header with Live Aggregated Metrics -->
  <CaseStudyHeader
    totalCaseStudies={caseStudies.length}
    totalProjects={standardProjects.length}
    totalTechCount={totalTechCount}
  />

  <SectionDivider />

  <main class="w-full">
    <!-- Interactive Case Study & Projects Explorer -->
    <div class="container mx-auto">
      <CaseStudyExplorer
        caseStudies={caseStudies}
        standardProjects={standardProjects}
      />
    </div>

    <SectionDivider class="mt-16" />

    <!-- Newsletter Section -->
    <NewsletterSection
      title="Subscribe to Tech & Architecture Insights"
      subtitle="Get notified when new technical post-mortems, hardware benchmarks, and software architecture case studies are published."
      source="case_study_list"
      idPrefix="cs-list-newsletter"
    />
  </main>
</MySiteLayout>
