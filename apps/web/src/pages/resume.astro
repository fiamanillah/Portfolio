---
import MySiteLayout from "@/layouts/MySiteLayout.astro"
import SectionDivider from "@/components/SectionDivider.astro"
import NewsletterSection from "@/components/Newsletter/NewsletterSection.astro"
import { ResumeApi } from "@/lib/api/resumeApi"
import SEO from "@/components/SEO/SEO.astro"

const activeResume = await ResumeApi.fetchActiveResume()

function formatBytes(bytes: number) {
  if (!bytes || bytes === 0) return "PDF Document"
  const k = 1024
  const sizes = ["Bytes", "KB", "MB"]
  const i = Math.floor(Math.log(bytes) / Math.log(k))
  return `${parseFloat((bytes / Math.pow(k, i)).toFixed(1))} ${sizes[i]}`
}

function formatDate(dateStr: string | null) {
  if (!dateStr) return "Recently Released"
  try {
    return new Date(dateStr).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  } catch {
    return "Recently Released"
  }
}
---

<MySiteLayout>
  <Fragment slot="head">
    <SEO
      title="Curriculum Vitae & Technical Resume | Fi Amanillah"
      description="Official curriculum vitae of Fi Amanillah — Full Stack Developer specializing in scalable TypeScript backends, event-driven architectures, and cloud DevOps."
      url="/resume"
      image="/fi.png"
      tags={[
        "Curriculum Vitae",
        "Resume",
        "Full Stack Developer",
        "Software Engineer",
        "TypeScript",
        "PostgreSQL",
      ]}
    />
  </Fragment>

  <style>
    @keyframes float-glow {
      0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.12; }
      50% { transform: translate(-50%, -50%) scale(1.18); opacity: 0.22; }
    }
    @keyframes blink-cursor {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }
    .cursor-blink {
      animation: blink-cursor 1.1s step-end infinite;
    }
    @keyframes slide-up-fade {
      from { opacity: 0; transform: translateY(18px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .anim-in { animation: slide-up-fade 0.7s ease forwards; }
    .anim-in-delay { animation: slide-up-fade 0.7s 0.18s ease forwards; opacity: 0; }
    .anim-in-delay-2 { animation: slide-up-fade 0.7s 0.32s ease forwards; opacity: 0; }
  </style>

  <!-- Hero Header matching Site-Wide Standards -->
  <header
    class="relative overflow-hidden border-b border-border pt-16 pb-16 sm:pt-24"
    data-grid-cross
  >
    <!-- Ambient glows -->
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div
        class="absolute top-1/2 left-1/4 h-96 w-96 -translate-x-1/2 -translate-y-1/2 animate-[float-glow_8s_ease-in-out_infinite] rounded-full bg-primary/15 blur-[110px]"
      ></div>
      <div
        class="absolute top-1/3 right-1/4 h-64 w-64 -translate-x-1/2 -translate-y-1/2 animate-[float-glow_8s_ease-in-out_infinite] rounded-full bg-primary/10 blur-[90px]"
        style="animation-delay: -4s;"
      ></div>
    </div>

    <!-- Diagonal stripe bg overlay -->
    <div
      class="diagonal-stripes pointer-events-none absolute inset-0 z-0 bg-background opacity-80"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <!-- Section label pill -->
      <div class="anim-in flex justify-center">
        <p
          class="mb-5 inline-flex items-center gap-2 border border-primary/25 bg-primary/8 px-4 py-1.5 font-mono text-xs font-semibold tracking-[0.2em] text-primary uppercase"
        >
          <span
            class="h-1.5 w-1.5 animate-pulse rounded-full bg-primary shadow-[0_0_6px_oklch(var(--primary)/80%)]"
          ></span>
          CURRICULUM_VITAE // OFFICIAL_RESUME
          <span class="cursor-blink ml-1 inline-block h-3 w-0.5 bg-primary"></span>
        </p>
      </div>

      <!-- Main heading -->
      <div class="anim-in-delay text-center">
        <h1 class="section-title text-foreground">
          Curriculum <span class="text-primary italic">Vitae</span>
          <br class="hidden sm:block" />
          <span class="text-foreground">&amp; Verified Track Record</span>
        </h1>
      </div>

      <!-- Accent bar -->
      <div class="accent-bar mx-auto mt-6 mb-8 w-52 anim-in-delay"></div>

      <!-- Description -->
      <p
        class="anim-in-delay mx-auto max-w-2xl text-center text-base leading-relaxed text-muted-foreground sm:text-lg"
      >
        Detailed overview of my engineering experience, system architecture track record, verified competencies, and production background.
      </p>

      <!-- Stats Grid -->
      {activeResume && (
        <div
          class="anim-in-delay-2 mt-12 grid grid-cols-2 sm:grid-cols-4 border border-border/70 bg-card/60 backdrop-blur-sm"
        >
          <div
            class="group relative flex flex-col items-center justify-center border-r border-b sm:border-b-0 border-border/70 p-5 sm:p-7 transition-colors duration-200 hover:bg-primary/5"
          >
            <span class="font-mono text-2xl font-black text-primary sm:text-3xl">
              {activeResume.version}
            </span>
            <span
              class="mt-1.5 font-mono text-[10px] font-semibold tracking-[0.15em] text-muted-foreground uppercase sm:text-xs"
            >
              Active Version
            </span>
          </div>

          <div
            class="group relative flex flex-col items-center justify-center sm:border-r border-b sm:border-b-0 border-border/70 p-5 sm:p-7 transition-colors duration-200 hover:bg-primary/5"
          >
            <span class="font-mono text-2xl font-black text-primary sm:text-3xl">
              {formatBytes(activeResume.fileSize)}
            </span>
            <span
              class="mt-1.5 font-mono text-[10px] font-semibold tracking-[0.15em] text-muted-foreground uppercase sm:text-xs"
            >
              Document Size
            </span>
          </div>

          <div
            class="group relative flex flex-col items-center justify-center border-r border-border/70 p-5 sm:p-7 transition-colors duration-200 hover:bg-primary/5"
          >
            <span class="font-mono text-2xl font-black text-primary sm:text-3xl">
              {formatDate(activeResume.updatedAt)}
            </span>
            <span
              class="mt-1.5 font-mono text-[10px] font-semibold tracking-[0.15em] text-muted-foreground uppercase sm:text-xs"
            >
              Last Updated
            </span>
          </div>

          <div
            class="group relative flex flex-col items-center justify-center p-5 sm:p-7 transition-colors duration-200 hover:bg-primary/5"
          >
            <span class="font-mono text-2xl font-black text-primary sm:text-3xl">
              {activeResume.downloadCount}
            </span>
            <span
              class="mt-1.5 font-mono text-[10px] font-semibold tracking-[0.15em] text-muted-foreground uppercase sm:text-xs"
            >
              Downloads
            </span>
          </div>
        </div>
      )}

      <!-- Action Buttons -->
      {activeResume?.fileUrl ? (
        <div class="anim-in-delay-2 mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href={activeResume.downloadEndpoint}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 rounded-md border-2 border-primary bg-primary px-6 py-3 text-xs font-bold tracking-widest text-primary-foreground uppercase shadow-lg shadow-primary/20 transition-all duration-200 hover:bg-primary/90 hover:shadow-primary/30 active:scale-98"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-4 transition-transform duration-200 group-hover:translate-y-0.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Download PDF Version</span>
          </a>

          <a
            href={activeResume.fileUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 rounded-md border border-border bg-card px-5 py-3 text-xs font-bold tracking-wider text-foreground uppercase transition-all duration-200 hover:border-primary hover:text-primary"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            <span>Open in New Tab</span>
          </a>

          <a
            href="/#contact"
            class="group inline-flex items-center gap-2 rounded-md border border-border/80 bg-background/50 px-5 py-3 text-xs font-semibold tracking-wider text-muted-foreground uppercase transition-all duration-200 hover:border-primary hover:text-foreground"
          >
            <span>Hire / Get in Touch →</span>
          </a>
        </div>
      ) : null}
    </div>
  </header>

  <SectionDivider />

  <main class="w-full">
    <div class="container mx-auto max-w-5xl px-4 py-10 sm:py-12">
      <!-- Main Document Showcase Area -->
      {activeResume?.fileUrl ? (
        <div class="space-y-8">
          <!-- Document Frame Window -->
          <div class="relative overflow-hidden rounded-xl border border-border/80 bg-card shadow-2xl backdrop-blur-md">
            <!-- Window Titlebar -->
            <div class="flex items-center justify-between border-b border-border bg-muted/40 px-4 py-3 sm:px-6">
              <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5">
                  <div class="size-3 rounded-full bg-rose-500/80"></div>
                  <div class="size-3 rounded-full bg-amber-500/80"></div>
                  <div class="size-3 rounded-full bg-emerald-500/80"></div>
                </div>
                <div class="hidden sm:block h-3.5 w-px bg-border"></div>
                <span class="font-mono text-xs font-medium text-foreground">
                  {activeResume.fileName}
                </span>
                <span class="hidden sm:inline-flex rounded bg-primary/10 px-1.5 py-0.5 font-mono text-[10px] text-primary">
                  {activeResume.version}
                </span>
              </div>

              <div class="flex items-center gap-3">
                <a
                  href={activeResume.downloadEndpoint}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 font-mono text-xs font-semibold text-primary transition hover:underline"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="size-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                  <span>Quick Download</span>
                </a>
              </div>
            </div>

            <!-- PDF Viewer Iframe -->
            <div class="relative w-full bg-background/50">
              <iframe
                src={`${activeResume.fileUrl}#toolbar=1&navpanes=0`}
                class="h-[850px] w-full border-0 sm:h-[950px]"
                title="Fi Amanillah Resume Document Viewer"
              >
              </iframe>
            </div>
          </div>

          <!-- Document Version Notes / Changelog (if present) -->
          {activeResume.description && (
            <div class="rounded-xl border border-border/70 bg-card/60 p-6 backdrop-blur-sm">
              <div class="flex items-center gap-2 mb-2">
                <span class="font-mono text-xs text-primary">// VERSION_NOTES</span>
                <span class="text-xs font-bold text-foreground">{activeResume.version}</span>
              </div>
              <p class="text-xs leading-relaxed text-muted-foreground">
                {activeResume.description}
              </p>
            </div>
          )}
        </div>
      ) : (
        /* Fallback State if No Active Resume Uploaded */
        <div class="mx-auto max-w-2xl rounded-2xl border border-dashed border-border bg-card/70 p-10 text-center backdrop-blur-md">
          <div class="mx-auto flex size-14 items-center justify-center rounded-2xl border border-primary/30 bg-primary/10 text-primary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-7"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
          </div>

          <p class="mt-4 font-mono text-xs text-primary">// REPOSITORY_EMPTY</p>
          <h2 class="mt-1 text-xl font-bold text-foreground">
            Resume Being Prepared
          </h2>

          <p class="mt-2 text-xs leading-relaxed text-muted-foreground max-w-md mx-auto">
            The curriculum vitae document is currently being updated in the admin repository. In the meantime, you can explore my verified case studies or reach out directly.
          </p>

          <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            <a
              href="/#about"
              class="inline-flex items-center gap-2 rounded-md border border-primary/40 bg-primary/10 px-4 py-2 text-xs font-semibold text-primary transition hover:bg-primary hover:text-primary-foreground"
            >
              <span>Explore Track Record</span>
            </a>
            <a
              href="/case-study"
              class="inline-flex items-center gap-2 rounded-md border border-border bg-card px-4 py-2 text-xs font-semibold text-foreground transition hover:border-primary hover:text-primary"
            >
              <span>Case Studies</span>
            </a>
            <a
              href="/#contact"
              class="inline-flex items-center gap-2 rounded-md border border-border bg-card px-4 py-2 text-xs font-semibold text-foreground transition hover:border-primary hover:text-primary"
            >
              <span>Contact Directly →</span>
            </a>
          </div>
        </div>
      )}
    </div>

    <SectionDivider />

    <!-- Newsletter & Updates Section -->
    <NewsletterSection
      title="Subscribe to Tech Stories & Engineering Insights"
      subtitle="Get weekly dispatches on AI breakthroughs, semiconductor & hardware trends, software engineering, and system design."
      source="resume_page"
      idPrefix="resume-newsletter"
    />
  </main>
</MySiteLayout>
