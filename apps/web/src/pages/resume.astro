---
import MySiteLayout from "@/layouts/MySiteLayout.astro"
import { ResumeApi } from "@/lib/api/resumeApi"

const activeResume = await ResumeApi.fetchActiveResume()

function formatBytes(bytes: number) {
  if (!bytes || bytes === 0) return "PDF Document"
  const k = 1024
  const sizes = ["Bytes", "KB", "MB"]
  const i = Math.floor(Math.log(bytes) / Math.log(k))
  return `${parseFloat((bytes / Math.pow(k, i)).toFixed(1))} ${sizes[i]}`
}

function formatDate(dateStr: string | null) {
  if (!dateStr) return "Recently Released"
  try {
    return new Date(dateStr).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  } catch {
    return "Recently Released"
  }
}
---

<MySiteLayout>
  <Fragment slot="head">
    <title>Curriculum Vitae & Resume | Fi Amanillah</title>
    <meta
      name="description"
      content="Official curriculum vitae of Fi Amanillah — Full Stack Developer specializing in scalable TypeScript backends, event-driven architectures, and cloud DevOps."
    />
    <meta property="og:title" content="Curriculum Vitae & Resume | Fi Amanillah" />
    <meta
      property="og:description"
      content="Download or preview the official developer resume of Fi Amanillah."
    />
  </Fragment>

  <main class="relative min-h-screen overflow-hidden py-12 sm:py-20" data-grid-cross>
    <!-- Background Ambient Glow & Diagonal Stripes -->
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div
        class="absolute top-1/4 left-1/2 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 bg-primary/10 blur-[150px]"
      >
      </div>
      <div
        class="absolute bottom-1/4 right-1/4 h-[350px] w-[350px] bg-primary/5 blur-[120px]"
      >
      </div>
    </div>

    <div class="container mx-auto px-4 max-w-6xl">
      <!-- Section Header -->
      <div class="mb-10 text-center">
        <p class="section-label mb-3 inline-flex items-center gap-2 font-mono text-xs text-primary uppercase tracking-widest">
          <span class="inline-block size-2 rounded-full bg-primary animate-pulse"></span>
          OFFICIAL_CURRICULUM_VITAE // {activeResume ? activeResume.version : "LATEST_BUILD"}
        </p>

        <h1 class="section-title mb-4 text-3xl font-black tracking-tight text-foreground sm:text-4xl md:text-5xl">
          Curriculum <span class="text-primary font-bold">Vitae</span>
        </h1>

        <!-- Accent bar -->
        <div class="accent-bar mx-auto mb-6 w-48 md:w-56"></div>

        <p class="mx-auto max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">
          Detailed overview of my engineering experience, architecture philosophy, production track record, and technical competencies.
        </p>

        <!-- Document Telemetry Bar -->
        {activeResume && (
          <div class="mt-6 flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/40 bg-primary/10 px-3 py-1 text-primary">
              <span class="size-1.5 rounded-full bg-primary"></span>
              VERSION: {activeResume.version}
            </span>

            <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-card/80 px-3 py-1 text-muted-foreground">
              SIZE: {formatBytes(activeResume.fileSize)}
            </span>

            <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-card/80 px-3 py-1 text-muted-foreground">
              RELEASED: {formatDate(activeResume.updatedAt)}
            </span>

            <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-card/80 px-3 py-1 text-muted-foreground">
              DOWNLOADS: {activeResume.downloadCount}
            </span>
          </div>
        )}

        <!-- Top Action Buttons -->
        {activeResume?.fileUrl ? (
          <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
            <a
              href={activeResume.downloadEndpoint}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2 rounded-md border-2 border-primary bg-primary px-6 py-3 text-xs font-bold tracking-widest text-primary-foreground uppercase shadow-lg shadow-primary/20 transition-all duration-200 hover:bg-primary/90 hover:shadow-primary/30 active:scale-98"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-4 transition-transform duration-200 group-hover:translate-y-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download PDF Version</span>
            </a>

            <a
              href={activeResume.fileUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2 rounded-md border border-border bg-card px-5 py-3 text-xs font-bold tracking-wider text-foreground uppercase transition-all duration-200 hover:border-primary hover:text-primary"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              <span>Open in New Tab</span>
            </a>

            <a
              href="/#contact"
              class="group inline-flex items-center gap-2 rounded-md border border-border/80 bg-background/50 px-5 py-3 text-xs font-semibold tracking-wider text-muted-foreground uppercase transition-all duration-200 hover:border-primary hover:text-foreground"
            >
              <span>Hire / Get in Touch →</span>
            </a>
          </div>
        ) : null}
      </div>

      <!-- Main Document Showcase Area -->
      {activeResume?.fileUrl ? (
        <div class="space-y-8">
          <!-- Document Frame Window -->
          <div class="relative overflow-hidden rounded-xl border border-border/80 bg-card shadow-2xl backdrop-blur-md">
            <!-- Window Titlebar -->
            <div class="flex items-center justify-between border-b border-border bg-muted/40 px-4 py-3 sm:px-6">
              <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5">
                  <div class="size-3 rounded-full bg-rose-500/80"></div>
                  <div class="size-3 rounded-full bg-amber-500/80"></div>
                  <div class="size-3 rounded-full bg-emerald-500/80"></div>
                </div>
                <div class="hidden sm:block h-3.5 w-px bg-border"></div>
                <span class="font-mono text-xs font-medium text-foreground">
                  {activeResume.fileName}
                </span>
                <span class="hidden sm:inline-flex rounded bg-primary/10 px-1.5 py-0.5 font-mono text-[10px] text-primary">
                  {activeResume.version}
                </span>
              </div>

              <div class="flex items-center gap-3">
                <a
                  href={activeResume.downloadEndpoint}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 font-mono text-xs font-semibold text-primary transition hover:underline"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="size-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                  <span>Quick Download</span>
                </a>
              </div>
            </div>

            <!-- PDF Viewer Iframe -->
            <div class="relative w-full bg-background/50">
              <iframe
                src={`${activeResume.fileUrl}#toolbar=1&navpanes=0`}
                class="h-[850px] w-full border-0 sm:h-[950px]"
                title="Fi Amanillah Resume Document Viewer"
              >
              </iframe>
            </div>

            <!-- Frame Footer Bar -->
            <div class="flex flex-col gap-2 border-t border-border bg-muted/20 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-6">
              <span class="text-xs text-muted-foreground">
                Document verified for recruiter review & ATS screening.
              </span>
              <div class="flex items-center gap-3">
                <a
                  href={activeResume.downloadEndpoint}
                  class="text-xs font-semibold text-primary hover:underline"
                >
                  Download Master PDF
                </a>
                <span class="text-muted-foreground">•</span>
                <a
                  href="/#experience"
                  class="text-xs text-muted-foreground hover:text-foreground"
                >
                  Interactive Timeline
                </a>
              </div>
            </div>
          </div>

          <!-- Document Version Notes / Changelog (if present) -->
          {activeResume.description && (
            <div class="rounded-xl border border-border/70 bg-card/60 p-6 backdrop-blur-sm">
              <div class="flex items-center gap-2 mb-2">
                <span class="font-mono text-xs text-primary">// VERSION_NOTES</span>
                <span class="text-xs font-bold text-foreground">{activeResume.version}</span>
              </div>
              <p class="text-xs leading-relaxed text-muted-foreground">
                {activeResume.description}
              </p>
            </div>
          )}

          <!-- Engineering Competencies & Highlights Grid -->
          <div class="grid gap-4 sm:grid-cols-3">
            <div class="rounded-xl border border-border/70 bg-card/60 p-5 backdrop-blur-sm">
              <div class="mb-2 font-mono text-xs font-bold text-primary">
                01 // BACKEND ARCHITECTURE
              </div>
              <p class="text-xs leading-relaxed text-muted-foreground">
                Specialized in Nest.js, Express, TypeScript, PostgreSQL, Prisma, Redis caching, and RabbitMQ message queues.
              </p>
            </div>

            <div class="rounded-xl border border-border/70 bg-card/60 p-5 backdrop-blur-sm">
              <div class="mb-2 font-mono text-xs font-bold text-primary">
                02 // CLOUD & DEVOPS
              </div>
              <p class="text-xs leading-relaxed text-muted-foreground">
                Proficient in Docker containerization, multi-service VPS deployments, Nginx reverse proxies, CI/CD, and Cloudflare R2/S3.
              </p>
            </div>

            <div class="rounded-xl border border-border/70 bg-card/60 p-5 backdrop-blur-sm">
              <div class="mb-2 font-mono text-xs font-bold text-primary">
                03 // FULL-STACK APPS
              </div>
              <p class="text-xs leading-relaxed text-muted-foreground">
                Modern React, Next.js, Astro, TailwindCSS, Shadcn UI, WebSockets real-time sync, and robust REST APIs.
              </p>
            </div>
          </div>
        </div>
      ) : (
        /* Fallback State if No Active Resume Uploaded */
        <div class="mx-auto max-w-2xl rounded-2xl border border-dashed border-border bg-card/70 p-10 text-center backdrop-blur-md">
          <div class="mx-auto flex size-14 items-center justify-center rounded-2xl border border-primary/30 bg-primary/10 text-primary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-7"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
          </div>

          <p class="mt-4 font-mono text-xs text-primary">// REPOSITORY_EMPTY</p>
          <h2 class="mt-1 text-xl font-bold text-foreground">
            Resume Being Prepared
          </h2>

          <p class="mt-2 text-xs leading-relaxed text-muted-foreground max-w-md mx-auto">
            The curriculum vitae document is currently being updated in the admin repository. In the meantime, you can explore my verified case studies or reach out directly.
          </p>

          <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            <a
              href="/#about"
              class="inline-flex items-center gap-2 rounded-md border border-primary/40 bg-primary/10 px-4 py-2 text-xs font-semibold text-primary transition hover:bg-primary hover:text-primary-foreground"
            >
              <span>Explore Track Record</span>
            </a>
            <a
              href="/case-study"
              class="inline-flex items-center gap-2 rounded-md border border-border bg-card px-4 py-2 text-xs font-semibold text-foreground transition hover:border-primary hover:text-primary"
            >
              <span>Case Studies</span>
            </a>
            <a
              href="/#contact"
              class="inline-flex items-center gap-2 rounded-md border border-border bg-card px-4 py-2 text-xs font-semibold text-foreground transition hover:border-primary hover:text-primary"
            >
              <span>Contact Directly →</span>
            </a>
          </div>
        </div>
      )}
    </div>
  </main>
</MySiteLayout>
