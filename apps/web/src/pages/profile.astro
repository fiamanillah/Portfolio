---
import MySiteLayout from "@/layouts/MySiteLayout.astro"
import { ProfileContainer } from "@/components/Profile/ProfileContainer"
import SEO from "@/components/SEO/SEO.astro"
---

<MySiteLayout>
  <Fragment slot="head">
    <SEO
      title="Profile & Account Settings | Fi Amanillah"
      description="Manage your developer account credentials, 2FA security, code typography themes, reading bookmarks, notification channels, and personal API tokens."
      url="/profile"
      noIndex={true}
    />
  </Fragment>

  <section class="relative min-h-[calc(100svh-12rem)] pb-16">
    <ProfileContainer client:load />
  </section>
</MySiteLayout>
