---
import About from "@/components/Home/About.astro"
import Blog from "@/components/Home/Blog.astro"
import BookCall from "@/components/Home/BookCall.astro"
import Contact from "@/components/Home/Contact.astro"
import EngineeringPillars from "@/components/Home/EngineeringPillars.astro"
import Hero from "@/components/Home/Hero.astro"
import Logos from "@/components/Home/Logos.astro"
import ProfesssionalHistory from "@/components/Home/ProfesssionalHistory.astro"
import Skills from "@/components/Home/Skills.astro"
import Work from "@/components/Home/Work.astro"
import NewsletterSection from "@/components/Newsletter/NewsletterSection.astro"
import SectionDivider from "@/components/SectionDivider.astro"
import MySiteLayout from "@/layouts/MySiteLayout.astro"
import SEO from "@/components/SEO/SEO.astro"
---

<MySiteLayout>
  <Fragment slot="head">
    <SEO
      title="Fi Amanillah | Full-Stack Architect & Software Engineer"
      description="Portfolio, system architecture deep dives, real-time microservices, database optimizations, and technical journal of Fi Amanillah — Software Engineer & Full-Stack Architect."
      url="/"
      image="/fi.png"
    />
  </Fragment>

  <!-- Hero Section -->
  <Hero />

  <SectionDivider />

  <!-- Logos -->
  <Logos />

  <SectionDivider />

  <!-- About Section -->
  <About />

  <SectionDivider />

  <!-- Skills Section -->
  <Skills />

  <SectionDivider />

  <!-- Engineering Pillars / Architectural Standards -->
  <EngineeringPillars />

  <SectionDivider />

  <!-- Work showcase -->
  <Work />

  <SectionDivider />

  <!-- Professional History -->
  <ProfesssionalHistory />

  <SectionDivider />

  <!-- Recent Blog Posts -->
  <Blog />

  <SectionDivider />

  <!-- Subscribe to Newsletter & Updates -->
  <NewsletterSection source="homepage_newsletter" idPrefix="home-newsletter" />

  <SectionDivider />

  <!-- Book a Call / Consultation -->
  <BookCall />

  <SectionDivider />

  <!-- Contact / Transmission -->
  <Contact />
</MySiteLayout>
