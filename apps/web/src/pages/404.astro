---
import MySiteLayout from "@/layouts/MySiteLayout.astro"
import { HugeiconsIcon } from "@hugeicons/react"
import {
  Home01Icon,
  ArrowLeft02Icon,
  Briefcase01Icon,
  BookOpen01Icon,
  DocumentCodeIcon,
} from "@hugeicons/core-free-icons"
import SEO from "@/components/SEO/SEO.astro"
---

<MySiteLayout>
  <Fragment slot="head">
    <SEO
      title="404: Page Not Found | Fi Amanillah"
      description="The page you are looking for does not exist on Fi Amanillah's website."
      url="/404"
      noIndex={true}
    />
  </Fragment>

  <section
    class="relative z-10 flex min-h-[calc(100svh-14rem)] flex-col items-center justify-center px-4 py-16 text-center sm:py-24"
  >
    <!-- Background Ambient Glow -->
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div
        class="absolute top-1/2 left-1/2 h-80 w-80 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/10 blur-[120px]"
      >
      </div>
    </div>

    <!-- Status Pill -->
    <div
      class="inline-flex items-center gap-2 border border-primary/25 bg-primary/8 px-3.5 py-1.5 font-mono text-xs font-semibold tracking-widest text-primary uppercase shadow-[0_0_12px_oklch(var(--primary)/12%)]"
    >
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-primary"></span>
      <span>404 // NOT_FOUND</span>
      <span class="ml-0.5 inline-block h-3 w-0.5 animate-pulse bg-primary"
      ></span>
    </div>

    <!-- 404 Large Numeric Display with Cyber Brackets -->
    <div class="relative mt-8 inline-block">
      <div
        class="pointer-events-none absolute -top-3 -left-3 h-4 w-4 border-t-2 border-l-2 border-primary/50"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -top-3 -right-3 h-4 w-4 border-t-2 border-r-2 border-primary/50"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-3 -left-3 h-4 w-4 border-b-2 border-l-2 border-primary/50"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -right-3 -bottom-3 h-4 w-4 border-r-2 border-b-2 border-primary/50"
        aria-hidden="true"
      >
      </div>

      <h1
        class="font-mono text-7xl font-black tracking-tight text-foreground select-none sm:text-8xl md:text-9xl"
      >
        <span>4</span><span
          class="text-primary drop-shadow-[0_0_24px_oklch(var(--primary)/40%)]"
          >0</span
        ><span>4</span>
      </h1>
    </div>

    <!-- Heading -->
    <h2
      class="mt-6 font-mono text-2xl font-bold tracking-tight text-foreground uppercase sm:text-3xl"
    >
      Page Not Found
    </h2>

    <div class="accent-bar mx-auto mt-3 mb-4 w-32"></div>

    <!-- Description -->
    <p
      class="max-w-md text-sm leading-relaxed text-muted-foreground sm:text-base"
    >
      The page you are looking for does not exist or has been moved. Let's get
      you back on track.
    </p>

    <!-- Action Buttons -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex cursor-pointer items-center justify-center gap-2 border border-primary bg-primary px-5 py-2.5 font-mono text-xs font-bold tracking-wider text-primary-foreground uppercase shadow-[0_0_16px_oklch(var(--primary)/25%)] transition-all duration-200 hover:bg-primary/90 hover:shadow-[0_0_24px_oklch(var(--primary)/45%)] focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
      >
        <HugeiconsIcon
          icon={Home01Icon}
          className="size-4"
          aria-hidden="true"
        />
        <span>Return Home</span>
      </a>

      <button
        type="button"
        id="go-back-btn"
        class="inline-flex cursor-pointer items-center justify-center gap-2 border border-border bg-card/80 px-5 py-2.5 font-mono text-xs font-bold tracking-wider text-foreground uppercase transition-all duration-200 hover:border-primary/60 hover:bg-primary/10 hover:text-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
      >
        <HugeiconsIcon
          icon={ArrowLeft02Icon}
          className="size-4"
          aria-hidden="true"
        />
        <span>Go Back</span>
      </button>
    </div>

    <!-- Helpful Quick Links -->
    <div
      class="mt-10 flex flex-wrap items-center justify-center gap-4 font-mono text-xs text-muted-foreground"
    >
      <span class="text-muted-foreground/60">Quick Links:</span>
      <a
        href="/case-study"
        class="flex items-center gap-1.5 transition-colors hover:text-primary"
      >
        <HugeiconsIcon
          icon={Briefcase01Icon}
          className="size-3.5"
          aria-hidden="true"
        />
        <span>Case Studies</span>
      </a>
      <span class="text-border/80">•</span>
      <a
        href="/blog"
        class="flex items-center gap-1.5 transition-colors hover:text-primary"
      >
        <HugeiconsIcon
          icon={BookOpen01Icon}
          className="size-3.5"
          aria-hidden="true"
        />
        <span>Blog</span>
      </a>
      <span class="text-border/80">•</span>
      <a
        href="/resume"
        class="flex items-center gap-1.5 transition-colors hover:text-primary"
      >
        <HugeiconsIcon
          icon={DocumentCodeIcon}
          className="size-3.5"
          aria-hidden="true"
        />
        <span>Resume</span>
      </a>
    </div>
  </section>
</MySiteLayout>

<script>
  function setupBackButton() {
    const backBtn = document.getElementById("go-back-btn")
    if (backBtn && backBtn.dataset.bound !== "true") {
      backBtn.dataset.bound = "true"
      backBtn.addEventListener("click", () => {
        if (window.history.length > 1) {
          window.history.back()
        } else {
          window.location.href = "/"
        }
      })
    }
  }

  // Automatic client-side redirect resolution for moved URLs
  async function checkRedirect() {
    try {
      const currentPath = window.location.pathname
      if (!currentPath || currentPath === "/" || currentPath === "/404") return

      const apiUrl =
        (typeof window !== "undefined" && (window as any).__PUBLIC_API_URL__) ||
        "http://localhost:3040"

      const res = await fetch(
        `${apiUrl}/redirects/v1/resolve?path=${encodeURIComponent(currentPath)}`
      )
      if (res.ok) {
        const body = await res.json()
        if (body.success && body.data?.redirected && body.data.destination) {
          window.location.replace(body.data.destination)
        }
      }
    } catch {
      // Ignore network errors on 404 page
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      setupBackButton()
      checkRedirect()
    })
  } else {
    setupBackButton()
    checkRedirect()
  }
  document.addEventListener("astro:page-load", () => {
    setupBackButton()
    checkRedirect()
  })
</script>
