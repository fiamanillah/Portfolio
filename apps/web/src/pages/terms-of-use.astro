---
import MySiteLayout from "@/layouts/MySiteLayout.astro"
---

<MySiteLayout>
  <Fragment slot="head">
    <title>Redirecting to Terms of Use | Fi Amanillah</title>
    <meta http-equiv="refresh" content="0;url=/terms" />
    <link rel="canonical" href="https://fi.amanillah.com/terms" />
    <meta name="robots" content="noindex, follow" />
  </Fragment>

  <section class="flex min-h-[calc(100vh-12rem)] flex-col items-center justify-center px-4 text-center">
    <p class="font-mono text-sm text-muted-foreground">
      Redirecting to <a href="/terms" class="text-primary font-semibold underline">Terms of Use</a>...
    </p>
  </section>
</MySiteLayout>
