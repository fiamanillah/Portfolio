---
interface Props {
  badge?: string
  title: string
  highlightWord?: string
  description: string
  effectiveDate?: string
  lastUpdated?: string
  version?: string
  readingTime?: string
}

const {
  badge = "LEGAL // DOCUMENTATION",
  title,
  highlightWord,
  description,
  effectiveDate = "January 1, 2026",
  lastUpdated = "August 2026",
  version = "v2.1.0",
  readingTime = "7 min read",
} = Astro.props
---

<style>
  @keyframes float-glow {
    0%,
    100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.12;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.18);
      opacity: 0.22;
    }
  }
  @keyframes blink-cursor {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
  .cursor-blink {
    animation: blink-cursor 1.1s step-end infinite;
  }
  @keyframes slide-up-fade {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .anim-in {
    animation: slide-up-fade 0.7s ease forwards;
  }
  .anim-in-delay {
    animation: slide-up-fade 0.7s 0.18s ease forwards;
    opacity: 0;
  }
  .anim-in-delay-2 {
    animation: slide-up-fade 0.7s 0.32s ease forwards;
    opacity: 0;
  }
</style>

<header
  class="relative overflow-hidden border-b border-border pt-14 pb-12 sm:pt-20 sm:pb-16"
  data-grid-cross
>
  <!-- Ambient glows -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute top-1/2 left-1/4 h-80 w-80 -translate-x-1/2 -translate-y-1/2 animate-[float-glow_8s_ease-in-out_infinite] rounded-full bg-primary/15 blur-[100px]"
    >
    </div>
    <div
      class="absolute top-1/3 right-1/4 h-60 w-60 -translate-x-1/2 -translate-y-1/2 animate-[float-glow_8s_ease-in-out_infinite] rounded-full bg-primary/10 blur-[80px]"
      style="animation-delay: -4s;"
    >
    </div>
  </div>

  <!-- Diagonal stripe background overlay -->
  <div
    class="diagonal-stripes pointer-events-none absolute inset-0 z-0 bg-background opacity-80"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <!-- Section label pill -->
    <div class="anim-in flex justify-center">
      <p
        class="mb-5 inline-flex items-center gap-2 border border-primary/25 bg-primary/8 px-4 py-1.5 font-mono text-xs font-semibold tracking-[0.2em] text-primary uppercase shadow-[0_0_15px_oklch(var(--primary)/10%)]"
      >
        <span
          class="h-1.5 w-1.5 animate-pulse rounded-full bg-primary shadow-[0_0_6px_oklch(var(--primary)/80%)]"
        ></span>
        {badge}
        <span class="cursor-blink ml-1 inline-block h-3 w-0.5 bg-primary"></span>
      </p>
    </div>

    <!-- Main heading -->
    <div class="anim-in-delay text-center">
      <h1 class="section-title text-foreground">
        {
          highlightWord ? (
            <>
              {title.replace(highlightWord, "")}
              <span class="text-primary italic">{highlightWord}</span>
            </>
          ) : (
            title
          )
        }
      </h1>
    </div>

    <!-- Accent bar -->
    <div class="accent-bar mx-auto mt-5 mb-6 w-44 anim-in-delay"></div>

    <!-- Description -->
    <p
      class="anim-in-delay mx-auto max-w-2xl text-center text-base leading-relaxed text-muted-foreground sm:text-lg"
    >
      {description}
    </p>

    <!-- Metadata Quick Badges Grid -->
    <div
      class="anim-in-delay-2 mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4"
    >
      <div
        class="flex flex-col items-center justify-center border border-border/70 bg-card/60 p-3.5 backdrop-blur-xs transition-colors hover:border-primary/40 hover:bg-primary/5 sm:p-4"
      >
        <span class="font-mono text-[10px] tracking-wider text-muted-foreground uppercase">
          Effective Date
        </span>
        <span class="mt-1 font-mono text-xs font-bold text-foreground sm:text-sm">
          {effectiveDate}
        </span>
      </div>

      <div
        class="flex flex-col items-center justify-center border border-border/70 bg-card/60 p-3.5 backdrop-blur-xs transition-colors hover:border-primary/40 hover:bg-primary/5 sm:p-4"
      >
        <span class="font-mono text-[10px] tracking-wider text-muted-foreground uppercase">
          Last Revision
        </span>
        <span class="mt-1 font-mono text-xs font-bold text-primary sm:text-sm">
          {lastUpdated}
        </span>
      </div>

      <div
        class="flex flex-col items-center justify-center border border-border/70 bg-card/60 p-3.5 backdrop-blur-xs transition-colors hover:border-primary/40 hover:bg-primary/5 sm:p-4"
      >
        <span class="font-mono text-[10px] tracking-wider text-muted-foreground uppercase">
          Document Version
        </span>
        <span class="mt-1 font-mono text-xs font-bold text-foreground sm:text-sm">
          {version}
        </span>
      </div>

      <div
        class="flex flex-col items-center justify-center border border-border/70 bg-card/60 p-3.5 backdrop-blur-xs transition-colors hover:border-primary/40 hover:bg-primary/5 sm:p-4"
      >
        <span class="font-mono text-[10px] tracking-wider text-muted-foreground uppercase">
          Est. Reading Time
        </span>
        <span class="mt-1 font-mono text-xs font-bold text-foreground sm:text-sm">
          {readingTime}
        </span>
      </div>
    </div>
  </div>
</header>
