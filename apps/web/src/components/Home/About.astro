---
// src/components/Home/About.astro
import { ArrowDown01Icon, ArrowRight01Icon } from "@hugeicons/core-free-icons"
import { HugeiconsIcon } from "@hugeicons/react"
---

<style>
  @keyframes float-glow {
    0%,
    100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.12;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.15);
      opacity: 0.22;
    }
  }

  .about-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 600ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .about-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Spec Card Hover Effects */
  .spec-card {
    transition:
      border-color 250ms ease,
      background-color 250ms ease,
      transform 250ms ease,
      box-shadow 250ms ease;
  }

  .spec-card:hover {
    border-color: oklch(var(--primary) / 60%);
    background-color: oklch(var(--card) / 80%);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px oklch(var(--primary) / 15%);
  }

  /* Custom terminal scroll styling */
  .terminal-screen::-webkit-scrollbar {
    width: 5px;
  }
  .terminal-screen::-webkit-scrollbar-track {
    background: transparent;
  }
  .terminal-screen::-webkit-scrollbar-thumb {
    background: oklch(var(--border) / 80%);
    border-radius: 2px;
  }
  .terminal-screen::-webkit-scrollbar-thumb:hover {
    background: oklch(var(--primary) / 60%);
  }
</style>

<section id="about" class="relative z-10 overflow-hidden py-20 lg:py-28" data-grid-cross>
  <!-- Ambient background glow -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute top-1/3 left-1/4 h-120 w-120 -translate-x-1/2 -translate-y-1/2 animate-[float-glow_8s_ease-in-out_infinite] rounded-full bg-primary/12 blur-[130px]"
    >
    </div>
    <div
      class="absolute top-2/3 right-1/4 h-96 w-96 -translate-x-1/2 -translate-y-1/2 animate-[float-glow_8s_ease-in-out_infinite] rounded-full bg-primary/8 blur-[110px]"
      style="animation-delay: -4s;"
    >
    </div>
  </div>

  <div class="container mx-auto px-4">
    <!-- Section Top Header Bar -->
    <div class="about-reveal mb-10 lg:mb-14">
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border/80 pb-5">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 border border-primary/30 bg-primary/10 px-2.5 py-1 font-mono text-[11px] font-bold tracking-wider text-primary uppercase">
            <span class="h-1.5 w-1.5 rounded-full bg-primary animate-pulse"></span>
            Identity & System Architecture
          </span>
          <span class="hidden font-mono text-xs text-muted-foreground/60 sm:inline">// 01_PROFILE</span>
        </div>

        <div class="flex items-center gap-2 font-mono text-[11px] text-muted-foreground">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
          </span>
          <span class="text-foreground/90 font-medium">AVAILABLE FOR FULL-STACK CONTRACTS</span>
        </div>
      </div>
    </div>

    <!-- Main Grid: Interactive Console (Left) + Architectural Story (Right) -->
    <div class="grid grid-cols-1 items-stretch gap-10 lg:grid-cols-12 lg:gap-10 xl:gap-14">
      
      <!-- LEFT COLUMN: Interactive System Console (5 cols on lg) -->
      <div class="about-reveal lg:col-span-5 flex flex-col h-full" style="transition-delay: 100ms;">
        <div class="relative flex flex-col h-full overflow-hidden border border-border bg-card/70 backdrop-blur-md shadow-xl transition-all duration-300">
          
          <!-- Corner Tech Accents -->
          <div class="pointer-events-none absolute top-0 left-0 z-20 h-3 w-3 border-t-2 border-l-2 border-primary/70"></div>
          <div class="pointer-events-none absolute top-0 right-0 z-20 h-3 w-3 border-t-2 border-r-2 border-primary/70"></div>
          <div class="pointer-events-none absolute bottom-0 left-0 z-20 h-3 w-3 border-b-2 border-l-2 border-primary/70"></div>
          <div class="pointer-events-none absolute right-0 bottom-0 z-20 h-3 w-3 border-r-2 border-b-2 border-primary/70"></div>

          <!-- Terminal Window Header -->
          <div class="flex items-center justify-between border-b border-border/80 bg-muted/40 px-4 py-3 select-none">
            <div class="flex items-center gap-2">
              <div class="flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-full bg-rose-500/80 inline-block"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-amber-500/80 inline-block"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/80 inline-block"></span>
              </div>
              <span class="font-mono text-[11px] font-semibold text-muted-foreground/80 tracking-wide ml-2">
                fi@core:~/architecture
              </span>
            </div>
            
            <div class="flex items-center gap-1.5 font-mono text-[10px] text-emerald-400 font-semibold tracking-wider bg-emerald-500/10 px-2 py-0.5 border border-emerald-500/20">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              SYS_OK
            </div>
          </div>

          <!-- Terminal Screen / Output Canvas -->
          <div
            id="about-terminal"
            class="terminal-screen relative flex-1 min-h-[340px] max-h-[440px] cursor-text overflow-y-auto bg-background/80 p-4 sm:p-5 font-mono text-[12px] leading-[1.7]"
          >
            <!-- Terminal Output Rows -->
            <div id="terminal-output" class="space-y-1.5"></div>

            <!-- Terminal Interactive Input -->
            <div class="mt-2 flex items-center gap-1.5 pt-1">
              <span class="shrink-0 text-primary font-bold select-none">➜</span>
              <span class="shrink-0 text-muted-foreground/70 select-none">~/fi $</span>
              <div class="relative flex-1">
                <input
                  id="terminal-input"
                  type="text"
                  class="w-full border-none bg-transparent font-mono text-[12px] text-foreground caret-transparent outline-none"
                  spellcheck="false"
                  autocomplete="off"
                  autocapitalize="off"
                  aria-label="Interactive Terminal Command Input"
                />
                <!-- Glowing Blinking Cursor -->
                <span
                  id="terminal-cursor"
                  class="pointer-events-none absolute top-0 left-0 inline-block h-[1.2em] w-1.5 animate-pulse bg-primary"
                ></span>
              </div>
            </div>
          </div>

          <!-- Quick Run Buttons / Interactive Strip -->
          <div class="border-t border-border/80 bg-muted/20 p-3">
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="font-mono text-[10px] font-semibold text-muted-foreground uppercase tracking-widest select-none">
                Interactive Quick Run:
              </span>
              <span class="font-mono text-[10px] text-muted-foreground/60 hidden sm:inline">
                Click chips or type commands
              </span>
            </div>
            <div class="flex flex-wrap items-center gap-1.5">
              {
                ["whoami", "skills", "projects", "contact", "neofetch", "clear"].map((cmd) => (
                  <button
                    type="button"
                    data-cmd={cmd}
                    class="terminal-chip group inline-flex items-center gap-1 border border-border bg-card px-2.5 py-1 font-mono text-[11px] text-foreground/80 transition-all duration-200 hover:border-primary hover:bg-primary/10 hover:text-primary active:scale-95 cursor-pointer"
                  >
                    <span class="text-primary/60 text-[10px] group-hover:text-primary">#</span>
                    <span>{cmd}</span>
                  </button>
                ))
              }
            </div>
          </div>

          <!-- Subtle scanline texture -->
          <div
            class="pointer-events-none absolute inset-0 bg-[repeating-linear-gradient(0deg,transparent,transparent_2px,oklch(0_0_0/0.02)_2px,oklch(0_0_0/0.02)_4px)]"
            aria-hidden="true"
          >
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Narrative & Architecture Spec Bento (7 cols on lg) -->
      <div class="about-reveal lg:col-span-7 flex flex-col justify-between gap-8" style="transition-delay: 200ms;">
        
        <!-- Main Headline & Bio Narrative -->
        <div class="space-y-5">
          <div class="space-y-3">
            <h2 class="section-title text-foreground">
              I architect systems and build <br class="hidden sm:inline" />
              <span class="text-primary">seamless digital experiences.</span>
            </h2>
            <div class="accent-bar w-24"></div>
          </div>

          <div class="space-y-3.5 text-sm leading-relaxed text-muted-foreground sm:text-base">
            <p>
              I'm a <strong class="font-semibold text-foreground">Full Stack Developer</strong> specializing in building scalable <strong class="text-foreground">MERN stack</strong>, <strong class="text-foreground">Nest.js</strong>, and <strong class="text-foreground">Next.js</strong> applications. I bridge the gap between complex event-driven backend architectures and clean, responsive frontend design.
            </p>
            <p>
              Currently focused on high-performance <strong class="text-foreground">REST APIs</strong>, real-time <strong class="text-foreground">WebSockets</strong> integration, message queues (<span class="font-mono text-xs font-semibold text-primary">RabbitMQ</span>, <span class="font-mono text-xs font-semibold text-primary">Redis</span>), and DevOps pipeline containerization with <span class="font-mono text-xs font-semibold text-primary">Docker</span>.
            </p>
          </div>
        </div>

        <!-- 3 Architectural Spec Cards (Clean Bento Strip) -->
        <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-3">
          
          <!-- Spec Card 1: Backend Core -->
          <div class="spec-card group relative flex flex-col justify-between border border-border bg-card/40 p-4 backdrop-blur-xs">
            <div class="space-y-2">
              <div class="flex items-center justify-between border-b border-border/60 pb-2">
                <span class="font-mono text-[10px] font-bold tracking-widest text-primary uppercase">
                  01 / CORE
                </span>
                <span class="h-1.5 w-1.5 rounded-full bg-primary/60"></span>
              </div>
              <div>
                <h3 class="font-mono text-xs font-bold text-foreground group-hover:text-primary transition-colors">
                  Backend Core
                </h3>
                <p class="font-mono text-xs text-muted-foreground mt-0.5 font-medium">
                  Nest.js · REST APIs
                </p>
              </div>
            </div>
            <p class="mt-3 text-[11px] leading-relaxed text-muted-foreground/80">
              High-throughput microservices, type-safe API contracts, and clean domain boundaries.
            </p>
          </div>

          <!-- Spec Card 2: Real-time & Queues -->
          <div class="spec-card group relative flex flex-col justify-between border border-border bg-card/40 p-4 backdrop-blur-xs">
            <div class="space-y-2">
              <div class="flex items-center justify-between border-b border-border/60 pb-2">
                <span class="font-mono text-[10px] font-bold tracking-widest text-primary uppercase">
                  02 / EVENTS
                </span>
                <span class="h-1.5 w-1.5 rounded-full bg-primary/60"></span>
              </div>
              <div>
                <h3 class="font-mono text-xs font-bold text-foreground group-hover:text-primary transition-colors">
                  Real-time & Queues
                </h3>
                <p class="font-mono text-xs text-muted-foreground mt-0.5 font-medium">
                  RabbitMQ · Redis
                </p>
              </div>
            </div>
            <p class="mt-3 text-[11px] leading-relaxed text-muted-foreground/80">
              Decoupled worker queues, pub/sub event streaming, and low-latency cache tiers.
            </p>
          </div>

          <!-- Spec Card 3: DevOps & Cloud -->
          <div class="spec-card group relative flex flex-col justify-between border border-border bg-card/40 p-4 backdrop-blur-xs">
            <div class="space-y-2">
              <div class="flex items-center justify-between border-b border-border/60 pb-2">
                <span class="font-mono text-[10px] font-bold tracking-widest text-primary uppercase">
                  03 / INFRA
                </span>
                <span class="h-1.5 w-1.5 rounded-full bg-primary/60"></span>
              </div>
              <div>
                <h3 class="font-mono text-xs font-bold text-foreground group-hover:text-primary transition-colors">
                  DevOps & Cloud
                </h3>
                <p class="font-mono text-xs text-muted-foreground mt-0.5 font-medium">
                  Docker · CI/CD VPS
                </p>
              </div>
            </div>
            <p class="mt-3 text-[11px] leading-relaxed text-muted-foreground/80">
              Isolated container builds, automated deployment pipelines, and hardened Linux hosting.
            </p>
          </div>

        </div>

        <!-- Action CTAs Bar -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="#work"
            class="group inline-flex items-center gap-2.5 border border-primary/60 bg-primary/10 px-6 py-3 font-mono text-xs font-bold tracking-widest text-primary uppercase no-underline transition-all duration-300 hover:border-primary hover:bg-primary hover:text-primary-foreground hover:shadow-[0_0_20px_oklch(var(--primary)/0.25)]"
          >
            <span>View Featured Work</span>
            <HugeiconsIcon
              icon={ArrowDown01Icon}
              className="size-4 transition-transform duration-200 group-hover:translate-y-0.5"
            />
          </a>

          <a
            href="#contact"
            class="group inline-flex items-center gap-2 border border-border bg-card/60 px-5 py-3 font-mono text-xs font-semibold tracking-wider text-foreground no-underline transition-all duration-200 hover:border-primary/60 hover:bg-primary/5 hover:text-primary"
          >
            <span>Get in touch</span>
            <HugeiconsIcon
              icon={ArrowRight01Icon}
              className="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
            />
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  function setupAboutObserver() {
    const reveals = document.querySelectorAll(".about-reveal")
    if (!reveals.length) return

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible")
            observer.unobserve(entry.target)
          }
        })
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -40px 0px",
      }
    )

    reveals.forEach((el) => observer.observe(el))
  }

  function setupTerminal() {
    const input = document.getElementById("terminal-input") as HTMLInputElement | null
    const output = document.getElementById("terminal-output")
    const terminal = document.getElementById("about-terminal")
    const cursor = document.getElementById("terminal-cursor")

    if (!input || !output || !terminal || !cursor) return

    const history: string[] = []
    let historyIndex = -1

    // Command definitions with styled output
    const commands: Record<string, () => string> = {
      help: () =>
        `<div class="space-y-1 text-muted-foreground">
  <div class="text-primary font-bold">// AVAILABLE COMMANDS</div>
  <div class="grid grid-cols-1 gap-1 pt-1">
    <div><span class="text-foreground font-semibold">whoami</span>      <span class="text-muted-foreground/80">— who is Fi Amanillah?</span></div>
    <div><span class="text-foreground font-semibold">skills</span>      <span class="text-muted-foreground/80">— view technical stack & tools</span></div>
    <div><span class="text-foreground font-semibold">projects</span>    <span class="text-muted-foreground/80">— active systems & architecture</span></div>
    <div><span class="text-foreground font-semibold">experience</span>  <span class="text-muted-foreground/80">— professional track record</span></div>
    <div><span class="text-foreground font-semibold">contact</span>     <span class="text-muted-foreground/80">— get direct transmission links</span></div>
    <div><span class="text-foreground font-semibold">neofetch</span>    <span class="text-muted-foreground/80">— system & runtime specs</span></div>
    <div><span class="text-foreground font-semibold">clear</span>       <span class="text-muted-foreground/80">— clear console display</span></div>
  </div>
</div>`,

      whoami: () =>
        `<div class="space-y-1">
  <div class="text-foreground font-bold text-sm">Fi Amanillah</div>
  <div class="text-primary font-semibold text-xs">Full Stack Developer & System Architect</div>
  <div class="text-muted-foreground text-xs leading-relaxed mt-1">
    Specializing in scalable MERN, Nest.js & Next.js architectures. Expert in bridging event-driven backends with clean, responsive user interfaces.
  </div>
  <div class="text-[11px] text-muted-foreground/70 pt-1">
    📍 Dhaka, Bangladesh · ⚡ 1+ Years Professional Experience
  </div>
</div>`,

      skills: () =>
        `<div class="space-y-2">
  <div>
    <span class="text-primary font-bold text-xs">// BACKEND CORE</span>
    <div class="text-foreground text-xs">Nest.js · Node.js · Express · REST APIs · Microservices · PostgreSQL · MongoDB · Redis</div>
  </div>
  <div>
    <span class="text-primary font-bold text-xs">// REAL-TIME & QUEUES</span>
    <div class="text-foreground text-xs">RabbitMQ · WebSockets · Redis Pub/Sub · Event-Driven Architecture</div>
  </div>
  <div>
    <span class="text-primary font-bold text-xs">// FRONTEND & UI</span>
    <div class="text-foreground text-xs">React · Next.js · TypeScript · Tailwind CSS · Shadcn UI · State Management</div>
  </div>
  <div>
    <span class="text-primary font-bold text-xs">// DEVOPS & INFRA</span>
    <div class="text-foreground text-xs">Docker · Linux VPS · Nginx · CI/CD Pipelines · Proxmox · Server Hardening</div>
  </div>
</div>`,

      projects: () =>
        `<div class="space-y-1.5">
  <div class="text-primary font-bold text-xs">// FEATURED ARCHITECTURES</div>
  <div>
    <span class="text-foreground font-bold">Mickanic</span> <span class="text-muted-foreground">— Freelance platform API, credit engine & microservice billing</span>
  </div>
  <div>
    <span class="text-foreground font-bold">Moja Cares</span> <span class="text-muted-foreground">— Healthcare insights & real-time provider messaging</span>
  </div>
  <div>
    <span class="text-foreground font-bold">Containerized VPS</span> <span class="text-muted-foreground">— Multi-service Docker orchestrations & zero-downtime Nginx routing</span>
  </div>
</div>`,

      contact: () =>
        `<div class="space-y-1">
  <div class="text-primary font-bold text-xs">// TRANSMISSION CHANNELS</div>
  <div class="grid grid-cols-1 gap-1 text-xs">
    <div><span class="text-muted-foreground">Email:</span> <span class="text-foreground font-medium">fi@amanillah.com</span></div>
    <div><span class="text-muted-foreground">GitHub:</span> <a href="https://github.com/fiamanillah" target="_blank" class="text-primary underline hover:text-foreground">github.com/fiamanillah</a></div>
    <div><span class="text-muted-foreground">LinkedIn:</span> <a href="https://www.linkedin.com/in/fi-amanillah/" target="_blank" class="text-primary underline hover:text-foreground">linkedin.com/in/fi-amanillah</a></div>
    <div><span class="text-muted-foreground">Facebook:</span> <a href="https://www.facebook.com/fiamanillah.b2" target="_blank" class="text-primary underline hover:text-foreground">facebook.com/fiamanillah.b2</a></div>
  </div>
</div>`,

      experience: () =>
        `<div class="space-y-1.5">
  <div class="text-primary font-bold text-xs">// WORK TIMELINE</div>
  <div class="text-foreground font-semibold">Full Stack Developer @ Softvence Agency (05/2025 - Present)</div>
  <div class="text-muted-foreground text-xs leading-relaxed">
    • Architected type-safe Nest.js/Express backend APIs<br/>
    • Integrated Redis caching & RabbitMQ to decouple worker queues<br/>
    • Built WebSocket real-time chat & billing via Stripe/Paystack
  </div>
</div>`,

      neofetch: () =>
        `<div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
  <div class="text-primary font-mono select-none">
    ╭──────────╮<br/>
    │  ██████  │  <span class="text-foreground font-bold">fi@portfolio</span><br/>
    │  ██  ██  │  <span class="text-muted-foreground">────────────</span><br/>
    │  ██████  │  <span class="text-primary">OS:</span> <span class="text-muted-foreground">Web v2026</span><br/>
    │  ██      │  <span class="text-primary">Host:</span> <span class="text-muted-foreground">Dhaka, BD</span><br/>
    │  ██      │  <span class="text-primary">Status:</span> <span class="text-emerald-400">Ready</span><br/>
    ╰──────────╯
  </div>
  <div class="space-y-0.5 text-muted-foreground font-mono text-[11px]">
    <div><span class="text-primary">Runtime:</span> Bun & Node.js</div>
    <div><span class="text-primary">Architecture:</span> Event-Driven MERN & Nest</div>
    <div><span class="text-primary">Queues:</span> RabbitMQ · Redis</div>
    <div><span class="text-primary">DevOps:</span> Docker · Linux VPS</div>
    <div><span class="text-primary">Uptime:</span> 100% Operational</div>
  </div>
</div>`,

      clear: () => "__CLEAR__",
    }

    function addOutput(html: string) {
      const line = document.createElement("div")
      line.className = "py-0.5"
      line.innerHTML = html
      output!.appendChild(line)
      terminal!.scrollTop = terminal!.scrollHeight
    }

    function processCommand(cmd: string) {
      const trimmed = cmd.trim().toLowerCase()

      // Echo command line
      addOutput(
        `<div class="flex items-center gap-1.5 text-xs"><span class="text-primary font-bold select-none">➜</span> <span class="text-muted-foreground/70 font-mono select-none">~/fi $</span> <span class="text-foreground font-semibold">${cmd}</span></div>`
      )

      if (trimmed === "") return

      if (trimmed === "clear") {
        output!.innerHTML = ""
        return
      }

      const handler = commands[trimmed]
      if (handler) {
        const result = handler()
        if (result !== "__CLEAR__") {
          addOutput(`<div class="pl-3 border-l border-primary/30 py-1 my-1">${result}</div>`)
        }
      } else {
        addOutput(
          `<div class="text-destructive text-xs">command not found: <span class="text-foreground font-mono">${trimmed}</span></div>
           <div class="text-muted-foreground text-[11px]">Type <span class="text-primary font-semibold">help</span> for available commands.</div>`
        )
      }
    }

    // Dynamic Cursor Tracking
    function updateCursor() {
      const text = input!.value
      const measure = document.createElement("span")
      measure.style.font = getComputedStyle(input!).font
      measure.style.visibility = "hidden"
      measure.style.position = "absolute"
      measure.style.whiteSpace = "pre"
      measure.textContent = text
      document.body.appendChild(measure)
      const width = measure.offsetWidth
      document.body.removeChild(measure)
      cursor!.style.left = `${width}px`
    }

    input.addEventListener("input", updateCursor)
    input.addEventListener("click", updateCursor)

    input.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Enter") {
        const cmd = input!.value
        if (cmd.trim()) {
          history.unshift(cmd)
        }
        historyIndex = -1
        processCommand(cmd)
        input!.value = ""
        updateCursor()
      } else if (e.key === "ArrowUp") {
        e.preventDefault()
        if (historyIndex < history.length - 1) {
          historyIndex++
          input!.value = history[historyIndex]
          updateCursor()
        }
      } else if (e.key === "ArrowDown") {
        e.preventDefault()
        if (historyIndex > 0) {
          historyIndex--
          input!.value = history[historyIndex]
          updateCursor()
        } else {
          historyIndex = -1
          input!.value = ""
          updateCursor()
        }
      } else if (e.key === "l" && e.ctrlKey) {
        e.preventDefault()
        output!.innerHTML = ""
      }
    })

    // Focus input on terminal container click
    terminal.addEventListener("click", () => {
      input.focus()
    })

    // Quick Command Buttons
    const chips = document.querySelectorAll(".terminal-chip")
    chips.forEach((chip) => {
      chip.addEventListener("click", (e) => {
        e.stopPropagation()
        const cmd = chip.getAttribute("data-cmd")
        if (cmd) {
          processCommand(cmd)
          input.focus()
        }
      })
    })

    // Typing Intro Simulation
    const introSequence = async () => {
      const typeCmd = async (cmd: string, delay = 50) => {
        for (const char of cmd) {
          input.value += char
          updateCursor()
          await new Promise((r) => setTimeout(r, delay + Math.random() * 30))
        }
        await new Promise((r) => setTimeout(r, 250))
        processCommand(input.value)
        input.value = ""
        updateCursor()
      }

      await new Promise((r) => setTimeout(r, 800))
      await typeCmd("whoami")
    }

    if (output.children.length === 0) {
      introSequence()
    }

    updateCursor()
  }

  // Lifecycle Bindings
  document.addEventListener("astro:page-load", () => {
    setupAboutObserver()
    setupTerminal()
  })

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      setupAboutObserver()
      setupTerminal()
    })
  } else {
    setupAboutObserver()
    setupTerminal()
  }
</script>
