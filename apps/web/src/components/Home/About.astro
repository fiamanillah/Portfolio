---
// src/components/Home/About.astro
import {
  ServerStack01Icon,
  FlashIcon,
  CloudServerIcon,
  Layers01Icon,
  ArrowRight01Icon,
  ArrowDown01Icon,
} from "@hugeicons/core-free-icons"
import { HugeiconsIcon } from "@hugeicons/react"

const capabilities = [
  {
    icon: ServerStack01Icon,
    title: "Backend & Microservices",
    description:
      "Architecting scalable RESTful APIs, modular Nest.js & Go services, clean domain boundaries, and optimized PostgreSQL & MongoDB schemas.",
  },
  {
    icon: FlashIcon,
    title: "Event-Driven & Real-Time",
    description:
      "Decoupling high-throughput systems with RabbitMQ worker queues, sub-millisecond Redis caching, and bidirectional WebSockets.",
  },
  {
    icon: CloudServerIcon,
    title: "DevOps & Cloud Infrastructure",
    description:
      "Automating CI/CD pipelines, containerizing environments with Docker, and orchestrating hardened Linux VPS hosting with Nginx.",
  },
  {
    icon: Layers01Icon,
    title: "Modern Frontend & UX",
    description:
      "Crafting type-safe, accessible, and high-performance user interfaces using Next.js, React, Tailwind CSS, and Astro.",
  },
]
---

<style>
  .about-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 600ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .about-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .capability-card {
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      transform 200ms ease;
  }

  .capability-card:hover {
    border-color: oklch(var(--primary) / 60%);
    background-color: oklch(var(--card) / 90%);
    transform: translateY(-2px);
  }
</style>

<section id="about" class="relative z-10 mx-auto pb-10" data-grid-cross>
  <!-- Standard Site Section Header -->
  <div class="relative mb-12 overflow-hidden text-center md:mb-16">
    <div
      class="diagonal-stripes pointer-events-none absolute inset-0 z-10 bg-background"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 py-6">
      <p class="section-label mb-3">
        Engineering Philosophy & Technical Background
      </p>
      <h2 class="section-title text-foreground">
        About <span class="text-primary">Me</span>
      </h2>
      <div class="accent-bar mx-auto mt-4 mb-2 w-48 md:w-56"></div>
    </div>
  </div>

  <div class="container mx-auto px-4">
    <div
      class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-12 xl:gap-16"
    >
      <!-- LEFT COLUMN: Narrative & Philosophy (7 cols on lg) -->
      <div
        class="about-reveal flex flex-col justify-between space-y-8 lg:col-span-7"
      >
        <div class="space-y-6">
          <div class="space-y-2">
            <h3
              class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl lg:text-4xl"
            >
              Architecting resilient systems with <span class="text-primary"
                >clarity & precision.</span
              >
            </h3>
          </div>

          <div
            class="space-y-4 text-base leading-relaxed text-muted-foreground sm:text-lg"
          >
            <p>
              I am a <strong class="font-semibold text-foreground"
                >Full Stack Developer & System Architect</strong
              > focused on building scalable, reliable web applications. My core expertise
              centers on <strong class="font-semibold text-foreground"
                >modern full-stack systems, Nest.js, Next.js</strong
              >, and scalable backend architectures.
            </p>
            <p>
              I bridge the gap between high-throughput backend services and
              fluid, accessible user interfaces. Rather than introducing
              unnecessary layers of abstraction, I value clean boundaries,
              deterministic data flows, and maintainable software that teams can
              understand and scale with ease.
            </p>
            <p>
              My recent engineering work involves architecting event-driven
              pipelines with <span class="font-medium text-foreground"
                >RabbitMQ</span
              > and <span class="font-medium text-foreground">Redis</span>,
              establishing type-safe API contracts, and orchestrating
              containerized continuous deployment workflows on Linux VPS
              infrastructure.
            </p>
          </div>

          <!-- Standout Philosophy Quote Callout -->
          <div
            class="border-l-2 border-primary/80 bg-card/40 p-5 backdrop-blur-xs"
          >
            <blockquote
              class="text-sm leading-relaxed font-medium text-foreground/90 italic sm:text-base"
            >
              "Great software isn't just code that functions—it's building
              resilient architectures that handle scale gracefully, remain clear
              to maintain, and deliver immediate value."
            </blockquote>
          </div>
        </div>

        <!-- Action CTAs Bar -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="#work"
            class="group inline-flex items-center gap-2.5 bg-primary px-6 py-3 font-mono text-xs font-bold tracking-wider text-primary-foreground uppercase no-underline transition-all duration-200 hover:shadow-[0_0_20px_oklch(var(--primary)/0.3)] hover:brightness-110 active:scale-98"
          >
            <span>Explore Work</span>
            <HugeiconsIcon
              icon={ArrowDown01Icon}
              className="size-4 transition-transform duration-200 group-hover:translate-y-0.5"
            />
          </a>

          <a
            href="#contact"
            class="group inline-flex items-center gap-2 border border-border bg-card/60 px-5 py-3 font-mono text-xs font-semibold tracking-wider text-foreground no-underline transition-all duration-200 hover:border-primary hover:bg-primary/5 hover:text-primary active:scale-98"
          >
            <span>Get in Touch</span>
            <HugeiconsIcon
              icon={ArrowRight01Icon}
              className="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
            />
          </a>
        </div>
      </div>

      <!-- RIGHT COLUMN: Core Capabilities & Quick Specs (5 cols on lg) -->
      <div
        class="about-reveal flex flex-col space-y-6 lg:col-span-5"
        style="transition-delay: 150ms;"
      >
        <!-- 4 Clean Capability Cards -->
        <div class="grid grid-cols-1 gap-3.5">
          {
            capabilities.map((cap) => (
              <div class="capability-card group flex items-start gap-4 border border-border bg-card/40 p-4 backdrop-blur-xs sm:p-5">
                <div class="flex size-10 shrink-0 items-center justify-center border border-border bg-muted/40 text-primary transition-colors duration-200 group-hover:border-primary/50 group-hover:bg-primary/10">
                  <HugeiconsIcon icon={cap.icon} className="size-5" />
                </div>
                <div class="space-y-1">
                  <h4 class="text-sm font-bold text-foreground transition-colors duration-200 group-hover:text-primary sm:text-base">
                    {cap.title}
                  </h4>
                  <p class="text-xs leading-relaxed text-muted-foreground sm:text-sm">
                    {cap.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupAboutObserver() {
    const reveals = document.querySelectorAll(".about-reveal")
    if (!reveals.length) return

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible")
            observer.unobserve(entry.target)
          }
        })
      },
      {
        threshold: 0.1,
        rootMargin: "0px 0px -40px 0px",
      }
    )

    reveals.forEach((el) => observer.observe(el))
  }

  document.addEventListener("astro:page-load", setupAboutObserver)

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupAboutObserver)
  } else {
    setupAboutObserver()
  }
</script>
