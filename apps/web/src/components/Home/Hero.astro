---
import {
  InputGroup,
  InputGroupAddon,
  InputGroupInput,
  InputGroupButton,
} from "@workspace/ui/components/input-group"
import { HugeiconsIcon } from "@hugeicons/react"
import {
  ArrowUpRight03Icon,
  Facebook02Icon,
  GithubIcon,
  Linkedin02Icon,
} from "@hugeicons/core-free-icons"
import { Badge } from "@workspace/ui/components/badge"
import { ResumeApi } from "@/lib/api/resumeApi"
import HeroResumeCard from "./HeroResumeCard.astro"

const resumeData = await ResumeApi.fetchPublicResume()
const resumeUrl = resumeData.downloadUrl || "/resume"
---

<section
  data-grid-cross
  class="relative flex min-h-[calc(100svh-5rem)] w-full items-center justify-center overflow-hidden py-24"
>
  <!-- Background Ambient Glow (Zero-CLS GPU Radial Gradient) -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_50%,rgba(0,220,200,0.12)_0%,transparent_65%)]"
    aria-hidden="true"
  >
  </div>

  <div
    class="z-10 container mx-auto grid grid-cols-1 justify-between gap-12 px-4 lg:grid-cols-2 lg:gap-16 xl:gap-24"
  >
    <!-- Left Side: Main Content -->
    <div class="flex max-w-xl flex-col justify-center space-y-8">
      <!-- Main Heading -->
      <div class="space-y-4">
        <h1
          class="text-4xl font-black tracking-tighter text-balance text-foreground sm:text-5xl lg:text-6xl"
        >
          Hi, I'm <br />
          <span class="relative inline-block">
            <span class="relative z-10 text-primary">Fi Amanillah</span>
          </span>
        </h1>
        <div
          class="flex min-h-[1.75rem] flex-wrap items-center gap-x-1.5 text-base leading-relaxed font-medium text-primary sm:min-h-[2rem] sm:text-lg"
        >
          <span class="text-foreground">I'm a</span>
          <span
            id="hero-text-scramble"
            class="inline-block min-w-[210px] font-mono text-primary select-none"
            data-texts={JSON.stringify([
              "Full Stack Developer",
              "Backend Specialist",
              "DevOps Engineer",
            ])}
          >
            Full Stack Developer
          </span>
        </div>
        <p
          class="max-w-lg text-sm! leading-relaxed font-medium text-balance text-muted-foreground sm:text-base"
        >
          Full Stack Developer with 3+ years of professional experience building
          scalable full-stack applications with Nest.js and Next.js.
          Specializing in <span class="text-foreground"
            >robust backend systems</span
          > and <span class="text-foreground">DevOps automation</span>.
        </p>
      </div>

      <div class="w-full max-w-md">
        <form id="hero-subscribe-form" class="space-y-2">
          <!-- Honeypot trap field (silent bot protection) -->
          <div
            aria-hidden="true"
            style="display:none; position:absolute; left:-9999px; opacity:0; pointer-events:none;"
          >
            <label for="hero-hp">Leave empty</label>
            <input
              type="text"
              id="hero-hp"
              name="hp_field"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <InputGroup
            className="h-12 border-2 border-border bg-foreground text-sm! font-medium text-background sm:h-14 sm:text-base! md:text-lg!"
          >
            <InputGroupInput
              type="email"
              id="hero-email"
              name="email"
              required
              placeholder="Enter your email for tech stories & updates..."
            />
            <InputGroupAddon align="inline-end">
              <InputGroupButton
                type="submit"
                id="hero-submit-btn"
                className="h-8 cursor-pointer px-3 sm:h-10 sm:px-4"
                variant={"default"}
              >
                <span id="hero-submit-text">Subscribe</span>
              </InputGroupButton>
            </InputGroupAddon>
          </InputGroup>

          <!-- Cloudflare Turnstile Container -->
          <div
            id="hero-turnstile-container"
            class="flex min-h-[65px] justify-center py-1 empty:hidden"
          >
          </div>

          <!-- Interactive Status Alert Banner -->
          <div
            id="hero-status"
            class="hidden rounded border p-2.5 font-mono text-xs leading-relaxed transition-all"
            role="alert"
          >
          </div>
        </form>
      </div>

      <!-- Secondary Navigation -->
      <div class="flex flex-wrap items-center gap-4 sm:gap-6">
        <div
          class="flex items-center gap-2 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground sm:text-sm"
        >
          <span>Read my story</span>
          <a
            href="/about"
            class="group flex items-center gap-1 text-primary underline-offset-4 hover:underline"
          >
            Portfolio
            <HugeiconsIcon
              icon={ArrowUpRight03Icon}
              className="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          </a>
        </div>
        <div class="h-4 w-px bg-border"></div>
        <a
          href="#work"
          class="text-xs font-medium text-muted-foreground hover:text-foreground sm:text-sm"
          >View Projects</a
        >
      </div>

      <!-- Social Links -->
      <div class="flex flex-col gap-3 pt-2">
        <span
          class="text-[10px] font-semibold tracking-[0.2em] text-muted-foreground uppercase sm:text-xs"
        >
          Follow me
        </span>
        <div class="flex items-center gap-3">
          {
            [
              {
                href: "https://github.com/fiamanillah",
                label: "GitHub",
                icon: GithubIcon,
              },
              {
                href: "https://www.linkedin.com/in/fi-amanillah/",
                label: "LinkedIn",
                icon: Linkedin02Icon,
              },
              {
                href: "https://www.facebook.com/fiamanillah.b2",
                label: "Facebook",
                icon: Facebook02Icon,
              },
            ].map(({ href, label, icon }) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={label}
                class="inline-flex h-11 w-11 items-center justify-center border border-border bg-background text-foreground transition hover:border-primary hover:bg-primary/10 focus:ring-2 focus:ring-primary/30 focus:outline-none"
              >
                <HugeiconsIcon
                  icon={icon}
                  className="size-5"
                  aria-hidden="true"
                />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Right Side: Details About Me -->
    <div
      class="flex flex-col items-start justify-center space-y-10 lg:items-end"
    >
      <!-- Identity Details (Minimalist List) -->
      <div class="flex w-full max-w-md flex-col gap-4 pt-4">
        <div
          class="flex items-center justify-between border-b border-border pb-3"
        >
          <span
            class="font-mono text-xs tracking-[0.12em] text-muted-foreground uppercase"
            >Location</span
          >
          <span
            class="text-xs font-semibold tracking-tight text-foreground sm:text-sm"
            >Dhaka, Bangladesh</span
          >
        </div>
        <div
          class="flex items-center justify-between border-b border-border pb-3"
        >
          <span
            class="font-mono text-xs tracking-[0.12em] text-muted-foreground uppercase"
            >Experience</span
          >
          <span
            class="text-xs font-semibold tracking-tight text-foreground sm:text-sm"
            >3+ Years</span
          >
        </div>
        <div
          class="flex items-center justify-between border-b border-border pb-3"
        >
          <span
            class="font-mono text-xs tracking-[0.12em] text-muted-foreground uppercase"
            >Specialty</span
          >
          <span
            class="text-xs font-semibold tracking-tight text-foreground sm:text-sm"
            >Full-Stack Dev</span
          >
        </div>
        <div
          class="flex items-center justify-between border-b border-border pb-3"
        >
          <span
            class="font-mono text-xs tracking-[0.12em] text-muted-foreground uppercase"
            >Focus</span
          >
          <span
            class="text-xs font-semibold tracking-tight text-foreground sm:text-sm"
            >Backend & DevOps</span
          >
        </div>
      </div>

      <!-- Curriculum Vitae / Resume Download (Zero-JS Astro Component) -->
      <HeroResumeCard
        resumeUrl={resumeData.resumeUrl}
        downloadUrl={resumeUrl}
        version={resumeData.version}
      />

      <!-- Tech Stack (Floating Badges) -->
      <div class="w-full max-w-md space-y-4">
        <div class="flex items-center justify-start gap-3 lg:justify-end">
          <div class="h-px w-12 bg-border"></div>
          <span
            class="font-mono text-xs tracking-[0.1em] whitespace-nowrap text-muted-foreground uppercase"
            >Tech Stack</span
          >
        </div>
        <div class="flex flex-wrap justify-start gap-2.5 lg:justify-end">
          {
            [
              { name: "React", color: "#61DAFB" },
              { name: "TypeScript", color: "#3178C6" },
              { name: "Node.js", color: "#68A063" },
              { name: "PostgreSQL", color: "#336791" },
              { name: "AWS", color: "#FF9900" },
              { name: "Docker", color: "#2496ED" },
            ].map(({ name, color }) => (
              <Badge
                variant={"outline"}
                className="border-border bg-background/50 py-1 backdrop-blur-sm"
              >
                <span
                  class="mr-2 h-1.5 w-1.5 shrink-0"
                  style={`background:${color}`}
                />
                {name}
              </Badge>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Background Image Handling -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-20 h-full overflow-hidden"
  >
    <!-- Dotted Background -->
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.3)_1px,transparent_1px)] bg-size-[24px_24px] opacity-60"
    >
    </div>
    <!-- Glow Effect (Zero-CLS Radial Gradient) -->
    <div
      class="absolute inset-x-0 bottom-0 h-3/4 bg-[radial-gradient(ellipse_80%_80%_at_50%_100%,rgba(0,220,200,0.15)_0%,transparent_75%)]"
      aria-hidden="true"
    >
    </div>
    <picture
      class="pointer-events-none absolute bottom-0 left-1/2 h-[65%] w-auto max-w-none -translate-x-1/2 [mask-image:radial-gradient(ellipse_at_center,black_55%,transparent_95%)] select-none sm:h-[75%] lg:left-[54%] lg:h-[82%] xl:left-[52%] xl:h-[88%]"
    >
      <source
        media="(max-width: 640px)"
        srcset="/fi-sm.webp"
        type="image/webp"
        width="360"
        height="360"
      />
      <source
        media="(max-width: 1024px)"
        srcset="/fi-md.webp"
        type="image/webp"
        width="720"
        height="720"
      />
      <source srcset="/fi.webp" type="image/webp" width="640" height="640" />
      <img
        src="/fi.webp"
        alt="Fi Amanillah - Full-Stack Architect"
        width="640"
        height="640"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class="h-full w-auto object-contain opacity-25 contrast-125 grayscale transition-opacity duration-700 sm:opacity-30 lg:opacity-35"
      />
    </picture>
    <div
      class="absolute inset-0 bg-linear-to-t from-background via-background/20 to-transparent"
    >
    </div>
  </div>
</section>

<script>
  import { getApiBaseUrl } from "@/lib/api/baseUrl"

  function setupTextScramble() {
    const el = document.getElementById("hero-text-scramble")
    if (!el || el.dataset.scrambleInit === "true") return
    el.dataset.scrambleInit = "true"

    let texts = []
    try {
      texts = JSON.parse(el.dataset.texts || "[]")
    } catch {}
    if (!texts.length) return

    const chars = "!<>-_\\/[]{}—=+*^?#________"
    let textIndex = 0
    let intervalId: ReturnType<typeof setInterval> | null = null
    let timeoutId: ReturnType<typeof setTimeout> | null = null

    const scramble = (targetText: string) => {
      if (intervalId) clearInterval(intervalId)
      let iteration = 0
      const maxIteration = targetText.length

      intervalId = setInterval(() => {
        el.textContent = targetText
          .split("")
          .map((char, index) => {
            if (index < iteration) return targetText[index]
            return chars[Math.floor(Math.random() * chars.length)]
          })
          .join("")

        if (iteration >= maxIteration) {
          if (intervalId) clearInterval(intervalId)
          intervalId = null
        }
        iteration += 1 / 3
      }, 50)
    }

    const cycle = () => {
      textIndex = (textIndex + 1) % texts.length
      scramble(texts[textIndex])
      timeoutId = setTimeout(cycle, 5000)
    }

    timeoutId = setTimeout(cycle, 5000)

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        if (intervalId) clearInterval(intervalId)
        if (timeoutId) clearTimeout(timeoutId)
      } else {
        timeoutId = setTimeout(cycle, 5000)
      }
    })
  }

  let heroTurnstileWidgetId: string | null = null

  function initHeroTurnstileOnDemand() {
    const isLocal =
      window.location.hostname === "localhost" ||
      window.location.hostname === "127.0.0.1"
    const turnstileKey =
      import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ||
      (isLocal ? "1x00000000000000000000AA" : "0x4AAAAAAEMAnAognjniSApt")
    const container = document.getElementById("hero-turnstile-container")
    const statusDiv = document.getElementById("hero-status")
    if (!turnstileKey || !container || heroTurnstileWidgetId !== null) return

    const render = () => {
      if (window.turnstile && heroTurnstileWidgetId === null) {
        try {
          heroTurnstileWidgetId = window.turnstile.render(
            "#hero-turnstile-container",
            {
              sitekey: turnstileKey,
              theme: "dark",
              callback: () => {
                window.dispatchEvent(new CustomEvent("grid-refresh"))
              },
              "error-callback": () => {
                if (statusDiv) {
                  statusDiv.classList.remove(
                    "hidden",
                    "bg-emerald-500/10",
                    "border-emerald-500/30",
                    "text-emerald-400"
                  )
                  statusDiv.classList.add(
                    "bg-destructive/10",
                    "border-destructive/30",
                    "text-destructive"
                  )
                  statusDiv.textContent =
                    "Security verification check failed. Please refresh or retry."
                  window.dispatchEvent(new CustomEvent("grid-refresh"))
                }
              },
              "expired-callback": () => {
                if (statusDiv) {
                  statusDiv.classList.remove(
                    "hidden",
                    "bg-emerald-500/10",
                    "border-emerald-500/30",
                    "text-emerald-400"
                  )
                  statusDiv.classList.add(
                    "bg-destructive/10",
                    "border-destructive/30",
                    "text-destructive"
                  )
                  statusDiv.textContent =
                    "Security verification expired. Please check the box again."
                  window.dispatchEvent(new CustomEvent("grid-refresh"))
                }
              },
            }
          )
          window.dispatchEvent(new CustomEvent("grid-refresh"))
        } catch (err) {
          console.warn("Hero Turnstile render error:", err)
        }
      }
    }

    if (window.turnstile) {
      render()
      return
    }

    let script = document.getElementById(
      "cf-turnstile-script"
    ) as HTMLScriptElement | null
    if (!script) {
      script = document.createElement("script")
      script.id = "cf-turnstile-script"
      script.src =
        "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
      script.async = true
      script.defer = true
      document.head.appendChild(script)
    }
    script.addEventListener("load", render, { once: true })
  }

  function setupHeroSubscription() {
    const form = document.getElementById(
      "hero-subscribe-form"
    ) as HTMLFormElement | null
    const submitBtn = document.getElementById(
      "hero-submit-btn"
    ) as HTMLButtonElement | null
    const submitText = document.getElementById("hero-submit-text")
    const statusDiv = document.getElementById("hero-status")
    const emailInput = document.getElementById(
      "hero-email"
    ) as HTMLInputElement | null

    if (!form || !submitBtn || !submitText) return

    if (form.dataset.bound === "true") return
    form.dataset.bound = "true"

    // Lazy load Turnstile on interaction (focus/input)
    emailInput?.addEventListener("focus", initHeroTurnstileOnDemand, {
      once: true,
    })
    emailInput?.addEventListener("click", initHeroTurnstileOnDemand, {
      once: true,
    })
    emailInput?.addEventListener("input", initHeroTurnstileOnDemand, {
      once: true,
    })

    form.addEventListener("submit", async (e) => {
      e.preventDefault()
      initHeroTurnstileOnDemand()

      if (statusDiv) {
        statusDiv.classList.add("hidden")
        statusDiv.innerHTML = ""
      }

      const formData = new FormData(form)
      const email = (formData.get("email") as string)?.trim()
      const hp_field = (formData.get("hp_field") as string) || ""

      if (!email) return

      let captchaToken = ""
      if (window.turnstile && heroTurnstileWidgetId !== null) {
        captchaToken = window.turnstile.getResponse(heroTurnstileWidgetId) || ""
      }

      const originalText = submitText.textContent
      submitBtn.disabled = true
      submitText.textContent = "Subscribing..."

      const apiUrl = getApiBaseUrl()

      try {
        const response = await fetch(`${apiUrl}/subscriber/v1/subscribe`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            email,
            source: "hero_section",
            hp_field,
            captchaToken,
          }),
        })

        const data = await response.json().catch(() => ({}))

        if (response.ok && data.success) {
          const isAlready = data.data?.alreadySubscribed || false
          submitText.textContent = isAlready
            ? "Already Subscribed"
            : "Subscribed!"
          if (statusDiv) {
            statusDiv.classList.remove(
              "hidden",
              "bg-destructive/10",
              "border-destructive/30",
              "text-destructive"
            )
            statusDiv.classList.add(
              "bg-emerald-500/10",
              "border-emerald-500/30",
              "text-emerald-400"
            )
            statusDiv.textContent = data.message || "Thank you for subscribing!"
          }
          form.reset()

          if (window.turnstile && heroTurnstileWidgetId !== null) {
            window.turnstile.reset(heroTurnstileWidgetId)
          }

          setTimeout(() => {
            submitText.textContent = originalText
            submitBtn.disabled = false
          }, 4000)
        } else {
          const errorMessage =
            data.message ||
            data.error?.message ||
            "Failed to subscribe. Please try again."
          const suggestedEmail =
            data.data?.suggestedEmail ||
            data.details?.suggestedEmail ||
            data.error?.details?.suggestedEmail

          if (statusDiv) {
            statusDiv.classList.remove(
              "hidden",
              "bg-emerald-500/10",
              "border-emerald-500/30",
              "text-emerald-400"
            )
            statusDiv.classList.add(
              "bg-destructive/10",
              "border-destructive/30",
              "text-destructive"
            )

            if (suggestedEmail) {
              statusDiv.innerHTML = `
                <div>${errorMessage}</div>
                <div class="mt-2 flex items-center justify-between gap-2 border-t border-destructive/20 pt-2 text-amber-300 font-semibold">
                  <span>Did you mean <strong>${suggestedEmail}</strong>?</span>
                  <button type="button" id="hero-apply-suggestion" class="rounded bg-amber-400 px-2 py-0.5 font-mono text-[10px] font-bold uppercase text-black transition hover:bg-amber-300 cursor-pointer">
                    Apply
                  </button>
                </div>
              `
              const applyBtn = document.getElementById("hero-apply-suggestion")
              applyBtn?.addEventListener("click", () => {
                if (emailInput) emailInput.value = suggestedEmail
                statusDiv.classList.add("hidden")
                statusDiv.innerHTML = ""
                emailInput?.focus()
              })
            } else {
              statusDiv.textContent = errorMessage
            }
          }

          if (window.turnstile && heroTurnstileWidgetId !== null) {
            window.turnstile.reset(heroTurnstileWidgetId)
          }

          submitText.textContent = originalText
          submitBtn.disabled = false
        }
      } catch (err) {
        console.error("Hero subscription error:", err)
        if (statusDiv) {
          statusDiv.classList.remove(
            "hidden",
            "bg-emerald-500/10",
            "border-emerald-500/30",
            "text-emerald-400"
          )
          statusDiv.classList.add(
            "bg-destructive/10",
            "border-destructive/30",
            "text-destructive"
          )
          statusDiv.textContent = "Network error. Please try again."
        }
        submitText.textContent = originalText
        submitBtn.disabled = false
      }
    })
  }

  // Ensure compatibility with Astro's View Transitions if enabled
  document.addEventListener("astro:page-load", () => {
    setupTextScramble()
    setupHeroSubscription()
  })
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      setupTextScramble()
      setupHeroSubscription()
    })
  } else {
    setupTextScramble()
    setupHeroSubscription()
  }
</script>
