---
import { Badge } from "@workspace/ui/components/badge"
import { Button } from "@workspace/ui/components/button"
import { blogPostsData as blogPosts } from "@/data/blogPosts"
---

<section id="blog" class="relative z-10 mx-auto py-16">
  <!-- Header -->
  <div class="relative overflow-hidden text-center">
    <!-- Background Pattern (diagonal stripes themed to site palette) -->
    <div
      class="diagonal-stripes pointer-events-none absolute inset-0 z-10 bg-background"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 py-6">
      <p class="section-label mb-3">
        Articles & Technical Insights
      </p>

      <h2 class="section-title text-foreground">
        Recent <span class="text-primary">/</span> Blog Posts
      </h2>

      <!-- Accent bar -->
      <div class="accent-bar mx-auto mb-4 mt-4 w-60"></div>
    </div>
  </div>

  <!-- Blog Cards Grid -->
  <div class="container mx-auto mt-8 px-4">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        blogPosts.map((post) => (
          <article
            class="group relative flex flex-col justify-between border border-border bg-background/60 p-6 backdrop-blur-sm transition-all duration-300 hover:border-primary/40 hover:bg-background/90 hover:shadow-[0_0_0_1px_oklch(var(--primary)/20%),0_8px_32px_-8px_oklch(var(--primary)/12%)]"
          >
            {/* Corner brackets matching design language */}
            <div class="pointer-events-none absolute top-2 left-2 z-10 h-3.5 w-3.5 border-t-[1.5px] border-l-[1.5px] border-border transition-all duration-200 group-hover:h-4.5 group-hover:w-4.5 group-hover:border-primary" />
            <div class="pointer-events-none absolute top-2 right-2 z-10 h-3.5 w-3.5 border-t-[1.5px] border-r-[1.5px] border-border transition-all duration-200 group-hover:h-4.5 group-hover:w-4.5 group-hover:border-primary" />
            <div class="pointer-events-none absolute bottom-2 left-2 z-10 h-3.5 w-3.5 border-b-[1.5px] border-l-[1.5px] border-border transition-all duration-200 group-hover:h-4.5 group-hover:w-4.5 group-hover:border-primary" />
            <div class="pointer-events-none absolute right-2 bottom-2 z-10 h-3.5 w-3.5 border-r-[1.5px] border-b-[1.5px] border-border transition-all duration-200 group-hover:h-4.5 group-hover:w-4.5 group-hover:border-primary" />

            <div>
              {/* Card top metadata */}
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-muted-foreground">
                  <span>{post.date}</span>
                  <span class="text-primary/60">•</span>
                  <span>{post.readTime}</span>
                </div>
                {post.featured && (
                  <Badge
                    variant="outline"
                    class="border-primary/40 bg-primary/10 font-mono text-[10px] tracking-wider text-primary uppercase"
                  >
                    FEATURED
                  </Badge>
                )}
              </div>

              {/* Title */}
              <h3 class="mt-4 text-lg font-bold tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary line-clamp-2">
                <a href={post.url} class="focus:outline-none">
                  <span class="absolute inset-0 z-0" aria-hidden="true"></span>
                  {post.title}
                </a>
              </h3>

              {/* Summary */}
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground line-clamp-3">
                {post.summary}
              </p>
            </div>

            {/* Tags & Footer Action */}
            <div class="mt-6">
              <div class="mb-5 flex flex-wrap gap-1.5">
                {post.tags.map((tag) => (
                  <Badge
                    variant="secondary"
                    class="font-mono text-[10px] font-normal text-muted-foreground/90 transition-colors group-hover:border-primary/20"
                  >
                    #{tag}
                  </Badge>
                ))}
              </div>

              <div class="relative z-10 flex items-center justify-between border-t border-border/60 pt-4">
                <span class="font-mono text-xs text-muted-foreground transition-colors group-hover:text-foreground">
                  READ ARTICLE
                </span>
                <a href={post.url} class="inline-block">
                  <Button
                    variant="outline"
                    size="sm"
                    class="h-8 gap-1.5 font-mono text-xs transition-colors group-hover:border-primary group-hover:text-primary"
                  >
                    Read
                    <span class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                      ↗
                    </span>
                  </Button>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- View All Articles Footer Button -->
    <div class="mt-12 text-center">
      <a href="#" class="inline-block">
        <Button
          variant="outline"
          size="lg"
          class="border-primary/40 font-mono text-xs tracking-wider text-primary transition-all duration-200 hover:bg-primary/10 hover:shadow-[0_0_16px_rgba(var(--primary-rgb),0.2)]"
        >
          View All Articles
          <span class="ml-1.5 transition-transform duration-200 hover:translate-x-0.5">↗</span>
        </Button>
      </a>
    </div>
  </div>
</section>
