---
import { Button } from "@workspace/ui/components/button"
import BlogCard from "@/components/Blog/cards/BlogCard.astro"
import { getAllBlogPostsAsync } from "@/data/blogPosts"

// Fetch published blog posts from DB / API for home page showcase (3 most recent)
const allPosts = await getAllBlogPostsAsync()
const recentPosts = allPosts.slice(0, 3)
---

<section id="blog" class="relative z-10 mx-auto py-16">
  <!-- Header -->
  <div class="relative overflow-hidden text-center">
    <!-- Background Pattern (diagonal stripes themed to site palette) -->
    <div
      class="diagonal-stripes pointer-events-none absolute inset-0 z-10 bg-background"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 py-6">
      <p class="section-label mb-3">Articles & Technical Insights</p>

      <h2 class="section-title text-foreground">
        Recent <span class="text-primary">/</span> Blog Posts
      </h2>

      <!-- Accent bar -->
      <div class="accent-bar mx-auto mt-4 mb-4 w-60"></div>
    </div>
  </div>

  <!-- Blog Cards Grid -->
  <div class="container mx-auto mt-8 px-4">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {recentPosts.map((post) => <BlogCard post={post} />)}
    </div>

    <!-- View All Articles Footer Button -->
    <div class="mt-12 text-center">
      <a href="/blog" class="inline-block">
        <Button
          variant="outline"
          size="lg"
          className="border-primary/40 font-mono text-xs tracking-wider text-primary transition-all duration-200 hover:bg-primary/10 hover:shadow-[0_0_16px_rgba(var(--primary-rgb),0.2)]"
        >
          Explore All Articles
          <span
            class="ml-1.5 transition-transform duration-200 hover:translate-x-0.5"
            >↗</span
          >
        </Button>
      </a>
    </div>
  </div>
</section>
