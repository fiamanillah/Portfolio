---
import { Button } from "@workspace/ui/components/button"
import BlogCard from "@/components/Blog/cards/BlogCard.astro"
import { getAllBlogPostsAsync } from "@/data/blogPosts"

// Fetch published blog posts from DB / API for home page showcase (up to 6 most recent)
const allPosts = await getAllBlogPostsAsync()
const recentPosts = allPosts.slice(0, 6)
---

<section id="blog" class="relative z-10 mx-auto" data-grid-cross>
  <!-- Header -->
  <div class="relative overflow-hidden text-center">
    <!-- Background Pattern (diagonal stripes themed to site palette) -->
    <div
      class="diagonal-stripes pointer-events-none absolute inset-0 z-10 bg-background"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 py-6">
      <p class="section-label mb-3">Technology, AI &amp; Engineering</p>

      <h2 class="section-title text-foreground">
        Recent <span class="text-primary">/</span> Tech Stories &amp; Articles
      </h2>

      <!-- Accent bar -->
      <div class="accent-bar mx-auto mt-4 mb-4 w-60"></div>
    </div>
  </div>

  <!-- Blog Cards Grid (3-Column Responsive Grid) -->
  <div class="container mx-auto">
    {
      recentPosts.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {recentPosts.map((post) => (
            <BlogCard post={post} class="border border-border" />
          ))}
        </div>
      ) : (
        <div class="border border-border/80 bg-background/50 p-8 text-center font-mono text-sm text-muted-foreground">
          No articles published yet. Check back soon!
        </div>
      )
    }

    <!-- View All Articles Footer Button -->
    <div class="mt-12 text-center">
      <a href="/blog" class="inline-block">
        <Button
          variant="outline"
          size="lg"
          className="border-primary/40 font-mono text-xs tracking-wider text-primary transition-all duration-200 hover:bg-primary/10 hover:shadow-[0_0_16px_rgba(var(--primary-rgb),0.2)]"
        >
          Explore All Articles &amp; Tech Stories
          <span
            class="ml-1.5 transition-transform duration-200 hover:translate-x-0.5"
            >↗</span
          >
        </Button>
      </a>
    </div>
  </div>
</section>
