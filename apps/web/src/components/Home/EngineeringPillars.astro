---
// src/components/Home/EngineeringPillars.astro
---

<section
  id="engineering-pillars"
  data-grid-cross
  class="relative container mx-auto overflow-hidden"
>
  <!-- Section Header -->
  <div class="relative mb-12 overflow-hidden text-center md:mb-16">
    <!-- Background Pattern (diagonal stripes themed to site palette) -->
    <div
      class="diagonal-stripes pointer-events-none absolute inset-0 z-10 bg-background"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 py-6">
      <p class="section-label mb-3">Architectural Standards & Core Values</p>
      <h2 class="section-title text-foreground">
        Engineering <span class="text-primary">Pillars</span>
      </h2>
      <div class="accent-bar mx-auto mt-3 mb-2 w-48 md:w-56"></div>
    </div>
  </div>

  <!-- Asymmetric Blueprint Bento Layout (Staggered non-uniform widths matching screenshot) -->
  <div class="flex w-full flex-col gap-6 lg:gap-8">
    <!-- ROW 1: Box 1 (~53% wide) + Box 2 (~38% narrower, stops before edge) -->
    <div class="flex w-full flex-col items-start gap-6 md:flex-row lg:gap-8">
      <!-- Box 1: Scalable Backend Architecture -->
      <div
        class="group relative w-full rounded-none border border-dashed border-border/80 bg-card/30 p-6 backdrop-blur-sm transition-all duration-300 hover:border-primary/60 hover:bg-card/60 sm:p-8 md:w-[53%]"
      >
        <!-- Corner Plus Markers -->
        <span
          class="pointer-events-none absolute -top-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -top-[9px] -right-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -bottom-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -right-[6px] -bottom-[9px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >

        <h3
          class="mb-3 text-xl font-bold tracking-tight text-foreground sm:text-2xl"
        >
          Scalable Backend Architecture
        </h3>
        <p class="text-sm leading-relaxed text-muted-foreground sm:text-base">
          Engineering resilient, modular microservices and backend systems with
          Nest.js, Express, Go, and Node.js built with high throughput, clean
          boundaries, and performance in mind.
        </p>
      </div>

      <!-- Box 2: DevOps & Cloud Native (Narrower, staggered right edge) -->
      <div
        class="group relative w-full rounded-none border border-dashed border-border/80 bg-card/30 p-6 backdrop-blur-sm transition-all duration-300 hover:border-primary/60 hover:bg-card/60 sm:p-8 md:w-[38%]"
      >
        <!-- Corner Plus Markers -->
        <span
          class="pointer-events-none absolute -top-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -top-[9px] -right-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -bottom-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -right-[6px] -bottom-[9px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >

        <h3
          class="mb-3 text-xl font-bold tracking-tight text-foreground sm:text-2xl"
        >
          DevOps & Cloud Native
        </h3>
        <p class="text-sm leading-relaxed text-muted-foreground sm:text-base">
          Automating continuous integration and deployment pipelines, container
          orchestration with Docker & Kubernetes, and rock-solid Linux server
          management to guarantee zero-downtime releases.
        </p>
      </div>
    </div>

    <!-- ROW 2: Box 3 (Wide ~64% & Taller) + Box 4 (Narrower ~33% extending to right edge) -->
    <div class="flex w-full flex-col items-stretch gap-6 md:flex-row lg:gap-8">
      <!-- Box 3: End-to-End System Design (Wide & Tall) -->
      <div
        class="group relative w-full rounded-none border border-dashed border-border/80 bg-card/30 p-6 backdrop-blur-sm transition-all duration-300 hover:border-primary/60 hover:bg-card/60 sm:p-8 md:w-[64%]"
      >
        <!-- Corner Plus Markers -->
        <span
          class="pointer-events-none absolute -top-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -top-[9px] -right-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -bottom-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -right-[6px] -bottom-[9px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >

        <h3
          class="mb-3 text-xl font-bold tracking-tight text-foreground sm:text-2xl"
        >
          End-to-End System Design
        </h3>
        <p class="text-sm leading-relaxed text-muted-foreground sm:text-base">
          Bridging distributed backend logic with fluid, high-performance web
          applications. Whether designing relational schemas in PostgreSQL,
          optimizing document models in MongoDB, implementing Redis caching
          tiers, or orchestrating real-time WebSocket and REST/gRPC protocols,
          every layer is crafted for reliability. With end-to-end type safety,
          query plan optimization, asynchronous job queues, and responsive state
          synchronization, your system adapts effortlessly to every device and
          heavy enterprise workload.
        </p>
      </div>

      <!-- Box 4: Security & Performance First -->
      <div
        class="group relative w-full rounded-none border border-dashed border-border/80 bg-card/30 p-6 backdrop-blur-sm transition-all duration-300 hover:border-primary/60 hover:bg-card/60 sm:p-8 md:w-[33%]"
      >
        <!-- Corner Plus Markers -->
        <span
          class="pointer-events-none absolute -top-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -top-[9px] -right-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -bottom-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -right-[6px] -bottom-[9px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >

        <h3
          class="mb-3 text-xl font-bold tracking-tight text-foreground sm:text-2xl"
        >
          Security & Performance First
        </h3>
        <p class="text-sm leading-relaxed text-muted-foreground sm:text-base">
          Every architecture is thoughtfully designed with OWASP security
          practices, RBAC authorization, and sub-millisecond query execution to
          work seamlessly under intense production scale.
        </p>
      </div>
    </div>

    <!-- ROW 3: Box 5 (Compact ~32% wide) + Box 6 (Feature Headline ~62% wide on the right) -->
    <div
      class="flex w-full flex-col items-stretch justify-between gap-6 md:flex-row lg:gap-8"
    >
      <!-- Box 5: Fast & Lightweight (Compact card) -->
      <div
        class="group relative w-full rounded-none border border-dashed border-border/80 bg-card/30 p-6 backdrop-blur-sm transition-all duration-300 hover:border-primary/60 hover:bg-card/60 sm:p-8 md:w-[32%]"
      >
        <!-- Corner Plus Markers -->
        <span
          class="pointer-events-none absolute -top-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -top-[9px] -right-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -bottom-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -right-[6px] -bottom-[9px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >

        <h3
          class="mb-3 text-xl font-bold tracking-tight text-foreground sm:text-2xl"
        >
          Fast & Lightweight
        </h3>
        <p class="text-sm leading-relaxed text-muted-foreground sm:text-base">
          Built for speed and performance, ensuring quick load times, optimal
          Core Web Vitals, and responsive interactions without sacrificing
          architectural quality.
        </p>
      </div>

      <!-- Box 6: Signature Large Typography Feature ("Built for...") -->
      <div
        class="group relative flex min-h-[180px] w-full flex-col justify-end rounded-none border border-dashed border-border/80 bg-card/30 p-6 backdrop-blur-sm transition-all duration-300 hover:border-primary/60 hover:bg-card/60 sm:p-8 md:w-[62%]"
      >
        <!-- Corner Plus Markers -->
        <span
          class="pointer-events-none absolute -top-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -top-[9px] -right-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -bottom-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >
        <span
          class="pointer-events-none absolute -right-[6px] -bottom-[9px] font-mono text-sm leading-none text-muted-foreground/60 transition-colors duration-300 select-none group-hover:text-primary"
          >+</span
        >

        <div class="space-y-4">
          <div class="flex items-center gap-2">
            <span
              class="inline-block size-2 animate-pulse rounded-full bg-primary"
            ></span>
            <span
              class="font-mono text-xs font-medium tracking-wider text-primary uppercase"
            >
              Core Philosophy
            </span>
          </div>

          <h3
            class="text-3xl font-black tracking-tight text-foreground sm:text-4xl lg:text-5xl"
          >
            Built for <span class="text-primary">scale & speed.</span>
          </h3>

          <div class="flex flex-wrap gap-2 pt-2">
            <span
              class="rounded border border-border/60 bg-muted/40 px-2.5 py-1 font-mono text-xs text-muted-foreground"
            >
              99.9% Uptime
            </span>
            <span
              class="rounded border border-border/60 bg-muted/40 px-2.5 py-1 font-mono text-xs text-muted-foreground"
            >
              Sub-ms Latency
            </span>
            <span
              class="rounded border border-border/60 bg-muted/40 px-2.5 py-1 font-mono text-xs text-muted-foreground"
            >
              Zero Bottlenecks
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
