---
// src/components/Home/EngineeringPillars.astro
import {
  ServerStack01Icon,
  CloudServerIcon,
  Layers01Icon,
  Shield01Icon,
  DashboardSpeed01Icon,
  CpuIcon,
} from "@hugeicons/core-free-icons"
import { HugeiconsIcon } from "@hugeicons/react"

const summaryMetrics = [
  { label: "Target Availability", value: "99.9%+" },
  { label: "P99 Response Time", value: "< 50ms" },
  { label: "Deployment Cycle", value: "Zero Downtime" },
  { label: "Architecture Spec", value: "Event-Driven" },
]
---

<style>
  .bento-card {
    transition:
      border-color 250ms ease,
      background-color 250ms ease,
      transform 250ms ease,
      box-shadow 250ms ease;
  }

  .bento-card:hover {
    border-color: oklch(var(--primary) / 60%);
    background-color: oklch(var(--card) / 80%);
    transform: translateY(-2px);
    box-shadow: 0 14px 32px -10px oklch(var(--primary) / 12%);
  }

  .pillar-icon-box {
    transition:
      border-color 250ms ease,
      background-color 250ms ease,
      color 250ms ease,
      transform 250ms ease;
  }

  .bento-card:hover .pillar-icon-box {
    border-color: oklch(var(--primary) / 50%);
    background-color: oklch(var(--primary) / 12%);
    color: oklch(var(--primary));
    transform: scale(1.05);
  }

  .manifesto-banner {
    background-image: radial-gradient(
      ellipse 80% 60% at 50% -20%,
      oklch(var(--primary) / 8%),
      transparent 75%
    );
  }
</style>

<section
  id="engineering-pillars"
  data-grid-cross
  class="relative container mx-auto overflow-hidden pb-12 md:pb-16"
>
  <!-- Section Header -->
  <div class="relative mb-8 overflow-hidden text-center md:mb-12">
    <!-- Background Diagonal Stripes -->
    <div
      class="diagonal-stripes pointer-events-none absolute inset-0 z-10 bg-background"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 py-5">
      <p class="section-label mb-2.5">Architectural Standards & Core Values</p>
      <h2 class="section-title text-foreground">
        Engineering <span class="text-primary">Pillars</span>
      </h2>
      <div class="accent-bar mx-auto mt-3.5 mb-2 w-48 md:w-56"></div>
    </div>
  </div>

  <!-- Truly Asymmetric Interlocking Bento Grid -->
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-12 lg:gap-6">
    {
      /* CARD 1: Scalable Backend Architecture (Tall 2-Row Left Anchor: 4 cols x 2 rows) */
    }
    <article
      class="bento-card group relative col-span-1 flex flex-col justify-between border border-dashed border-border/80 bg-card/30 p-6 backdrop-blur-xs sm:p-7 md:col-span-2 lg:col-span-4 lg:row-span-2"
    >
      {/* Corner Crosshairs */}
      <span
        class="pointer-events-none absolute -top-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -top-[9px] -right-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -bottom-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -right-[6px] -bottom-[9px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>

      <div>
        <div
          class="mb-4 flex items-center justify-between border-b border-border/40 pb-3"
        >
          <div class="flex items-center gap-2">
            <span class="inline-block size-1.5 rounded-full bg-primary"></span>
            <span
              class="font-mono text-[11px] font-bold tracking-wider text-primary uppercase"
            >
              SYS_01 // SCALE
            </span>
          </div>
        </div>

        <div class="mb-3.5 flex items-center gap-3.5">
          <div
            class="pillar-icon-box flex size-10 shrink-0 items-center justify-center rounded border border-border/70 bg-muted/30 text-primary/80 transition-all duration-200"
          >
            <HugeiconsIcon
              icon={ServerStack01Icon}
              size={20}
              strokeWidth={1.75}
            />
          </div>
          <h3
            class="text-lg font-bold tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary sm:text-xl"
          >
            Scalable Backend Architecture
          </h3>
        </div>

        <p class="text-xs leading-relaxed text-muted-foreground sm:text-sm">
          Engineering resilient, modular microservices and distributed backend
          systems with Nest.js, Go, Express, and Node.js — architected for high
          concurrency, domain-driven boundaries, and zero single points of
          failure.
        </p>
      </div>

      <div class="mt-6 flex flex-wrap gap-1.5 border-t border-border/30 pt-4">
        {
          ["Nest.js & Go", "Microservices", "Event Pub/Sub", "Modular DDD"].map(
            (tag) => (
              <span class="rounded border border-border/60 bg-muted/30 px-2 py-0.5 font-mono text-[10px] font-medium text-muted-foreground transition-colors group-hover:border-primary/30 group-hover:text-foreground">
                {tag}
              </span>
            )
          )
        }
      </div>
    </article>

    {/* CARD 2: DevOps & Cloud Native (Wide Top Right Card: 8 cols x 1 row) */}
    <article
      class="bento-card group relative col-span-1 flex flex-col justify-between border border-dashed border-border/80 bg-card/30 p-6 backdrop-blur-xs sm:p-7 md:col-span-2 lg:col-span-8 lg:row-span-1"
    >
      {/* Corner Crosshairs */}
      <span
        class="pointer-events-none absolute -top-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -top-[9px] -right-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -bottom-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -right-[6px] -bottom-[9px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>

      <div>
        <div
          class="mb-4 flex items-center justify-between border-b border-border/40 pb-3"
        >
          <div class="flex items-center gap-2">
            <span class="inline-block size-1.5 rounded-full bg-primary"></span>
            <span
              class="font-mono text-[11px] font-bold tracking-wider text-primary uppercase"
            >
              OPS_02 // INFRA
            </span>
          </div>
        </div>

        <div
          class="grid grid-cols-1 gap-4 sm:grid-cols-12 sm:items-start sm:gap-6"
        >
          <div class="flex items-center gap-3.5 sm:col-span-5">
            <div
              class="pillar-icon-box flex size-10 shrink-0 items-center justify-center rounded border border-border/70 bg-muted/30 text-primary/80 transition-all duration-200"
            >
              <HugeiconsIcon
                icon={CloudServerIcon}
                size={20}
                strokeWidth={1.75}
              />
            </div>
            <h3
              class="text-lg font-bold tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary sm:text-xl"
            >
              DevOps &amp; Cloud Native
            </h3>
          </div>

          <div class="sm:col-span-7">
            <p class="text-xs leading-relaxed text-muted-foreground sm:text-sm">
              Automating zero-downtime CI/CD pipelines, container orchestration
              with Docker & Kubernetes, and hardened Linux server management
              with proactive health monitoring.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-5 flex flex-wrap gap-1.5 border-t border-border/30 pt-3">
        {
          [
            "Docker & K8s",
            "CI/CD Automation",
            "Hardened Linux VPS",
            "Reverse Proxy",
          ].map((tag) => (
            <span class="rounded border border-border/60 bg-muted/30 px-2 py-0.5 font-mono text-[10px] font-medium text-muted-foreground transition-colors group-hover:border-primary/30 group-hover:text-foreground">
              {tag}
            </span>
          ))
        }
      </div>
    </article>

    {/* CARD 3: End-to-End System Design (Middle-Left Card: 5 cols x 1 row) */}
    <article
      class="bento-card group relative col-span-1 flex flex-col justify-between border border-dashed border-border/80 bg-card/30 p-6 backdrop-blur-xs sm:p-7 md:col-span-1 lg:col-span-5 lg:row-span-1"
    >
      {/* Corner Crosshairs */}
      <span
        class="pointer-events-none absolute -top-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -top-[9px] -right-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -bottom-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -right-[6px] -bottom-[9px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>

      <div>
        <div
          class="mb-4 flex items-center justify-between border-b border-border/40 pb-3"
        >
          <div class="flex items-center gap-2">
            <span class="inline-block size-1.5 rounded-full bg-primary"></span>
            <span
              class="font-mono text-[11px] font-bold tracking-wider text-primary uppercase"
            >
              ARCH_03 // DATA
            </span>
          </div>
        </div>

        <div class="mb-3.5 flex items-center gap-3.5">
          <div
            class="pillar-icon-box flex size-10 shrink-0 items-center justify-center rounded border border-border/70 bg-muted/30 text-primary/80 transition-all duration-200"
          >
            <HugeiconsIcon icon={Layers01Icon} size={20} strokeWidth={1.75} />
          </div>
          <h3
            class="text-lg font-bold tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary sm:text-xl"
          >
            End-to-End System Design
          </h3>
        </div>

        <p class="text-xs leading-relaxed text-muted-foreground sm:text-sm">
          Bridging distributed backend logic with fluid client applications.
          Designing optimized PostgreSQL schemas, MongoDB document stores, and
          Redis caching layers.
        </p>
      </div>

      <div class="mt-5 flex flex-wrap gap-1.5 border-t border-border/30 pt-3">
        {
          ["PostgreSQL & Mongo", "Redis Caching", "gRPC & WebSockets"].map(
            (tag) => (
              <span class="rounded border border-border/60 bg-muted/30 px-2 py-0.5 font-mono text-[10px] font-medium text-muted-foreground transition-colors group-hover:border-primary/30 group-hover:text-foreground">
                {tag}
              </span>
            )
          )
        }
      </div>
    </article>

    {
      /* CARD 4: Security & Zero-Trust (Middle-Right Compact Card: 3 cols x 1 row) */
    }
    <article
      class="bento-card group relative col-span-1 flex flex-col justify-between border border-dashed border-border/80 bg-card/30 p-6 backdrop-blur-xs sm:p-7 md:col-span-1 lg:col-span-3 lg:row-span-1"
    >
      {/* Corner Crosshairs */}
      <span
        class="pointer-events-none absolute -top-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -top-[9px] -right-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -bottom-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -right-[6px] -bottom-[9px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>

      <div>
        <div
          class="mb-4 flex items-center justify-between border-b border-border/40 pb-3"
        >
          <div class="flex items-center gap-2">
            <span class="inline-block size-1.5 rounded-full bg-primary"></span>
            <span
              class="font-mono text-[11px] font-bold tracking-wider text-primary uppercase"
            >
              SEC_04 // ZERO-TRUST
            </span>
          </div>
        </div>

        <div class="mb-3.5 flex items-center gap-3">
          <div
            class="pillar-icon-box flex size-9 shrink-0 items-center justify-center rounded border border-border/70 bg-muted/30 text-primary/80 transition-all duration-200"
          >
            <HugeiconsIcon icon={Shield01Icon} size={18} strokeWidth={1.75} />
          </div>
          <h3
            class="text-base font-bold tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary sm:text-lg"
          >
            Security &amp; Zero-Trust
          </h3>
        </div>

        <p class="text-xs leading-relaxed text-muted-foreground">
          OWASP Top 10 compliance, granular RBAC policies, signed sessions, and
          input sanitization at every layer.
        </p>
      </div>

      <div class="mt-5 flex flex-wrap gap-1.5 border-t border-border/30 pt-3">
        {
          ["OWASP Top 10", "Granular RBAC", "Encrypted Auth"].map((tag) => (
            <span class="rounded border border-border/60 bg-muted/30 px-2 py-0.5 font-mono text-[10px] font-medium text-muted-foreground transition-colors group-hover:border-primary/30 group-hover:text-foreground">
              {tag}
            </span>
          ))
        }
      </div>
    </article>

    {/* CARD 5: Performance & Web Vitals (Bottom-Left Card: 4 cols x 1 row) */}
    <article
      class="bento-card group relative col-span-1 flex flex-col justify-between border border-dashed border-border/80 bg-card/30 p-6 backdrop-blur-xs sm:p-7 md:col-span-1 lg:col-span-4 lg:row-span-1"
    >
      {/* Corner Crosshairs */}
      <span
        class="pointer-events-none absolute -top-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -top-[9px] -right-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -bottom-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -right-[6px] -bottom-[9px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>

      <div>
        <div
          class="mb-4 flex items-center justify-between border-b border-border/40 pb-3"
        >
          <div class="flex items-center gap-2">
            <span class="inline-block size-1.5 rounded-full bg-primary"></span>
            <span
              class="font-mono text-[11px] font-bold tracking-wider text-primary uppercase"
            >
              PERF_05 // SPEED
            </span>
          </div>
        </div>

        <div class="mb-3.5 flex items-center gap-3.5">
          <div
            class="pillar-icon-box flex size-10 shrink-0 items-center justify-center rounded border border-border/70 bg-muted/30 text-primary/80 transition-all duration-200"
          >
            <HugeiconsIcon
              icon={DashboardSpeed01Icon}
              size={20}
              strokeWidth={1.75}
            />
          </div>
          <h3
            class="text-lg font-bold tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary sm:text-xl"
          >
            Performance &amp; Web Vitals
          </h3>
        </div>

        <p class="text-xs leading-relaxed text-muted-foreground sm:text-sm">
          Optimized runtime execution with sub-second Time to Interactive (TTI),
          aggressive database query indexing, and minimal bundle overhead.
        </p>
      </div>

      <div class="mt-5 flex flex-wrap gap-1.5 border-t border-border/30 pt-3">
        {
          ["Sub-100ms TTFB", "Query Optimization", "Lean Footprint"].map(
            (tag) => (
              <span class="rounded border border-border/60 bg-muted/30 px-2 py-0.5 font-mono text-[10px] font-medium text-muted-foreground transition-colors group-hover:border-primary/30 group-hover:text-foreground">
                {tag}
              </span>
            )
          )
        }
      </div>
    </article>

    {
      /* CARD 6: Core Architectural Manifesto (Bottom-Right Card: 8 cols x 1 row) */
    }
    <article
      class="bento-card manifesto-banner group relative col-span-1 flex flex-col justify-between border border-dashed border-border/80 bg-card/30 p-6 backdrop-blur-xs sm:p-7 md:col-span-2 lg:col-span-8 lg:row-span-1"
    >
      {/* Corner Crosshairs */}
      <span
        class="pointer-events-none absolute -top-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -top-[9px] -right-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -bottom-[9px] -left-[6px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="pointer-events-none absolute -right-[6px] -bottom-[9px] font-mono text-sm leading-none text-muted-foreground/40 transition-colors duration-300 select-none group-hover:text-primary"
        aria-hidden="true"
      >
        +
      </span>

      <div class="grid grid-cols-1 items-center gap-6 lg:grid-cols-12 lg:gap-8">
        {/* Left Column: Statement */}
        <div class="space-y-3 lg:col-span-7">
          <div class="flex items-center gap-2">
            <span
              class="inline-block size-1.5 animate-pulse rounded-full bg-primary"
            ></span>
            <span
              class="font-mono text-[11px] font-bold tracking-wider text-primary uppercase"
            >
              CORE_06 // PHILOSOPHY
            </span>
          </div>

          <div class="flex items-center gap-3.5">
            <div
              class="pillar-icon-box flex size-10 shrink-0 items-center justify-center rounded border border-border/70 bg-muted/30 text-primary/80 transition-all duration-200"
            >
              <HugeiconsIcon icon={CpuIcon} size={20} strokeWidth={1.75} />
            </div>
            <h3
              class="text-xl font-bold tracking-tight text-foreground transition-colors duration-200 group-hover:text-foreground sm:text-2xl"
            >
              Built for <span class="text-primary">scale &amp; resilience.</span
              >
            </h3>
          </div>

          <p class="text-xs leading-relaxed text-muted-foreground sm:text-sm">
            Structuring complex, high-concurrency systems so they operate
            predictably under heavy enterprise load, recover automatically from
            failure, and remain effortless to maintain.
          </p>
        </div>

        {/* Right Column: Key Metrics Grid */}
        <div class="lg:col-span-5">
          <div class="grid grid-cols-2 gap-2.5 sm:gap-3">
            {
              summaryMetrics.map((metric) => (
                <div class="flex flex-col justify-center rounded border border-border/60 bg-muted/20 p-2.5 backdrop-blur-xs transition-colors duration-200 group-hover:border-primary/30 sm:p-3">
                  <span class="font-mono text-sm font-bold tracking-tight text-primary">
                    {metric.value}
                  </span>
                  <span class="mt-0.5 font-mono text-[10px] font-medium tracking-wider text-muted-foreground uppercase">
                    {metric.label}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
