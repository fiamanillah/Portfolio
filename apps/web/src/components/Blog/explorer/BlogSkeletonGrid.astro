---
interface Props {
  count?: number
  class?: string
}

const { count = 6, class: className = "" } = Astro.props
const skeletonCards = Array.from({ length: count }, (_, i) => i)
---

<div
  data-skeleton-grid
  aria-hidden="true"
  class={`overflow-hidden border border-border bg-card/60 backdrop-blur-sm transition-opacity duration-200 ${className}`}
>
  <div class="grid grid-cols-1 md:grid-cols-2">
    {
      skeletonCards.map((_, index) => {
        const isLeftCol = index % 2 === 0
        const isLastRow =
          index >=
          skeletonCards.length - (skeletonCards.length % 2 === 0 ? 2 : 1)
        const isLastMobile = index === skeletonCards.length - 1
        return (
          <div
            class={`relative flex flex-col sm:flex-row items-stretch overflow-hidden animate-pulse border-border ${
              !isLastMobile ? "border-b" : "border-b-0"
            } ${isLeftCol ? "md:border-r" : "md:border-r-0"} ${
              isLastRow ? "md:border-b-0" : "md:border-b"
            }`}
          >
            {/* Cyberpunk corner bracket skeletons on all 4 corners */}
            <div class="pointer-events-none absolute top-2 left-2 z-20 h-2.5 w-2.5 border-t-[1.5px] border-l-[1.5px] border-border/40" />
            <div class="pointer-events-none absolute top-2 right-2 z-20 h-2.5 w-2.5 border-t-[1.5px] border-r-[1.5px] border-border/40" />
            <div class="pointer-events-none absolute bottom-2 left-2 z-20 h-2.5 w-2.5 border-b-[1.5px] border-l-[1.5px] border-border/40" />
            <div class="pointer-events-none absolute right-2 bottom-2 z-20 h-2.5 w-2.5 border-r-[1.5px] border-b-[1.5px] border-border/40" />

            {/* Thumbnail Skeleton (16:9) */}
            <div class="relative aspect-[16/9] w-full sm:w-[160px] md:w-[155px] lg:w-[185px] xl:w-[200px] shrink-0 overflow-hidden border-b sm:border-b-0 sm:border-r border-border bg-muted/40" />

            {/* Content Skeleton */}
            <div class="flex flex-1 flex-col justify-between p-4 sm:p-5 min-w-0">
              <div class="space-y-2.5">
                {/* Category & Date */}
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class="h-3 w-16 rounded-xs bg-muted/60" />
                    <div class="h-3 w-1.5 rounded-xs bg-muted/30" />
                    <div class="h-3 w-20 rounded-xs bg-muted/50" />
                  </div>
                  <div class="h-2.5 w-12 rounded-xs bg-muted/40" />
                </div>

                {/* Title */}
                <div class="space-y-1.5 pt-1">
                  <div class="h-4 w-full rounded-xs bg-muted/70" />
                  <div class="h-4 w-3/4 rounded-xs bg-muted/70" />
                </div>

                {/* Excerpt */}
                <div class="space-y-1 pt-1">
                  <div class="h-3 w-full rounded-xs bg-muted/40" />
                  <div class="h-3 w-4/5 rounded-xs bg-muted/40" />
                </div>

                {/* Tags skeleton */}
                <div class="flex gap-1.5 pt-1">
                  <div class="h-3.5 w-12 rounded-xs bg-muted/40" />
                  <div class="h-3.5 w-14 rounded-xs bg-muted/40" />
                </div>
              </div>

              {/* Author & Stats Footer */}
              <div class="mt-3.5 flex items-center justify-between border-t border-border/40 pt-2.5">
                <div class="flex items-center gap-2">
                  <div class="h-5 w-5 shrink-0 rounded-full bg-muted/60" />
                  <div class="h-3 w-20 rounded-xs bg-muted/60" />
                </div>
                <div class="flex items-center gap-2">
                  <div class="h-3 w-8 rounded-xs bg-muted/50" />
                  <div class="h-3 w-8 rounded-xs bg-muted/50" />
                </div>
              </div>
            </div>
          </div>
        )
      })
    }
  </div>
</div>
