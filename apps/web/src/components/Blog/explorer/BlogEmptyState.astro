---
import { Icon } from "astro-icon/components"

interface Props {
  popularCategories?: string[]
  class?: string
}

const {
  popularCategories = ["Architecture", "Database", "Performance", "DevOps", "WebSockets", "Security"],
  class: className = "",
} = Astro.props
---

<div
  data-empty-state
  class={`relative my-12 hidden overflow-hidden border border-dashed border-border/80 bg-background/40 p-8 sm:p-12 text-center backdrop-blur-sm transition-all duration-300 ${className}`}
>
  {/* Cyberpunk corner brackets */}
  <div class="pointer-events-none absolute top-2 left-2 h-3.5 w-3.5 border-t-[1.5px] border-l-[1.5px] border-border" />
  <div class="pointer-events-none absolute top-2 right-2 h-3.5 w-3.5 border-t-[1.5px] border-r-[1.5px] border-border" />
  <div class="pointer-events-none absolute bottom-2 left-2 h-3.5 w-3.5 border-b-[1.5px] border-l-[1.5px] border-border" />
  <div class="pointer-events-none absolute right-2 bottom-2 h-3.5 w-3.5 border-r-[1.5px] border-b-[1.5px] border-border" />

  <div class="mx-auto flex max-w-md flex-col items-center">
    {/* Icon with glowing pulse ring */}
    <div class="relative mb-5 flex h-16 w-16 items-center justify-center rounded-none border border-primary/30 bg-primary/10 text-primary shadow-[0_0_24px_oklch(var(--primary)/20%)]">
      <Icon name="mdi:file-search-outline" class="size-8" />
      <span class="absolute -top-1 -right-1 flex h-3 w-3">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-75"></span>
        <span class="relative inline-flex h-3 w-3 rounded-full bg-primary"></span>
      </span>
    </div>

    {/* Terminal Code Status */}
    <span class="inline-flex items-center gap-1.5 border border-border bg-muted/60 px-2.5 py-0.5 font-mono text-[10px] font-semibold text-muted-foreground uppercase">
      <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
      404 // NO_ARTICLES_FOUND
    </span>

    {/* Heading */}
    <h3 class="mt-4 font-mono text-lg font-bold tracking-tight text-foreground sm:text-xl">
      No Articles Matched
    </h3>

    {/* Dynamic Category Text Description */}
    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
      No published posts found under category <span data-empty-category-name class="font-mono font-semibold text-primary">"all"</span>.
      Try choosing another topic or reset the category filter.
    </p>

    {/* Action: Reset Filter */}
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <button
        type="button"
        data-reset-filter-btn
        class="inline-flex items-center gap-2 border border-primary bg-primary px-4 py-2 font-mono text-xs font-bold text-primary-foreground shadow-sm transition-all duration-200 hover:bg-primary/90 hover:shadow-[0_0_16px_oklch(var(--primary)/30%)] cursor-pointer"
      >
        <Icon name="mdi:refresh" class="size-4" />
        <span>View All Articles</span>
      </button>
    </div>

    {/* Quick Jump Suggestions */}
    {
      popularCategories.length > 0 && (
        <div class="mt-8 w-full border-t border-border/50 pt-5">
          <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground/80">
            Suggested Categories:
          </span>
          <div class="mt-2.5 flex flex-wrap items-center justify-center gap-1.5">
            {popularCategories.map((cat) => (
              <button
                type="button"
                data-empty-category-chip={cat}
                class="border border-border/80 bg-background/60 px-2.5 py-1 font-mono text-[11px] text-muted-foreground transition-all duration-200 hover:border-primary/50 hover:text-primary hover:bg-primary/5 cursor-pointer"
              >
                #{cat}
              </button>
            ))}
          </div>
        </div>
      )
    }
  </div>
</div>
