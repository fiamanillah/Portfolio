---
import type { BlogPost } from "@/data/blogPosts"
import BlogFilterBar from "./BlogFilterBar.astro"
import BlogGridHeader from "./BlogGridHeader.astro"
import BlogSkeletonGrid from "./BlogSkeletonGrid.astro"
import BlogCard from "@/components/Blog/cards/BlogCard.astro"
import BlogEmptyState from "./BlogEmptyState.astro"
import BlogPaginationBar from "./BlogPaginationBar.astro"

interface Props {
  initialPosts?: BlogPost[]
  posts?: BlogPost[]
  categories: { name: string; count: number }[]
  postsPerPage?: number
}

const {
  initialPosts,
  posts = initialPosts || [],
  categories = [],
  postsPerPage = 6,
} = Astro.props

const totalCount = posts.length
const initialTotalPages = Math.max(1, Math.ceil(totalCount / postsPerPage))
const popularCategoryNames = categories
  .filter((c) => c.name.toLowerCase() !== "all")
  .map((c) => c.name)
---

<div
  id="blog-grid-top"
  class="w-full"
  data-blog-explorer
  data-posts-per-page={postsPerPage}
>
  <!-- 1. Accessible Category Filter & Real-Time Search Bar -->
  <BlogFilterBar categories={categories} activeCategory="all" />

  <!-- 2. Grid Results Header with Live Counter & Category Indicator -->
  <BlogGridHeader
    totalCount={totalCount}
    postsPerPage={postsPerPage}
    activeCategory="all"
  />

  <!-- 3. Skeleton Loading State (animated shimmer during category/search/page transitions) -->
  <div data-loading-container class="hidden">
    <BlogSkeletonGrid count={postsPerPage} />
  </div>

  <!-- 4. Cards Grid Container (3-Column Responsive Grid) -->
  <div
    data-cards-container
    class="transition-opacity duration-200"
  >
    <div
      data-cards-grid
      class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        posts.map((post, index) => {
          return (
            <BlogCard
              post={post}
              isInitiallyVisible={index < postsPerPage}
              class="border border-border"
            />
          )
        })
      }
    </div>
  </div>

  <!-- 5. Rich Empty State -->
  <BlogEmptyState popularCategories={popularCategoryNames} />

  <!-- 6. Pagination Bar -->
  <BlogPaginationBar initialTotalPages={initialTotalPages} />
</div>

<script>
  function initBlogExplorer() {
    const explorer = document.querySelector<HTMLElement>("[data-blog-explorer]")
    if (!explorer) return

    const postsPerPage = parseInt(explorer.dataset.postsPerPage || "6", 10)
    const cards = Array.from(
      explorer.querySelectorAll<HTMLElement>("[data-blog-card]")
    )
    const categoryBtns = Array.from(
      explorer.querySelectorAll<HTMLButtonElement>("[data-category-btn]")
    )
    const searchInput = explorer.querySelector<HTMLInputElement>(
      "[data-blog-search-input]"
    )
    const searchClearBtn = explorer.querySelector<HTMLButtonElement>(
      "[data-blog-search-clear]"
    )
    const journalTitle = explorer.querySelector<HTMLElement>(
      "[data-journal-title]"
    )
    const activeCategoryText = explorer.querySelector<HTMLElement>(
      "[data-active-category-text]"
    )
    const showingCount = explorer.querySelector<HTMLElement>(
      "[data-showing-count]"
    )
    const cardsContainer = explorer.querySelector<HTMLElement>(
      "[data-cards-container]"
    )
    const loadingContainer = explorer.querySelector<HTMLElement>(
      "[data-loading-container]"
    )
    const emptyState = explorer.querySelector<HTMLElement>("[data-empty-state]")
    const emptyCategoryName = explorer.querySelector<HTMLElement>(
      "[data-empty-category-name]"
    )
    const resetBtn = explorer.querySelector<HTMLButtonElement>(
      "[data-reset-filter-btn]"
    )
    const emptyCategoryChips = Array.from(
      explorer.querySelectorAll<HTMLButtonElement>("[data-empty-category-chip]")
    )
    const paginationBar = explorer.querySelector<HTMLElement>(
      "[data-pagination-bar]"
    )
    const currentPageNum = explorer.querySelector<HTMLElement>(
      "[data-current-page-num]"
    )
    const totalPagesNum = explorer.querySelector<HTMLElement>(
      "[data-total-pages-num]"
    )
    const prevBtn = explorer.querySelector<HTMLButtonElement>(
      "[data-pagination-prev]"
    )
    const nextBtn = explorer.querySelector<HTMLButtonElement>(
      "[data-pagination-next]"
    )
    const pageNumbersContainer = explorer.querySelector<HTMLElement>(
      "[data-page-numbers]"
    )

    // Check URL search params on load
    const urlParams = new URLSearchParams(window.location.search)
    let activeCategory = (urlParams.get("category") || "all").toLowerCase()
    let searchQuery = (urlParams.get("q") || "").trim().toLowerCase()
    let currentPage = parseInt(urlParams.get("page") || "1", 10) || 1
    let transitionTimer: ReturnType<typeof setTimeout> | null = null

    if (searchInput && searchQuery) {
      searchInput.value = searchQuery
      if (searchClearBtn) searchClearBtn.classList.remove("hidden")
    }

    function syncUrl() {
      const url = new URL(window.location.href)
      if (activeCategory === "all") {
        url.searchParams.delete("category")
      } else {
        url.searchParams.set("category", activeCategory)
      }

      if (searchQuery) {
        url.searchParams.set("q", searchQuery)
      } else {
        url.searchParams.delete("q")
      }

      if (currentPage > 1) {
        url.searchParams.set("page", String(currentPage))
      } else {
        url.searchParams.delete("page")
      }

      window.history.replaceState({}, "", url.toString())
    }

    function performUpdate(targetPage = 1, shouldScroll = false) {
      // 1. Filter matching cards by both category and query string
      const matchingCards = cards.filter((card) => {
        const cardCat = (card.dataset.category || "").toLowerCase()
        const cardTitle = (card.dataset.title || "").toLowerCase()
        const cardSummary = (card.dataset.summary || "").toLowerCase()
        const cardTags = (card.dataset.tags || "").toLowerCase()

        const matchesCategory =
          activeCategory === "all" || cardCat === activeCategory

        const matchesQuery =
          !searchQuery ||
          cardTitle.includes(searchQuery) ||
          cardSummary.includes(searchQuery) ||
          cardTags.includes(searchQuery)

        return matchesCategory && matchesQuery
      })

      const totalCount = matchingCards.length
      const totalPages = Math.max(1, Math.ceil(totalCount / postsPerPage))
      currentPage = Math.max(1, Math.min(targetPage, totalPages))

      const startIndex = (currentPage - 1) * postsPerPage
      const endIndex = startIndex + postsPerPage
      const visibleCards = matchingCards.slice(startIndex, endIndex)

      // 2. Show / hide cards and apply 0-gap border classes
      cards.forEach((card) => {
        const isVisible = visibleCards.includes(card)
        if (!isVisible) {
          card.classList.add("hidden")
          card.classList.remove("flex")
          return
        }

        const idx = visibleCards.indexOf(card)
        card.classList.remove("hidden")
        card.classList.add("flex")
      })

      // 3. Update Category button states & ARIA
      categoryBtns.forEach((btn) => {
        const catName = (btn.dataset.categoryName || "").toLowerCase()
        const isAll = catName === "all"
        const isActive =
          catName === activeCategory || (isAll && activeCategory === "all")
        const countSpan = btn.querySelector<HTMLElement>(
          "[data-category-count]"
        )

        btn.setAttribute("aria-selected", isActive ? "true" : "false")
        btn.setAttribute("tabindex", isActive ? "0" : "-1")

        if (isActive) {
          btn.className =
            "group/btn category-btn flex items-center gap-2 border px-3.5 py-1.5 font-mono text-xs transition-all duration-200 cursor-pointer select-none rounded-none active border-primary bg-primary/10 text-primary font-bold shadow-[0_0_14px_oklch(var(--primary)/20%)] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary"
          if (countSpan) {
            countSpan.className =
              "inline-flex h-4 min-w-[1.25rem] items-center justify-center rounded-xs px-1.5 font-mono text-[10px] bg-primary text-primary-foreground font-bold"
          }
        } else {
          btn.className =
            "group/btn category-btn flex items-center gap-2 border px-3.5 py-1.5 font-mono text-xs transition-all duration-200 cursor-pointer select-none rounded-none border-border bg-background/50 text-muted-foreground hover:border-primary/40 hover:text-foreground hover:bg-background/80 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary"
          if (countSpan) {
            countSpan.className =
              "inline-flex h-4 min-w-[1.25rem] items-center justify-center rounded-xs px-1.5 font-mono text-[10px] bg-muted text-muted-foreground group-hover/btn:text-foreground group-hover/btn:bg-muted/80"
          }
        }
      })

      // 4. Update Header counts & title
      if (journalTitle) {
        if (searchQuery) {
          journalTitle.innerHTML = `Search <span class="text-primary">/</span> Results`
        } else if (activeCategory !== "all") {
          journalTitle.innerHTML = `${activeCategory.charAt(0).toUpperCase() + activeCategory.slice(1)} <span class="text-primary">/</span> Stories`
        } else {
          journalTitle.innerHTML = `All <span class="text-primary">/</span> Tech Articles & Stories`
        }
      }

      if (activeCategoryText) {
        activeCategoryText.textContent = searchQuery
          ? `SEARCH: ${searchQuery}`
          : activeCategory.toUpperCase()
      }

      if (showingCount) {
        if (totalCount > 0) {
          const from = startIndex + 1
          const to = Math.min(endIndex, totalCount)
          showingCount.textContent = `SHOWING ${from}-${to} OF ${totalCount} ARTICLES`
        } else {
          showingCount.textContent = `0 ARTICLES AVAILABLE`
        }
      }

      // 5. Empty State Handling
      if (totalCount === 0) {
        if (cardsContainer) cardsContainer.classList.add("hidden")
        if (emptyState) {
          emptyState.classList.remove("hidden")
          if (emptyCategoryName) {
            emptyCategoryName.textContent = searchQuery
              ? `query "${searchQuery}" in ${activeCategory}`
              : `category "${activeCategory}"`
          }
        }
      } else {
        if (cardsContainer) cardsContainer.classList.remove("hidden")
        if (emptyState) emptyState.classList.add("hidden")
      }

      // 6. Pagination UI
      if (paginationBar) {
        if (totalPages <= 1) {
          paginationBar.classList.add("hidden")
          paginationBar.classList.remove("flex")
        } else {
          paginationBar.classList.remove("hidden")
          paginationBar.classList.add("flex")
        }
      }

      if (currentPageNum) currentPageNum.textContent = String(currentPage)
      if (totalPagesNum) totalPagesNum.textContent = String(totalPages)

      // Prev / Next button states
      if (prevBtn) {
        if (currentPage <= 1) {
          prevBtn.disabled = true
          prevBtn.className =
            "inline-flex items-center gap-1 border border-border bg-background px-3 py-1.5 font-mono text-xs transition-colors cursor-not-allowed opacity-40 select-none"
        } else {
          prevBtn.disabled = false
          prevBtn.className =
            "inline-flex items-center gap-1 border border-border bg-background px-3 py-1.5 font-mono text-xs transition-colors cursor-pointer select-none hover:border-primary hover:text-primary"
        }
      }

      if (nextBtn) {
        if (currentPage >= totalPages) {
          nextBtn.disabled = true
          nextBtn.className =
            "inline-flex items-center gap-1 border border-border bg-background px-3 py-1.5 font-mono text-xs transition-colors cursor-not-allowed opacity-40 select-none"
        } else {
          nextBtn.disabled = false
          nextBtn.className =
            "inline-flex items-center gap-1 border border-border bg-background px-3 py-1.5 font-mono text-xs transition-colors cursor-pointer select-none hover:border-primary hover:text-primary"
        }
      }

      // Render page numbers
      if (pageNumbersContainer) {
        pageNumbersContainer.innerHTML = ""
        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement("button")
          btn.type = "button"
          btn.dataset.pageBtn = String(i)
          btn.textContent = String(i)
          btn.setAttribute("aria-label", `Go to page ${i}`)
          if (i === currentPage) {
            btn.setAttribute("aria-current", "page")
            btn.className =
              "h-8 w-8 font-mono text-xs transition-colors cursor-pointer select-none bg-primary text-primary-foreground font-bold shadow-xs"
          } else {
            btn.className =
              "h-8 w-8 font-mono text-xs transition-colors cursor-pointer select-none border border-border bg-background text-muted-foreground hover:border-primary hover:text-primary"
          }
          btn.addEventListener("click", (e) => {
            e.preventDefault()
            e.stopPropagation()
            updateView(i, true, false)
          })
          pageNumbersContainer.appendChild(btn)
        }
      }

      // Hide loading skeleton and reveal cards grid
      if (loadingContainer) loadingContainer.classList.add("hidden")
      if (cardsContainer && totalCount > 0) {
        cardsContainer.classList.remove("opacity-0")
      }

      syncUrl()

      // Scroll to top of explorer grid
      if (shouldScroll) {
        explorer?.scrollIntoView({ behavior: "smooth", block: "start" })
      }
    }

    function updateView(
      targetPage = 1,
      shouldScroll = false,
      withSkeleton = false
    ) {
      if (withSkeleton && loadingContainer && cardsContainer) {
        if (transitionTimer) clearTimeout(transitionTimer)
        loadingContainer.classList.remove("hidden")
        cardsContainer.classList.add("opacity-0")
        if (emptyState) emptyState.classList.add("hidden")

        transitionTimer = setTimeout(() => {
          performUpdate(targetPage, shouldScroll)
        }, 100)
      } else {
        performUpdate(targetPage, shouldScroll)
      }
    }


    function switchCategory(newCategory: string) {
      activeCategory = newCategory.toLowerCase()
      updateView(1, false, true)
    }

    // Attach Category Button Click & Keyboard Navigation
    categoryBtns.forEach((btn, index) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault()
        const cat = (btn.dataset.categoryName || "all").toLowerCase()
        switchCategory(cat)
      })

      btn.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") {
          e.preventDefault()
          const nextIndex = (index + 1) % categoryBtns.length
          categoryBtns[nextIndex]?.focus()
          categoryBtns[nextIndex]?.click()
        } else if (e.key === "ArrowLeft") {
          e.preventDefault()
          const prevIndex =
            (index - 1 + categoryBtns.length) % categoryBtns.length
          categoryBtns[prevIndex]?.focus()
          categoryBtns[prevIndex]?.click()
        } else if (e.key === "Home") {
          e.preventDefault()
          categoryBtns[0]?.focus()
          categoryBtns[0]?.click()
        } else if (e.key === "End") {
          e.preventDefault()
          categoryBtns[categoryBtns.length - 1]?.focus()
          categoryBtns[categoryBtns.length - 1]?.click()
        }
      })
    })

    // Search Input Listener
    if (searchInput) {
      searchInput.addEventListener("input", () => {
        searchQuery = searchInput.value.trim().toLowerCase()
        if (searchClearBtn) {
          if (searchQuery) {
            searchClearBtn.classList.remove("hidden")
          } else {
            searchClearBtn.classList.add("hidden")
          }
        }
        updateView(1, false, false)
      })
    }

    // Search Clear Listener
    if (searchClearBtn && searchInput) {
      searchClearBtn.addEventListener("click", () => {
        searchInput.value = ""
        searchQuery = ""
        searchClearBtn.classList.add("hidden")
        searchInput.focus()
        updateView(1, false, false)
      })
    }

    // Global keyboard shortcut ('/' to focus search, 'Escape' to clear)
    window.addEventListener("keydown", (e) => {
      if (
        e.key === "/" &&
        searchInput &&
        document.activeElement !== searchInput &&
        !["INPUT", "TEXTAREA"].includes(document.activeElement?.tagName || "")
      ) {
        e.preventDefault()
        searchInput.focus()
      } else if (
        searchInput &&
        e.key === "Escape" &&
        document.activeElement === searchInput
      ) {
        if (searchInput.value) {
          searchInput.value = ""
          searchQuery = ""
          searchClearBtn?.classList.add("hidden")
          updateView(1, false, false)
        } else {
          searchInput.blur()
        }
      }
    })

    // Attach Empty State Category Chips
    emptyCategoryChips.forEach((chip) => {
      chip.addEventListener("click", (e) => {
        e.preventDefault()
        const cat = (chip.dataset.emptyCategoryChip || "all").toLowerCase()
        if (searchInput) {
          searchInput.value = ""
          searchQuery = ""
          searchClearBtn?.classList.add("hidden")
        }
        switchCategory(cat)
      })
    })

    // Reset Button Click Handler
    if (resetBtn) {
      resetBtn.addEventListener("click", (e) => {
        e.preventDefault()
        if (searchInput) {
          searchInput.value = ""
          searchQuery = ""
          searchClearBtn?.classList.add("hidden")
        }
        switchCategory("all")
      })
    }

    // Prev / Next Handlers
    if (prevBtn) {
      prevBtn.addEventListener("click", (e) => {
        e.preventDefault()
        if (currentPage > 1) {
          updateView(currentPage - 1, true, false)
        }
      })
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", (e) => {
        e.preventDefault()
        const matchingCardsCount = cards.filter((card) => {
          const cardCat = (card.dataset.category || "").toLowerCase()
          const cardTitle = (card.dataset.title || "").toLowerCase()
          const cardSummary = (card.dataset.summary || "").toLowerCase()
          const cardTags = (card.dataset.tags || "").toLowerCase()
          const matchesCategory =
            activeCategory === "all" || cardCat === activeCategory
          const matchesQuery =
            !searchQuery ||
            cardTitle.includes(searchQuery) ||
            cardSummary.includes(searchQuery) ||
            cardTags.includes(searchQuery)
          return matchesCategory && matchesQuery
        }).length
        const totalPages = Math.max(1, Math.ceil(matchingCardsCount / postsPerPage))
        if (currentPage < totalPages) {
          updateView(currentPage + 1, true, false)
        }
      })
    }

    // Event delegation on explorer for robust click handling
    explorer.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null
      if (!target) return

      const pageBtn = target.closest<HTMLButtonElement>("[data-page-btn]")
      if (pageBtn) {
        e.preventDefault()
        const targetPage = parseInt(pageBtn.dataset.pageBtn || "1", 10)
        if (!isNaN(targetPage) && targetPage !== currentPage) {
          updateView(targetPage, true, false)
        }
      }
    })

    // Browser back/forward navigation sync
    window.addEventListener("popstate", () => {
      const currentUrlParams = new URLSearchParams(window.location.search)
      activeCategory = (currentUrlParams.get("category") || "all").toLowerCase()
      searchQuery = (currentUrlParams.get("q") || "").trim().toLowerCase()
      currentPage = parseInt(currentUrlParams.get("page") || "1", 10) || 1
      if (searchInput) {
        searchInput.value = searchQuery
        if (searchClearBtn) {
          if (searchQuery) searchClearBtn.classList.remove("hidden")
          else searchClearBtn.classList.add("hidden")
        }
      }
      performUpdate(currentPage, false)
    })

    // Initialize immediately on load
    performUpdate(currentPage, false)
  }

  // Setup on initial load and Astro View Transitions
  initBlogExplorer()
  document.addEventListener("astro:page-load", initBlogExplorer)
</script>
