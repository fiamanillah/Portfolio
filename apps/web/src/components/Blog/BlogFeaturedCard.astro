---
import { Badge } from "@workspace/ui/components/badge"
import { Button } from "@workspace/ui/components/button"
import type { BlogPost } from "@/data/blogPosts"

interface Props {
  post: BlogPost
}

const { post } = Astro.props
---

<article
  class="group relative overflow-hidden border border-border bg-background/80 backdrop-blur-md transition-all duration-300 hover:border-primary/50 hover:shadow-[0_0_0_1px_oklch(var(--primary)/20%),0_12px_40px_-12px_oklch(var(--primary)/15%)]"
>
  {/* Cyberpunk corner brackets */}
  <div class="pointer-events-none absolute top-3 left-3 z-30 h-4 w-4 border-t-2 border-l-2 border-border transition-all duration-200 group-hover:h-6 group-hover:w-6 group-hover:border-primary"></div>
  <div class="pointer-events-none absolute top-3 right-3 z-30 h-4 w-4 border-t-2 border-r-2 border-border transition-all duration-200 group-hover:h-6 group-hover:w-6 group-hover:border-primary"></div>
  <div class="pointer-events-none absolute bottom-3 left-3 z-30 h-4 w-4 border-b-2 border-l-2 border-border transition-all duration-200 group-hover:h-6 group-hover:w-6 group-hover:border-primary"></div>
  <div class="pointer-events-none absolute right-3 bottom-3 z-30 h-4 w-4 border-r-2 border-b-2 border-border transition-all duration-200 group-hover:h-6 group-hover:w-6 group-hover:border-primary"></div>

  <div class="grid grid-cols-1 lg:grid-cols-12">
    {/* Left: Thumbnail & Badges (7 cols) */}
    <div class="relative aspect-[16/10] w-full overflow-hidden bg-muted/30 lg:col-span-7 lg:aspect-auto lg:h-full">
      <img
        src={post.thumbnail}
        alt={post.title}
        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
      />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/90 via-background/20 to-transparent lg:bg-gradient-to-r lg:from-transparent lg:via-background/10 lg:to-background/90"></div>

      <div class="absolute top-4 left-4 z-20 flex items-center gap-2">
        <Badge class="bg-primary text-primary-foreground font-mono text-xs font-bold tracking-wider uppercase">
          FEATURED STORY
        </Badge>
        <Badge variant="outline" class="border-primary/40 bg-background/80 font-mono text-xs font-semibold text-primary uppercase backdrop-blur-md">
          {post.category}
        </Badge>
      </div>
    </div>

    {/* Right: Content & Metadata (5 cols) */}
    <div class="flex flex-col justify-between p-6 sm:p-8 lg:col-span-5">
      <div>
        <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-muted-foreground">
          <span>{post.date}</span>
          <span class="text-primary">•</span>
          <span>{post.readTime}</span>
          {post.views && (
            <>
              <span class="text-primary">•</span>
              <span>{post.views} VIEWS</span>
            </>
          )}
        </div>

        <h3 class="mt-4 text-2xl font-black tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary sm:text-3xl">
          <a href={`/blog/${post.slug}`} class="focus:outline-none">
            <span class="absolute inset-0 z-10" aria-hidden="true"></span>
            {post.title}
          </a>
        </h3>

        {post.subtitle && (
          <p class="mt-2 text-sm font-medium text-primary/80">
            {post.subtitle}
          </p>
        )}

        <p class="mt-4 text-sm leading-relaxed text-muted-foreground sm:text-base">
          {post.summary}
        </p>

        <div class="mt-6 flex flex-wrap gap-1.5">
          {post.tags.map((tag) => (
            <Badge variant="secondary" class="font-mono text-xs font-normal">
              #{tag}
            </Badge>
          ))}
        </div>
      </div>

      <div class="relative z-20 mt-8 flex items-center justify-between border-t border-border/80 pt-6">
        <div class="flex items-center gap-3">
          <img
            src={post.author.avatar}
            alt={post.author.name}
            class="h-9 w-9 rounded-full border border-primary/30 object-cover"
          />
          <div>
            <p class="font-mono text-xs font-bold text-foreground">
              {post.author.name}
            </p>
            <p class="text-[11px] text-muted-foreground">
              {post.author.role}
            </p>
          </div>
        </div>

        <a href={`/blog/${post.slug}`} class="inline-block relative z-20">
          <Button
            variant="outline"
            size="default"
            class="gap-2 font-mono text-xs font-semibold tracking-wider text-primary border-primary/40 hover:bg-primary/10"
          >
            Read Article
            <span class="transition-transform duration-200 group-hover:translate-x-1">
              ↗
            </span>
          </Button>
        </a>
      </div>
    </div>
  </div>
</article>
