---
import BlogFeaturedCard from "@/components/Blog/cards/BlogFeaturedCard.astro"
import type { BlogPost } from "@/data/blogPosts"

interface Props {
  featuredPosts: BlogPost[]
}

const { featuredPosts = [] } = Astro.props

const primaryFeatured = featuredPosts[0]
const secondaryFeatured = featuredPosts.slice(1)
---

{
  featuredPosts.length > 0 && (
    <section class="mb-16">
      {/* Section Sub-Header */}
      <div class="mb-6 flex items-center justify-between border-b border-border/60 pb-3">
        <div class="flex items-center gap-2">
          <h2 class="font-mono text-xs font-bold tracking-widest text-primary uppercase">
            // FEATURED STORIES & TOP PICKS ({featuredPosts.length})
          </h2>
        </div>
        <span class="hidden font-mono text-xs text-muted-foreground sm:inline">
          HAND-PICKED ARCHITECTURE WRITEUPS
        </span>
      </div>

      {/* Bento Grid Layout */}
      {featuredPosts.length === 1 ? (
        <BlogFeaturedCard post={primaryFeatured} />
      ) : (
        <div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-12">
          {/* Main Hero Bento Cell (7 cols) */}
          <div class="flex flex-col lg:col-span-7">
            <BlogFeaturedCard post={primaryFeatured} />
          </div>

          {/* Secondary Stacked Bento Column (5 cols) */}
          <div class="flex flex-col justify-between gap-6 lg:col-span-5">
            {secondaryFeatured.map((post) => (
              <article class="group relative flex flex-1 flex-col justify-between overflow-hidden border border-border bg-background/80 p-5 backdrop-blur-md transition-all duration-300 hover:border-primary/50 hover:bg-background/95 hover:shadow-[0_0_0_1px_oklch(var(--primary)/20%),0_8px_24px_-8px_oklch(var(--primary)/12%)]">
                {/* Cyberpunk corner brackets */}
                <div class="pointer-events-none absolute top-2 left-2 z-20 h-3 w-3 border-t border-l border-border transition-all duration-200 group-hover:h-4 group-hover:w-4 group-hover:border-primary" />
                <div class="pointer-events-none absolute top-2 right-2 z-20 h-3 w-3 border-t border-r border-border transition-all duration-200 group-hover:h-4 group-hover:w-4 group-hover:border-primary" />
                <div class="pointer-events-none absolute bottom-2 left-2 z-20 h-3 w-3 border-b border-l border-border transition-all duration-200 group-hover:h-4 group-hover:w-4 group-hover:border-primary" />
                <div class="pointer-events-none absolute right-2 bottom-2 z-20 h-3 w-3 border-r border-b border-border transition-all duration-200 group-hover:h-4 group-hover:w-4 group-hover:border-primary" />

                <div class="grid grid-cols-1 items-center gap-4 sm:grid-cols-12">
                  {/* Thumbnail (5 cols sm) */}
                  <div class="relative aspect-[16/10] w-full overflow-hidden border border-border/60 bg-muted/30 sm:col-span-5">
                    <img
                      src={post.thumbnail}
                      alt={post.title}
                      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                      loading="lazy"
                    />
                    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent" />
                    <div class="absolute top-2 left-2 z-10">
                      <span class="inline-flex items-center border border-primary/40 bg-background/90 px-1.5 py-0.5 font-mono text-[9px] font-semibold text-primary uppercase backdrop-blur-md">
                        {post.category}
                      </span>
                    </div>
                  </div>

                  {/* Content (7 cols sm) */}
                  <div class="flex h-full flex-col justify-between sm:col-span-7">
                    <div>
                      <div class="flex items-center gap-1.5 font-mono text-[10px] tracking-widest text-muted-foreground uppercase">
                        <span>{post.date}</span>
                        <span class="text-primary">•</span>
                        <span>{post.readTime}</span>
                      </div>

                      <h3 class="mt-2 line-clamp-2 text-base font-bold tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary">
                        <a
                          href={`/blog/${post.slug}`}
                          class="focus:outline-none"
                        >
                          <span
                            class="absolute inset-0 z-10"
                            aria-hidden="true"
                          />
                          {post.title}
                        </a>
                      </h3>

                      <p class="mt-1.5 line-clamp-2 text-xs leading-relaxed text-muted-foreground">
                        {post.summary}
                      </p>
                    </div>

                    <div class="relative z-20 mt-3 flex items-center justify-between border-t border-border/60 pt-2.5">
                      <div class="flex min-w-0 items-center gap-2">
                        {post.author.avatar && (
                          <img
                            src={post.author.avatar}
                            alt={post.author.name}
                            class="h-5 w-5 shrink-0 rounded-full border border-primary/30 object-cover"
                          />
                        )}
                        <span class="truncate font-mono text-[11px] font-semibold text-muted-foreground transition-colors group-hover:text-foreground">
                          {post.author.name}
                        </span>
                      </div>

                      <a
                        href={`/blog/${post.slug}`}
                        class="relative z-20 ml-2 inline-block shrink-0"
                      >
                        <button
                          type="button"
                          class="inline-flex h-7 cursor-pointer items-center gap-1 border border-border bg-background px-2.5 font-mono text-[11px] transition-colors hover:border-primary hover:text-primary"
                        >
                          <span>Read</span>
                          <span class="transition-transform duration-200 group-hover:translate-x-0.5">
                            ↗
                          </span>
                        </button>
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      )}
    </section>
  )
}
