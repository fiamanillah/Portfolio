---
import type { BlogPost } from "@/data/blogPosts"
import { formatViewsCount } from "@/data/blogPosts"
import { HugeiconsIcon } from "@hugeicons/react"
import {
  FavouriteIcon,
  Comment01Icon,
  ViewIcon,
} from "@hugeicons/core-free-icons"

interface Props {
  featuredPosts: BlogPost[]
}

const { featuredPosts = [] } = Astro.props

const primaryFeatured = featuredPosts[0]
const secondaryFeatured = featuredPosts.slice(1, 4)
---

{
  featuredPosts.length > 0 && (
    <section class="mb-20">
      {/* Section header — matches site-standard Work.astro pattern */}
      <div class="relative mb-10 overflow-hidden text-center">
        <div
          class="diagonal-stripes pointer-events-none absolute inset-0 z-10 bg-background"
          aria-hidden="true"
        />
        <div class="relative z-10 py-8">
          <p class="section-label">Editor's picks &amp; top reads</p>
          <h2 class="section-title text-foreground">
            Featured <span class="text-primary">/</span> Stories
          </h2>
          <div class="accent-bar mx-auto mt-4 mb-0 w-48" />
        </div>
      </div>

      {/* Grid container — no outer border, gap-px creates dividers */}
      <div class="overflow-hidden border border-border bg-border shadow-sm transition-all duration-300">
        {secondaryFeatured.length === 0 ? (
          /* Single Featured Post Full-Width */
          <article class="group relative flex flex-col lg:flex-row items-stretch overflow-hidden transition-all duration-300 hover:bg-card/90 hover:shadow-[inset_0_0_0_1px_oklch(var(--primary)/35%)]">

            <div class="relative aspect-[16/9] w-full lg:w-3/5 overflow-hidden border-b lg:border-b-0 lg:border-r border-border bg-muted/30 before:pointer-events-none before:absolute before:inset-0 before:z-10 before:bg-[linear-gradient(105deg,transparent_40%,oklch(var(--primary)/15%)_50%,transparent_60%)] before:bg-size-[200%_100%] before:transition-all before:duration-700 hover:before:bg-position-[-100%_0] after:pointer-events-none after:absolute after:inset-0 after:bg-[repeating-linear-gradient(0deg,transparent,transparent_2px,rgba(0,0,0,0.04)_2px,rgba(0,0,0,0.04)_4px)] after:opacity-60 after:transition-opacity after:duration-400 group-hover:after:opacity-0">
              <img
                src={primaryFeatured.thumbnail}
                alt={primaryFeatured.title}
                class="h-full w-full object-cover grayscale-[10%] transition-all duration-700 ease-out group-hover:scale-105 group-hover:grayscale-0"
                loading="eager"
              />
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/70 via-transparent to-transparent lg:bg-gradient-to-r lg:from-transparent lg:to-background/40" />
              <div class="absolute top-3 left-3 z-20">
                <span class="inline-flex items-center gap-1.5 border border-primary/40 bg-background/90 px-2 py-0.5 font-mono text-[9px] font-bold text-primary uppercase shadow-xs backdrop-blur-md">
                  <span class="h-1.5 w-1.5 rounded-full bg-primary shadow-[0_0_6px_oklch(var(--primary))]" />
                  {primaryFeatured.category}
                </span>
              </div>
            </div>
            <div class="flex flex-1 flex-col justify-between p-6 sm:p-8 lg:p-10">
              <div>
                <div class="flex items-center justify-between gap-2 font-mono text-xs tracking-wider text-muted-foreground uppercase">
                  <div class="flex items-center gap-1.5">
                    <span class="text-primary/70">//</span>
                    <span>{primaryFeatured.date}</span>
                  </div>
                  {primaryFeatured.readTime && (
                    <span class="rounded-xs border border-border/80 bg-muted/40 px-1.5 py-0.5 font-mono text-[9px] text-muted-foreground">
                      {primaryFeatured.readTime}
                    </span>
                  )}
                </div>

                <h3 class="mt-4 text-2xl font-bold tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary sm:text-3xl lg:text-4xl">
                  <a href={`/blog/${primaryFeatured.slug}`} class="focus:outline-none">
                    <span class="absolute inset-0 z-10" aria-hidden="true" />
                    {primaryFeatured.title}
                  </a>
                </h3>

                <p class="mt-4 text-sm leading-relaxed text-muted-foreground sm:text-base">
                  {primaryFeatured.summary}
                </p>

                {primaryFeatured.tags && primaryFeatured.tags.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {primaryFeatured.tags.map((tag) => (
                      <span class="inline-flex items-center border border-border/80 bg-muted/30 px-2 py-0.5 font-mono text-[10px] font-medium text-muted-foreground transition-colors group-hover:border-primary/40 group-hover:text-foreground">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              {/* Author & Stats Footer */}
              <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-border/50 pt-4">
                <div class="flex items-center gap-3">
                  {primaryFeatured.author.avatar ? (
                    <img
                      src={primaryFeatured.author.avatar}
                      alt={primaryFeatured.author.name}
                      class="h-7 w-7 rounded-full border border-primary/40 object-cover shadow-[0_0_6px_oklch(var(--primary)/20%)]"
                    />
                  ) : (
                    <div class="flex h-7 w-7 items-center justify-center rounded-full border border-primary/40 bg-primary/10 font-mono text-xs font-bold text-primary">
                      {primaryFeatured.author.name.charAt(0)}
                    </div>
                  )}
                  <span class="font-mono text-xs sm:text-sm font-semibold text-foreground transition-colors group-hover:text-primary">
                    {primaryFeatured.author.name}
                  </span>
                </div>

                <div class="flex items-center gap-3 font-mono text-xs">
                  {primaryFeatured.views && (
                    <span class="inline-flex items-center gap-1 text-muted-foreground transition-colors group-hover:text-foreground" title={`${primaryFeatured.views} views`}>
                      <HugeiconsIcon icon={ViewIcon} className="size-3.5 text-primary/70" />
                      <span>{formatViewsCount(primaryFeatured.views)}</span>
                    </span>
                  )}
                  {primaryFeatured.likesCount !== undefined && (
                    <span class="inline-flex items-center gap-1 text-rose-400/80 transition-colors group-hover:text-rose-400" title={`${primaryFeatured.likesCount} likes`}>
                      <HugeiconsIcon icon={FavouriteIcon} className="size-3.5 fill-rose-400/30 text-rose-400" />
                      <span>{primaryFeatured.likesCount}</span>
                    </span>
                  )}
                  {primaryFeatured.commentsCount !== undefined && (
                    <span class="inline-flex items-center gap-1 text-primary/80 transition-colors group-hover:text-primary" title={`${primaryFeatured.commentsCount} comments`}>
                      <HugeiconsIcon icon={Comment01Icon} className="size-3.5" />
                      <span>{primaryFeatured.commentsCount}</span>
                    </span>
                  )}
                  <span class="text-primary transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                    ↗
                  </span>
                </div>
              </div>
            </div>
          </article>
        ) : (
          /* 2-Column Split: Left (Primary) + Right (3 Stacked Rows) */
          <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch">
            {/* Left Column: Primary Featured Post */}
            <article class="group relative flex flex-col justify-between lg:col-span-6 xl:col-span-6 overflow-hidden transition-all duration-300 hover:bg-card/90 hover:shadow-[inset_0_0_0_1px_oklch(var(--primary)/35%)]">

              <div>
                {/* Large landscape thumbnail (16:9) with scanline and shimmer */}
                <div class="relative aspect-[16/9] w-full overflow-hidden border-b border-border bg-muted/30 before:pointer-events-none before:absolute before:inset-0 before:z-10 before:bg-[linear-gradient(105deg,transparent_40%,oklch(var(--primary)/15%)_50%,transparent_60%)] before:bg-size-[200%_100%] before:transition-all before:duration-700 hover:before:bg-position-[-100%_0] after:pointer-events-none after:absolute after:inset-0 after:bg-[repeating-linear-gradient(0deg,transparent,transparent_2px,rgba(0,0,0,0.04)_2px,rgba(0,0,0,0.04)_4px)] after:opacity-60 after:transition-opacity after:duration-400 group-hover:after:opacity-0">
                  <img
                    src={primaryFeatured.thumbnail}
                    alt={primaryFeatured.title}
                    class="h-full w-full object-cover grayscale-[10%] transition-all duration-700 ease-out group-hover:scale-105 group-hover:grayscale-0"
                    loading="eager"
                  />
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/70 via-transparent to-transparent" />
                  <div class="absolute top-3 left-3 z-20">
                    <span class="inline-flex items-center gap-1.5 border border-primary/40 bg-background/90 px-2 py-0.5 font-mono text-[9px] font-bold text-primary uppercase shadow-xs backdrop-blur-md">
                      <span class="h-1.5 w-1.5 rounded-full bg-primary shadow-[0_0_6px_oklch(var(--primary))]" />
                      {primaryFeatured.category}
                    </span>
                  </div>
                </div>

                {/* Primary Content Details */}
                <div class="p-6 sm:p-8">
                  <div class="flex items-center justify-between gap-2 font-mono text-xs tracking-wider text-muted-foreground uppercase">
                    <div class="flex items-center gap-1.5">
                      <span class="text-primary/70">//</span>
                      <span>{primaryFeatured.date}</span>
                    </div>
                    {primaryFeatured.readTime && (
                      <span class="rounded-xs border border-border/80 bg-muted/40 px-1.5 py-0.5 font-mono text-[9px] text-muted-foreground">
                        {primaryFeatured.readTime}
                      </span>
                    )}
                  </div>

                  <h3 class="mt-3 text-xl font-bold tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary sm:text-2xl lg:text-3xl">
                    <a href={`/blog/${primaryFeatured.slug}`} class="focus:outline-none">
                      <span class="absolute inset-0 z-10" aria-hidden="true" />
                      {primaryFeatured.title}
                    </a>
                  </h3>

                  <p class="mt-3 text-sm leading-relaxed text-muted-foreground line-clamp-3">
                    {primaryFeatured.summary}
                  </p>

                  {primaryFeatured.tags && primaryFeatured.tags.length > 0 && (
                    <div class="mt-3.5 flex flex-wrap gap-1">
                      {primaryFeatured.tags.slice(0, 3).map((tag) => (
                        <span class="inline-flex items-center border border-border/80 bg-muted/30 px-1.5 py-0.5 font-mono text-[9px] font-medium text-muted-foreground transition-colors group-hover:border-primary/40 group-hover:text-foreground">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </div>

              {/* Author & Stats at bottom */}
              <div class="p-6 pt-0 sm:p-8 sm:pt-0">
                <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border/50 pt-4">
                  <div class="flex items-center gap-3">
                    {primaryFeatured.author.avatar ? (
                      <img
                        src={primaryFeatured.author.avatar}
                        alt={primaryFeatured.author.name}
                        class="h-6 w-6 rounded-full border border-primary/40 object-cover shadow-[0_0_6px_oklch(var(--primary)/20%)]"
                      />
                    ) : (
                      <div class="flex h-6 w-6 items-center justify-center rounded-full border border-primary/40 bg-primary/10 font-mono text-[10px] font-bold text-primary">
                        {primaryFeatured.author.name.charAt(0)}
                      </div>
                    )}
                    <span class="font-mono text-xs sm:text-sm font-semibold text-foreground transition-colors group-hover:text-primary">
                      {primaryFeatured.author.name}
                    </span>
                  </div>

                  <div class="flex items-center gap-3 font-mono text-xs">
                    {primaryFeatured.views && (
                      <span class="inline-flex items-center gap-1 text-muted-foreground transition-colors group-hover:text-foreground" title={`${primaryFeatured.views} views`}>
                        <HugeiconsIcon icon={ViewIcon} className="size-3.5 text-primary/70" />
                        <span>{formatViewsCount(primaryFeatured.views)}</span>
                      </span>
                    )}
                    {primaryFeatured.likesCount !== undefined && (
                      <span class="inline-flex items-center gap-1 text-rose-400/80 transition-colors group-hover:text-rose-400" title={`${primaryFeatured.likesCount} likes`}>
                        <HugeiconsIcon icon={FavouriteIcon} className="size-3.5 fill-rose-400/30 text-rose-400" />
                        <span>{primaryFeatured.likesCount}</span>
                      </span>
                    )}
                    {primaryFeatured.commentsCount !== undefined && (
                      <span class="inline-flex items-center gap-1 text-primary/80 transition-colors group-hover:text-primary" title={`${primaryFeatured.commentsCount} comments`}>
                        <HugeiconsIcon icon={Comment01Icon} className="size-3.5" />
                        <span>{primaryFeatured.commentsCount}</span>
                      </span>
                    )}
                    <span class="text-primary transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                      ↗
                    </span>
                  </div>
                </div>
              </div>
            </article>

            {/* Right Column: Stacked Secondary Featured Posts */}
            <div class="flex flex-col lg:col-span-6 xl:col-span-6 border-t lg:border-t-0 lg:border-l border-border divide-y divide-border">
              {secondaryFeatured.map((post) => (
                <article class="group relative flex flex-1 flex-col sm:flex-row items-stretch overflow-hidden transition-all duration-300 hover:bg-card/90 hover:shadow-[inset_0_0_0_1px_oklch(var(--primary)/35%)]">

                  {/* 16:9 Thumbnail on Left with scanline and shimmer */}
                  <div class="relative aspect-[16/9] w-full sm:w-[150px] md:w-[170px] lg:w-[190px] shrink-0 border-b sm:border-b-0 sm:border-r border-border overflow-hidden bg-muted/30 before:pointer-events-none before:absolute before:inset-0 before:z-10 before:bg-[linear-gradient(105deg,transparent_40%,oklch(var(--primary)/15%)_50%,transparent_60%)] before:bg-size-[200%_100%] before:transition-all before:duration-700 hover:before:bg-position-[-100%_0] after:pointer-events-none after:absolute after:inset-0 after:bg-[repeating-linear-gradient(0deg,transparent,transparent_2px,rgba(0,0,0,0.04)_2px,rgba(0,0,0,0.04)_4px)] after:opacity-60 after:transition-opacity after:duration-400 group-hover:after:opacity-0">
                    <img
                      src={post.thumbnail}
                      alt={post.title}
                      class="h-full w-full object-cover grayscale-[10%] transition-all duration-500 ease-out group-hover:scale-105 group-hover:grayscale-0"
                      loading="lazy"
                    />
                    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/70 via-transparent to-transparent sm:bg-gradient-to-r sm:from-transparent sm:to-background/30" />
                    <div class="absolute top-2 left-2 z-20">
                      <span class="inline-flex items-center gap-1 border border-primary/40 bg-background/90 px-1.5 py-0.5 font-mono text-[9px] font-semibold text-primary uppercase shadow-xs backdrop-blur-md">
                        <span class="h-1 w-1 rounded-full bg-primary shadow-[0_0_4px_oklch(var(--primary))]" />
                        {post.category}
                      </span>
                    </div>
                  </div>

                  {/* Details on Right */}
                  <div class="flex flex-1 flex-col justify-between p-4 sm:p-5 min-w-0">
                    <div>
                      <div class="flex items-center justify-between gap-2 font-mono text-[10px] sm:text-[11px] tracking-wider text-muted-foreground uppercase">
                        <div class="flex items-center min-w-0 truncate gap-1">
                          <span class="text-primary/70">//</span>
                          <span class="truncate">{post.date}</span>
                        </div>
                        {post.readTime && (
                          <span class="shrink-0 rounded-xs border border-border/80 bg-muted/40 px-1.5 py-0.5 font-mono text-[9px] text-muted-foreground">
                            {post.readTime}
                          </span>
                        )}
                      </div>

                      <h4 class="mt-1.5 text-sm sm:text-base font-bold tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary line-clamp-2 leading-snug">
                        <a href={`/blog/${post.slug}`} class="focus:outline-none">
                          <span class="absolute inset-0 z-10" aria-hidden="true" />
                          {post.title}
                        </a>
                      </h4>

                      <p class="mt-1 text-xs leading-relaxed text-muted-foreground line-clamp-2">
                        {post.summary}
                      </p>

                      {post.tags && post.tags.length > 0 && (
                        <div class="mt-2 flex flex-wrap gap-1">
                          {post.tags.slice(0, 2).map((tag) => (
                            <span class="inline-flex items-center border border-border/80 bg-muted/30 px-1.5 py-0.5 font-mono text-[9px] font-medium text-muted-foreground transition-colors group-hover:border-primary/40 group-hover:text-foreground">
                              #{tag}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>

                    {/* Author & Stats Footer */}
                    <div class="mt-3 flex items-center justify-between gap-2 border-t border-border/50 pt-2">
                      <div class="flex min-w-0 items-center gap-2">
                        {post.author.avatar ? (
                          <img
                            src={post.author.avatar}
                            alt={post.author.name}
                            class="h-4.5 w-4.5 rounded-full border border-primary/40 object-cover shadow-[0_0_4px_oklch(var(--primary)/20%)]"
                          />
                        ) : (
                          <div class="flex h-4.5 w-4.5 items-center justify-center rounded-full border border-primary/40 bg-primary/10 font-mono text-[9px] font-bold text-primary">
                            {post.author.name.charAt(0)}
                          </div>
                        )}
                        <span class="font-mono text-xs font-semibold text-foreground transition-colors group-hover:text-primary truncate">
                          {post.author.name}
                        </span>
                      </div>

                      <div class="flex items-center gap-2 font-mono text-[10px]">
                        {post.views && (
                          <span class="inline-flex items-center gap-1 text-muted-foreground transition-colors group-hover:text-foreground" title={`${post.views} views`}>
                            <HugeiconsIcon icon={ViewIcon} className="size-3 text-primary/70" />
                            <span>{formatViewsCount(post.views)}</span>
                          </span>
                        )}
                        {post.likesCount !== undefined && (
                          <span class="inline-flex items-center gap-1 text-rose-400/80 transition-colors group-hover:text-rose-400" title={`${post.likesCount} likes`}>
                            <HugeiconsIcon icon={FavouriteIcon} className="size-3 fill-rose-400/30 text-rose-400" />
                            <span>{post.likesCount}</span>
                          </span>
                        )}
                        {post.commentsCount !== undefined && (
                          <span class="inline-flex items-center gap-1 text-primary/80 transition-colors group-hover:text-primary" title={`${post.commentsCount} comments`}>
                            <HugeiconsIcon icon={Comment01Icon} className="size-3" />
                            <span>{post.commentsCount}</span>
                          </span>
                        )}
                        <span class="text-primary transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                          ↗
                        </span>
                      </div>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )
}
