---
import { Code } from "astro:components"
import type { ComponentProps } from "astro/types"

type CodeLang = ComponentProps<typeof Code>["lang"]

interface Props {
  code: string
  language?: string
  lang?: string
  title?: string
  wrap?: boolean
  class?: string
}

const {
  code,
  language = "typescript",
  lang,
  title,
  wrap = false,
  class: className = "",
} = Astro.props

const rawLang = (lang || language || "text").toLowerCase().trim()

// Language normalization and alias mapping for Shiki
const languageMap: Record<string, string> = {
  // Web & Frontend
  ts: "typescript",
  typescript: "typescript",
  js: "javascript",
  javascript: "javascript",
  jsx: "jsx",
  tsx: "tsx",
  mjs: "javascript",
  cjs: "javascript",
  html: "html",
  htm: "html",
  css: "css",
  scss: "scss",
  sass: "sass",
  less: "less",
  astro: "astro",
  svelte: "svelte",
  vue: "vue",
  vuejs: "vue",

  // Backend & Systems
  py: "python",
  python: "python",
  python3: "python",
  rs: "rust",
  rust: "rust",
  go: "go",
  golang: "go",
  c: "c",
  cpp: "cpp",
  "c++": "cpp",
  cc: "cpp",
  csharp: "csharp",
  cs: "csharp",
  "c#": "csharp",
  java: "java",
  kt: "kotlin",
  kotlin: "kotlin",
  swift: "swift",
  php: "php",
  ruby: "ruby",
  rb: "ruby",
  dart: "dart",
  zig: "zig",
  lua: "lua",
  r: "r",
  scala: "scala",
  elixir: "elixir",
  erlang: "erlang",
  haskell: "haskell",
  hs: "haskell",
  clojure: "clojure",
  clj: "clojure",
  solidity: "solidity",
  sol: "solidity",

  // Data & Config Formats
  json: "json",
  jsonc: "jsonc",
  json5: "json5",
  yaml: "yaml",
  yml: "yaml",
  toml: "toml",
  xml: "xml",
  svg: "xml",
  ini: "ini",
  env: "ini",
  dotenv: "ini",
  csv: "csv",

  // Database & Query Languages
  sql: "sql",
  mysql: "sql",
  pgsql: "sql",
  postgres: "sql",
  postgresql: "sql",
  sqlite: "sql",
  prisma: "prisma",
  graphql: "graphql",
  gql: "graphql",
  proto: "proto",
  protobuf: "proto",

  // Shell, Scripting & DevOps
  bash: "bash",
  sh: "bash",
  shell: "bash",
  zsh: "bash",
  powershell: "powershell",
  ps1: "powershell",
  pwsh: "powershell",
  bat: "bat",
  cmd: "bat",
  docker: "dockerfile",
  dockerfile: "dockerfile",
  "docker-compose": "yaml",
  terraform: "terraform",
  tf: "terraform",
  hcl: "terraform",
  nginx: "nginx",
  caddy: "nginx",
  caddyfile: "nginx",
  makefile: "makefile",
  make: "makefile",
  cmake: "cmake",

  // Documentation & Text
  md: "markdown",
  markdown: "markdown",
  mdx: "mdx",
  diff: "diff",
  git: "diff",
  txt: "plaintext",
  text: "plaintext",
  plaintext: "plaintext",
}

// List of known built-in Shiki languages to prevent runtime/build fallback errors
const shikiKnownLanguages = new Set([
  "astro",
  "bash",
  "bat",
  "c",
  "clojure",
  "cmake",
  "cpp",
  "csharp",
  "css",
  "csv",
  "dart",
  "diff",
  "dockerfile",
  "elixir",
  "erlang",
  "go",
  "graphql",
  "haskell",
  "html",
  "ini",
  "java",
  "javascript",
  "json",
  "json5",
  "jsonc",
  "jsx",
  "kotlin",
  "less",
  "lua",
  "makefile",
  "markdown",
  "mdx",
  "nginx",
  "php",
  "plaintext",
  "powershell",
  "prisma",
  "proto",
  "python",
  "r",
  "ruby",
  "rust",
  "sass",
  "scala",
  "scss",
  "solidity",
  "sql",
  "svelte",
  "swift",
  "terraform",
  "toml",
  "tsx",
  "typescript",
  "vue",
  "xml",
  "yaml",
  "zig",
])

const targetLang = languageMap[rawLang] || rawLang
const normalizedLang = shikiKnownLanguages.has(targetLang)
  ? targetLang
  : "plaintext"

// Clean, formatted display labels for the header badge
const displayLabels: Record<string, string> = {
  typescript: "TypeScript",
  javascript: "JavaScript",
  jsx: "JSX",
  tsx: "TSX",
  html: "HTML",
  css: "CSS",
  scss: "SCSS",
  sass: "Sass",
  less: "Less",
  astro: "Astro",
  svelte: "Svelte",
  vue: "Vue",
  python: "Python",
  rust: "Rust",
  go: "Go",
  c: "C",
  cpp: "C++",
  csharp: "C#",
  java: "Java",
  kotlin: "Kotlin",
  swift: "Swift",
  php: "PHP",
  ruby: "Ruby",
  dart: "Dart",
  zig: "Zig",
  lua: "Lua",
  r: "R",
  scala: "Scala",
  elixir: "Elixir",
  erlang: "Erlang",
  haskell: "Haskell",
  clojure: "Clojure",
  solidity: "Solidity",
  json: "JSON",
  jsonc: "JSONC",
  json5: "JSON5",
  yaml: "YAML",
  toml: "TOML",
  xml: "XML",
  svg: "SVG",
  ini: "INI",
  env: "ENV",
  dotenv: "ENV",
  sql: "SQL",
  mysql: "MySQL",
  postgres: "PostgreSQL",
  postgresql: "PostgreSQL",
  prisma: "Prisma",
  graphql: "GraphQL",
  proto: "Protobuf",
  protobuf: "Protobuf",
  bash: "Bash",
  sh: "Shell",
  shell: "Shell",
  zsh: "Zsh",
  powershell: "PowerShell",
  dockerfile: "Dockerfile",
  docker: "Docker",
  "docker-compose": "Docker Compose",
  terraform: "Terraform",
  nginx: "Nginx",
  caddy: "Caddy",
  caddyfile: "Caddyfile",
  makefile: "Makefile",
  cmake: "CMake",
  markdown: "Markdown",
  mdx: "MDX",
  diff: "Diff",
  plaintext: "Plain Text",
  text: "Plain Text",
}

const displayBadge =
  displayLabels[rawLang] ||
  displayLabels[normalizedLang] ||
  rawLang.toUpperCase()
---

<div
  class={`code-block-container relative my-6 overflow-hidden rounded-md border shadow-lg transition-all duration-200 ${className}`}
>
  <!-- Terminal Header -->
  <div
    class="code-header flex items-center justify-between border-b px-4 py-2 font-mono text-xs select-none"
  >
    <!-- Left: Terminal Dots & Status -->
    <div class="flex items-center gap-2">
      <div class="flex items-center gap-1.5">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-red-500/70"
        ></span>
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-amber-500/70"
        ></span>
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-emerald-500/70"
        ></span>
      </div>
      {
        title && (
          <span class="ml-2 flex max-w-xs items-center gap-1.5 truncate font-medium text-foreground/80">
            <svg
              class="h-3.5 w-3.5 shrink-0 text-muted-foreground"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
              <polyline points="14 2 14 8 20 8" />
            </svg>
            <span class="truncate">{title}</span>
          </span>
        )
      }
    </div>

    <!-- Right: Language Badge & Copy Button -->
    <div class="flex items-center gap-3">
      <span
        class="rounded border border-primary/20 bg-primary/10 px-2 py-0.5 text-[11px] font-semibold tracking-wider text-primary uppercase"
      >
        {displayBadge}
      </span>
      <button
        type="button"
        class="code-copy-btn inline-flex cursor-pointer items-center gap-1.5 rounded px-2 py-1 text-[11px] font-medium text-muted-foreground transition-all duration-150 hover:bg-primary/10 hover:text-primary"
        data-code={code}
        aria-label="Copy code to clipboard"
      >
        <svg
          class="copy-icon h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
          ></path>
        </svg>
        <svg
          class="check-icon hidden h-3.5 w-3.5 text-emerald-500"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="btn-text">Copy</span>
      </button>
    </div>
  </div>

  <!-- Shiki Highlighted Code Body -->
  <div
    class="code-body-wrapper max-h-[420px] min-h-[50px] overflow-auto text-[13px] leading-relaxed"
  >
    <Code
      code={code.trim()}
      lang={normalizedLang as CodeLang}
      themes={{
        light: "github-light",
        dark: "tokyo-night",
      }}
      wrap={wrap}
    />
  </div>
</div>

<script>
  function initCodeBlockCopyButtons() {
    document.querySelectorAll(".code-copy-btn").forEach((btn) => {
      if (btn.hasAttribute("data-copy-initialized")) return
      btn.setAttribute("data-copy-initialized", "true")

      btn.addEventListener("click", async () => {
        const code = btn.getAttribute("data-code")
        if (!code) return

        try {
          await navigator.clipboard.writeText(code)
          const copyIcon = btn.querySelector(".copy-icon")
          const checkIcon = btn.querySelector(".check-icon")
          const textSpan = btn.querySelector(".btn-text")

          if (copyIcon && checkIcon && textSpan) {
            copyIcon.classList.add("hidden")
            checkIcon.classList.remove("hidden")
            textSpan.textContent = "Copied!"
            btn.classList.add("text-emerald-500")

            setTimeout(() => {
              copyIcon.classList.remove("hidden")
              checkIcon.classList.add("hidden")
              textSpan.textContent = "Copy"
              btn.classList.remove("text-emerald-500")
            }, 2000)
          }
        } catch (err) {
          console.error("Failed to copy code:", err)
        }
      })
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCodeBlockCopyButtons)
  } else {
    initCodeBlockCopyButtons()
  }

  document.addEventListener("astro:page-load", initCodeBlockCopyButtons)
</script>
