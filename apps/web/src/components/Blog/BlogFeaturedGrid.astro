---
import { Badge } from "@workspace/ui/components/badge"
import { Button } from "@workspace/ui/components/button"
import BlogFeaturedCard from "@/components/Blog/BlogFeaturedCard.astro"
import type { BlogPost } from "@/data/blogPosts"

interface Props {
  featuredPosts: BlogPost[]
}

const { featuredPosts = [] } = Astro.props

const primaryFeatured = featuredPosts[0]
const secondaryFeatured = featuredPosts.slice(1)
---

{
  featuredPosts.length > 0 && (
    <section class="mb-16">
      {/* Section Sub-Header (without blinking dot) */}
      <div class="mb-6 flex items-center justify-between border-b border-border/60 pb-3">
        <div class="flex items-center gap-2">
          <h2 class="font-mono text-xs font-bold tracking-widest text-primary uppercase">
            // FEATURED STORIES & TOP PICKS ({featuredPosts.length})
          </h2>
        </div>
        <span class="font-mono text-xs text-muted-foreground hidden sm:inline">
          HAND-PICKED ARCHITECTURE WRITEUPS
        </span>
      </div>

      {/* Bento Grid Layout */}
      {featuredPosts.length === 1 ? (
        <BlogFeaturedCard post={primaryFeatured} />
      ) : (
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 items-stretch">
          {/* Main Hero Bento Cell (7 cols) */}
          <div class="lg:col-span-7 flex flex-col">
            <BlogFeaturedCard post={primaryFeatured} />
          </div>

          {/* Secondary Stacked Bento Column (5 cols) */}
          <div class="lg:col-span-5 flex flex-col gap-6 justify-between">
            {secondaryFeatured.map((post) => (
              <article
                class="group relative flex flex-1 flex-col justify-between overflow-hidden border border-border bg-background/80 p-5 backdrop-blur-md transition-all duration-300 hover:border-primary/50 hover:bg-background/95 hover:shadow-[0_0_0_1px_oklch(var(--primary)/20%),0_8px_24px_-8px_oklch(var(--primary)/12%)]"
              >
                {/* Cyberpunk corner brackets */}
                <div class="pointer-events-none absolute top-2 left-2 z-20 h-3 w-3 border-t border-l border-border transition-all duration-200 group-hover:h-4 group-hover:w-4 group-hover:border-primary" />
                <div class="pointer-events-none absolute top-2 right-2 z-20 h-3 w-3 border-t border-r border-border transition-all duration-200 group-hover:h-4 group-hover:w-4 group-hover:border-primary" />
                <div class="pointer-events-none absolute bottom-2 left-2 z-20 h-3 w-3 border-b border-l border-border transition-all duration-200 group-hover:h-4 group-hover:w-4 group-hover:border-primary" />
                <div class="pointer-events-none absolute right-2 bottom-2 z-20 h-3 w-3 border-r border-b border-border transition-all duration-200 group-hover:h-4 group-hover:w-4 group-hover:border-primary" />

                <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-center">
                  {/* Thumbnail (5 cols sm) */}
                  <div class="relative aspect-[16/10] w-full overflow-hidden bg-muted/30 sm:col-span-5 border border-border/60">
                    <img
                      src={post.thumbnail}
                      alt={post.title}
                      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                      loading="lazy"
                    />
                    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent"></div>
                    <div class="absolute top-2 left-2 z-10">
                      <Badge variant="outline" class="border-primary/40 bg-background/90 font-mono text-[9px] font-semibold text-primary uppercase backdrop-blur-md px-1.5 py-0">
                        {post.category}
                      </Badge>
                    </div>
                  </div>

                  {/* Content (7 cols sm) */}
                  <div class="sm:col-span-7 flex flex-col justify-between h-full">
                    <div>
                      <div class="flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest text-muted-foreground">
                        <span>{post.date}</span>
                        <span class="text-primary">•</span>
                        <span>{post.readTime}</span>
                      </div>

                      <h3 class="mt-2 text-base font-bold tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary line-clamp-2">
                        <a href={`/blog/${post.slug}`} class="focus:outline-none">
                          <span class="absolute inset-0 z-10" aria-hidden="true"></span>
                          {post.title}
                        </a>
                      </h3>

                      <p class="mt-1.5 text-xs text-muted-foreground line-clamp-2 leading-relaxed">
                        {post.summary}
                      </p>
                    </div>

                    <div class="mt-3 relative z-20 flex items-center justify-between border-t border-border/60 pt-2">
                      <span class="font-mono text-[10px] font-semibold text-primary">
                        FEATURED
                      </span>
                      <a href={`/blog/${post.slug}`} class="inline-block relative z-20">
                        <Button
                          variant="outline"
                          size="sm"
                          class="h-7 px-2.5 font-mono text-[11px] gap-1 transition-colors group-hover:border-primary group-hover:text-primary"
                        >
                          Read
                          <span class="transition-transform duration-200 group-hover:translate-x-0.5">↗</span>
                        </Button>
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      )}
    </section>
  )
}
