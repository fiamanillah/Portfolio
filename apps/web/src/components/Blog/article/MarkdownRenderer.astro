---
import { renderMarkdown } from "@/lib/markdown"

interface Props {
  content: string
  class?: string
}

const { content, class: className = "" } = Astro.props

const { html } = await renderMarkdown(content)
---

<div class={`markdown-content max-w-3xl space-y-6 text-foreground/90 leading-relaxed text-base ${className}`} set:html={html} />

<script>
  function initMarkdownInteractions() {
    // 1. Initialize Code Block Copy Buttons
    document.querySelectorAll(".code-copy-btn").forEach((btn) => {
      if (btn.hasAttribute("data-copy-initialized")) return
      btn.setAttribute("data-copy-initialized", "true")

      btn.addEventListener("click", async () => {
        const code = btn.getAttribute("data-code")
        if (!code) return

        try {
          await navigator.clipboard.writeText(code)
          const copyIcon = btn.querySelector(".copy-icon")
          const checkIcon = btn.querySelector(".check-icon")
          const textSpan = btn.querySelector(".btn-text")

          if (copyIcon && checkIcon && textSpan) {
            copyIcon.classList.add("hidden")
            checkIcon.classList.remove("hidden")
            textSpan.textContent = "Copied!"
            btn.classList.add("text-emerald-500")

            setTimeout(() => {
              copyIcon.classList.remove("hidden")
              checkIcon.classList.add("hidden")
              textSpan.textContent = "Copy"
              btn.classList.remove("text-emerald-500")
            }, 2000)
          }
        } catch (err) {
          console.error("Failed to copy code:", err)
        }
      })
    })

    // 2. Smooth scrolling for heading anchor links
    document.querySelectorAll(".heading-anchor").forEach((anchor) => {
      if (anchor.hasAttribute("data-anchor-initialized")) return
      anchor.setAttribute("data-anchor-initialized", "true")

      anchor.addEventListener("click", (e) => {
        const href = anchor.getAttribute("href")
        if (!href || !href.startsWith("#")) return
        const target = document.getElementById(href.slice(1))
        if (target) {
          e.preventDefault()
          target.scrollIntoView({ behavior: "smooth", block: "start" })
          history.replaceState(null, "", href)
        }
      })
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMarkdownInteractions)
  } else {
    initMarkdownInteractions()
  }

  document.addEventListener("astro:page-load", initMarkdownInteractions)
</script>
