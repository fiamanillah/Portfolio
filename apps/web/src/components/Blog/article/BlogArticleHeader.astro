---
import type { BlogPost } from "@/data/blogPosts"
import { getBlogPostPublishedDate, getCategorySlug } from "@/data/blogPosts"
import { ArticleHeaderActions } from "./ArticleHeaderActions"
import { HugeiconsIcon } from "@hugeicons/react"
import {
  Calendar03Icon,
  Time02Icon,
  ViewIcon,
} from "@hugeicons/core-free-icons"
import { webEnv } from "@workspace/env/web"

interface Props {
  post: BlogPost
}

const { post } = Astro.props
const publishedDateIso = getBlogPostPublishedDate(post)
const siteUrl = (
  webEnv.PUBLIC_WEB_URL ||
  import.meta.env.PUBLIC_WEB_URL ||
  Astro.site?.toString() ||
  "https://fi.amanillah.com"
).replace(/\/$/, "")
const articleUrl = `${siteUrl}/blog/${post.slug}`
const catColor =
  post.categoryColor && post.categoryColor.startsWith("#")
    ? post.categoryColor
    : undefined
const categorySlug = getCategorySlug(post.categorySlug || post.category)
---

<header id="article-top" class="border-b border-border/80 pb-8 text-left">
  {/* Category & Featured Badges */}
  <div class="mb-4 flex flex-wrap items-center gap-2">
    <a href={`/blog/category/${categorySlug}`}>
      <span
        style={catColor
          ? {
              borderColor: `${catColor}60`,
              backgroundColor: `${catColor}18`,
              color: catColor,
              boxShadow: `0 0 10px ${catColor}25`,
            }
          : undefined}
        class="inline-flex items-center gap-1.5 border border-primary/40 bg-primary/10 px-2.5 py-1 font-mono text-xs font-semibold text-primary uppercase transition-colors hover:border-primary"
      >
        {
          catColor && (
            <span
              class="h-1.5 w-1.5 shrink-0 rounded-full"
              style={{
                backgroundColor: catColor,
                boxShadow: `0 0 5px ${catColor}`,
              }}
            />
          )
        }
        {post.category}
      </span>
    </a>
    {
      post.featured && (
        <span class="inline-flex items-center bg-primary px-2.5 py-1 font-mono text-xs font-bold text-primary-foreground uppercase shadow-sm">
          FEATURED STORY
        </span>
      )
    }
  </div>

  {/* Main Article Title */}
  <h1
    class="text-3xl leading-[1.15] font-black tracking-tight text-foreground sm:text-4xl lg:text-5xl"
  >
    {post.title}
  </h1>

  {/* Subtitle */}
  {
    post.subtitle && (
      <p class="mt-4 text-base leading-relaxed font-medium text-muted-foreground sm:text-lg">
        {post.subtitle}
      </p>
    )
  }

  {/* Author & Reading Metadata Overview Cockpit */}
  <div
    class="mt-8 overflow-hidden border border-border/80 bg-card/60 backdrop-blur-md"
  >
    {/* Upper Section: Persona & Article Telemetry */}
    <div
      class="flex flex-col gap-4 border-b border-border/50 bg-background/50 p-4 sm:flex-row sm:items-center sm:justify-between sm:p-5"
    >
      {/* Left: Author Profile */}
      <div
        class="flex min-w-0 items-center gap-3.5"
        itemscope
        itemtype="https://schema.org/Person"
      >
        <div class="relative shrink-0">
          <img
            src={post.author.avatar}
            alt={post.author.name}
            class="h-11 w-11 rounded-full border border-primary/40 object-cover shadow-xs"
            itemprop="image"
          />
          <span
            class="absolute -right-0.5 -bottom-0.5 h-3 w-3 rounded-full border-2 border-background bg-emerald-500 shadow-xs"
            title="Author Active"></span>
        </div>
        <div class="flex min-w-0 flex-col">
          <div class="flex items-center gap-2">
            <span
              class="truncate font-mono text-sm font-bold text-foreground"
              itemprop="name"
            >
              {post.author.name}
            </span>
            <span
              class="py-0.2 border border-primary/30 bg-primary/10 px-1.5 font-mono text-[9px] font-bold text-primary uppercase"
            >
              AUTHOR
            </span>
          </div>
          <span
            class="truncate font-mono text-xs text-muted-foreground"
            itemprop="jobTitle"
          >
            {post.author.role}
          </span>
        </div>
      </div>

      {/* Right: Reading Telemetry Specs */}
      <div
        class="flex flex-wrap items-center gap-2 font-mono text-xs text-muted-foreground"
      >
        {/* Publish Date */}
        <div
          class="inline-flex items-center gap-1.5 border border-border/70 bg-background/80 px-2.5 py-1"
          title="Publish Date"
        >
          <HugeiconsIcon
            icon={Calendar03Icon}
            className="size-3 text-primary/80"
          />
          <time datetime={publishedDateIso} class="text-[11px] font-medium"
            >{post.date}</time
          >
        </div>

        {/* Read Time */}
        <div
          class="inline-flex items-center gap-1.5 border border-border/70 bg-background/80 px-2.5 py-1"
          title="Estimated Read Time"
        >
          <HugeiconsIcon icon={Time02Icon} className="size-3 text-primary/80" />
          <span class="text-[11px] font-medium">{post.readTime}</span>
        </div>

        {/* Views */}
        <div
          class="inline-flex items-center gap-1.5 border border-border/70 bg-background/80 px-2.5 py-1"
          title="Total Views"
        >
          <HugeiconsIcon icon={ViewIcon} className="size-3 text-primary/80" />
          <span data-post-views-count class="text-[11px] font-medium"
            >{post.views || "1"} Views</span
          >
        </div>
      </div>
    </div>

    {/* Lower Section: Action Station & Social Hub */}
    <div class="bg-muted/15 px-4 py-3 sm:px-5">
      <ArticleHeaderActions
        client:load
        postSlug={post.slug}
        postTitle={post.title}
        postSummary={post.summary}
        initialLikes={post.likesCount || 0}
        articleUrl={articleUrl}
      />
    </div>
  </div>
</header>
