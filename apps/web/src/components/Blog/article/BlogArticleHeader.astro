---
import type { BlogPost } from "@/data/blogPosts"
import { getBlogPostPublishedDate, getCategorySlug } from "@/data/blogPosts"
import { ArticleHeaderActions } from "./ArticleHeaderActions"
import { HugeiconsIcon } from "@hugeicons/react"
import {
  Calendar03Icon,
  Time02Icon,
  ViewIcon,
} from "@hugeicons/core-free-icons"
import { webEnv } from "@workspace/env/web"

interface Props {
  post: BlogPost
}

const { post } = Astro.props
const publishedDateIso = getBlogPostPublishedDate(post)
const siteUrl = (
  webEnv.PUBLIC_WEB_URL ||
  import.meta.env.PUBLIC_WEB_URL ||
  Astro.site?.toString() ||
  "https://fi.amanillah.com"
).replace(/\/$/, "")
const articleUrl = `${siteUrl}/blog/${post.slug}`
const catColor =
  post.categoryColor && post.categoryColor.startsWith("#")
    ? post.categoryColor
    : undefined
const categorySlug = getCategorySlug(post.categorySlug || post.category)
const authorUsername = post.author.username || "admin"
---

<header
  id="article-top"
  class="border-b border-border/80 pb-6 text-left sm:pb-8"
>
  {/* Category & Featured Badges */}
  <div class="mb-3.5 flex flex-wrap items-center gap-2 sm:mb-4">
    <a href={`/blog/category/${categorySlug}`}>
      <span
        style={catColor
          ? {
              borderColor: `${catColor}60`,
              backgroundColor: `${catColor}18`,
              color: catColor,
              boxShadow: `0 0 10px ${catColor}25`,
            }
          : undefined}
        class="inline-flex items-center gap-1.5 border border-primary/40 bg-primary/10 px-2 py-0.5 font-mono text-[11px] font-semibold text-primary uppercase transition-colors hover:border-primary sm:px-2.5 sm:py-1 sm:text-xs"
      >
        {
          catColor && (
            <span
              class="h-1.5 w-1.5 shrink-0 rounded-full"
              style={{
                backgroundColor: catColor,
                boxShadow: `0 0 5px ${catColor}`,
              }}
            />
          )
        }
        {post.category}
      </span>
    </a>
    {
      post.featured && (
        <span class="inline-flex items-center bg-primary px-2 py-0.5 font-mono text-[11px] font-bold text-primary-foreground uppercase shadow-sm sm:px-2.5 sm:py-1 sm:text-xs">
          FEATURED STORY
        </span>
      )
    }
  </div>

  {/* Main Article Title */}
  <h1
    class="text-2xl leading-tight font-black tracking-tight text-foreground sm:text-4xl sm:leading-[1.15] lg:text-5xl"
  >
    {post.title}
  </h1>

  {/* Subtitle */}
  {
    post.subtitle && (
      <p class="mt-3 text-sm leading-relaxed font-medium text-muted-foreground sm:mt-4 sm:text-base sm:text-lg">
        {post.subtitle}
      </p>
    )
  }

  {/* Author & Reading Metadata Overview Cockpit */}
  <div
    class="mt-6 overflow-hidden border border-border/80 bg-card/60 backdrop-blur-md sm:mt-8"
  >
    {/* Upper Section: Persona & Article Telemetry */}
    <div
      class="flex flex-col gap-3.5 border-b border-border/50 bg-background/50 p-3.5 sm:flex-row sm:items-center sm:justify-between sm:gap-4 sm:p-5"
    >
      {/* Left: Author Profile */}
      <a
        href={`/authors/${authorUsername}`}
        class="group/author flex min-w-0 items-center gap-3 transition-opacity hover:opacity-90 focus:outline-none sm:gap-3.5"
        itemscope
        itemtype="https://schema.org/Person"
      >
        <div class="relative shrink-0">
          <img
            src={post.author.avatar}
            alt={post.author.name}
            class="h-10 w-10 rounded-full border border-primary/40 object-cover shadow-xs transition-transform duration-200 group-hover/author:scale-105 sm:h-11 sm:w-11"
            itemprop="image"
          />
          <span
            class="absolute -right-0.5 -bottom-0.5 h-2.5 w-2.5 rounded-full border-2 border-background bg-emerald-500 shadow-xs sm:h-3 sm:w-3"
            title="Author Active"></span>
        </div>
        <div class="flex min-w-0 flex-col">
          <div class="flex items-center gap-1.5 sm:gap-2">
            <span
              class="truncate font-mono text-xs font-bold text-foreground transition-colors group-hover/author:text-primary sm:text-sm"
              itemprop="name"
            >
              {post.author.name}
            </span>
            <span
              class="border border-primary/30 bg-primary/10 px-1 py-0.5 font-mono text-[8px] font-bold text-primary uppercase sm:px-1.5 sm:text-[9px]"
            >
              AUTHOR
            </span>
          </div>
          <span
            class="truncate font-mono text-[11px] text-muted-foreground sm:text-xs"
            itemprop="jobTitle"
          >
            {post.author.role}
          </span>
        </div>
      </a>

      {/* Right: Reading Telemetry Specs */}
      <div
        class="flex flex-wrap items-center gap-1.5 font-mono text-[11px] text-muted-foreground sm:gap-2 sm:text-xs"
      >
        {/* Publish Date */}
        <div
          class="inline-flex items-center gap-1.5 border border-border/70 bg-background/80 px-2 py-0.5 transition-colors hover:border-border sm:px-2.5 sm:py-1"
          title="Publish Date"
        >
          <HugeiconsIcon
            icon={Calendar03Icon}
            className="size-3 text-primary/80"
          />
          <time
            datetime={publishedDateIso}
            class="text-[10px] font-medium sm:text-[11px]">{post.date}</time
          >
        </div>

        {/* Read Time */}
        <div
          class="inline-flex items-center gap-1.5 border border-border/70 bg-background/80 px-2 py-0.5 transition-colors hover:border-border sm:px-2.5 sm:py-1"
          title="Estimated Read Time"
        >
          <HugeiconsIcon icon={Time02Icon} className="size-3 text-primary/80" />
          <span class="text-[10px] font-medium sm:text-[11px]"
            >{post.readTime}</span
          >
        </div>

        {/* Views */}
        <div
          class="inline-flex items-center gap-1.5 border border-border/70 bg-background/80 px-2 py-0.5 transition-colors hover:border-border sm:px-2.5 sm:py-1"
          title="Total Views"
        >
          <HugeiconsIcon icon={ViewIcon} className="size-3 text-primary/80" />
          <span
            data-post-views-count
            class="text-[10px] font-medium sm:text-[11px]"
            >{post.views || "1"} Views</span
          >
        </div>
      </div>
    </div>

    {/* Lower Section: Action Station & Social Hub */}
    <div class="bg-muted/15 px-3 py-2.5 sm:px-5 sm:py-3">
      <ArticleHeaderActions
        client:load
        postSlug={post.slug}
        postTitle={post.title}
        postSummary={post.summary}
        initialLikes={post.likesCount || 0}
        articleUrl={articleUrl}
      />
    </div>
  </div>
</header>
