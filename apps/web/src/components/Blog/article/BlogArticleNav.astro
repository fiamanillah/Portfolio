---
import type { BlogPost } from "@/data/blogPosts"

interface Props {
  prevPost: BlogPost | null
  nextPost: BlogPost | null
}

const { prevPost, nextPost } = Astro.props
---

{
  (prevPost || nextPost) && (
    <nav
      aria-label="Article Navigation"
      class="my-5 grid grid-cols-1 gap-3 border-t border-border/60 pt-4 sm:my-6 sm:grid-cols-2 sm:gap-4 sm:pt-6"
    >
      {/* Previous Post Link */}
      {prevPost ? (
        <a
          href={`/blog/${prevPost.slug}`}
          class="group relative flex items-center gap-3 border border-border bg-background/60 p-3 transition-all duration-200 hover:border-primary/40 hover:bg-background/90 sm:gap-4 sm:p-4"
        >
          <div class="pointer-events-none absolute top-1.5 left-1.5 h-2.5 w-2.5 border-t border-l border-border transition-colors group-hover:border-primary" />
          <div class="pointer-events-none absolute right-1.5 bottom-1.5 h-2.5 w-2.5 border-r border-b border-border transition-colors group-hover:border-primary" />

          <div class="relative h-12 w-16 shrink-0 overflow-hidden border border-border/60 bg-muted/30 sm:h-14 sm:w-20">
            <img
              src={prevPost.thumbnail}
              alt={prevPost.title}
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </div>

          <div class="min-w-0 flex-1">
            <span class="font-mono text-[9px] tracking-widest text-muted-foreground uppercase transition-colors group-hover:text-primary sm:text-[10px]">
              ← PREVIOUS ARTICLE
            </span>
            <h4 class="truncate text-xs font-bold text-foreground transition-colors group-hover:text-primary sm:text-sm">
              {prevPost.title}
            </h4>
            <span class="font-mono text-[9px] text-muted-foreground sm:text-[10px]">
              {prevPost.readTime}
            </span>
          </div>
        </a>
      ) : (
        <div class="hidden sm:block" />
      )}

      {/* Next Post Link */}
      {nextPost && (
        <a
          href={`/blog/${nextPost.slug}`}
          class="group relative flex items-center justify-between gap-3 border border-border bg-background/60 p-3 text-right transition-all duration-200 hover:border-primary/40 hover:bg-background/90 sm:gap-4 sm:p-4"
        >
          <div class="pointer-events-none absolute top-1.5 right-1.5 h-2.5 w-2.5 border-t border-r border-border transition-colors group-hover:border-primary" />
          <div class="pointer-events-none absolute bottom-1.5 left-1.5 h-2.5 w-2.5 border-b border-l border-border transition-colors group-hover:border-primary" />

          <div class="min-w-0 flex-1">
            <span class="font-mono text-[9px] tracking-widest text-muted-foreground uppercase transition-colors group-hover:text-primary sm:text-[10px]">
              NEXT ARTICLE →
            </span>
            <h4 class="truncate text-xs font-bold text-foreground transition-colors group-hover:text-primary sm:text-sm">
              {nextPost.title}
            </h4>
            <span class="font-mono text-[9px] text-muted-foreground sm:text-[10px]">
              {nextPost.readTime}
            </span>
          </div>

          <div class="relative h-12 w-16 shrink-0 overflow-hidden border border-border/60 bg-muted/30 sm:h-14 sm:w-20">
            <img
              src={nextPost.thumbnail}
              alt={nextPost.title}
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </div>
        </a>
      )}
    </nav>
  )
}
