---
interface SectionItem {
  heading: string
}

export interface TocItem {
  id: string
  title: string
  depth?: number
}

interface Props {
  sections?: SectionItem[]
  headings?: TocItem[]
}

const { sections = [], headings } = Astro.props

const tocItems: TocItem[] =
  headings && headings.length > 0
    ? headings
    : sections.map((sec, i) => ({
        id: `section-${i + 1}`,
        title: sec.heading,
        depth: 2,
      }))
---

{
  tocItems.length > 0 && (
    <div class="h-full w-full">
      {/* Mobile Collapsible TOC */}
      <details class="group mb-8 border border-border bg-background/80 p-4 lg:hidden">
        <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-foreground select-none">
          <span>On this page</span>
          <span class="text-muted-foreground transition-transform duration-200 group-open:rotate-180">
            ↓
          </span>
        </summary>
        <nav class="mt-3 border-t border-border/60 pt-3">
          <ul class="space-y-1.5">
            {tocItems.map((item, index) => {
              const depth = item.depth ?? 2
              const prevItem = index > 0 ? tocItems[index - 1] : null
              const isFirstH2AfterH3 =
                depth === 2 && prevItem && (prevItem.depth ?? 2) === 3
              const isTopLevelAfterTopLevel =
                depth === 2 && prevItem && (prevItem.depth ?? 2) === 2

              return (
                <li
                  class={
                    index === 0
                      ? ""
                      : isFirstH2AfterH3
                        ? "mt-3 pt-2 border-t border-border/40"
                        : isTopLevelAfterTopLevel
                          ? "mt-2"
                          : "mt-1"
                  }
                >
                  <a
                    href={`#${item.id}`}
                    class={`toc-mobile-link block py-1.5 text-xs leading-snug transition-colors hover:text-foreground ${
                      depth === 3
                        ? "pl-5 text-muted-foreground/80"
                        : "pl-2 font-medium text-muted-foreground hover:text-foreground"
                    }`}
                  >
                    {item.title}
                  </a>
                </li>
              )
            })}
          </ul>
        </nav>
      </details>

      {/* Desktop Sticky Right Sidebar TOC */}
      <div class="toc-container sticky top-24 hidden lg:block">
        <p class="mb-4 text-sm font-semibold tracking-tight text-foreground select-none">
          On this page
        </p>

        <nav aria-label="Table of Contents" class="toc-nav-scrollable">
          <div class="toc-rail-wrapper relative">
            {/* Continuous SVG Rail Line with Dynamic Bevel/Tilt */}
            <svg
              id="toc-svg"
              class="pointer-events-none absolute top-0 left-0 h-full w-[40px] overflow-visible"
              aria-hidden="true"
            >
              <path
                id="toc-bg-path"
                class="toc-bg-path"
                fill="none"
              />
              <path
                id="toc-active-path"
                class="toc-active-path"
                fill="none"
              />
            </svg>

            {/* TOC Item List */}
            <ul id="toc-list" class="relative m-0 list-none p-0">
              {tocItems.map((item, index) => {
                const depth = item.depth ?? 2
                const isSubItem = depth === 3
                const prevItem = index > 0 ? tocItems[index - 1] : null
                const isFirstH2AfterH3 =
                  depth === 2 && prevItem && (prevItem.depth ?? 2) === 3
                const isTopLevelAfterTopLevel =
                  depth === 2 && prevItem && (prevItem.depth ?? 2) === 2

                return (
                  <li
                    class={`toc-item relative ${
                      index === 0
                        ? ""
                        : isFirstH2AfterH3
                          ? "mt-3.5"
                          : isTopLevelAfterTopLevel
                            ? "mt-2.5"
                            : "mt-1.5"
                    }`}
                    data-index={index}
                    data-depth={depth}
                    style={`--toc-index: ${index};`}
                  >
                    <a
                      href={`#${item.id}`}
                      data-toc-link={item.id}
                      class={`toc-link block py-1.5 leading-[1.35] transition-colors duration-200 select-none ${
                        isSubItem
                          ? "pl-8 text-xs text-muted-foreground/75 hover:text-foreground"
                          : "pl-5 text-[13px] font-medium text-muted-foreground hover:text-foreground"
                      } ${index === 0 ? "toc-active text-foreground font-semibold" : ""}`}
                    >
                      {item.title}
                    </a>
                  </li>
                )
              })}
            </ul>
          </div>
        </nav>
      </div>
    </div>
  )
}

<style>
  /* Stagger fade-in animation for TOC items */
  @keyframes toc-fade-in {
    from {
      opacity: 0;
      transform: translateX(6px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .toc-item {
    opacity: 0;
    animation: toc-fade-in 0.3s ease-out forwards;
    animation-delay: calc(var(--toc-index, 0) * 0.04s + 0.1s);
  }

  /* SVG Base Rail Styling */
  .toc-bg-path {
    stroke: oklch(var(--border) / 0.55);
    stroke-width: 1.5px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* SVG Active Sliding Indicator Styling */
  .toc-active-path {
    stroke: oklch(var(--primary));
    stroke-width: 2px;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 4px oklch(var(--primary) / 0.45));
    transition:
      stroke-dashoffset 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      stroke-dasharray 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease;
  }

  /* Active text highlight */
  .toc-link.toc-active {
    color: oklch(var(--foreground));
  }

  /* Scrollable TOC container */
  .toc-nav-scrollable {
    max-height: calc(100vh - 180px);
    overflow-y: auto;
    scrollbar-width: none;
  }

  .toc-nav-scrollable::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function initTocBehavior() {
    const tocLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")
    )
    const sections = document.querySelectorAll("[data-article-section]")
    const bgPath = document.getElementById("toc-bg-path") as SVGPathElement | null
    const activePath = document.getElementById("toc-active-path") as SVGPathElement | null
    const wrapper = document.querySelector<HTMLElement>(".toc-rail-wrapper")
    const items = Array.from(document.querySelectorAll<HTMLElement>(".toc-item"))

    if (!tocLinks.length || !sections.length || !bgPath || !activePath || !wrapper || items.length === 0) {
      return
    }

    const X_H2 = 2
    const X_H3 = 16

    // Helper to find path length at a specific Y coordinate using binary search
    function getPathLengthAtY(pathEl: SVGPathElement, targetY: number, totalLen: number): number {
      if (totalLen <= 0) return 0
      let low = 0
      let high = totalLen
      for (let i = 0; i < 24; i++) {
        const mid = (low + high) / 2
        const pt = pathEl.getPointAtLength(mid)
        if (pt.y < targetY) {
          low = mid
        } else {
          high = mid
        }
      }
      return (low + high) / 2
    }

    // Build the SVG path that traces H2 and H3 items with smooth S-curves for bevel/tilt
    function buildSvgRail() {
      if (!bgPath || !activePath || items.length === 0) return

      let d = ""

      for (let i = 0; i < items.length; i++) {
        const item = items[i]
        const depth = Number(item.dataset.depth || 2)
        const currX = depth === 3 ? X_H3 : X_H2
        const itemTop = item.offsetTop
        const itemHeight = item.offsetHeight
        const itemBottom = itemTop + itemHeight

        if (i === 0) {
          d += `M ${currX} ${itemTop + 2}`
        }

        if (i < items.length - 1) {
          const next = items[i + 1]
          const nextDepth = Number(next.dataset.depth || 2)
          const nextX = nextDepth === 3 ? X_H3 : X_H2
          const nextTop = next.offsetTop

          if (currX === nextX) {
            // Same level — straight vertical line to the next item
            d += ` L ${currX} ${nextTop}`
          } else {
            // Level change — smooth tilted S-curve transition between items
            const y1 = itemBottom - 2
            const y2 = nextTop + 2
            const midY = (y1 + y2) / 2
            d += ` L ${currX} ${y1}`
            d += ` C ${currX} ${midY}, ${nextX} ${midY}, ${nextX} ${y2}`
          }
        } else {
          // Last item — straight line to bottom of item
          d += ` L ${currX} ${itemBottom - 2}`
        }
      }

      bgPath.setAttribute("d", d)
      activePath.setAttribute("d", d)

      updateActiveIndicator()
    }

    // Update active sliding indicator along the SVG path
    function updateActiveIndicator() {
      if (!bgPath || !activePath) return

      const activeLink = document.querySelector<HTMLAnchorElement>(".toc-link.toc-active")
      if (!activeLink) {
        activePath.style.opacity = "0"
        return
      }

      const activeItem = activeLink.closest<HTMLElement>(".toc-item")
      if (!activeItem) return

      const totalLen = bgPath.getTotalLength()
      if (totalLen <= 0) return

      const topY = activeItem.offsetTop + 1
      const bottomY = activeItem.offsetTop + activeItem.offsetHeight - 1

      const startDist = getPathLengthAtY(bgPath, topY, totalLen)
      const endDist = getPathLengthAtY(bgPath, bottomY, totalLen)
      const segLen = Math.max(endDist - startDist, 14)

      activePath.style.strokeDasharray = `${segLen} ${totalLen}`
      activePath.style.strokeDashoffset = `-${startDist}`
      activePath.style.opacity = "1"
    }

    // Initialize rail path after layout stabilizes
    requestAnimationFrame(() => {
      buildSvgRail()
    })

    // ResizeObserver to rebuild path if dimensions shift
    const resizeObserver = new ResizeObserver(() => {
      buildSvgRail()
    })
    resizeObserver.observe(wrapper)

    // --- Smooth scroll on TOC link click ---
    tocLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault()
        const targetId = link.getAttribute("data-toc-link")
        if (!targetId) return
        const target = document.getElementById(targetId)
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "start" })
          history.replaceState(null, "", `#${targetId}`)
        }
      })
    })

    // Mobile TOC links smooth scroll
    document.querySelectorAll(".toc-mobile-link").forEach((link) => {
      link.addEventListener("click", (e) => {
        const href = link.getAttribute("href")
        if (!href || !href.startsWith("#")) return
        e.preventDefault()
        const target = document.getElementById(href.slice(1))
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "start" })
          history.replaceState(null, "", href)
        }
      })
    })

    // --- Scrollspy with IntersectionObserver ---
    const observerOptions = {
      root: null,
      rootMargin: "-15% 0px -50% 0px",
      threshold: 0,
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const activeId = entry.target.getAttribute("id")

          tocLinks.forEach((link) => {
            const targetId = link.getAttribute("data-toc-link")
            if (targetId === activeId) {
              link.classList.add("toc-active", "text-foreground", "font-semibold")
              link.classList.remove("text-muted-foreground", "text-muted-foreground/75")
            } else {
              link.classList.remove("toc-active", "text-foreground", "font-semibold")
              const depth = link.closest<HTMLElement>(".toc-item")?.dataset.depth
              if (depth === "3") {
                link.classList.add("text-muted-foreground/75")
                link.classList.remove("font-semibold")
              } else {
                link.classList.add("text-muted-foreground", "font-medium")
                link.classList.remove("font-semibold")
              }
            }
          })

          updateActiveIndicator()

          // Scroll TOC item into view inside the sticky container if needed
          const activeLink = document.querySelector<HTMLAnchorElement>(".toc-link.toc-active")
          const tocNav = activeLink?.closest<HTMLElement>(".toc-nav-scrollable")
          if (activeLink && tocNav) {
            const linkTop = activeLink.offsetTop - tocNav.offsetTop
            const navScroll = tocNav.scrollTop
            const navHeight = tocNav.clientHeight
            if (linkTop < navScroll || linkTop > navScroll + navHeight - 40) {
              tocNav.scrollTo({
                top: linkTop - navHeight / 3,
                behavior: "smooth",
              })
            }
          }
        }
      })
    }, observerOptions)

    sections.forEach((section) => observer.observe(section))
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTocBehavior)
  } else {
    initTocBehavior()
  }
  document.addEventListener("astro:page-load", initTocBehavior)
</script>
