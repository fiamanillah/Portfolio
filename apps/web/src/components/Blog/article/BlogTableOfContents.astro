---
interface SectionItem {
  heading: string
}

export interface TocItem {
  id: string
  title: string
  depth?: number
}

interface Props {
  sections?: SectionItem[]
  headings?: TocItem[]
}

const { sections = [], headings } = Astro.props

const tocItems: TocItem[] =
  headings && headings.length > 0
    ? headings
    : sections.map((sec, i) => ({
        id: `section-${i + 1}`,
        title: sec.heading,
        depth: 2,
      }))
---

{
  tocItems.length > 0 && (
    <div class="h-full w-full">
      {/* Mobile Floating Action Button (FAB) */}
      <button
        id="mobile-toc-toggle-btn"
        type="button"
        aria-label="Open Table of Contents"
        aria-controls="mobile-toc-dialog"
        class="fixed right-4 bottom-5 z-50 flex cursor-pointer items-center gap-2 rounded-full border border-primary/50 bg-background/95 px-3.5 py-2.5 font-mono text-xs font-semibold text-foreground shadow-[0_4px_20px_rgba(0,0,0,0.4)] ring-1 ring-primary/30 backdrop-blur-xl transition-all hover:border-primary hover:bg-primary/10 hover:text-primary active:scale-95 sm:right-6 sm:bottom-6 lg:hidden"
      >
        <svg
          class="h-4 w-4 text-primary"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="15" y2="12" />
          <line x1="3" y1="18" x2="18" y2="18" />
        </svg>
        <span>On this page</span>
        <span class="flex h-4 min-w-4 items-center justify-center rounded-full bg-primary/20 px-1 text-[10px] font-bold text-primary">
          {tocItems.length}
        </span>
      </button>

      {/* Mobile Table of Contents Modal Dialog / Bottom Sheet Drawer */}
      <dialog
        id="mobile-toc-dialog"
        class="fixed inset-x-0 bottom-0 z-50 m-0 max-h-[75vh] w-full max-w-none rounded-t-2xl border-t border-border bg-background/95 p-0 text-foreground shadow-2xl backdrop-blur-xl lg:hidden"
      >
        <div class="flex max-h-[75vh] flex-col">
          {/* Drawer Header */}
          <div class="flex items-center justify-between border-b border-border/60 px-5 py-3.5">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 animate-pulse rounded-full bg-primary" />
              <h3 class="font-mono text-xs font-bold tracking-wider text-foreground uppercase">
                // Table of Contents
              </h3>
              <span class="rounded-xs border border-border bg-muted/40 px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                {tocItems.length} sections
              </span>
            </div>
            <button
              id="mobile-toc-close-btn"
              type="button"
              class="flex h-7 w-7 items-center justify-center rounded-md border border-border/60 bg-muted/20 font-mono text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground active:scale-95"
              aria-label="Close Table of Contents"
            >
              ✕
            </button>
          </div>

          {/* Scrollable list of headings */}
          <div class="overflow-y-auto overscroll-contain px-5 py-4">
            <ul class="space-y-1">
              {tocItems.map((item, index) => {
                const depth = item.depth ?? 2
                const isSubItem = depth === 3
                return (
                  <li>
                    <a
                      href={`#${item.id}`}
                      data-mobile-toc-link={item.id}
                      class={`mobile-toc-link flex items-center justify-between rounded-md px-3 py-2 text-xs transition-colors duration-150 ${
                        isSubItem
                          ? "pl-6 text-muted-foreground hover:bg-primary/5 hover:text-foreground"
                          : "font-medium text-muted-foreground hover:bg-primary/10 hover:text-foreground"
                      } ${index === 0 ? "mobile-toc-active bg-primary/10 font-semibold text-primary" : ""}`}
                    >
                      <span class="truncate">{item.title}</span>
                      <span class="ml-2 font-mono text-[10px] text-muted-foreground/50">
                        {isSubItem ? "H3" : "H2"}
                      </span>
                    </a>
                  </li>
                )
              })}
            </ul>
          </div>
        </div>
      </dialog>

      {/* Desktop Sticky Right Sidebar TOC */}
      <div class="toc-container sticky top-24 hidden lg:block">
        <p class="mb-4 text-sm font-semibold tracking-tight text-foreground select-none">
          On this page
        </p>

        <nav aria-label="Table of Contents" class="toc-nav-scrollable">
          <div class="toc-rail-wrapper relative">
            {/* Continuous SVG Rail Line with Dynamic Bevel/Tilt */}
            <svg
              id="toc-svg"
              class="pointer-events-none absolute top-0 left-0 h-full w-[40px] overflow-visible"
              aria-hidden="true"
            >
              <path id="toc-bg-path" class="toc-bg-path" fill="none" />
              <path id="toc-active-path" class="toc-active-path" fill="none" />
            </svg>

            {/* TOC Item List */}
            <ul id="toc-list" class="relative m-0 list-none p-0">
              {tocItems.map((item, index) => {
                const depth = item.depth ?? 2
                const isSubItem = depth === 3
                const prevItem = index > 0 ? tocItems[index - 1] : null
                const isFirstH2AfterH3 =
                  depth === 2 && prevItem && (prevItem.depth ?? 2) === 3
                const isTopLevelAfterTopLevel =
                  depth === 2 && prevItem && (prevItem.depth ?? 2) === 2

                return (
                  <li
                    class={`toc-item relative ${
                      index === 0
                        ? ""
                        : isFirstH2AfterH3
                          ? "mt-3.5"
                          : isTopLevelAfterTopLevel
                            ? "mt-2.5"
                            : "mt-1.5"
                    }`}
                    data-index={index}
                    data-depth={depth}
                    style={`--toc-index: ${index};`}
                  >
                    <a
                      href={`#${item.id}`}
                      data-toc-link={item.id}
                      class={`toc-link block py-1.5 leading-[1.35] transition-colors duration-200 select-none ${
                        isSubItem
                          ? "pl-8 text-xs text-muted-foreground/75 hover:text-foreground"
                          : "pl-5 text-[13px] font-medium text-muted-foreground hover:text-foreground"
                      } ${index === 0 ? "toc-active font-semibold text-foreground" : ""}`}
                    >
                      {item.title}
                    </a>
                  </li>
                )
              })}
            </ul>
          </div>
        </nav>
      </div>
    </div>
  )
}

<style>
  /* SVG Base Rail Styling */
  .toc-bg-path {
    stroke: oklch(var(--border) / 0.55);
    stroke-width: 1.5px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* SVG Active Sliding Indicator Styling */
  .toc-active-path {
    stroke: oklch(var(--primary));
    stroke-width: 2px;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 4px oklch(var(--primary) / 0.45));
    transition:
      stroke-dashoffset 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      stroke-dasharray 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease;
  }

  /* Active text highlight */
  .toc-link.toc-active {
    color: oklch(var(--foreground));
  }

  /* Scrollable TOC container */
  .toc-nav-scrollable {
    max-height: calc(100vh - 180px);
    overflow-y: auto;
    scrollbar-width: none;
  }

  .toc-nav-scrollable::-webkit-scrollbar {
    display: none;
  }

  /* Mobile Dialog styling */
  #mobile-toc-dialog {
    margin-top: auto;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
  }

  #mobile-toc-dialog::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }
</style>

<script>
  function initTocBehavior() {
    const tocLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")
    )
    const mobileLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-mobile-toc-link]")
    )
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("[data-article-section]")
    )
    const bgPath = document.getElementById(
      "toc-bg-path"
    ) as SVGPathElement | null
    const activePath = document.getElementById(
      "toc-active-path"
    ) as SVGPathElement | null
    const wrapper = document.querySelector<HTMLElement>(".toc-rail-wrapper")
    const items = Array.from(
      document.querySelectorAll<HTMLElement>(".toc-item")
    )
    const mobileDialog = document.getElementById(
      "mobile-toc-dialog"
    ) as HTMLDialogElement | null
    const mobileToggleBtn = document.getElementById("mobile-toc-toggle-btn")
    const mobileCloseBtn = document.getElementById("mobile-toc-close-btn")

    // --- Mobile Dialog Setup ---
    if (mobileDialog && mobileToggleBtn) {
      mobileToggleBtn.addEventListener("click", () => {
        mobileDialog.showModal()
      })

      mobileCloseBtn?.addEventListener("click", () => {
        mobileDialog.close()
      })

      // Close on backdrop click
      mobileDialog.addEventListener("click", (e) => {
        const rect = mobileDialog.getBoundingClientRect()
        if (
          e.clientX < rect.left ||
          e.clientX > rect.right ||
          e.clientY < rect.top ||
          e.clientY > rect.bottom
        ) {
          mobileDialog.close()
        }
      })
    }

    // Mobile TOC links smooth scroll & close drawer
    mobileLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        const targetId = link.getAttribute("data-mobile-toc-link")
        if (!targetId) return
        e.preventDefault()
        if (mobileDialog?.open) {
          mobileDialog.close()
        }
        const target = document.getElementById(targetId)
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "start" })
          history.replaceState(null, "", `#${targetId}`)
          setActiveSection(targetId)
        }
      })
    })

    if (!sections.length || !tocLinks.length) {
      return
    }

    const X_H2 = 2
    const X_H3 = 16

    // Helper to find path length at a specific Y coordinate using binary search
    function getPathLengthAtY(
      pathEl: SVGPathElement,
      targetY: number,
      totalLen: number
    ): number {
      if (totalLen <= 0) return 0
      let low = 0
      let high = totalLen
      for (let i = 0; i < 20; i++) {
        const mid = (low + high) / 2
        const pt = pathEl.getPointAtLength(mid)
        if (pt.y < targetY) {
          low = mid
        } else {
          high = mid
        }
      }
      return (low + high) / 2
    }

    // Build the SVG path that traces H2 and H3 items with smooth S-curves for bevel/tilt
    function buildSvgRail() {
      if (!bgPath || !activePath || !wrapper || items.length === 0) return

      let d = ""

      for (let i = 0; i < items.length; i++) {
        const item = items[i]
        const depth = Number(item.dataset.depth || 2)
        const currX = depth === 3 ? X_H3 : X_H2
        const itemTop = item.offsetTop
        const itemHeight = item.offsetHeight
        const itemBottom = itemTop + itemHeight

        if (i === 0) {
          d += `M ${currX} ${itemTop + 2}`
        }

        if (i < items.length - 1) {
          const next = items[i + 1]
          const nextDepth = Number(next.dataset.depth || 2)
          const nextX = nextDepth === 3 ? X_H3 : X_H2
          const nextTop = next.offsetTop

          if (currX === nextX) {
            d += ` L ${currX} ${nextTop}`
          } else {
            const y1 = itemBottom - 2
            const y2 = nextTop + 2
            const midY = (y1 + y2) / 2
            d += ` L ${currX} ${y1}`
            d += ` C ${currX} ${midY}, ${nextX} ${midY}, ${nextX} ${y2}`
          }
        } else {
          d += ` L ${currX} ${itemBottom - 2}`
        }
      }

      bgPath.setAttribute("d", d)
      activePath.setAttribute("d", d)

      updateActiveIndicator()
    }

    // Update active sliding indicator along the SVG path
    function updateActiveIndicator() {
      if (!bgPath || !activePath) return

      const activeLink = document.querySelector<HTMLAnchorElement>(
        ".toc-link.toc-active"
      )
      if (!activeLink) {
        activePath.style.opacity = "0"
        return
      }

      const activeItem = activeLink.closest<HTMLElement>(".toc-item")
      if (!activeItem) return

      const totalLen = bgPath.getTotalLength()
      if (totalLen <= 0) return

      const topY = activeItem.offsetTop + 1
      const bottomY = activeItem.offsetTop + activeItem.offsetHeight - 1

      const startDist = getPathLengthAtY(bgPath, topY, totalLen)
      const endDist = getPathLengthAtY(bgPath, bottomY, totalLen)
      const segLen = Math.max(endDist - startDist, 14)

      activePath.style.strokeDasharray = `${segLen} ${totalLen}`
      activePath.style.strokeDashoffset = `-${startDist}`
      activePath.style.opacity = "1"
    }

    // Scroll active item in sidebar container without animating or fighting manual scroll
    function scrollActiveTocItemIntoView(activeLink: HTMLElement | null) {
      if (!activeLink) return
      const activeItem = activeLink.closest<HTMLElement>(".toc-item")
      const tocNav = activeLink.closest<HTMLElement>(".toc-nav-scrollable")
      if (!activeItem || !tocNav) return

      const navRect = tocNav.getBoundingClientRect()
      const itemRect = activeItem.getBoundingClientRect()

      const itemTopInNav = itemRect.top - navRect.top
      const itemBottomInNav = itemRect.bottom - navRect.top
      const navHeight = tocNav.clientHeight

      if (itemTopInNav < 24 || itemBottomInNav > navHeight - 24) {
        const targetScroll =
          activeItem.offsetTop - navHeight / 2 + activeItem.offsetHeight / 2
        tocNav.scrollTop = Math.max(0, targetScroll)
      }
    }

    // Centralized active section updater
    let currentActiveId: string | null = null

    function setActiveSection(activeId: string) {
      if (currentActiveId === activeId) return
      currentActiveId = activeId

      let matchedLink: HTMLAnchorElement | null = null

      // Sync desktop links — maintain stable font weights to avoid layout shifts
      tocLinks.forEach((link) => {
        const targetId = link.getAttribute("data-toc-link")
        if (targetId === activeId) {
          matchedLink = link
          link.classList.add("toc-active", "text-foreground")
          link.classList.remove(
            "text-muted-foreground",
            "text-muted-foreground/75"
          )
        } else {
          link.classList.remove("toc-active", "text-foreground")
          const depth = link.closest<HTMLElement>(".toc-item")?.dataset.depth
          if (depth === "3") {
            link.classList.add("text-muted-foreground/75")
          } else {
            link.classList.add("text-muted-foreground")
          }
        }
      })

      // Sync mobile drawer links
      mobileLinks.forEach((link) => {
        const targetId = link.getAttribute("data-mobile-toc-link")
        if (targetId === activeId) {
          link.classList.add(
            "mobile-toc-active",
            "bg-primary/10",
            "text-primary"
          )
          link.classList.remove("text-muted-foreground")
        } else {
          link.classList.remove(
            "mobile-toc-active",
            "bg-primary/10",
            "text-primary"
          )
          link.classList.add("text-muted-foreground")
        }
      })

      updateActiveIndicator()
      scrollActiveTocItemIntoView(matchedLink)
    }

    // Initialize rail path after initial layout
    requestAnimationFrame(() => {
      buildSvgRail()
    })

    // Debounced window resize handler instead of continuous ResizeObserver
    let resizeTimer: number | undefined
    window.addEventListener(
      "resize",
      () => {
        clearTimeout(resizeTimer)
        resizeTimer = window.setTimeout(() => {
          buildSvgRail()
        }, 100)
      },
      { passive: true }
    )

    // --- Desktop TOC links smooth scroll ---
    tocLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault()
        const targetId = link.getAttribute("data-toc-link")
        if (!targetId) return
        const target = document.getElementById(targetId)
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "start" })
          history.replaceState(null, "", `#${targetId}`)
          setActiveSection(targetId)
        }
      })
    })

    // --- High-Performance Scrollspy via requestAnimationFrame ---
    let scrollSpyTicking = false

    function computeActiveSection() {
      if (!sections.length) return

      const scrollPosition = window.scrollY + 130
      let matchedSection: HTMLElement = sections[0]

      // Find the last section whose offsetTop is <= current scroll position
      for (let i = 0; i < sections.length; i++) {
        const sec = sections[i]
        if (sec.offsetTop <= scrollPosition) {
          matchedSection = sec
        } else {
          break
        }
      }

      // Special case: reached bottom of page
      if (
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 70
      ) {
        matchedSection = sections[sections.length - 1]
      }

      const activeId = matchedSection.getAttribute("id")
      if (activeId) {
        setActiveSection(activeId)
      }
    }

    window.addEventListener(
      "scroll",
      () => {
        if (!scrollSpyTicking) {
          requestAnimationFrame(() => {
            computeActiveSection()
            scrollSpyTicking = false
          })
          scrollSpyTicking = true
        }
      },
      { passive: true }
    )

    // Initial check
    computeActiveSection()
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTocBehavior)
  } else {
    initTocBehavior()
  }
  document.addEventListener("astro:page-load", initTocBehavior)
</script>
