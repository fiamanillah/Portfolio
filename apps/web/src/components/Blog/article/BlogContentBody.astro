---
import BlogArticleHeader from "@/components/Blog/article/BlogArticleHeader.astro"
import BlogTableOfContents from "@/components/Blog/article/BlogTableOfContents.astro"
import {
  ArticleReactionStation,
  BlogCommentsSection,
} from "@/components/Blog/engagement"
import { renderMarkdown } from "@/lib/markdown"
import type { BlogPost } from "@/data/blogPosts"
import { HugeiconsIcon } from "@hugeicons/react"
import {
  NewTwitterIcon,
  Linkedin02Icon,
  GithubIcon,
} from "@hugeicons/core-free-icons"

interface Props {
  post: BlogPost
}

const { post } = Astro.props

const { html: renderedMarkdownHtml, headings: tocHeadings } =
  await renderMarkdown(post.content || "")

const authorUsername =
  post.author?.username ||
  (post.author?.name
    ? post.author.name
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "")
    : "admin")
const authorProfileUrl = `/authors/${authorUsername}`

const normalizeSocialUrl = (handle?: string, domain = "https://x.com/") =>
  handle
    ? handle.startsWith("http")
      ? handle
      : `${domain}${handle.replace(/^@/, "")}`
    : undefined

const twitterUrl =
  normalizeSocialUrl(post.author?.twitter, "https://x.com/") ||
  "https://x.com/fiamanillah"
const githubUrl =
  normalizeSocialUrl(post.author?.github, "https://github.com/") ||
  "https://github.com/fiamanillah"
const linkedinUrl =
  normalizeSocialUrl(post.author?.linkedin, "https://linkedin.com/in/") ||
  "https://linkedin.com/in/fiamanillah"
---

<div
  class="mx-auto max-w-7xl px-3.5 py-6 sm:px-6 sm:py-8 lg:px-8"
  style="scroll-behavior: smooth;"
>
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
    {/* Main Article Reading Column (8 cols lg) */}
    <article class="min-w-0 lg:col-span-8">
      {/* Article Header — full article-column width */}
      <BlogArticleHeader post={post} />

      {/* Main Cover Artwork — full article-column width */}
      <div
        class="relative my-6 aspect-[16/9] w-full overflow-hidden border border-border bg-muted/30 sm:my-8"
      >
        <img
          src={post.thumbnail}
          alt={`Cover illustration for ${post.title}`}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover"
        />
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent"
        >
        </div>
        <div
          class="absolute bottom-2.5 left-3 font-mono text-[10px] text-muted-foreground sm:bottom-3 sm:left-4 sm:text-xs"
        >
          // COVER IMAGE: {post.title}
        </div>
      </div>

      {/* Key Takeaways Callout Box — full article-column width */}
      {
        post.keyTakeaways && post.keyTakeaways.length > 0 && (
          <div class="relative my-6 overflow-hidden border border-primary/30 bg-primary/5 p-4 backdrop-blur-sm sm:my-8 sm:p-6">
            <div class="pointer-events-none absolute top-2 left-2 z-10 h-3 w-3 border-t border-l border-primary" />
            <div class="pointer-events-none absolute top-2 right-2 z-10 h-3 w-3 border-t border-r border-primary" />
            <div class="pointer-events-none absolute bottom-2 left-2 z-10 h-3 w-3 border-b border-l border-primary" />
            <div class="pointer-events-none absolute right-2 bottom-2 z-10 h-3 w-3 border-r border-b border-primary" />

            <h3 class="font-mono text-xs font-bold tracking-widest text-primary uppercase">
              // KEY TAKEAWAYS & ARCHITECTURE HIGHLIGHTS
            </h3>
            <ul class="mt-2.5 space-y-1.5 text-xs leading-relaxed text-foreground/90 sm:mt-3 sm:space-y-2 sm:text-sm">
              {post.keyTakeaways.map((item) => (
                <li class="flex items-start gap-2 sm:gap-2.5">
                  <span class="mt-0.5 text-primary">⚡</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {/* Main Reading Content (Markdown Rendered) */}
      <div
        class="markdown-content max-w-3xl text-foreground/90"
        set:html={renderedMarkdownHtml}
      />

      {/* Decorative divider between content and meta */}
      <div class="my-8 flex items-center gap-3 sm:my-12 sm:gap-4">
        <div
          class="h-px flex-1 bg-gradient-to-r from-transparent via-border to-transparent"
        >
        </div>
        <span
          class="font-mono text-[9px] tracking-widest text-muted-foreground/50 uppercase sm:text-[10px]"
          >END OF ARTICLE</span
        >
        <div
          class="h-px flex-1 bg-gradient-to-r from-transparent via-border to-transparent"
        >
        </div>
      </div>

      {/* Article Tags — full article-column width */}
      <div
        class="flex flex-wrap items-center gap-1.5 border-t border-border/60 pt-4 sm:gap-2 sm:pt-6"
      >
        <span class="font-mono text-[11px] text-muted-foreground sm:text-xs"
          >TAGS:</span
        >
        {
          post.tags.map((tag) => (
            <span class="inline-flex items-center border border-border bg-muted/60 px-2 py-0.5 font-mono text-[11px] text-muted-foreground sm:px-2.5 sm:text-xs">
              #{tag}
            </span>
          ))
        }
      </div>

      {/* Article Reaction & Like Station */}
      <div>
        <ArticleReactionStation
          client:visible
          postSlug={post.slug}
          postTitle={post.title}
          initialLikes={post.likesCount || 0}
        />
      </div>

      {/* Author Bio Card — full article-column width */}
      <div
        class="relative mt-8 overflow-hidden border border-border/80 bg-card/60 p-4 backdrop-blur-md sm:mt-10 sm:p-6 md:p-7"
      >
        {/* Cyberpunk corner brackets */}
        <div
          class="pointer-events-none absolute top-2 left-2 h-3.5 w-3.5 border-t-[1.5px] border-l-[1.5px] border-primary/40"
        >
        </div>
        <div
          class="pointer-events-none absolute top-2 right-2 h-3.5 w-3.5 border-t-[1.5px] border-r-[1.5px] border-primary/40"
        >
        </div>
        <div
          class="pointer-events-none absolute bottom-2 left-2 h-3.5 w-3.5 border-b-[1.5px] border-l-[1.5px] border-primary/40"
        >
        </div>
        <div
          class="pointer-events-none absolute right-2 bottom-2 h-3.5 w-3.5 border-r-[1.5px] border-b-[1.5px] border-primary/40"
        >
        </div>

        {/* Top Header Tag & Author Badge */}
        <div
          class="mb-4 flex flex-wrap items-center justify-between gap-2.5 border-b border-border/50 pb-2.5 font-mono text-xs sm:mb-5 sm:gap-3 sm:pb-3"
        >
          <div
            class="flex items-center gap-1.5 text-[11px] sm:gap-2 sm:text-xs"
          >
            <span class="font-bold text-primary">[ AUTHOR PROFILE ]</span>
            <span class="text-muted-foreground/60">//</span>
            <span class="text-muted-foreground">ENGINEERING & WRITING</span>
          </div>
          <a
            href={authorProfileUrl}
            class="group/btn inline-flex items-center gap-1 font-mono text-[10px] font-semibold text-primary transition-colors hover:text-primary/80 sm:gap-1.5 sm:text-[11px]"
          >
            <span>View All Articles</span>
            <span
              class="transition-transform duration-200 group-hover/btn:translate-x-1"
              >→</span
            >
          </a>
        </div>

        {/* Main Body: Avatar, Bio, Details, and Actions */}
        <div
          class="flex flex-col gap-5 sm:gap-6 md:flex-row md:items-start md:justify-between"
        >
          {/* Left: Avatar + Identity + Bio */}
          <div
            class="flex flex-1 flex-col gap-3.5 sm:flex-row sm:items-start sm:gap-4"
          >
            <a
              href={authorProfileUrl}
              class="group/avatar relative shrink-0 focus:outline-none"
              title={`View ${post.author.name}'s profile`}
            >
              <img
                src={post.author.avatar}
                alt={post.author.name}
                class="h-14 w-14 rounded-full border-2 border-primary/50 object-cover shadow-md transition-transform duration-300 group-hover/avatar:scale-105 group-hover/avatar:border-primary sm:h-16 sm:w-16"
              />
              <span
                class="absolute right-0 bottom-0 h-3.5 w-3.5 rounded-full border-2 border-background bg-emerald-500 shadow-sm sm:h-4 sm:w-4"
                title="Author Verified & Active"></span>
            </a>

            <div class="min-w-0 flex-1 space-y-1 text-left sm:space-y-1.5">
              <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                <a
                  href={authorProfileUrl}
                  class="font-mono text-sm font-bold text-foreground transition-colors hover:text-primary focus:outline-none sm:text-base"
                >
                  {post.author.name}
                </a>
                <span
                  class="border border-primary/30 bg-primary/10 px-1.5 py-0.5 font-mono text-[8px] font-bold text-primary uppercase sm:text-[9px]"
                >
                  AUTHOR
                </span>
              </div>
              <p class="font-mono text-[11px] text-muted-foreground sm:text-xs">
                {post.author.role}
              </p>
              <p
                class="max-w-xl pt-1 text-[11px] leading-relaxed text-muted-foreground/90 sm:text-xs"
              >
                Software Engineer &amp; Technology Writer exploring distributed
                systems, modern web architectures, and full-stack cloud
                engineering.
              </p>
            </div>
          </div>

          {/* Right: Social Hub & Author Profile CTA */}
          <div
            class="flex shrink-0 flex-col items-start gap-2.5 border-t border-border/40 pt-3.5 sm:flex-row sm:items-center sm:justify-between sm:gap-3 md:flex-col md:items-end md:border-t-0 md:pt-0"
          >
            {/* Social Icons */}
            <div class="flex items-center gap-1.5 sm:gap-2">
              <a
                href={twitterUrl}
                target="_blank"
                rel="noopener noreferrer"
                title="Follow on Twitter / X"
                class="flex h-7.5 w-7.5 items-center justify-center border border-border/80 bg-background/80 text-muted-foreground transition-all hover:border-primary/60 hover:bg-primary/10 hover:text-primary sm:h-8 sm:w-8"
              >
                <HugeiconsIcon icon={NewTwitterIcon} className="size-3.5" />
              </a>
              <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                title="View GitHub profile"
                class="flex h-7.5 w-7.5 items-center justify-center border border-border/80 bg-background/80 text-muted-foreground transition-all hover:border-primary/60 hover:bg-primary/10 hover:text-primary sm:h-8 sm:w-8"
              >
                <HugeiconsIcon icon={GithubIcon} className="size-3.5" />
              </a>
              <a
                href={linkedinUrl}
                target="_blank"
                rel="noopener noreferrer"
                title="Connect on LinkedIn"
                class="flex h-7.5 w-7.5 items-center justify-center border border-border/80 bg-background/80 text-muted-foreground transition-all hover:border-primary/60 hover:bg-primary/10 hover:text-primary sm:h-8 sm:w-8"
              >
                <HugeiconsIcon icon={Linkedin02Icon} className="size-3.5" />
              </a>
            </div>

            {/* Profile CTA Button */}
            <a
              href={authorProfileUrl}
              class="inline-flex h-7.5 items-center gap-1.5 border border-primary/40 bg-primary/10 px-2.5 font-mono text-[10px] font-semibold text-primary shadow-xs transition-all hover:border-primary hover:bg-primary hover:text-primary-foreground sm:h-8 sm:px-3 sm:text-[11px]"
            >
              <span>Explore Profile</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>

      {/* Discussion & Comments Hub */}
      <div>
        <BlogCommentsSection
          client:visible
          postSlug={post.slug}
          postTitle={post.title}
        />
      </div>
    </article>

    {/* Right Sidebar Column: Sticky Table of Contents (4 cols lg) */}
    <aside class="h-full min-w-0 lg:col-span-4">
      <BlogTableOfContents headings={tocHeadings} />
    </aside>
  </div>
</div>

<script>
  // Initialize Code Block Copy Buttons for Markdown content
  function initMarkdownCodeCopy() {
    document.querySelectorAll(".code-copy-btn").forEach((btn) => {
      if (btn.hasAttribute("data-copy-initialized")) return
      btn.setAttribute("data-copy-initialized", "true")

      btn.addEventListener("click", async () => {
        const code = btn.getAttribute("data-code")
        if (!code) return

        try {
          await navigator.clipboard.writeText(code)
          const copyIcon = btn.querySelector(".copy-icon")
          const checkIcon = btn.querySelector(".check-icon")
          const textSpan = btn.querySelector(".btn-text")

          if (copyIcon && checkIcon && textSpan) {
            copyIcon.classList.add("hidden")
            checkIcon.classList.remove("hidden")
            textSpan.textContent = "Copied!"
            btn.classList.add("text-emerald-500")

            setTimeout(() => {
              copyIcon.classList.remove("hidden")
              checkIcon.classList.add("hidden")
              textSpan.textContent = "Copy"
              btn.classList.remove("text-emerald-500")
            }, 2000)
          }
        } catch (err) {
          console.error("Failed to copy code:", err)
        }
      })
    })
  }

  function initAll() {
    initMarkdownCodeCopy()
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAll)
  } else {
    initAll()
  }
  document.addEventListener("astro:page-load", initAll)
</script>
