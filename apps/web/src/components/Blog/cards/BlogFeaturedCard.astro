---
import type { BlogPost } from "@/data/blogPosts"
import { formatViewsCount } from "@/data/blogPosts"
import { HugeiconsIcon } from "@hugeicons/react"
import {
  FavouriteIcon,
  Comment01Icon,
  ViewIcon,
} from "@hugeicons/core-free-icons"

interface Props {
  post: BlogPost
  class?: string
}

const { post, class: className = "" } = Astro.props
---

<article
  class={`group relative overflow-hidden border border-border bg-background transition-all duration-300 hover:shadow-[0_0_0_1px_oklch(var(--primary)/25%),0_8px_48px_-8px_oklch(var(--primary)/15%)] ${className}`}
>
  {/* Corner brackets — site-standard */}

  <div class="grid grid-cols-1 items-stretch lg:grid-cols-12">
    {/* Left: Thumbnail */}
    <div
      class="relative aspect-[16/10] w-full overflow-hidden border-b border-border bg-muted/30 before:pointer-events-none before:absolute before:inset-0 before:z-10 before:bg-[linear-gradient(105deg,transparent_40%,oklch(var(--primary)/12%)_50%,transparent_60%)] before:bg-[length:200%_100%] before:transition-all before:duration-700 after:pointer-events-none after:absolute after:inset-0 after:bg-[repeating-linear-gradient(0deg,transparent,transparent_2px,rgba(0,0,0,0.04)_2px,rgba(0,0,0,0.04)_4px)] after:opacity-60 after:transition-opacity after:duration-400 group-hover:after:opacity-0 hover:before:bg-[-100%_0] lg:col-span-7 lg:aspect-auto lg:h-full lg:border-r lg:border-b-0"
    >
      <img
        src={post.thumbnail}
        alt={post.title}
        class="h-full w-full object-cover grayscale-[8%] transition-all duration-700 ease-out group-hover:scale-105 group-hover:grayscale-0"
      />
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/85 via-background/15 to-transparent lg:bg-gradient-to-r lg:from-transparent lg:via-background/5 lg:to-background/85"
      >
      </div>

      {/* Badges */}
      <div class="absolute top-4 left-4 z-20 flex flex-wrap items-center gap-2">
        <span
          class="inline-flex items-center gap-2 bg-primary px-3 py-1 font-mono text-xs font-bold tracking-wider text-primary-foreground uppercase shadow-md"
        >
          <span
            class="h-1.5 w-1.5 animate-pulse rounded-full bg-primary-foreground"
          ></span>
          FEATURED
        </span>
        <span
          class="inline-flex items-center border border-primary/40 bg-background/85 px-2.5 py-1 font-mono text-xs font-semibold text-primary uppercase backdrop-blur-md"
        >
          {post.category}
        </span>
      </div>
    </div>

    {/* Right: Content */}
    <div class="flex flex-col justify-between p-6 sm:p-8 lg:col-span-5">
      <div>
        {/* Meta */}
        <div
          class="flex flex-wrap items-center gap-2 font-mono text-xs tracking-wider text-muted-foreground uppercase"
        >
          <span class="text-primary/60">//</span>
          <span>{post.date}</span>
          {
            post.readTime && (
              <>
                <span class="text-primary/40">•</span>
                <span>{post.readTime}</span>
              </>
            )
          }
        </div>

        {/* Title */}
        <h3
          class="mt-4 text-2xl font-black tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary sm:text-3xl"
        >
          <a href={`/blog/${post.slug}`} class="focus:outline-none">
            <span class="absolute inset-0 z-10" aria-hidden="true"></span>
            {post.title}
          </a>
        </h3>

        {
          post.subtitle && (
            <p class="mt-1.5 font-mono text-xs font-semibold tracking-wide text-primary">
              {post.subtitle}
            </p>
          )
        }

        <p
          class="mt-4 text-sm leading-relaxed text-muted-foreground sm:text-base"
        >
          {post.summary}
        </p>

        {/* Tags */}
        {
          post.tags && post.tags.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-1.5">
              {post.tags.map((tag) => (
                <span class="inline-flex items-center border border-border/70 bg-muted/30 px-2.5 py-1 font-mono text-xs font-medium text-muted-foreground transition-colors group-hover:border-primary/35 group-hover:text-foreground">
                  #{tag}
                </span>
              ))}
            </div>
          )
        }
      </div>

      {/* Author & Action */}
      <div
        class="relative z-20 mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-border/50 pt-5"
      >
        {/* Author */}
        <div class="flex items-center gap-3">
          <div class="relative shrink-0">
            {
              post.author.avatar ? (
                <img
                  src={post.author.avatar}
                  alt={post.author.name}
                  class="h-10 w-10 rounded-full border-2 border-primary/35 object-cover"
                />
              ) : (
                <div class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-primary/35 bg-primary/10 font-mono text-sm font-bold text-primary">
                  {post.author.name.charAt(0)}
                </div>
              )
            }
            <span
              class="absolute -right-0.5 -bottom-0.5 h-3 w-3 rounded-full border-2 border-background bg-emerald-500"
            ></span>
          </div>
          <div class="flex flex-col gap-0.5">
            <span
              class="font-mono text-xs leading-tight font-bold text-foreground"
            >
              {post.author.name}
            </span>
            {
              post.author.role && (
                <span class="font-mono text-[11px] leading-tight tracking-wide text-muted-foreground">
                  {post.author.role}
                </span>
              )
            }
          </div>
        </div>

        {/* Stats & CTA */}
        <div class="flex items-center gap-3">
          <div
            class="hidden items-center gap-2.5 font-mono text-xs text-muted-foreground sm:flex"
          >
            {
              post.views && (
                <span
                  class="inline-flex items-center gap-1 transition-colors group-hover:text-foreground"
                  title={`${post.views} views`}
                >
                  <HugeiconsIcon
                    icon={ViewIcon}
                    className="size-3.5 text-primary/60"
                  />
                  <span>{formatViewsCount(post.views)}</span>
                </span>
              )
            }
            {
              post.likesCount !== undefined && (
                <span
                  class="inline-flex items-center gap-1 text-rose-400/75 transition-colors group-hover:text-rose-400"
                  title={`${post.likesCount} likes`}
                >
                  <HugeiconsIcon
                    icon={FavouriteIcon}
                    className="size-3.5 fill-rose-400/25 text-rose-400"
                  />
                  <span>{post.likesCount}</span>
                </span>
              )
            }
            {
              post.commentsCount !== undefined && (
                <span
                  class="inline-flex items-center gap-1 text-primary/70 transition-colors group-hover:text-primary"
                  title={`${post.commentsCount} comments`}
                >
                  <HugeiconsIcon icon={Comment01Icon} className="size-3.5" />
                  <span>{post.commentsCount}</span>
                </span>
              )
            }
          </div>

          <a
            href={`/blog/${post.slug}`}
            class="relative z-20 inline-block shrink-0"
          >
            <button
              type="button"
              class="group/btn inline-flex cursor-pointer items-center gap-2 border border-primary/40 bg-primary/10 px-4 py-2 font-mono text-xs font-bold tracking-wider text-primary uppercase transition-all duration-200 hover:border-primary hover:bg-primary hover:text-primary-foreground"
            >
              <span>Read Article</span>
              <span
                class="transition-transform duration-200 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5"
                >↗</span
              >
            </button>
          </a>
        </div>
      </div>
    </div>
  </div>
</article>
