---
import type { BlogPost } from "@/data/blogPosts"
import { formatViewsCount } from "@/data/blogPosts"
import { HugeiconsIcon } from "@hugeicons/react"
import {
  FavouriteIcon,
  Comment01Icon,
  ViewIcon,
} from "@hugeicons/core-free-icons"

interface Props {
  post: BlogPost
  class?: string
}

const { post, class: className = "" } = Astro.props
---

<article
  class={`group relative overflow-hidden border border-border bg-card/70 backdrop-blur-md transition-all duration-300 hover:border-primary/50 hover:shadow-[0_0_32px_-8px_oklch(var(--primary)/20%),inset_0_0_0_1px_oklch(var(--primary)/30%)] ${className}`}
>
  {/* Cyberpunk corner brackets with glowing expansion */}
  <div
    class="pointer-events-none absolute top-3 left-3 z-30 h-3.5 w-3.5 border-t-2 border-l-2 border-border/80 transition-all duration-300 group-hover:h-5 group-hover:w-5 group-hover:border-primary group-hover:shadow-[0_0_10px_oklch(var(--primary)/70%)]"
  >
  </div>
  <div
    class="pointer-events-none absolute top-3 right-3 z-30 h-3.5 w-3.5 border-t-2 border-r-2 border-border/80 transition-all duration-300 group-hover:h-5 group-hover:w-5 group-hover:border-primary group-hover:shadow-[0_0_10px_oklch(var(--primary)/70%)]"
  >
  </div>
  <div
    class="pointer-events-none absolute bottom-3 left-3 z-30 h-3.5 w-3.5 border-b-2 border-l-2 border-border/80 transition-all duration-300 group-hover:h-5 group-hover:w-5 group-hover:border-primary group-hover:shadow-[0_0_10px_oklch(var(--primary)/70%)]"
  >
  </div>
  <div
    class="pointer-events-none absolute right-3 bottom-3 z-30 h-3.5 w-3.5 border-r-2 border-b-2 border-border/80 transition-all duration-300 group-hover:h-5 group-hover:w-5 group-hover:border-primary group-hover:shadow-[0_0_10px_oklch(var(--primary)/70%)]"
  >
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch">
    {/* Left: Thumbnail & Badges (7 cols) */}
    <div
      class="relative aspect-[16/10] w-full overflow-hidden border-b lg:border-b-0 lg:border-r border-border bg-muted/30 lg:col-span-7 lg:aspect-auto lg:h-full before:pointer-events-none before:absolute before:inset-0 before:z-10 before:bg-[linear-gradient(105deg,transparent_40%,oklch(var(--primary)/15%)_50%,transparent_60%)] before:bg-size-[200%_100%] before:transition-all before:duration-700 hover:before:bg-position-[-100%_0] after:pointer-events-none after:absolute after:inset-0 after:bg-[repeating-linear-gradient(0deg,transparent,transparent_2px,rgba(0,0,0,0.04)_2px,rgba(0,0,0,0.04)_4px)] after:opacity-60 after:transition-opacity after:duration-400 group-hover:after:opacity-0"
    >
      <img
        src={post.thumbnail}
        alt={post.title}
        class="h-full w-full object-cover grayscale-[10%] transition-all duration-700 ease-out group-hover:scale-105 group-hover:grayscale-0"
      />
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/90 via-background/20 to-transparent lg:bg-gradient-to-r lg:from-transparent lg:via-background/10 lg:to-background/90"
      >
      </div>

      <div class="absolute top-4 left-4 z-20 flex flex-wrap items-center gap-2">
        <span
          class="inline-flex items-center gap-1.5 bg-primary px-3 py-1 font-mono text-xs font-bold tracking-wider text-primary-foreground uppercase shadow-md shadow-primary/20"
        >
          <span class="h-2 w-2 animate-pulse rounded-full bg-primary-foreground"></span>
          FEATURED STORY
        </span>
        <span
          class="inline-flex items-center border border-primary/40 bg-background/85 px-2.5 py-1 font-mono text-xs font-semibold text-primary uppercase backdrop-blur-md"
        >
          {post.category}
        </span>
      </div>
    </div>

    {/* Right: Content & Metadata (5 cols) */}
    <div class="flex flex-col justify-between p-6 sm:p-8 lg:col-span-5">
      <div>
        <div
          class="flex flex-wrap items-center gap-2 font-mono text-xs tracking-wider text-muted-foreground uppercase"
        >
          <span class="text-primary/70">//</span>
          <span>{post.date}</span>
          <span class="text-primary/60">•</span>
          <span>{post.readTime}</span>
        </div>

        <h3
          class="mt-4 text-2xl font-black tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary sm:text-3xl"
        >
          <a href={`/blog/${post.slug}`} class="focus:outline-none">
            <span class="absolute inset-0 z-10" aria-hidden="true"></span>
            {post.title}
          </a>
        </h3>

        {
          post.subtitle && (
            <p class="mt-2 font-mono text-xs font-semibold tracking-wide text-primary">
              {post.subtitle}
            </p>
          )
        }

        <p
          class="mt-4 text-sm leading-relaxed text-muted-foreground sm:text-base"
        >
          {post.summary}
        </p>

        {
          post.tags && post.tags.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-1.5">
              {post.tags.map((tag) => (
                <span class="inline-flex items-center border border-border bg-muted/40 px-2.5 py-1 font-mono text-xs font-medium text-muted-foreground transition-colors group-hover:border-primary/40 group-hover:text-foreground">
                  #{tag}
                </span>
              ))}
            </div>
          )
        }
      </div>

      {/* Author & Action Bar */}
      <div
        class="relative z-20 mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-border/60 pt-6"
      >
        <div class="flex items-center gap-3">
          <div class="relative shrink-0">
            {
              post.author.avatar ? (
                <img
                  src={post.author.avatar}
                  alt={post.author.name}
                  class="h-10 w-10 rounded-full border-2 border-primary/40 object-cover shadow-sm"
                />
              ) : (
                <div class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-primary/40 bg-primary/10 font-mono text-sm font-bold text-primary">
                  {post.author.name.charAt(0)}
                </div>
              )
            }
            <span
              class="absolute -right-0.5 -bottom-0.5 h-3 w-3 rounded-full border-2 border-background bg-emerald-500 shadow-sm"
            ></span>
          </div>
          <div class="flex flex-col justify-center gap-0.5">
            <span
              class="font-mono text-xs leading-tight font-bold text-foreground"
            >
              {post.author.name}
            </span>
            <span
              class="font-mono text-[11px] leading-tight tracking-wide text-muted-foreground"
            >
              {post.author.role}
            </span>
          </div>
        </div>

        {/* Stats & Button */}
        <div class="flex items-center gap-3">
          {/* Stats Bar */}
          <div class="hidden sm:flex items-center gap-2.5 font-mono text-xs text-muted-foreground">
            {
              post.views && (
                <span
                  class="inline-flex items-center gap-1 transition-colors group-hover:text-foreground"
                  title={`${post.views} views`}
                >
                  <HugeiconsIcon
                    icon={ViewIcon}
                    className="size-3.5 text-primary/70"
                  />
                  <span>{formatViewsCount(post.views)}</span>
                </span>
              )
            }
            {
              post.likesCount !== undefined && (
                <span
                  class="inline-flex items-center gap-1 text-rose-400/80 transition-colors group-hover:text-rose-400"
                  title={`${post.likesCount} likes`}
                >
                  <HugeiconsIcon
                    icon={FavouriteIcon}
                    className="size-3.5 fill-rose-400/30 text-rose-400"
                  />
                  <span>{post.likesCount}</span>
                </span>
              )
            }
            {
              post.commentsCount !== undefined && (
                <span
                  class="inline-flex items-center gap-1 text-primary/80 transition-colors group-hover:text-primary"
                  title={`${post.commentsCount} comments`}
                >
                  <HugeiconsIcon icon={Comment01Icon} className="size-3.5" />
                  <span>{post.commentsCount}</span>
                </span>
              )
            }
          </div>

          <a
            href={`/blog/${post.slug}`}
            class="relative z-20 inline-block shrink-0"
          >
            <button
              type="button"
              class="group/btn inline-flex cursor-pointer items-center gap-2 border border-primary/40 bg-primary/10 px-4 py-2 font-mono text-xs font-bold tracking-wider text-primary uppercase transition-all duration-200 hover:border-primary hover:bg-primary hover:text-primary-foreground shadow-xs"
            >
              <span>Read Article</span>
              <span
                class="transition-transform duration-200 group-hover/btn:translate-x-1"
              >
                ↗
              </span>
            </button>
          </a>
        </div>
      </div>
    </div>
  </div>
</article>
