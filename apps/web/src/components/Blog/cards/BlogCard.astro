---
import type { BlogPost } from "@/data/blogPosts"
import { formatViewsCount, getCategorySlug } from "@/data/blogPosts"
import { HugeiconsIcon } from "@hugeicons/react"
import {
  FavouriteIcon,
  Comment01Icon,
  ViewIcon,
  Clock01Icon,
} from "@hugeicons/core-free-icons"

interface Props {
  post: BlogPost
  isInitiallyVisible?: boolean
  class?: string
}

const { post, isInitiallyVisible = true, class: className = "" } = Astro.props
const catColor =
  post.categoryColor && post.categoryColor.startsWith("#")
    ? post.categoryColor
    : undefined
const categorySlug = getCategorySlug(post.categorySlug || post.category)
---

<article
  data-blog-card
  data-category={post.category.toLowerCase()}
  data-title={post.title.toLowerCase()}
  data-summary={(post.summary || "").toLowerCase()}
  data-tags={(post.tags || []).join(",").toLowerCase()}
  class={`group relative flex flex-col overflow-hidden bg-background border-border transition-all duration-300 hover:bg-card/60 hover:shadow-[0_0_0_1px_oklch(var(--primary)/20%),0_4px_24px_-4px_oklch(var(--primary)/10%)] ${
    isInitiallyVisible ? "flex" : "hidden"
  } ${className}`}
>
  {/* Corner brackets — site-standard */}

  {/* Thumbnail */}
  <div
    class="relative aspect-[16/9] w-full overflow-hidden bg-muted/30 before:pointer-events-none before:absolute before:inset-0 before:z-10 before:bg-[linear-gradient(105deg,transparent_40%,oklch(var(--primary)/12%)_50%,transparent_60%)] before:bg-[length:200%_100%] before:transition-all before:duration-700 after:pointer-events-none after:absolute after:inset-0 after:bg-[repeating-linear-gradient(0deg,transparent,transparent_2px,rgba(0,0,0,0.04)_2px,rgba(0,0,0,0.04)_4px)] after:opacity-60 after:transition-opacity after:duration-400 group-hover:after:opacity-0 hover:before:bg-[-100%_0]"
  >
    <img
      src={post.thumbnail}
      alt={post.title}
      class="h-full w-full object-cover grayscale transition-all duration-700 ease-out group-hover:scale-105 group-hover:grayscale-0"
      loading="lazy"
    />
    <!-- Gradient overlay -->
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/80 via-background/20 to-transparent"
    >
    </div>

    <!-- Category badge -->
    <div class="absolute bottom-3 left-3 z-20">
      <a
        href={`/blog/category/${categorySlug}`}
        class="inline-block transition-transform duration-150 hover:scale-105"
      >
        <span
          style={catColor
            ? {
                borderColor: `${catColor}60`,
                backgroundColor: `${catColor}18`,
                color: catColor,
                boxShadow: `0 0 10px ${catColor}25`,
              }
            : undefined}
          class="inline-flex items-center gap-1.5 border border-primary/40 bg-background/90 px-2.5 py-1 font-mono text-[10px] font-bold text-primary uppercase shadow-xs backdrop-blur-md"
        >
          <span
            style={catColor
              ? {
                  backgroundColor: catColor,
                  boxShadow: `0 0 6px ${catColor}`,
                }
              : undefined}
            class="h-1.5 w-1.5 rounded-full bg-primary shadow-[0_0_5px_oklch(var(--primary)/80%)]"
          ></span>
          {post.category}
        </span>
      </a>
    </div>
  </div>

  {/* Content */}
  <div class="flex flex-1 flex-col justify-between p-5">
    <div>
      {/* Meta row: date + read time */}
      <div
        class="flex items-center justify-between font-mono text-[10px] tracking-wider text-muted-foreground uppercase"
      >
        <span class="flex items-center gap-1.5">
          <span class="text-primary/60">//</span>
          <span>{post.date}</span>
        </span>
        {
          post.readTime && (
            <span class="flex items-center gap-1 border border-border/70 bg-muted/30 px-2 py-0.5 text-[9px]">
              <HugeiconsIcon
                icon={Clock01Icon}
                className="size-2.5 text-primary/60"
              />
              {post.readTime}
            </span>
          )
        }
      </div>

      {/* Title */}
      <h3
        class="mt-3 line-clamp-2 text-base leading-snug font-black tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary sm:text-lg"
      >
        <a href={`/blog/${post.slug}`} class="focus:outline-none">
          <span class="absolute inset-0 z-10" aria-hidden="true"></span>
          {post.title}
        </a>
      </h3>

      {/* Summary */}
      <p
        class="mt-2 line-clamp-2 text-xs leading-relaxed text-muted-foreground sm:text-sm"
      >
        {post.summary}
      </p>

      {/* Tags */}
      {
        post.tags && post.tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-1">
            {post.tags.slice(0, 3).map((tag) => (
              <span class="inline-flex items-center border border-border/70 bg-muted/20 px-2 py-0.5 font-mono text-[9px] font-medium text-muted-foreground transition-colors group-hover:border-primary/30 group-hover:text-foreground">
                #{tag}
              </span>
            ))}
          </div>
        )
      }
    </div>

    {/* Footer */}
    <div
      class="mt-4 flex items-center justify-between gap-2 border-t border-border/40 pt-3"
    >
      {/* Author */}
      <div class="flex min-w-0 items-center gap-2">
        {
          post.author.avatar ? (
            <img
              src={post.author.avatar}
              alt={post.author.name}
              class="h-6 w-6 shrink-0 rounded-full border border-primary/30 object-cover shadow-[0_0_6px_oklch(var(--primary)/15%)]"
            />
          ) : (
            <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-primary/30 bg-primary/10 font-mono text-[10px] font-bold text-primary">
              {post.author.name.charAt(0)}
            </div>
          )
        }
        <span
          class="truncate font-mono text-xs font-semibold text-foreground transition-colors group-hover:text-primary"
        >
          {post.author.name}
        </span>
      </div>

      {/* Stats + arrow */}
      <div class="flex shrink-0 items-center gap-2.5 font-mono text-[10px]">
        {
          post.views && (
            <span
              class="inline-flex items-center gap-1 text-muted-foreground transition-colors group-hover:text-foreground"
              title={`${post.views} views`}
            >
              <HugeiconsIcon
                icon={ViewIcon}
                className="size-3 text-primary/60"
              />
              <span>{formatViewsCount(post.views)}</span>
            </span>
          )
        }
        {
          post.likesCount !== undefined && (
            <span
              class="inline-flex items-center gap-1 text-rose-400/70 transition-colors group-hover:text-rose-400"
              title={`${post.likesCount} likes`}
            >
              <HugeiconsIcon
                icon={FavouriteIcon}
                className="size-3 fill-rose-400/25 text-rose-400"
              />
              <span>{post.likesCount}</span>
            </span>
          )
        }
        {
          post.commentsCount !== undefined && (
            <span
              class="inline-flex items-center gap-1 text-primary/70 transition-colors group-hover:text-primary"
              title={`${post.commentsCount} comments`}
            >
              <HugeiconsIcon icon={Comment01Icon} className="size-3" />
              <span>{post.commentsCount}</span>
            </span>
          )
        }
        <span
          class="text-primary transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          aria-hidden="true"
        >
          ↗
        </span>
      </div>
    </div>
  </div>
</article>
