---
import { Badge } from "@workspace/ui/components/badge"
import { Button } from "@workspace/ui/components/button"
import type { BlogPost } from "@/data/blogPosts"

interface Props {
  post: BlogPost
}

const { post } = Astro.props
---

<article class="mx-auto max-w-4xl px-4 py-10">
  {/* Header Metadata & Title */}
  <div class="border-b border-border/80 pb-8">
    <div class="mb-4 flex flex-wrap items-center gap-2">
      <a href="/blog">
        <Button variant="outline" size="sm" class="h-7 gap-1 font-mono text-xs text-muted-foreground hover:text-primary">
          ← Back to Articles
        </Button>
      </a>
      <Badge variant="outline" class="border-primary/40 bg-primary/10 font-mono text-xs text-primary uppercase">
        {post.category}
      </Badge>
      {post.featured && (
        <Badge class="bg-primary text-primary-foreground font-mono text-xs uppercase">
          FEATURED STORY
        </Badge>
      )}
    </div>

    <h1 class="text-3xl font-black tracking-tight text-foreground sm:text-5xl">
      {post.title}
    </h1>

    {post.subtitle && (
      <p class="mt-3 text-lg font-medium text-muted-foreground sm:text-xl">
        {post.subtitle}
      </p>
    )}

    {/* Author & Reading Meta bar */}
    <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-border/60 pt-6">
      <div class="flex items-center gap-3">
        <img
          src={post.author.avatar}
          alt={post.author.name}
          class="h-10 w-10 rounded-full border border-primary/40 object-cover"
        />
        <div>
          <p class="font-mono text-sm font-bold text-foreground">
            {post.author.name}
          </p>
          <p class="text-xs text-muted-foreground">
            {post.author.role}
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3 font-mono text-xs text-muted-foreground">
        <span>PUBLISHED {post.date}</span>
        <span class="text-primary">•</span>
        <span>{post.readTime}</span>
        {post.views && (
          <>
            <span class="text-primary">•</span>
            <span>{post.views} VIEWS</span>
          </>
        )}
      </div>
    </div>
  </div>

  {/* Main Thumbnail Hero Image */}
  <div class="relative my-8 aspect-[16/9] w-full overflow-hidden border border-border bg-muted/30">
    <img
      src={post.thumbnail}
      alt={post.title}
      class="h-full w-full object-cover"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/60 via-transparent to-transparent"></div>
  </div>

  {/* Key Takeaways Callout Box */}
  {post.keyTakeaways && post.keyTakeaways.length > 0 && (
    <div class="relative my-8 overflow-hidden border border-primary/30 bg-primary/5 p-6 backdrop-blur-sm">
      <div class="pointer-events-none absolute top-2 left-2 z-10 h-3 w-3 border-t border-l border-primary"></div>
      <div class="pointer-events-none absolute top-2 right-2 z-10 h-3 w-3 border-t border-r border-primary"></div>
      <div class="pointer-events-none absolute bottom-2 left-2 z-10 h-3 w-3 border-b border-l border-primary"></div>
      <div class="pointer-events-none absolute right-2 bottom-2 z-10 h-3 w-3 border-r border-b border-primary"></div>

      <h3 class="font-mono text-xs font-bold tracking-widest text-primary uppercase">
        // KEY TAKEAWAYS & HIGHLIGHTS
      </h3>
      <ul class="mt-3 space-y-2 text-sm text-foreground/90">
        {post.keyTakeaways.map((item) => (
          <li class="flex items-start gap-2.5">
            <span class="mt-1 text-primary">⚡</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  )}

  {/* Article Body Content */}
  <div class="prose prose-invert max-w-none space-y-8 text-foreground/90 leading-relaxed">
    <p class="text-lg text-muted-foreground leading-relaxed">
      {post.summary}
    </p>

    {post.sections && post.sections.length > 0 ? (
      post.sections.map((sec) => (
        <section class="space-y-4 pt-4">
          <h2 class="text-2xl font-bold tracking-tight text-foreground border-b border-border/40 pb-2">
            {sec.heading}
          </h2>
          <p class="text-base text-muted-foreground leading-relaxed">
            {sec.body}
          </p>

          {sec.codeSnippet && (
            <div class="relative my-4 overflow-hidden border border-border bg-slate-950 p-4 font-mono text-xs text-slate-100">
              <div class="mb-2 flex items-center justify-between border-b border-slate-800 pb-2 font-mono text-[10px] text-slate-400">
                <span>{sec.codeSnippet.language.toUpperCase()}</span>
                <span>SNIPPET</span>
              </div>
              <pre class="overflow-x-auto p-2">
                <code>{sec.codeSnippet.code}</code>
              </pre>
            </div>
          )}
        </section>
      ))
    ) : (
      <div class="space-y-4 pt-4">
        <p class="text-base text-muted-foreground leading-relaxed">
          Full technical postmortem and detailed code examples for {post.title} continue in this article. Check back regularly for detailed benchmarks and code references.
        </p>
      </div>
    )}
  </div>

  {/* Article Footer: Tags & Share */}
  <div class="mt-12 border-t border-border/80 pt-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="font-mono text-xs text-muted-foreground">TAGS:</span>
        {post.tags.map((tag) => (
          <Badge variant="secondary" class="font-mono text-xs">
            #{tag}
          </Badge>
        ))}
      </div>

      <a href="/blog">
        <Button variant="outline" size="sm" class="font-mono text-xs gap-1">
          ← All Articles
        </Button>
      </a>
    </div>
  </div>
</article>
