---
interface SectionItem {
  heading: string
}

interface Props {
  sections: SectionItem[]
}

const { sections = [] } = Astro.props

const tocItems = sections.map((sec, i) => ({
  id: `section-${i + 1}`,
  title: sec.heading,
}))
---

{
  tocItems.length > 0 && (
    <div class="w-full h-full">
      {/* Mobile Collapsible TOC */}
      <details class="group mb-8 border border-border bg-background/80 p-4 lg:hidden">
        <summary class="flex cursor-pointer items-center justify-between font-mono text-xs font-bold tracking-widest text-primary uppercase select-none">
          <span>// TABLE OF CONTENTS ({tocItems.length})</span>
          <span class="transition-transform duration-200 group-open:rotate-180">↓</span>
        </summary>
        <nav class="mt-3 border-t border-border/60 pt-3">
          <ul class="space-y-2 font-mono text-xs text-muted-foreground">
            {tocItems.map((item) => (
              <li>
                <a
                  href={`#${item.id}`}
                  class="toc-mobile-link hover:text-primary transition-colors block py-1 border-l border-transparent pl-2"
                >
                  → {item.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>

      {/* Desktop Sticky Right Sidebar TOC */}
      <div class="hidden lg:block sticky top-24 border border-border/80 bg-background/80 p-6 backdrop-blur-md transition-all duration-300 toc-container">
        {/* Cyberpunk corner brackets */}
        <div class="pointer-events-none absolute top-2 left-2 z-10 h-3 w-3 border-t border-l border-border" />
        <div class="pointer-events-none absolute top-2 right-2 z-10 h-3 w-3 border-t border-r border-border" />
        <div class="pointer-events-none absolute bottom-2 left-2 z-10 h-3 w-3 border-b border-l border-border" />
        <div class="pointer-events-none absolute right-2 bottom-2 z-10 h-3 w-3 border-r border-b border-border" />

        <div class="flex items-center justify-between border-b border-border/60 pb-3 mb-4">
          <h3 class="font-mono text-xs font-bold tracking-widest text-primary uppercase">
            // TABLE OF CONTENTS
          </h3>
          <span class="font-mono text-[10px] text-muted-foreground">
            {tocItems.length} SECTIONS
          </span>
        </div>

        <nav aria-label="Table of Contents" class="toc-nav-scrollable">
          <ul id="toc-list" class="relative space-y-1 font-mono text-xs">
            {tocItems.map((item, index) => (
              <li class="toc-item" style={`--toc-index: ${index};`}>
                <a
                  href={`#${item.id}`}
                  data-toc-link={item.id}
                  class={`toc-link group relative flex items-center justify-between rounded-sm px-3 py-2 text-muted-foreground transition-all duration-300 ease-out hover:bg-muted/40 hover:text-foreground ${
                    index === 0 ? "toc-active bg-primary/10 border-l-2 border-primary text-primary font-bold" : ""
                  }`}
                >
                  <span class="line-clamp-2 transition-colors">{item.title}</span>
                  <span class="text-[10px] opacity-40 group-hover:opacity-100 transition-opacity shrink-0 ml-2">
                    #0{index + 1}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        {/* Reading Progress Section */}
        <div class="mt-5 border-t border-border/60 pt-4 space-y-3">
          {/* Progress Bar */}
          <div class="space-y-1.5">
            <div class="flex items-center justify-between font-mono text-[10px] text-muted-foreground">
              <span>READING PROGRESS</span>
              <span id="toc-progress-pct" class="tabular-nums text-primary font-bold">0%</span>
            </div>
            <div class="h-1 w-full overflow-hidden bg-border/40 rounded-full">
              <div
                id="toc-progress-bar"
                class="h-full bg-primary rounded-full transition-[width] duration-300 ease-out"
                style="width: 0%"
              />
            </div>
          </div>

          <a
            href="#article-top"
            class="toc-mobile-link flex items-center justify-center gap-1.5 text-[11px] font-mono text-muted-foreground transition-all duration-200 hover:text-primary hover:-translate-y-0.5 py-1"
          >
            ↑ BACK TO TOP
          </a>
        </div>
      </div>
    </div>
  )
}

<style>
  /* Stagger fade-in animation for TOC items */
  @keyframes toc-fade-in {
    from {
      opacity: 0;
      transform: translateX(12px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .toc-item {
    opacity: 0;
    animation: toc-fade-in 0.4s ease-out forwards;
    animation-delay: calc(var(--toc-index, 0) * 0.06s + 0.3s);
  }

  /* Active link glow effect */
  .toc-link.toc-active {
    box-shadow: 0 0 12px oklch(var(--primary) / 10%);
  }

  /* Scrollable TOC for many sections */
  .toc-nav-scrollable {
    max-height: calc(100vh - 340px);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: oklch(var(--primary) / 30%) transparent;
  }

  .toc-nav-scrollable::-webkit-scrollbar {
    width: 3px;
  }

  .toc-nav-scrollable::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-nav-scrollable::-webkit-scrollbar-thumb {
    background: oklch(var(--primary) / 30%);
    border-radius: 100px;
  }

  /* Container subtle border glow on scroll */
  .toc-container {
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .toc-container.toc-scrolled {
    border-color: oklch(var(--primary) / 25%);
    box-shadow: 0 0 20px oklch(var(--primary) / 5%);
  }
</style>

<script>
  // Scrollspy, Smooth Scroll, & Reading Progress Script
  function initTocBehavior() {
    const tocLinks = document.querySelectorAll("[data-toc-link]")
    const sections = document.querySelectorAll("[data-article-section]")
    const progressBar = document.getElementById("toc-progress-bar")
    const progressPct = document.getElementById("toc-progress-pct")
    const tocContainer = document.querySelector(".toc-container")

    if (!tocLinks.length || !sections.length) return

    // --- Smooth scroll on TOC link click ---
    tocLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault()
        const targetId = link.getAttribute("data-toc-link")
        if (!targetId) return
        const target = document.getElementById(targetId)
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "start" })
          // Update URL hash without jumping
          history.replaceState(null, "", `#${targetId}`)
        }
      })
    })

    // Mobile TOC links also get smooth scroll
    document.querySelectorAll(".toc-mobile-link").forEach((link) => {
      link.addEventListener("click", (e) => {
        const href = link.getAttribute("href")
        if (!href || !href.startsWith("#")) return
        e.preventDefault()
        const target = document.getElementById(href.slice(1))
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "start" })
          history.replaceState(null, "", href)
        }
      })
    })

    // --- Scrollspy with IntersectionObserver ---
    const observerOptions = {
      root: null,
      rootMargin: "-20% 0px -50% 0px",
      threshold: 0,
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const activeId = entry.target.getAttribute("id")

          tocLinks.forEach((link) => {
            const targetId = link.getAttribute("data-toc-link")
            if (targetId === activeId) {
              link.classList.add(
                "toc-active",
                "bg-primary/10",
                "border-l-2",
                "border-primary",
                "text-primary",
                "font-bold"
              )
              link.classList.remove("text-muted-foreground")

              // Scroll TOC item into view if needed
              const tocNav = link.closest(".toc-nav-scrollable")
              if (tocNav) {
                const linkEl = link as HTMLElement
                const navEl = tocNav as HTMLElement
                const linkTop = linkEl.offsetTop - navEl.offsetTop
                const navScroll = navEl.scrollTop
                const navHeight = navEl.clientHeight
                if (linkTop < navScroll || linkTop > navScroll + navHeight - 40) {
                  navEl.scrollTo({ top: linkTop - navHeight / 3, behavior: "smooth" })
                }
              }
            } else {
              link.classList.remove(
                "toc-active",
                "bg-primary/10",
                "border-l-2",
                "border-primary",
                "text-primary",
                "font-bold"
              )
              link.classList.add("text-muted-foreground")
            }
          })
        }
      })
    }, observerOptions)

    sections.forEach((section) => observer.observe(section))

    // --- Reading Progress Bar ---
    function updateProgress() {
      const article = document.querySelector("article")
      if (!article || !progressBar || !progressPct) return

      const articleRect = article.getBoundingClientRect()
      const articleTop = articleRect.top + window.scrollY
      const articleHeight = article.scrollHeight
      const windowHeight = window.innerHeight
      const scrollY = window.scrollY

      // Calculate how far we've scrolled through the article
      const scrolled = scrollY - articleTop + windowHeight * 0.3
      const total = articleHeight - windowHeight * 0.5
      const progress = Math.max(0, Math.min(100, (scrolled / total) * 100))

      progressBar.style.width = `${progress}%`
      progressPct.textContent = `${Math.round(progress)}%`

      // Add subtle glow to TOC container when scrolled
      if (tocContainer) {
        if (progress > 5 && progress < 100) {
          tocContainer.classList.add("toc-scrolled")
        } else {
          tocContainer.classList.remove("toc-scrolled")
        }
      }
    }

    // Throttled scroll handler
    let ticking = false
    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateProgress()
          ticking = false
        })
        ticking = true
      }
    })

    // Initial progress calculation
    updateProgress()
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTocBehavior)
  } else {
    initTocBehavior()
  }
  document.addEventListener("astro:page-load", initTocBehavior)
</script>
