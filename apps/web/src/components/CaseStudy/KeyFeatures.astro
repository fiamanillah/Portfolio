---
import CaseStudySectionTitle from "@/components/CaseStudy/CaseStudySectionTitle.astro"

interface Feature {
  title: string
  description: string
  mediaType: string
  mediaLabel: string
  media: string
}

interface Props {
  features: Feature[]
}

const { features } = Astro.props as Props
---

<section class="space-y-5">
  <CaseStudySectionTitle label="[ SEC_03 // KEY_FEATURES ]" />
  <div class="space-y-6">
    {
      features.map((feature, index) => (
        <article
          class={`group relative overflow-hidden rounded-lg border border-border/80 bg-card/60 shadow-sm transition-colors duration-300 hover:border-primary/30 lg:grid lg:grid-cols-[2fr_3fr] lg:items-stretch ${index % 2 ? "lg:[&>*:first-child]:order-2 lg:grid-cols-[3fr_2fr]" : ""}`}
        >
          {/* Corner brackets */}
          <div class="pointer-events-none absolute left-0 top-0 h-3 w-3 border-l-[1.5px] border-t-[1.5px] border-primary/30" />
          <div class="pointer-events-none absolute right-0 top-0 h-3 w-3 border-r-[1.5px] border-t-[1.5px] border-primary/30" />
          <div class="pointer-events-none absolute bottom-0 left-0 h-3 w-3 border-b-[1.5px] border-l-[1.5px] border-primary/30" />
          <div class="pointer-events-none absolute bottom-0 right-0 h-3 w-3 border-b-[1.5px] border-r-[1.5px] border-primary/30" />

          {/* Content Side */}
          <div class="relative z-10 flex flex-col justify-between gap-5 p-6 lg:p-8">
            <div class="space-y-4">
              {/* Feature index + type badge row */}
              <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-primary/20 bg-primary/10 font-mono text-xs font-bold text-primary">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="font-mono text-[10px] tracking-[0.2em] text-muted-foreground/60 uppercase">
                    Feature {String(index + 1).padStart(2, "0")}
                  </span>
                </div>
                <div class="inline-flex items-center gap-2 rounded-md border border-border bg-muted/40 px-2.5 py-1">
                  <span class="h-1.5 w-1.5 rounded-full bg-primary" />
                  <span class="font-mono text-[9px] tracking-[0.18em] text-muted-foreground uppercase">
                    {feature.mediaType}
                  </span>
                </div>
              </div>

              {/* Title */}
              <h3 class="text-xl font-bold tracking-tight text-foreground sm:text-2xl">
                {feature.title}
              </h3>

              {/* Description */}
              <p class="max-w-[60ch] text-sm leading-7 text-muted-foreground">
                {feature.description}
              </p>
            </div>

            {/* Footer */}
            <div class="flex items-center gap-3 border-t border-border/50 pt-4">
              <span class="h-px w-5 bg-primary/40" />
              <span class="font-mono text-[10px] tracking-[0.15em] text-muted-foreground uppercase">
                {feature.mediaLabel}
              </span>
            </div>
          </div>

          {/* Media Container */}
          <div class={`relative z-10 overflow-hidden border-border/50 bg-background/50 ${index % 2 ? "lg:border-r" : "lg:border-l"}`}>
            {feature.mediaType === "Code Snippet" ? (
              <div class="flex h-full flex-col">
                {/* Code editor header */}
                <div class="flex items-center justify-between border-b border-border/60 bg-muted/30 px-4 py-2.5">
                  <div class="flex items-center gap-2">
                    <span class="h-2.5 w-2.5 rounded-full bg-rose-500/70" />
                    <span class="h-2.5 w-2.5 rounded-full bg-amber-500/70" />
                    <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/70" />
                  </div>
                  <span class="font-mono text-[10px] tracking-[0.15em] text-muted-foreground/70 uppercase">
                    snippet.ts
                  </span>
                </div>
                <pre class="m-0 flex-1 overflow-auto bg-background/30 p-5 text-xs leading-6 text-foreground max-h-105">
                  <code>{feature.media}</code>
                </pre>
              </div>
            ) : (
              <figure class="relative m-0 h-full min-h-72 w-full overflow-hidden">
                <img
                  src={feature.media}
                  alt={feature.mediaLabel}
                  class="h-full w-full object-cover"
                />
              </figure>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
