---
import CaseStudySectionTitle from "@/components/CaseStudy/CaseStudySectionTitle.astro"

interface Feature {
  title: string
  description: string
  mediaType: string
  mediaLabel: string
  media: string
  tags?: string[]
  highlights?: string[]
}

interface Props {
  features: Feature[]
}

const { features } = Astro.props as Props
---

<section class="space-y-6">
  <CaseStudySectionTitle label="[ SEC_03 // KEY_FEATURES ]" />

  <div class="space-y-8 px-5 md:px-6 lg:px-8">
    {
      features.map((feature, index) => {
        return (
          <article class="group overflow-hidden rounded-lg border border-border/70 bg-card/40 transition-colors duration-200 hover:border-border">
            <div class="grid lg:grid-cols-12 lg:items-stretch">
              {/* Content Side */}
              <div class="flex flex-col justify-between gap-6 p-6 sm:p-8 lg:col-span-6">
                <div class="space-y-4">
                  {/* Meta Header */}
                  <div class="flex items-center gap-3">
                    <span class="font-mono text-xs font-semibold text-primary">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="text-xs text-muted-foreground/40">•</span>
                    <span class="font-mono text-xs tracking-wider text-muted-foreground uppercase">
                      {feature.mediaLabel || feature.mediaType}
                    </span>
                  </div>

                  {/* Title & Description */}
                  <div class="space-y-2">
                    <h3 class="text-xl font-bold tracking-tight text-foreground sm:text-2xl">
                      {feature.title}
                    </h3>
                    <p class="text-sm leading-relaxed text-muted-foreground">
                      {feature.description}
                    </p>
                  </div>

                  {/* Highlights List */}
                  {feature.highlights && feature.highlights.length > 0 && (
                    <ul class="space-y-2 pt-1">
                      {feature.highlights.map((highlight) => (
                        <li class="flex items-start gap-2.5 text-xs text-muted-foreground">
                          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary/70" />
                          <span>{highlight}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>

                {/* Tech Tags */}
                {feature.tags && feature.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 pt-2">
                    {feature.tags.map((tag) => (
                      <span class="rounded-md border border-border/50 bg-muted/40 px-2.5 py-1 font-mono text-xs text-muted-foreground">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              {/* Image Side */}
              <div class="relative min-h-[260px] overflow-hidden bg-muted/20 lg:col-span-6">
                <img
                  src={feature.media}
                  alt={feature.mediaLabel || feature.title}
                  class="h-full w-full object-cover object-top"
                />
              </div>
            </div>
          </article>
        )
      })
    }
  </div>
</section>
