---
import CaseStudySectionTitle from "@/components/CaseStudy/CaseStudySectionTitle.astro"

interface Feature {
  title: string
  description: string
  mediaType: string
  mediaLabel: string
  media: string
  tags?: string[]
  highlights?: string[]
}

interface Props {
  features: Feature[]
}

const { features } = Astro.props as Props
---

<section class="space-y-8">
  <CaseStudySectionTitle
    label="[ SEC_03 // CORE_CAPABILITIES_&_IMPLEMENTATION ]"
  />

  <div class="space-y-8 px-4 sm:px-6 lg:px-8">
    {
      features.map((feature, index) => {
        return (
          <article class="group relative overflow-hidden border border-border bg-card/50 transition-all duration-300 hover:border-primary/50 hover:bg-card/80 hover:shadow-[0_0_0_1px_oklch(var(--primary)/15%)]">
            {/* Corner brackets */}
            <div class="pointer-events-none absolute top-2 left-2 z-20 h-3 w-3 border-t-[1.5px] border-l-[1.5px] border-border transition-colors group-hover:border-primary" />
            <div class="pointer-events-none absolute top-2 right-2 z-20 h-3 w-3 border-t-[1.5px] border-r-[1.5px] border-border transition-colors group-hover:border-primary" />
            <div class="pointer-events-none absolute bottom-2 left-2 z-20 h-3 w-3 border-b-[1.5px] border-l-[1.5px] border-border transition-colors group-hover:border-primary" />
            <div class="pointer-events-none absolute right-2 bottom-2 z-20 h-3 w-3 border-r-[1.5px] border-b-[1.5px] border-border transition-colors group-hover:border-primary" />

            <div class="grid lg:grid-cols-12 lg:items-stretch">
              {/* Content Column */}
              <div class="flex flex-col justify-between gap-6 p-6 sm:p-8 lg:col-span-6">
                <div class="space-y-4">
                  {/* Meta Header */}
                  <div class="flex items-center justify-between border-b border-border/50 pb-3">
                    <div class="flex items-center gap-2 font-mono text-xs">
                      <span class="font-bold text-primary">
                        FEATURE_{String(index + 1).padStart(2, "0")}
                      </span>
                      <span class="text-muted-foreground/40">•</span>
                      <span class="tracking-wider text-muted-foreground uppercase">
                        {feature.mediaLabel || feature.mediaType}
                      </span>
                    </div>
                  </div>

                  {/* Title & Description */}
                  <div class="space-y-2">
                    <h3 class="text-xl font-bold tracking-tight text-foreground transition-colors group-hover:text-primary sm:text-2xl">
                      {feature.title}
                    </h3>
                    <p class="text-sm leading-relaxed text-muted-foreground">
                      {feature.description}
                    </p>
                  </div>

                  {/* Highlights Checklist */}
                  {feature.highlights && feature.highlights.length > 0 && (
                    <ul class="space-y-2 pt-2">
                      {feature.highlights.map((highlight) => (
                        <li class="flex items-start gap-2.5 text-xs text-muted-foreground">
                          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary shadow-[0_0_4px_oklch(var(--primary))]" />
                          <span class="leading-relaxed">{highlight}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>

                {/* Tech Tags */}
                {feature.tags && feature.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 border-t border-border/40 pt-4">
                    {feature.tags.map((tag) => (
                      <span class="border border-border/80 bg-muted/30 px-2 py-0.5 font-mono text-[10px] font-medium text-muted-foreground transition-colors group-hover:border-primary/40 group-hover:text-foreground">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              {/* Image Viewport Column (16:9 aspect ratio with vertical scrolling for tall captures) */}
              <div class="relative flex flex-col justify-center overflow-hidden border-t border-border bg-muted/20 lg:col-span-6 lg:border-t-0 lg:border-l">
                <div class="relative aspect-video w-full overflow-hidden bg-background/50">
                  {/* Scrollable image container */}
                  <div
                    tabindex="0"
                    role="region"
                    aria-label={`Scrollable preview for ${feature.title}`}
                    class="h-full w-full overflow-x-hidden overflow-y-auto [scrollbar-color:oklch(var(--primary)/40%)_transparent] [scrollbar-width:thin] focus:outline-none [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-primary/30 hover:[&::-webkit-scrollbar-thumb]:bg-primary/60 [&::-webkit-scrollbar-track]:bg-transparent"
                  >
                    <div class="flex min-h-full w-full flex-col justify-center">
                      <img
                        src={feature.media}
                        alt={feature.mediaLabel || feature.title}
                        class="block h-auto w-full grayscale-[10%] transition-[filter] duration-300 group-hover:grayscale-0"
                        loading="lazy"
                      />
                    </div>
                  </div>

                  {/* Corner accents & scanline overlay */}
                  <div class="pointer-events-none absolute inset-0 z-10 before:absolute before:inset-0 before:bg-[linear-gradient(105deg,transparent_40%,oklch(var(--primary)/8%)_50%,transparent_60%)] before:bg-[length:200%_100%] after:absolute after:inset-0 after:bg-[repeating-linear-gradient(0deg,transparent,transparent_2px,rgba(0,0,0,0.03)_2px,rgba(0,0,0,0.03)_4px)]" />

                  {/* Full Resolution Link on Hover */}
                  <a
                    href={feature.media}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Open ${feature.title} image in full resolution`}
                    class="absolute top-2.5 right-2.5 z-20 flex size-7 items-center justify-center rounded-sm border border-border/80 bg-background/80 text-muted-foreground opacity-0 backdrop-blur-md transition-all group-hover:opacity-100 hover:border-primary hover:text-primary"
                    title="Open full resolution in new tab"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </article>
        )
      })
    }
  </div>
</section>
