---
import CaseStudySectionTitle from "@/components/CaseStudy/CaseStudySectionTitle.astro"
import { HugeiconsIcon } from "@hugeicons/react"
import { ArrowRight01Icon } from "@hugeicons/core-free-icons"

interface Layer {
  name: string
  description: string
  tech?: string[]
  items?: { title: string; subtitle?: string }[]
}

interface Props {
  layers: Layer[]
}

const { layers } = Astro.props as Props
---

<section class="space-y-8">
  <CaseStudySectionTitle label="[ SEC_02 // SYSTEM_TOPOLOGY_&_DATA_FLOW ]" />

  <div class="px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        layers.map((layer, index) => {
          const items = ((layer.items ??
            layer.tech?.map((t) => ({ title: t }))) ||
            []) as { title: string; subtitle?: string }[]

          return (
            <article class="group relative flex flex-col justify-between overflow-hidden border border-border bg-card/50 p-5 transition-all duration-300 hover:border-primary/50 hover:bg-card/80 hover:shadow-[0_0_0_1px_oklch(var(--primary)/15%)] sm:p-6">
              {/* Corner bracket accents */}
              <div class="pointer-events-none absolute top-2 left-2 z-10 h-3 w-3 border-t-[1.5px] border-l-[1.5px] border-border transition-colors group-hover:border-primary" />
              <div class="pointer-events-none absolute top-2 right-2 z-10 h-3 w-3 border-t-[1.5px] border-r-[1.5px] border-border transition-colors group-hover:border-primary" />
              <div class="pointer-events-none absolute bottom-2 left-2 z-10 h-3 w-3 border-b-[1.5px] border-l-[1.5px] border-border transition-colors group-hover:border-primary" />
              <div class="pointer-events-none absolute right-2 bottom-2 z-10 h-3 w-3 border-r-[1.5px] border-b-[1.5px] border-border transition-colors group-hover:border-primary" />

              <div class="space-y-4">
                {/* Header */}
                <div class="flex items-center justify-between border-b border-border/60 pb-3">
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-xs font-black text-primary">
                      TIER_{String(index + 1).padStart(2, "0")}
                    </span>
                  </div>
                  <span class="rounded-xs border border-primary/30 bg-primary/10 px-2 py-0.5 font-mono text-[9px] font-bold text-primary uppercase">
                    STAGE #{index + 1}
                  </span>
                </div>

                <div>
                  <h3 class="text-base font-bold tracking-tight text-foreground transition-colors group-hover:text-primary sm:text-lg">
                    {layer.name}
                  </h3>
                  <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                    {layer.description}
                  </p>
                </div>

                {/* Sub-components / Tech items */}
                {items.length > 0 && (
                  <div class="space-y-2 pt-2">
                    <span class="font-mono text-[9px] font-semibold tracking-wider text-muted-foreground/70 uppercase">
                      // COMPONENTS
                    </span>
                    <div class="space-y-1.5">
                      {items.map((entry) => (
                        <div class="rounded-sm border border-border/70 bg-muted/20 p-2.5 transition-colors hover:border-primary/40 hover:bg-muted/40">
                          <p class="text-xs font-semibold text-foreground">
                            {entry.title}
                          </p>
                          {entry.subtitle && (
                            <p class="mt-0.5 font-mono text-[10px] text-muted-foreground">
                              {entry.subtitle}
                            </p>
                          )}
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              {/* Data Flow Direction Footnote */}
              <div class="mt-6 flex items-center justify-between border-t border-border/40 pt-3 font-mono text-[9px] text-muted-foreground/60 uppercase">
                <span>
                  FLOW:{" "}
                  {index === 0
                    ? "INGRESS"
                    : index === layers.length - 1
                      ? "STORAGE"
                      : "TRANSIT"}
                </span>
                <HugeiconsIcon
                  icon={ArrowRight01Icon}
                  className="size-3 text-primary/70"
                />
              </div>
            </article>
          )
        })
      }
    </div>
  </div>
</section>
