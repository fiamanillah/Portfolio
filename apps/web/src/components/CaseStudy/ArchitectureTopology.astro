---
import CaseStudySectionTitle from "@/components/CaseStudy/CaseStudySectionTitle.astro"

interface Layer {
  name: string
  description: string
  tech?: string[]
  items?: { title: string; subtitle?: string }[]
}

interface Props {
  layers: Layer[]
}

const { layers } = Astro.props as Props
---

<section class="space-y-6">
  <CaseStudySectionTitle label="[ SEC_02 // ARCHITECTURE_TOPOLOGY ]" />

  <div class="px-5 md:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        layers.map((layer, index) => {
          const items = ((layer.items ??
            layer.tech?.map((t: any) => ({ title: t }))) ||
            []) as { title: string; subtitle?: string }[]

          return (
            <article class="flex flex-col justify-between rounded-lg border border-border/70 bg-card/40 p-5 transition-colors duration-200 hover:border-border">
              <div class="space-y-4">
                {/* Header */}
                <div class="flex items-center justify-between border-b border-border/40 pb-3">
                  <h3 class="text-sm font-semibold tracking-tight text-foreground">
                    {layer.name}
                  </h3>
                  <span class="font-mono text-xs font-semibold text-primary">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                </div>

                {/* Description */}
                <p class="text-xs leading-relaxed text-muted-foreground">
                  {layer.description}
                </p>

                {/* Items List */}
                {items.length > 0 && (
                  <div class="space-y-2 pt-1">
                    {items.map((entry) => (
                      <div class="rounded-md border border-border/40 bg-muted/20 p-2.5 transition-colors hover:border-border/60">
                        <p class="text-xs font-medium text-foreground">
                          {entry.title}
                        </p>
                        {entry.subtitle && (
                          <p class="mt-0.5 text-[11px] text-muted-foreground/80">
                            {entry.subtitle}
                          </p>
                        )}
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </article>
          )
        })
      }
    </div>
  </div>
</section>
