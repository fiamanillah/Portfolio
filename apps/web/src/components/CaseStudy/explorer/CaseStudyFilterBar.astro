---
import { HugeiconsIcon } from "@hugeicons/react"
import {
  Search01Icon,
  Cancel01Icon,
  FilterIcon,
  BookOpen01Icon,
  Layers01Icon,
  CpuIcon,
} from "@hugeicons/core-free-icons"
import type { ComponentProps } from "astro/types"

type HugeIconType = ComponentProps<typeof HugeiconsIcon>["icon"]

interface CategoryCount {
  id: string
  label: string
  count: number
  icon?: HugeIconType
}

interface Props {
  categories: CategoryCount[]
  techTags: string[]
  totalItems: number
  class?: string
}

const { categories, techTags, totalItems, class: className = "" } = Astro.props
---

<div
  class={`w-full border-b border-border/70 p-5 sm:p-6 space-y-5 bg-background/50 backdrop-blur-sm ${className}`}
>
  <!-- Top Row: Category Tabs & Search Bar -->
  <div
    class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between"
  >
    <!-- Category Tabs -->
    <div class="flex flex-col gap-2">
      <div class="flex items-center gap-2 text-muted-foreground">
        <HugeiconsIcon icon={FilterIcon} className="size-3.5 text-primary" />
        <span class="font-mono text-xs font-semibold tracking-wider uppercase">
          Filter Work:
        </span>
      </div>

      <div
        data-cs-category-group
        class="flex flex-wrap items-center gap-2"
        role="tablist"
        aria-label="Case Study and Project Filters"
      >
        {
          categories.map((cat, idx) => {
            const isActive = idx === 0
            return (
              <button
                type="button"
                role="tab"
                data-cs-filter={cat.id}
                aria-selected={isActive ? "true" : "false"}
                tabindex={isActive ? 0 : -1}
                class={`cs-category-btn group/btn flex cursor-pointer items-center gap-2 border px-3.5 py-1.5 font-mono text-xs transition-all duration-200 select-none focus-visible:ring-1 focus-visible:ring-primary focus-visible:outline-none ${
                  isActive
                    ? "active border-primary bg-primary/10 font-bold text-primary shadow-[0_0_14px_oklch(var(--primary)/20%)]"
                    : "border-border bg-background/50 text-muted-foreground hover:border-primary/40 hover:bg-background/80 hover:text-foreground"
                }`}
              >
                {cat.id === "case-study" && (
                  <HugeiconsIcon icon={BookOpen01Icon} className="size-3.5" />
                )}
                {cat.id === "project-only" && (
                  <HugeiconsIcon icon={CpuIcon} className="size-3.5" />
                )}
                {cat.id === "all" && (
                  <HugeiconsIcon icon={Layers01Icon} className="size-3.5" />
                )}
                <span class="tracking-wide">{cat.label}</span>
                <span
                  data-cs-cat-count={cat.id}
                  class={`inline-flex h-4 min-w-[1.25rem] items-center justify-center rounded-xs px-1.5 font-mono text-[10px] transition-colors ${
                    isActive
                      ? "bg-primary font-bold text-primary-foreground"
                      : "bg-muted text-muted-foreground group-hover/btn:bg-muted/80 group-hover/btn:text-foreground"
                  }`}
                >
                  {cat.count}
                </span>
              </button>
            )
          })
        }
      </div>
    </div>

    <!-- Real-time Search Input & View Toggle -->
    <div class="flex items-center gap-3">
      <div class="relative w-full shrink-0 sm:w-72">
        <label for="cs-search-input" class="sr-only">
          Search case studies by title, stack, architecture keywords
        </label>
        <div
          class="relative flex items-center border border-border bg-background/80 transition-all focus-within:border-primary focus-within:shadow-[0_0_12px_oklch(var(--primary)/15%)]"
        >
          <span
            class="pointer-events-none flex items-center pl-3 text-muted-foreground/70"
          >
            <HugeiconsIcon icon={Search01Icon} className="size-3.5" />
          </span>
          <input
            id="cs-search-input"
            type="text"
            data-cs-search-input
            placeholder="Search systems, stack, tags (/)..."
            autocomplete="off"
            class="w-full bg-transparent py-1.5 pr-8 pl-2 font-sans text-xs text-foreground placeholder:text-muted-foreground/60 focus:outline-none"
          />
          <button
            type="button"
            data-cs-search-clear
            aria-label="Clear search query"
            class="absolute right-2.5 hidden cursor-pointer p-0.5 text-muted-foreground/70 transition-colors hover:text-foreground"
          >
            <HugeiconsIcon icon={Cancel01Icon} className="size-3" />
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Row: Tech Stack Chips & Results Summary -->
  <div
    class="flex flex-wrap items-center justify-between gap-3 border-t border-border/40 pt-4"
  >
    <!-- Tech Tag Filter Chips -->
    <div class="flex flex-wrap items-center gap-1.5">
      <span
        class="mr-1 font-mono text-[10px] tracking-wider text-muted-foreground uppercase"
      >
        Tech:
      </span>
      {
        techTags.map((tech) => (
          <button
            type="button"
            data-cs-tech-chip={tech.toLowerCase()}
            class="cs-tech-chip cursor-pointer border border-border/70 bg-muted/20 px-2 py-0.5 font-mono text-[10px] text-muted-foreground transition-all duration-150 hover:border-primary/50 hover:text-foreground"
          >
            #{tech}
          </button>
        ))
      }
      <button
        type="button"
        data-cs-clear-tech
        class="hidden cursor-pointer border border-dashed border-destructive/50 bg-destructive/10 px-2 py-0.5 font-mono text-[10px] text-destructive transition-colors hover:bg-destructive/20"
      >
        ✕ Reset Tech
      </button>
    </div>

    <!-- Active Count Counter -->
    <div
      class="flex items-center gap-2 font-mono text-[11px] text-muted-foreground"
    >
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-primary"></span>
      <span>
        Showing <strong data-cs-visible-count class="text-primary"
          >{totalItems}</strong
        > solutions
      </span>
    </div>
  </div>
</div>
