---
import CaseStudySectionTitle from "@/components/CaseStudy/CaseStudySectionTitle.astro"

interface Metric {
  value: string
  label: string
}

interface Props {
  metrics: Metric[]
}

const { metrics } = Astro.props as Props
---

<section class="space-y-6">
  <CaseStudySectionTitle label="[ SEC_04 // PERFORMANCE_METRICS ]" />

  <div class="px-5 md:px-6 lg:px-8">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        metrics.map((metric) => (
          <article class="group flex flex-col items-center justify-center rounded-lg border border-border/70 bg-card/40 p-6 text-center transition-colors duration-200 hover:border-border">
            <div class="flex flex-col items-center gap-3">
              <p class="text-4xl font-black tracking-tighter text-foreground transition-colors duration-200 group-hover:text-primary sm:text-5xl">
                {metric.value}
              </p>
              <div class="flex flex-col items-center gap-2">
                <div class="h-px w-6 bg-primary/40" />
                <p class="font-mono text-[10px] tracking-[0.18em] text-muted-foreground uppercase">
                  {metric.label}
                </p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
