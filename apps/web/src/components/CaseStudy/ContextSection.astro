---
import CaseStudySectionTitle from "@/components/CaseStudy/CaseStudySectionTitle.astro"
import { HugeiconsIcon } from "@hugeicons/react"
import { CircleIcon, LightbulbOffIcon } from "@hugeicons/core-free-icons"

interface ContextBlock {
  label: string
  body: string
}

interface Props {
  blocks: ContextBlock[]
}

const { blocks } = Astro.props as Props
---

<section class="space-y-6">
  <CaseStudySectionTitle label="[ SEC_01 // CONTEXT_&_PROBLEM ]" />

  <div class="px-5 md:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      {
        blocks.map((block, i) => (
          <article class="flex flex-col gap-4 rounded-lg border border-border/70 bg-card/40 p-6 transition-colors duration-200 hover:border-border">
            <div class="flex items-center gap-3">
              <div class="flex h-8 w-8 items-center justify-center rounded-md border border-border/60 bg-muted/30 text-primary">
                <HugeiconsIcon
                  icon={i === 0 ? CircleIcon : LightbulbOffIcon}
                  className="size-4"
                />
              </div>
              <h4 class="text-base font-semibold tracking-tight text-foreground">
                {block.label}
              </h4>
            </div>

            <p class="text-sm leading-relaxed text-muted-foreground">{block.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
