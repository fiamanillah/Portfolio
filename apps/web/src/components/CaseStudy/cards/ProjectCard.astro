---
import { Button } from "@workspace/ui/components/button"
import { HugeiconsIcon } from "@hugeicons/react"
import {
  Github,
  Globe02Icon,
} from "@hugeicons/core-free-icons"

interface ProjectProps {
  id: string
  title: string
  subtitle?: string
  description: string
  role: string
  impact?: string
  tech: string[]
  links: {
    live?: string
    github?: string
    caseStudy?: string
  }
  img?: string
  index: string
  status: string
  year: string
  highlights?: string[]
}

interface Props {
  project: ProjectProps
}

const { project } = Astro.props
---

<article
  class="project-card group relative flex flex-col justify-between overflow-hidden border border-border bg-background transition-all duration-300 hover:border-primary/50 hover:bg-card/40 hover:shadow-[0_0_0_1px_oklch(var(--primary)/15%),0_8px_24px_-8px_oklch(var(--primary)/10%)] p-6 sm:p-7"
  data-category="project-only"
  data-title={project.title.toLowerCase()}
  data-tech={project.tech.join(" ").toLowerCase()}
>
  {/* Corner Bracket Accents */}
  <div
    class="pointer-events-none absolute top-2 left-2 z-20 h-3 w-3 border-t-[1.5px] border-l-[1.5px] border-primary/30 transition-all duration-300 group-hover:h-4 group-hover:w-4 group-hover:border-primary"
  >
  </div>
  <div
    class="pointer-events-none absolute top-2 right-2 z-20 h-3 w-3 border-t-[1.5px] border-r-[1.5px] border-primary/30 transition-all duration-300 group-hover:h-4 group-hover:w-4 group-hover:border-primary"
  >
  </div>
  <div
    class="pointer-events-none absolute bottom-2 left-2 z-20 h-3 w-3 border-b-[1.5px] border-l-[1.5px] border-primary/30 transition-all duration-300 group-hover:h-4 group-hover:w-4 group-hover:border-primary"
  >
  </div>
  <div
    class="pointer-events-none absolute right-2 bottom-2 z-20 h-3 w-3 border-r-[1.5px] border-b-[1.5px] border-primary/30 transition-all duration-300 group-hover:h-4 group-hover:w-4 group-hover:border-primary"
  >
  </div>

  <div class="space-y-4">
    {/* Meta Header */}
    <div class="flex items-start justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 font-mono text-[10px] tracking-wider text-muted-foreground uppercase">
          <span class="text-primary/80">// SYS_{project.index}</span>
          <span>•</span>
          <span>{project.year}</span>
        </div>
        <h3
          class="mt-1.5 text-xl font-bold tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary"
        >
          {project.title}
        </h3>
      </div>
      <span
        class="shrink-0 rounded-sm border border-border/80 bg-muted/40 px-2.5 py-1 font-mono text-[10px] font-semibold text-muted-foreground uppercase"
      >
        {project.role}
      </span>
    </div>

    {
      project.subtitle && (
        <p class="font-mono text-xs font-semibold text-primary/90">
          // {project.subtitle}
        </p>
      )
    }

    <p class="text-sm leading-relaxed text-muted-foreground">
      {project.description}
    </p>

    {/* Highlights list */}
    {
      project.highlights && project.highlights.length > 0 && (
        <ul class="space-y-1.5 pt-1">
          {project.highlights.map((h) => (
            <li class="flex items-start gap-2 text-xs text-muted-foreground">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary/70 shadow-[0_0_4px_oklch(var(--primary))]" />
              <span>{h}</span>
            </li>
          ))}
        </ul>
      )
    }

    {/* Tech stack tags */}
    <div class="flex flex-wrap gap-1.5 pt-2">
      {
        project.tech.map((t) => (
          <span class="rounded-sm border border-border/80 bg-muted/20 px-2 py-0.5 font-mono text-[10px] font-medium text-muted-foreground transition-colors group-hover:border-primary/40 group-hover:text-foreground">
            {t}
          </span>
        ))
      }
    </div>
  </div>

  {/* Action Footer */}
  <div
    class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-border/50 pt-4"
  >
    <div class="flex flex-wrap items-center gap-2.5">
      {
        project.links.github && (
          <a
            href={project.links.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Button
              variant="outline"
              size="sm"
              className="gap-1.5 text-xs transition-colors hover:border-primary/60 hover:text-primary"
            >
              <HugeiconsIcon icon={Github} className="size-3.5" />
              Source Code ↗
            </Button>
          </a>
        )
      }

      {
        project.links.live && project.links.live !== "#" && (
          <a
            href={project.links.live}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Button
              variant="outline"
              size="sm"
              className="gap-1.5 text-xs transition-colors hover:border-primary/60 hover:text-primary"
            >
              <HugeiconsIcon icon={Globe02Icon} className="size-3.5" />
              Live Demo ↗
            </Button>
          </a>
        )
      }
    </div>

    <span class="font-mono text-[10px] text-muted-foreground/60">
      ARCH_TEMPLATE
    </span>
  </div>
</article>
