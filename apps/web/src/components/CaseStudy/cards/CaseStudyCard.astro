---
import { Badge } from "@workspace/ui/components/badge"
import { Button } from "@workspace/ui/components/button"
import { HugeiconsIcon } from "@hugeicons/react"
import {
  ArrowUpRight01Icon,
  BookOpen01Icon,
  Github,
  Globe02Icon,
} from "@hugeicons/core-free-icons"

export interface CaseStudyCardProps {
  id: string
  slug?: string
  title: string
  subtitle?: string
  description: string
  role?: string
  tech: string[]
  links: {
    live?: string
    github?: string
    caseStudy?: string
  }
  img: string
  index: string
  status?: string
  year?: string
}

interface Props {
  project: CaseStudyCardProps
  class?: string
}

const { project, class: className = "" } = Astro.props

const caseStudyUrl =
  project.links.caseStudy ||
  (project.slug ? `/case-study/${project.slug}` : undefined)

const rawStatus = (project.status || "Completed")
  .replace(/^Status:\s*/i, "")
  .trim()
const statusLower = rawStatus.toLowerCase()
const isLive = statusLower === "live"
const isInProgress = statusLower.includes("progress")
---

<article
  class={`project-card group relative flex flex-col overflow-hidden border border-border/70 bg-card/40 backdrop-blur-md transition-all duration-300 hover:border-primary/50 hover:bg-card/70 hover:shadow-[0_0_24px_-4px_oklch(var(--primary)/14%)] lg:grid lg:grid-cols-12 lg:items-stretch ${className}`}
  data-category="case-study"
  data-title={project.title.toLowerCase()}
  data-tech={project.tech.join(" ").toLowerCase()}
>
  {/* Precision Cyber Corner Brackets */}
  <div
    class="pointer-events-none absolute top-0 left-0 z-20 h-3.5 w-3.5 border-t-2 border-l-2 border-primary/40 transition-colors duration-300 group-hover:border-primary"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute top-0 right-0 z-20 h-3.5 w-3.5 border-t-2 border-r-2 border-primary/40 transition-colors duration-300 group-hover:border-primary"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute bottom-0 left-0 z-20 h-3.5 w-3.5 border-b-2 border-l-2 border-primary/40 transition-colors duration-300 group-hover:border-primary"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute right-0 bottom-0 z-20 h-3.5 w-3.5 border-r-2 border-b-2 border-primary/40 transition-colors duration-300 group-hover:border-primary"
    aria-hidden="true"
  >
  </div>

  {/* Left Column: Streamlined Project Details (7 Cols on Large Screens) */}
  <div
    class="flex flex-1 flex-col justify-between gap-5 p-6 sm:p-8 lg:col-span-7"
  >
    <div class="flex flex-col gap-4">
      {/* Meta Header: Index, Status, Role, Timeline */}
      <div
        class="flex flex-wrap items-center justify-between gap-2 border-b border-border/40 pb-3"
      >
        <div class="flex flex-wrap items-center gap-2.5">
          <span
            class="font-mono text-xs font-bold tracking-[0.2em] text-primary"
          >
            // {project.index}
          </span>

          {/* Status Badge */}
          <span
            class={`inline-flex items-center gap-1.5 px-2 py-0.5 font-mono text-[10px] font-bold uppercase border ${
              isLive
                ? "border-emerald-500/40 bg-emerald-500/10 text-emerald-400"
                : isInProgress
                  ? "border-amber-500/40 bg-amber-500/10 text-amber-400"
                  : "border-primary/40 bg-primary/10 text-primary"
            }`}
          >
            <span
              class={`size-1.5 rounded-full ${
                isLive
                  ? "bg-emerald-400 animate-pulse shadow-[0_0_6px_rgb(52,211,153)]"
                  : isInProgress
                    ? "bg-amber-400"
                    : "bg-primary"
              }`}></span>
            {rawStatus}
          </span>

          {
            project.role && (
              <>
                <span class="hidden text-muted-foreground/30 sm:inline">•</span>
                <span class="hidden max-w-[200px] truncate font-mono text-xs text-muted-foreground sm:inline">
                  {project.role}
                </span>
              </>
            )
          }
        </div>

        {
          project.year && (
            <span class="font-mono text-xs text-muted-foreground tabular-nums">
              {project.year}
            </span>
          )
        }
      </div>

      {/* Title & Subtitle */}
      <div>
        <h3
          class="text-2xl leading-tight font-black tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary sm:text-3xl"
        >
          {
            caseStudyUrl ? (
              <a
                href={caseStudyUrl}
                class="decoration-primary/50 underline-offset-4 hover:underline focus:outline-none"
              >
                {project.title}
              </a>
            ) : (
              project.title
            )
          }
        </h3>
        {
          project.subtitle && (
            <p class="mt-1 font-mono text-xs font-semibold text-primary/90 sm:text-sm">
              // {project.subtitle}
            </p>
          )
        }
        {
          project.role && (
            <p class="mt-1 font-mono text-xs text-muted-foreground sm:hidden">
              Role: {project.role}
            </p>
          )
        }
      </div>

      {/* Description */}
      <p class="text-sm leading-relaxed text-muted-foreground sm:text-base">
        {project.description}
      </p>

      {/* Tech Stack Badges */}
      <div class="flex flex-wrap items-center gap-1.5 pt-1">
        {
          project.tech.slice(0, 7).map((t) => (
            <Badge
              variant="outline"
              className="text-[11px] font-mono border-border/70 bg-background/50 text-muted-foreground transition-colors group-hover:border-primary/40 group-hover:text-foreground"
            >
              {t}
            </Badge>
          ))
        }
        {
          project.tech.length > 7 && (
            <span class="pl-1 font-mono text-[10px] text-muted-foreground">
              +{project.tech.length - 7} more
            </span>
          )
        }
      </div>
    </div>

    {/* Action Buttons Row */}
    {
      ((caseStudyUrl && caseStudyUrl !== "#") ||
        (project.links.live && project.links.live !== "#") ||
        (project.links.github && project.links.github !== "#")) && (
        <div class="mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-border/40 pt-4">
          <div class="flex flex-wrap items-center gap-2.5">
            {caseStudyUrl && caseStudyUrl !== "#" && (
              <a
                href={caseStudyUrl}
                target={caseStudyUrl.startsWith("/") ? "_self" : "_blank"}
                rel={
                  caseStudyUrl.startsWith("/")
                    ? undefined
                    : "noopener noreferrer"
                }
              >
                <Button
                  size="sm"
                  className="font-semibold gap-1.5 shadow-xs cursor-pointer"
                >
                  <HugeiconsIcon icon={BookOpen01Icon} className="size-3.5" />
                  Read Case Study
                  <HugeiconsIcon
                    icon={ArrowUpRight01Icon}
                    className="size-3.5"
                  />
                </Button>
              </a>
            )}

            {project.links.live && project.links.live !== "#" && (
              <a
                href={project.links.live}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Button
                  variant="outline"
                  size="sm"
                  className="gap-1.5 text-xs border-border hover:border-primary/60 hover:text-primary transition-colors cursor-pointer"
                >
                  <HugeiconsIcon icon={Globe02Icon} className="size-3.5" />
                  Live site ↗
                </Button>
              </a>
            )}

            {project.links.github && project.links.github !== "#" && (
              <a
                href={project.links.github}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Button
                  variant="ghost"
                  size="sm"
                  className="gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
                >
                  <HugeiconsIcon icon={Github} className="size-3.5" />
                  Code ↗
                </Button>
              </a>
            )}
          </div>

          <span class="hidden font-mono text-[10px] text-muted-foreground/60 sm:inline">
            DEEP_DIVE // {project.index}
          </span>
        </div>
      )
    }
  </div>

  {/* Right Column: Media Preview Showcase (5 Cols on Large Screens) */}
  <div
    class="relative flex w-full aspect-video items-center justify-center overflow-hidden border-t border-border/60 bg-muted/10 lg:col-span-5 lg:aspect-auto lg:h-full lg:border-t-0 lg:border-l lg:border-border/60"
  >
    {
      caseStudyUrl ? (
        <a
          href={caseStudyUrl}
          class="group/img relative flex h-full w-full items-center justify-center overflow-hidden"
        >
          <div class="relative aspect-video w-full overflow-hidden">
            <img
              src={project.img}
              alt={project.title}
              loading="lazy"
              class="h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
            />
            {/* Subtle Vignette Overlay */}
            <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-background/60 via-transparent to-transparent opacity-40 transition-opacity duration-300 group-hover:opacity-20 lg:bg-linear-to-r lg:from-transparent lg:to-background/20" />
          </div>
        </a>
      ) : (
        <div class="relative flex h-full w-full items-center justify-center overflow-hidden">
          <div class="relative aspect-video w-full overflow-hidden">
            <img
              src={project.img}
              alt={project.title}
              loading="lazy"
              class="h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
            />
            <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-background/60 via-transparent to-transparent opacity-40 transition-opacity duration-300 group-hover:opacity-20 lg:bg-linear-to-r lg:from-transparent lg:to-background/20" />
          </div>
        </div>
      )
    }
  </div>
</article>
