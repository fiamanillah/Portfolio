---
import { HugeiconsIcon } from "@hugeicons/react"
import {
  Layers01Icon,
  CpuIcon,
  CodeCircleIcon,
} from "@hugeicons/core-free-icons"

interface Props {
  totalCaseStudies: number
  totalProjects: number
  totalTechCount: number
}

const { totalCaseStudies, totalProjects, totalTechCount } = Astro.props
---

<style>
  @keyframes float-glow {
    0%,
    100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.12;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.18);
      opacity: 0.22;
    }
  }
  @keyframes blink-cursor {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
  .cursor-blink {
    animation: blink-cursor 1.1s step-end infinite;
  }
  @keyframes slide-up-fade {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .anim-in {
    animation: slide-up-fade 0.7s ease forwards;
  }
  .anim-in-delay {
    animation: slide-up-fade 0.7s 0.18s ease forwards;
    opacity: 0;
  }
  .anim-in-delay-2 {
    animation: slide-up-fade 0.7s 0.32s ease forwards;
    opacity: 0;
  }
</style>

<header
  class="relative overflow-hidden border-b border-border pt-16 pb-16 sm:pt-24"
  data-grid-cross
>
  <!-- Ambient glows -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute top-1/2 left-1/4 h-96 w-96 -translate-x-1/2 -translate-y-1/2 animate-[float-glow_8s_ease-in-out_infinite] rounded-full bg-primary/15 blur-[110px]"
    >
    </div>
    <div
      class="absolute top-1/3 right-1/4 h-64 w-64 -translate-x-1/2 -translate-y-1/2 animate-[float-glow_8s_ease-in-out_infinite] rounded-full bg-primary/10 blur-[90px]"
      style="animation-delay: -4s;"
    >
    </div>
  </div>

  <!-- Diagonal stripe bg overlay -->
  <div
    class="diagonal-stripes pointer-events-none absolute inset-0 z-0 bg-background opacity-80"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <!-- Section label pill -->
    <div class="anim-in flex justify-center">
      <p
        class="mb-5 inline-flex items-center gap-2 border border-primary/25 bg-primary/8 px-4 py-1.5 font-mono text-xs font-semibold tracking-[0.2em] text-primary uppercase shadow-xs"
      >
        <span
          class="h-1.5 w-1.5 animate-pulse rounded-full bg-primary shadow-[0_0_6px_oklch(var(--primary)/80%)]"
        ></span>
        SYSTEM_ARCHITECTURE // CASE_STUDIES
        <span class="cursor-blink ml-1 inline-block h-3 w-0.5 bg-primary"
        ></span>
      </p>
    </div>

    <!-- Main heading -->
    <div class="anim-in-delay text-center">
      <h1 class="section-title text-foreground">
        Technical <span class="text-primary italic">Case Studies</span>
        <br class="hidden sm:block" />
        <span class="text-foreground">&amp; System Engineering</span>
      </h1>
    </div>

    <!-- Accent bar -->
    <div class="accent-bar anim-in-delay mx-auto mt-6 mb-8 w-56"></div>

    <!-- Description -->
    <p
      class="anim-in-delay mx-auto max-w-2xl text-center text-base leading-relaxed text-muted-foreground sm:text-lg"
    >
      In-depth architectural breakdowns, database schema designs, event-driven
      message pipelines, and production engineering post-mortems across scalable
      full-stack systems.
    </p>

    <!-- Stats Grid -->
    <div
      class="anim-in-delay-2 mt-12 grid grid-cols-1 border border-border/70 bg-card/60 backdrop-blur-sm sm:grid-cols-3"
    >
      <div
        class="group relative flex flex-col items-center justify-center border-b border-border/70 p-5 transition-colors duration-200 hover:bg-primary/5 sm:border-r sm:border-b-0 sm:p-8"
      >
        <div class="flex items-center gap-2.5 sm:gap-3">
          <HugeiconsIcon
            icon={Layers01Icon}
            className="size-6 sm:size-7 text-primary/80 transition-colors duration-200 group-hover:text-primary shrink-0"
          />
          <span class="font-mono text-3xl font-black text-primary sm:text-4xl">
            {totalCaseStudies}
          </span>
        </div>
        <span
          class="mt-1.5 font-mono text-[10px] font-semibold tracking-[0.15em] text-muted-foreground uppercase sm:text-xs"
        >
          Deep-Dive Case Studies
        </span>
      </div>

      <div
        class="group relative flex flex-col items-center justify-center border-b border-border/70 p-5 transition-colors duration-200 hover:bg-primary/5 sm:border-r sm:border-b-0 sm:p-8"
      >
        <div class="flex items-center gap-2.5 sm:gap-3">
          <HugeiconsIcon
            icon={CpuIcon}
            className="size-6 sm:size-7 text-primary/80 transition-colors duration-200 group-hover:text-primary shrink-0"
          />
          <span class="font-mono text-3xl font-black text-primary sm:text-4xl">
            {totalProjects}
          </span>
        </div>
        <span
          class="mt-1.5 font-mono text-[10px] font-semibold tracking-[0.15em] text-muted-foreground uppercase sm:text-xs"
        >
          Engineered Systems
        </span>
      </div>

      <div
        class="group relative flex flex-col items-center justify-center p-5 transition-colors duration-200 hover:bg-primary/5 sm:p-8"
      >
        <div class="flex items-center gap-2.5 sm:gap-3">
          <HugeiconsIcon
            icon={CodeCircleIcon}
            className="size-6 sm:size-7 text-primary/80 transition-colors duration-200 group-hover:text-primary shrink-0"
          />
          <span class="font-mono text-3xl font-black text-primary sm:text-4xl">
            {totalTechCount}+
          </span>
        </div>
        <span
          class="mt-1.5 font-mono text-[10px] font-semibold tracking-[0.15em] text-muted-foreground uppercase sm:text-xs"
        >
          Technologies &amp; Protocols
        </span>
      </div>
    </div>
  </div>
</header>
