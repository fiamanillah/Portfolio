---
import CaseStudySectionTitle from "@/components/CaseStudy/CaseStudySectionTitle.astro"

interface PostMortemEntry {
  heading: string
  detail: string
  code?: string
}

interface PostMortemItem {
  title: string
  body?: string
  entries?: PostMortemEntry[]
}

interface Props {
  items: PostMortemItem[]
}

const { items } = Astro.props as Props
---

<section class="space-y-6">
  <CaseStudySectionTitle label="[ SEC_05 // ARCHITECTURAL_POST_MORTEM ]" />

  <div class="px-5 md:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      {
        items.map((item, index) => (
          <article class="group rounded-lg border border-border/70 bg-card/40 p-6 transition-colors duration-200 hover:border-border">
            <div class="flex items-center gap-3 border-b border-border/40 pb-4">
              <span
                class={`flex h-6 w-6 shrink-0 items-center justify-center rounded border ${index % 2 === 0 ? "border-destructive/40 bg-destructive/10 text-destructive" : "border-primary/40 bg-primary/10 text-primary"}`}
              >
                {index % 2 === 0 ? (
                  <svg
                    class="h-3.5 w-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M12 9v4" />
                    <path d="M12 17h.01" />
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                  </svg>
                ) : (
                  <svg
                    class="h-3.5 w-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                )}
              </span>
              <h3 class="text-lg font-bold tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary sm:text-xl">
                {item.title}
              </h3>
            </div>

            <div class="mt-5 space-y-4">
              {(
                item.entries ??
                (item.body ? [{ heading: "Summary", detail: item.body }] : [])
              ).map((entry) => (
                <article class="space-y-1.5 border-l-2 border-primary/40 pl-3.5">
                  <h4 class="font-mono text-[11px] font-semibold tracking-wider text-foreground uppercase">
                    // {entry.heading}
                  </h4>
                  <p class="text-xs leading-relaxed text-muted-foreground">
                    {entry.detail}
                  </p>
                  {entry.code && (
                    <code class="mt-2 block rounded border border-border/50 bg-muted/30 px-3 py-2 font-mono text-[11px] text-foreground">
                      {entry.code}
                    </code>
                  )}
                </article>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
