---
import CaseStudySectionTitle from "@/components/CaseStudy/CaseStudySectionTitle.astro"
import { ArrowUpRight01Icon } from "@hugeicons/core-free-icons"
import { HugeiconsIcon } from "@hugeicons/react"
import { getCaseStudies } from "@/data/projects"

interface Props {
  currentSlug: string
}

const { currentSlug } = Astro.props as Props

const allCaseStudies = getCaseStudies().map((p) => ({
  slug: p.slug || p.id,
  title: p.subtitle ? `${p.title} — ${p.subtitle}` : p.title,
  description: p.description,
  href: p.links.caseStudy || `#`,
  image: p.img,
  techStack: p.tech.slice(0, 4),
}))

const otherStudies = allCaseStudies.filter(
  (study) => study.slug !== currentSlug && study.href !== "#"
)
---

{
  otherStudies.length > 0 && (
    <section class="space-y-6">
      <CaseStudySectionTitle label="[ MORE // CASE_STUDIES ]" />

      <div class="px-5 md:px-6 lg:px-8">
        <div class="grid gap-6 md:grid-cols-2">
          {otherStudies.map((study) => (
            <a
              href={study.href}
              class="group flex flex-col overflow-hidden rounded-lg border border-border/70 bg-card/40 transition-colors duration-200 hover:border-border"
            >
              {/* Thumbnail */}
              <div class="relative aspect-video w-full overflow-hidden border-b border-border/40">
                <img
                  src={study.image}
                  alt={study.title}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-102"
                />
              </div>

              {/* Content */}
              <div class="flex flex-1 flex-col gap-4 p-5">
                <div class="flex-1 space-y-2">
                  <h3 class="text-base font-bold tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary sm:text-lg">
                    {study.title}
                  </h3>
                  <p class="line-clamp-2 text-xs leading-relaxed text-muted-foreground">
                    {study.description}
                  </p>
                </div>

                {/* Tech stack tags */}
                {study.techStack && study.techStack.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {study.techStack.map((tech) => (
                      <span class="rounded border border-border/50 bg-muted/30 px-2 py-0.5 font-mono text-[10px] tracking-wide text-muted-foreground">
                        {tech}
                      </span>
                    ))}
                  </div>
                )}

                {/* View link */}
                <div class="flex items-center gap-2 border-t border-border/40 pt-3">
                  <span class="h-px w-4 bg-primary/40" />
                  <span class="font-mono text-[10px] tracking-[0.15em] text-muted-foreground uppercase transition-colors duration-200 group-hover:text-primary">
                    View Case Study
                  </span>
                  <HugeiconsIcon
                    icon={ArrowUpRight01Icon}
                    className="size-3 text-muted-foreground transition-colors duration-200 group-hover:text-primary"
                  />
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
