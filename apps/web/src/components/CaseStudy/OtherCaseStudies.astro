---
import CaseStudySectionTitle from "@/components/CaseStudy/CaseStudySectionTitle.astro"
import { ArrowUpRight01Icon, BookOpen01Icon } from "@hugeicons/core-free-icons"
import { HugeiconsIcon } from "@hugeicons/react"
import { Badge } from "@workspace/ui/components/badge"
import { CaseStudyApi } from "@/lib/api/caseStudyApi"

interface Props {
  currentSlug: string
}

const { currentSlug } = Astro.props as Props

const fetchedStudies = await CaseStudyApi.fetchAllCaseStudies()
const allCaseStudies = fetchedStudies.map((p, idx) => ({
  slug: p.slug,
  title: p.title.includes("—") ? p.title.split("—")[0]?.trim() : p.title,
  subtitle: p.title.includes("—") ? p.title.split("—")[1]?.trim() : undefined,
  description: p.description,
  href: `/case-study/${p.slug}`,
  image: p.image,
  techStack: (p.techStack || []).slice(0, 4),
  index: String(idx + 1).padStart(2, "0"),
  status: (p.status || "Completed").replace(/^Status:\s*/i, ""),
}))

const otherStudies = allCaseStudies.filter(
  (study) => study.slug !== currentSlug
)
---

{
  otherStudies.length > 0 && (
    <section class="space-y-8">
      <CaseStudySectionTitle label="[ SEC_06 // MORE_ARCHITECTURAL_DEEP_DIVES ]" />

      <div class="px-4 sm:px-6 lg:px-8">
        <div class="grid gap-6 md:grid-cols-2">
          {otherStudies.map((study) => (
            <a
              href={study.href}
              class="group relative flex flex-col justify-between overflow-hidden border border-border/70 bg-card/40 backdrop-blur-md transition-all duration-300 hover:border-primary/50 hover:bg-card/70 hover:shadow-[0_0_20px_-4px_oklch(var(--primary)/12%)]"
            >
              {/* Precision Cyber Corner Brackets */}
              <div class="pointer-events-none absolute top-0 left-0 z-20 h-3 w-3 border-t-2 border-l-2 border-primary/40 transition-colors duration-300 group-hover:border-primary" />
              <div class="pointer-events-none absolute top-0 right-0 z-20 h-3 w-3 border-t-2 border-r-2 border-primary/40 transition-colors duration-300 group-hover:border-primary" />
              <div class="pointer-events-none absolute bottom-0 left-0 z-20 h-3 w-3 border-b-2 border-l-2 border-primary/40 transition-colors duration-300 group-hover:border-primary" />
              <div class="pointer-events-none absolute right-0 bottom-0 z-20 h-3 w-3 border-r-2 border-b-2 border-primary/40 transition-colors duration-300 group-hover:border-primary" />

              {/* Thumbnail with subtle gradient */}
              <div class="relative aspect-video w-full overflow-hidden border-b border-border/60 bg-muted/20">
                <img
                  src={study.image}
                  alt={study.title}
                  class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                />
                <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-background/80 via-transparent to-transparent opacity-70" />
                <div class="absolute top-3 left-3 z-20">
                  <span class="inline-flex items-center gap-1.5 border border-primary/40 bg-background/90 px-2 py-0.5 font-mono text-[10px] font-bold text-primary uppercase shadow-xs backdrop-blur-md">
                    <span class="size-1.5 rounded-full bg-primary" />
                    // {study.index}
                  </span>
                </div>
              </div>

              {/* Content Area */}
              <div class="flex flex-1 flex-col justify-between gap-4 p-5 sm:p-6">
                <div class="space-y-2">
                  <h3 class="text-xl font-bold tracking-tight text-foreground transition-colors duration-200 group-hover:text-primary">
                    {study.title}
                  </h3>
                  {study.subtitle && (
                    <p class="font-mono text-xs font-semibold text-primary/90">
                      // {study.subtitle}
                    </p>
                  )}
                  <p class="line-clamp-2 text-xs leading-relaxed text-muted-foreground sm:text-sm">
                    {study.description}
                  </p>
                </div>

                {/* Tech tags */}
                {study.techStack && study.techStack.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 pt-1">
                    {study.techStack.map((tech) => (
                      <Badge
                        variant="outline"
                        className="text-[10px] font-mono border-border/70 bg-background/50 text-muted-foreground transition-colors group-hover:border-primary/40 group-hover:text-foreground"
                      >
                        {tech}
                      </Badge>
                    ))}
                  </div>
                )}

                {/* Bottom link bar */}
                <div class="flex items-center justify-between border-t border-border/40 pt-3 mt-auto">
                  <span class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold tracking-wider text-muted-foreground uppercase transition-colors duration-200 group-hover:text-primary">
                    <HugeiconsIcon icon={BookOpen01Icon} className="size-3.5" />
                    Read Deep Dive
                  </span>
                  <HugeiconsIcon
                    icon={ArrowUpRight01Icon}
                    className="size-4 text-primary transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  />
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
