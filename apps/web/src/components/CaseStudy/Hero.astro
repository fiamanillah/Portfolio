---
import {
  ArrowUpRight01Icon,
  Github,
  Clock01Icon,
  UserIcon,
  BuildingIcon,
  Globe02Icon,
  GroupLayersIcon,
  CloudServerIcon,
  Briefcase01Icon,
  AiCloud01Icon,
  Database,
  Cpu,
} from "@hugeicons/core-free-icons"
import { HugeiconsIcon } from "@hugeicons/react"
import { Badge } from "@workspace/ui/components/badge"
import { Button } from "@workspace/ui/components/button"
import type { ComponentProps } from "astro/types"

type HugeIconType = ComponentProps<typeof HugeiconsIcon>["icon"]

const ICON_MAP: Record<string, HugeIconType> = {
  layers: GroupLayersIcon,
  server: CloudServerIcon,
  infrastructure: CloudServerIcon,
  briefcase: Briefcase01Icon,
  domain: Briefcase01Icon,
  cloud: AiCloud01Icon,
  deployment: AiCloud01Icon,
  database: Database,
  cpu: Cpu,
  globe: Globe02Icon,
  clock: Clock01Icon,
  timeline: Clock01Icon,
  user: UserIcon,
  role: UserIcon,
  building: BuildingIcon,
  company: BuildingIcon,
}

function resolveIcon(
  icon?: HugeIconType | string,
  label?: string
): HugeIconType {
  if (icon && typeof icon !== "string") return icon
  if (typeof icon === "string" && ICON_MAP[icon.toLowerCase()]) {
    return ICON_MAP[icon.toLowerCase()]!
  }
  if (label) {
    const l = label.toLowerCase()
    for (const key of Object.keys(ICON_MAP)) {
      if (l.includes(key)) return ICON_MAP[key]!
    }
  }
  return Globe02Icon
}

interface MetadataItem {
  label: string
  value: string
  icon?: HugeIconType | string
}

interface Props {
  title?: string
  description?: string
  status?: string
  techStack?: string[]
  githubUrl?: string
  liveUrl?: string
  image?: string
  imageLabel?: string
  metadata?: MetadataItem[]
}

const {
  title = "Mickanic — Real-Time Bidding & Service Marketplace Platform",
  description = "I architected a service-based marketplace using Next.js and Bun, integrating real-time bidding, Socket.io messaging, and tiered Stripe subscriptions, all backed by a robust PostgreSQL and RabbitMQ infrastructure.",
  techStack = [
    "Next.js 16",
    "Bun",
    "PostgreSQL",
    "Prisma",
    "RabbitMQ",
    "Redis",
    "Socket.io",
    "Stripe",
    "Docker",
    "Tailwind CSS 4",
  ],
  githubUrl,
  liveUrl = "https://mickanic.ca/",
  image = "/assets/images/mickanic-cover.png",
  imageLabel = "Mickanic_Architecture_Overview.png",
  metadata = [
    { label: "Role", value: "Full Stack Developer", icon: UserIcon },
    { label: "Timeline", value: "2025 - 2026", icon: Clock01Icon },
    { label: "Client / Company", value: "Mickanic", icon: BuildingIcon },
    {
      label: "Tech Stack",
      value: "Next.js 16, Bun, PostgreSQL, RabbitMQ",
      icon: Globe02Icon,
    },
  ],
} = Astro.props as Props

// Extract clean title and subtitle if dash is present
const cleanTitle = title.includes("—") ? title.split("—")[0]?.trim() : title
const cleanSubtitle = title.includes("—")
  ? title.split("—")[1]?.trim()
  : undefined
---

<!-- Detail Page Hero Section: Blueprint Showcase, Description & Metadata Grid -->
<article
  data-grid-cross
  class="relative w-full overflow-hidden border-b border-border bg-background"
>
  <!-- Main Hero Layout -->
  <section
    class="grid gap-10 px-5 py-10 md:px-8 lg:grid-cols-12 lg:items-center lg:gap-12"
  >
    <!-- Left Column: Title, Subtitle, Description, Tech Stack, CTAs -->
    <div class="flex flex-col justify-between gap-8 lg:col-span-6">
      <div class="space-y-4">
        <div>
          <h1
            class="text-3xl leading-tight font-black tracking-tight text-foreground sm:text-4xl lg:text-5xl"
          >
            {cleanTitle}
          </h1>
          {
            cleanSubtitle && (
              <p class="mt-2 font-mono text-sm font-semibold tracking-wide text-primary sm:text-base">
                // {cleanSubtitle}
              </p>
            )
          }
        </div>

        <p class="text-sm leading-relaxed text-muted-foreground sm:text-base">
          {description}
        </p>
      </div>

      <!-- Tech Stack Badges -->
      <div class="space-y-2.5">
        <span
          class="font-mono text-[10px] font-semibold tracking-[0.2em] text-muted-foreground uppercase"
        >
          // PRODUCTION_TECH_STACK
        </span>
        <nav aria-label="Technology Stack" class="flex flex-wrap gap-1.5">
          {
            techStack.map((tech) => (
              <Badge
                variant="outline"
                className="font-mono text-xs px-2.5 py-1 transition-colors hover:border-primary/50"
              >
                <span class="mr-1.5 h-1.5 w-1.5 rounded-full bg-primary" />
                {tech}
              </Badge>
            ))
          }
        </nav>
      </div>

      <!-- Call-to-Action Buttons -->
      {
        ((githubUrl && githubUrl !== "#") || (liveUrl && liveUrl !== "#")) && (
          <div class="flex flex-wrap items-center gap-3 pt-2">
            {liveUrl && liveUrl !== "#" && (
              <a
                href={liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Open live application"
              >
                <Button size="lg" className="gap-2 font-medium shadow-sm">
                  <HugeiconsIcon icon={ArrowUpRight01Icon} className="size-4" />
                  <span>Live Production App</span>
                </Button>
              </a>
            )}

            {githubUrl && githubUrl !== "#" && (
              <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View source repository"
              >
                <Button variant="outline" size="lg" className="gap-2">
                  <HugeiconsIcon icon={Github} className="size-4" />
                  <span>View Repository</span>
                </Button>
              </a>
            )}
          </div>
        )
      }
    </div>

    <!-- Right Column: Visual Blueprint Preview Container -->
    <figure class="relative lg:col-span-6">
      {/* Outer corner brackets */}
      <div
        class="pointer-events-none absolute -top-1.5 -left-1.5 z-20 h-4 w-4 border-t-2 border-l-2 border-primary/60"
      >
      </div>
      <div
        class="pointer-events-none absolute -top-1.5 -right-1.5 z-20 h-4 w-4 border-t-2 border-r-2 border-primary/60"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-1.5 -left-1.5 z-20 h-4 w-4 border-b-2 border-l-2 border-primary/60"
      >
      </div>
      <div
        class="pointer-events-none absolute -right-1.5 -bottom-1.5 z-20 h-4 w-4 border-r-2 border-b-2 border-primary/60"
      >
      </div>

      <div
        class="relative aspect-[16/10] w-full overflow-hidden border border-border bg-muted/30 shadow-lg before:pointer-events-none before:absolute before:inset-0 before:z-10 before:bg-[linear-gradient(105deg,transparent_40%,oklch(var(--primary)/12%)_50%,transparent_60%)] before:bg-[length:200%_100%] after:pointer-events-none after:absolute after:inset-0 after:bg-[repeating-linear-gradient(0deg,transparent,transparent_2px,rgba(0,0,0,0.04)_2px,rgba(0,0,0,0.04)_4px)]"
      >
        <img
          src={image}
          alt={`System Architecture Blueprint for ${title}`}
          class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
        />
      </div>

      <figcaption
        class="mt-2 flex items-center justify-between font-mono text-[10px] text-muted-foreground/70 uppercase"
      >
        <span class="flex items-center gap-1.5">
          <span class="h-px w-4 bg-primary/60"></span>
          <span>{imageLabel}</span>
        </span>
        <span>VERIFIED_ARCH</span>
      </figcaption>
    </figure>
  </section>

  <!-- 4-Column Metadata Bento Grid -->
  <div class="grid grid-cols-2 border-t border-border sm:grid-cols-4">
    {
      metadata.map(({ label, value, icon }, i) => {
        const resolvedIcon = resolveIcon(icon, label)
        return (
          <div
            class={`group relative border-border p-4.5 transition-colors hover:bg-primary/5 sm:p-6 ${
              i % 2 === 0 ? "border-r" : ""
            } ${i < 2 ? "border-b" : ""} sm:border-r sm:border-b-0 sm:last:border-r-0`}
          >
            <dl class="flex flex-col gap-1.5">
              <dt class="flex items-center gap-1.5 font-mono text-[10px] font-semibold tracking-[0.2em] text-muted-foreground uppercase">
                {resolvedIcon && (
                  <HugeiconsIcon
                    icon={resolvedIcon}
                    className="size-3 text-primary/80 shrink-0"
                  />
                )}
                {label}
              </dt>
              <dd class="text-sm font-bold tracking-tight text-foreground sm:text-base">
                {value}
              </dd>
            </dl>
          </div>
        )
      })
    }
  </div>
</article>
