---
// src/components/GridLines.astro
interface Props {
  lines?: number[]
}
const { lines = [-0.04, 0, 1, 1.04] } = Astro.props
---

<!-- GridLines Canvas Component -->
<canvas
  id="grid-lines-canvas"
  class="pointer-events-none absolute top-0 left-0 z-0"
  style="width:100%;will-change:transform;transform:translateZ(0);"></canvas>

<script is:inline define:vars={{ lines }}>
  const canvas = document.getElementById("grid-lines-canvas")
  if (!canvas) return
  const ctx = canvas.getContext("2d")
  if (!ctx) return

  const lineOffsets = lines || [-0.04, 0, 1, 1.04]

  // --- CONFIG ---
  const LINE_COLOR =
    getComputedStyle(document.documentElement)
      .getPropertyValue("--grid-line-color")
      .trim() || "rgba(0,220,200,0.18)"
  const CROSS_COLOR =
    getComputedStyle(document.documentElement)
      .getPropertyValue("--grid-cross-color")
      .trim() || "rgba(0,220,200,0.55)"
  const LINE_WIDTH = 0.75
  const CROSS_ARM = 6

  let dpr = 1
  let lineXs = []
  let absYs = []
  let lastW = 0
  let lastH = 0

  function updateCanvasDimensions() {
    dpr = window.devicePixelRatio || 1
    const W = document.documentElement.scrollWidth
    const H = Math.max(
      document.body.scrollHeight,
      document.documentElement.scrollHeight,
      document.body.offsetHeight,
      document.documentElement.offsetHeight
    )

    if (W !== lastW || H !== lastH || canvas.width !== W * dpr || canvas.height !== H * dpr) {
      lastW = W
      lastH = H
      canvas.width = Math.round(W * dpr)
      canvas.height = Math.round(H * dpr)
      canvas.style.width = W + "px"
      canvas.style.height = H + "px"
    }

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    return { W, H }
  }

  function cacheCoordinates() {
    // 1. Calculate vertical X lines based on reference container
    const el =
      document.querySelector("main.container") ||
      document.querySelector("main") ||
      document.querySelector(".container")

    const { left, width } = el
      ? el.getBoundingClientRect()
      : { left: 0, width: document.documentElement.scrollWidth }

    lineXs = lineOffsets.map((f) => Math.round(left + f * width))

    // 2. Calculate horizontal Y positions for all marked sections
    absYs = []
    const crossElements = document.querySelectorAll("[data-grid-cross]")
    const scrollY = window.scrollY || window.pageYOffset || 0

    crossElements.forEach((element) => {
      const rect = element.getBoundingClientRect()
      const topY = Math.round(rect.top + scrollY)
      const bottomY = Math.round(rect.bottom + scrollY)

      if (!absYs.includes(topY)) absYs.push(topY)
      if (!absYs.includes(bottomY)) absYs.push(bottomY)
    })

    absYs.sort((a, b) => a - b)
  }

  function renderGrid(W, H) {
    ctx.clearRect(0, 0, W, H)

    // BATCH 1: Continuous Vertical & Horizontal Grid Lines
    ctx.strokeStyle = LINE_COLOR
    ctx.lineWidth = LINE_WIDTH
    ctx.beginPath()

    // Vertical lines
    for (let i = 0; i < lineXs.length; i++) {
      const x = lineXs[i] + 0.5
      ctx.moveTo(x, 0)
      ctx.lineTo(x, H)
    }

    // Horizontal lines at section boundaries
    for (let i = 0; i < absYs.length; i++) {
      const y = absYs[i] + 0.5
      ctx.moveTo(0, y)
      ctx.lineTo(W, y)
    }

    ctx.stroke()

    // BATCH 2: Precision Crosshairs (+)
    ctx.strokeStyle = CROSS_COLOR
    ctx.lineWidth = 1
    ctx.beginPath()

    for (let i = 0; i < absYs.length; i++) {
      const y = absYs[i] + 0.5
      for (let j = 0; j < lineXs.length; j++) {
        const x = lineXs[j] + 0.5
        ctx.moveTo(x - CROSS_ARM, y)
        ctx.lineTo(x + CROSS_ARM, y)
        ctx.moveTo(x, y - CROSS_ARM)
        ctx.lineTo(x, y + CROSS_ARM)
      }
    }

    ctx.stroke()
  }

  function updateGrid() {
    const { W, H } = updateCanvasDimensions()
    cacheCoordinates()
    renderGrid(W, H)
  }

  // --- SCHEDULED BATCH UPDATES (Single rAF per frame) ---
  let updateScheduled = false
  function scheduleUpdate() {
    if (!updateScheduled) {
      updateScheduled = true
      requestAnimationFrame(() => {
        updateGrid()
        updateScheduled = false
      })
    }
  }

  // --- OBSERVERS ---
  const ro = new ResizeObserver(() => {
    scheduleUpdate()
  })

  function observeElements() {
    if (document.documentElement) ro.observe(document.documentElement)
    if (document.body) ro.observe(document.body)

    const mainEl = document.querySelector("main")
    if (mainEl) ro.observe(mainEl)

    document.querySelectorAll("[data-grid-cross]").forEach((el) => {
      ro.observe(el)
    })
  }

  // MutationObserver to watch for dynamic DOM insertions (React components, Turnstile, etc.)
  const mo = new MutationObserver(() => {
    observeElements()
    scheduleUpdate()
  })

  // --- LISTENERS ---
  window.addEventListener("resize", scheduleUpdate, { passive: true })
  window.addEventListener("orientationchange", scheduleUpdate, { passive: true })
  window.addEventListener("grid-refresh", scheduleUpdate, { passive: true })

  function init() {
    observeElements()
    if (document.body) {
      mo.observe(document.body, { childList: true, subtree: true })
    }
    scheduleUpdate()

    // Safety passes for async web fonts, Turnstile, and dynamic images
    setTimeout(scheduleUpdate, 100)
    setTimeout(scheduleUpdate, 350)
    setTimeout(scheduleUpdate, 800)
    setTimeout(scheduleUpdate, 1500)
  }

  if (document.readyState === "complete" || document.readyState === "interactive") {
    init()
  } else {
    window.addEventListener("DOMContentLoaded", init, { once: true })
  }

  document.addEventListener("astro:page-load", () => {
    observeElements()
    scheduleUpdate()
  })
</script>
