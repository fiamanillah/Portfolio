---
import {
  Home01Icon,
  Briefcase01Icon,
  BookOpen01Icon,
  DocumentCodeIcon,
  Calendar03Icon,
  Menu01Icon,
  Cancel01Icon,
} from "@hugeicons/core-free-icons"
import { HugeiconsIcon } from "@hugeicons/react"
import { ModeToggle } from "@workspace/ui/components/ModeToggle"
import { NavUserButton } from "@/components/auth/NavUserButton"

const navLinks = [
  { href: "/", label: "Home", icon: Home01Icon },
  { href: "/case-study", label: "Case Studies", icon: Briefcase01Icon },
  { href: "/blog", label: "Blog", icon: BookOpen01Icon },
  { href: "/resume", label: "Resume", icon: DocumentCodeIcon },
  {
    href: "/#book-call",
    label: "Book a Call",
    icon: Calendar03Icon,
    highlight: true,
  },
]

const currentPath = Astro.url.pathname

function isLinkActive(href: string) {
  if (href === "/") {
    return currentPath === "/"
  }
  const cleanHref = href.split("#")[0]
  if (cleanHref && cleanHref !== "/") {
    return currentPath.startsWith(cleanHref)
  }
  return false
}
---

<nav aria-label="Primary" class="w-full">
  <div class="flex h-16 items-center justify-between px-4">
    <!-- Brand / Logo -->
    <a
      href="/"
      class="group flex items-center gap-2.5 font-bold tracking-tight text-foreground transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:outline-none"
    >
      <img
        src="/logo1.svg"
        alt="Fi Amanillah Logo"
        class="size-6 transition-transform duration-300 group-hover:scale-110"
      />
      <div class="flex flex-col">
        <span
          class="font-mono text-sm font-bold tracking-tight text-foreground transition-colors group-hover:text-primary"
        >
          Fi Amanillah
        </span>
        <span
          class="hidden font-mono text-[9px] leading-none tracking-widest text-muted-foreground uppercase 2xl:inline"
        >
          Software &amp; Tech
        </span>
      </div>
    </a>

    <!-- Right-side Container (Desktop Nav + Actions + Mobile Trigger) -->
    <div class="flex items-center gap-3">
      <!-- Desktop Navigation (lg and up) -->
      <div class="hidden items-center lg:flex">
        <ul class="m-0 flex list-none items-center gap-1 p-0 font-mono text-xs">
          {
            navLinks.map((link) => {
              const active = isLinkActive(link.href)
              return (
                <li class="m-0 list-none">
                  <a
                    href={link.href}
                    class:list={[
                      "group flex items-center gap-1.5 border px-2.5 py-1.5 text-xs transition-all duration-200",
                      active
                        ? "border-primary/40 bg-primary/10 font-medium text-primary shadow-[0_0_10px_rgba(0,220,200,0.15)]"
                        : link.highlight
                          ? "border-primary/30 bg-primary/5 text-foreground hover:border-primary hover:bg-primary/15 hover:text-primary"
                          : "border-transparent text-muted-foreground hover:border-border hover:bg-muted/40 hover:text-foreground",
                    ]}
                  >
                    <HugeiconsIcon
                      icon={link.icon}
                      className={`size-3.5 transition-transform duration-200 group-hover:scale-110 ${active ? "text-primary" : "text-muted-foreground group-hover:text-primary"}`}
                      aria-hidden="true"
                    />
                    <span>{link.label}</span>
                  </a>
                </li>
              )
            })
          }
        </ul>
      </div>

      <!-- Actions & Mobile Trigger -->
      <div class="flex items-center gap-2">
        <div
          class="flex items-center gap-2 lg:border-l lg:border-border/60 lg:pl-3"
        >
          <ModeToggle client:idle />
          <NavUserButton client:idle />
        </div>

        <!-- Mobile Navigation Toggle Bar (< lg) -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          data-state="closed"
          aria-controls="mobile-nav-panel"
          class="group relative flex size-9 cursor-pointer items-center justify-center border border-border bg-background/80 text-foreground transition-colors duration-150 hover:border-primary hover:bg-primary/10 hover:text-primary focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:outline-none lg:hidden"
        >
          <span
            id="menu-open-icon"
            class="nav-icon-open pointer-events-none absolute inset-0 flex items-center justify-center"
          >
            <HugeiconsIcon
              icon={Menu01Icon}
              className="size-5"
              aria-hidden="true"
            />
          </span>
          <span
            id="menu-close-icon"
            class="nav-icon-close pointer-events-none absolute inset-0 flex items-center justify-center"
          >
            <HugeiconsIcon
              icon={Cancel01Icon}
              className="size-5"
              aria-hidden="true"
            />
          </span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Dropdown Panel -->
  <div
    id="mobile-nav-panel"
    data-state="closed"
    class="mobile-nav-dropdown border-t border-transparent bg-background/95 shadow-xl backdrop-blur-md lg:hidden"
  >
    <div class="min-h-0 overflow-hidden">
      <div id="mobile-nav-content" class="space-y-4 px-4 py-4">
        <!-- Responsive Links Grid -->
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            navLinks.map((link) => {
              const active = isLinkActive(link.href)
              return (
                <a
                  href={link.href}
                  class:list={[
                    "group flex items-center justify-between border p-2.5 transition-all duration-150",
                    active
                      ? "border-primary/50 bg-primary/15 font-medium text-primary"
                      : link.highlight
                        ? "border-primary/30 bg-primary/5 text-foreground hover:border-primary hover:bg-primary/10"
                        : "border-border/50 bg-card/40 text-muted-foreground hover:border-border hover:bg-muted/40 hover:text-foreground",
                  ]}
                >
                  <div class="flex items-center gap-2.5">
                    <div
                      class:list={[
                        "flex size-7 items-center justify-center border transition-colors",
                        active
                          ? "border-primary/40 bg-primary/20 text-primary"
                          : "border-border bg-background text-muted-foreground group-hover:border-primary/40 group-hover:text-primary",
                      ]}
                    >
                      <HugeiconsIcon
                        icon={link.icon}
                        className="size-3.5"
                        aria-hidden="true"
                      />
                    </div>
                    <span class="font-mono text-xs font-medium">
                      {link.label}
                    </span>
                  </div>
                  <span class="text-xs text-muted-foreground/50 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:text-primary">
                    →
                  </span>
                </a>
              )
            })
          }
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  .mobile-nav-dropdown {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      grid-template-rows 220ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 180ms ease-out,
      border-color 200ms ease-out,
      visibility 0s linear 220ms;
    will-change: grid-template-rows, opacity;
  }

  .mobile-nav-dropdown[data-state="open"] {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    border-color: color-mix(
      in oklch,
      var(--color-border, #e5e7eb) 60%,
      transparent
    );
    transition:
      grid-template-rows 240ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 200ms ease-out,
      border-color 200ms ease-out,
      visibility 0s linear 0s;
  }

  #mobile-nav-content {
    transform: translateY(-6px);
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .mobile-nav-dropdown[data-state="open"] #mobile-nav-content {
    transform: translateY(0);
  }

  /* Hamburger to Close Icon smooth morph */
  .nav-icon-open {
    opacity: 1;
    transform: rotate(0deg) scale(1);
    transition:
      opacity 150ms ease-out,
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  #mobile-menu-btn[data-state="open"] .nav-icon-open {
    opacity: 0;
    transform: rotate(90deg) scale(0.65);
  }

  .nav-icon-close {
    opacity: 0;
    transform: rotate(-90deg) scale(0.65);
    transition:
      opacity 150ms ease-out,
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  #mobile-menu-btn[data-state="open"] .nav-icon-close {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
</style>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn")
    const panel = document.getElementById("mobile-nav-panel")

    if (!btn || !panel) return

    // Prevent duplicate per-element event binding across astro navigations
    if (btn.dataset.initialized === "true") return
    btn.dataset.initialized = "true"

    const setMenuState = (isOpen: boolean) => {
      const state = isOpen ? "open" : "closed"
      btn.setAttribute("data-state", state)
      panel.setAttribute("data-state", state)
      btn.setAttribute("aria-expanded", isOpen ? "true" : "false")
    }

    btn.addEventListener("click", (e) => {
      e.stopPropagation()
      const isOpen = panel.getAttribute("data-state") === "open"
      setMenuState(!isOpen)
    })

    // Close on navigation link click
    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        setMenuState(false)
      })
    })
  }

  // Register global document & window handlers once
  if (typeof window !== "undefined" && !(window as any).__mobileNavGlobalInit) {
    ;(window as any).__mobileNavGlobalInit = true

    // Close on click outside
    document.addEventListener("click", (e) => {
      const btn = document.getElementById("mobile-menu-btn")
      const panel = document.getElementById("mobile-nav-panel")
      if (panel && btn && panel.getAttribute("data-state") === "open") {
        if (
          !panel.contains(e.target as Node) &&
          !btn.contains(e.target as Node)
        ) {
          btn.setAttribute("data-state", "closed")
          panel.setAttribute("data-state", "closed")
          btn.setAttribute("aria-expanded", "false")
        }
      }
    })

    // Close on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        const btn = document.getElementById("mobile-menu-btn")
        const panel = document.getElementById("mobile-nav-panel")
        if (panel && btn && panel.getAttribute("data-state") === "open") {
          btn.setAttribute("data-state", "closed")
          panel.setAttribute("data-state", "closed")
          btn.setAttribute("aria-expanded", "false")
        }
      }
    })

    // Auto-close on resize to desktop (>= 1024px)
    window.addEventListener(
      "resize",
      () => {
        if (window.innerWidth >= 1024) {
          const btn = document.getElementById("mobile-menu-btn")
          const panel = document.getElementById("mobile-nav-panel")
          if (panel && btn && panel.getAttribute("data-state") === "open") {
            btn.setAttribute("data-state", "closed")
            panel.setAttribute("data-state", "closed")
            btn.setAttribute("aria-expanded", "false")
          }
        }
      },
      { passive: true }
    )
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupMobileMenu)
  } else {
    setupMobileMenu()
  }
  document.addEventListener("astro:page-load", setupMobileMenu)
</script>
