---
import {
  Home01Icon,
  Briefcase01Icon,
  BookOpen01Icon,
  DocumentCodeIcon,
  Calendar03Icon,
  Menu01Icon,
  Cancel01Icon,
} from "@hugeicons/core-free-icons"
import { HugeiconsIcon } from "@hugeicons/react"
import { ModeToggle } from "@workspace/ui/components/ModeToggle"
import { NavUserButton } from "@/components/auth/NavUserButton"

const navLinks = [
  { href: "/", label: "Home", icon: Home01Icon },
  { href: "/case-study", label: "Case Studies", icon: Briefcase01Icon },
  { href: "/blog", label: "Blog", icon: BookOpen01Icon },
  { href: "/resume", label: "Resume", icon: DocumentCodeIcon },
  {
    href: "/#book-call",
    label: "Book a Call",
    icon: Calendar03Icon,
    highlight: true,
  },
]

const currentPath = Astro.url.pathname

function isLinkActive(href: string) {
  if (href === "/") {
    return currentPath === "/"
  }
  const cleanHref = href.split("#")[0]
  if (cleanHref && cleanHref !== "/") {
    return currentPath.startsWith(cleanHref)
  }
  return false
}
---

<nav aria-label="Primary" class="w-full">
  <div class="flex h-16 items-center justify-between px-4">
    <!-- Brand / Logo -->
    <a
      href="/"
      class="group flex items-center gap-2.5 font-bold tracking-tight text-foreground transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:outline-none"
    >
      <img
        src="/logo1.svg"
        alt="Fi Amanillah Logo"
        class="size-6 transition-transform duration-300 group-hover:scale-110"
      />
      <div class="flex flex-col">
        <span
          class="font-mono text-sm font-bold tracking-tight text-foreground transition-colors group-hover:text-primary"
        >
          Fi Amanillah
        </span>
        <span
          class="hidden text-[9px] font-mono tracking-widest text-muted-foreground uppercase leading-none 2xl:inline"
        >
          Full Stack Dev
        </span>
      </div>
    </a>

    <!-- Desktop Navigation (lg and up) -->
    <div class="hidden items-center gap-5 lg:flex">
      <ul class="m-0 flex list-none items-center gap-1 p-0 font-mono text-xs">
        {
          navLinks.map((link) => {
            const active = isLinkActive(link.href)
            return (
              <li class="m-0 list-none">
                <a
                  href={link.href}
                  class:list={[
                    "group flex items-center gap-1.5 px-2.5 py-1.5 text-xs transition-all duration-200 border",
                    active
                      ? "border-primary/40 bg-primary/10 text-primary font-medium shadow-[0_0_10px_rgba(0,220,200,0.15)]"
                      : link.highlight
                        ? "border-primary/30 bg-primary/5 text-foreground hover:border-primary hover:bg-primary/15 hover:text-primary"
                        : "border-transparent text-muted-foreground hover:border-border hover:bg-muted/40 hover:text-foreground",
                  ]}
                >
                  <HugeiconsIcon
                    icon={link.icon}
                    className={`size-3.5 transition-transform duration-200 group-hover:scale-110 ${active ? "text-primary" : "text-muted-foreground group-hover:text-primary"}`}
                    aria-hidden="true"
                  />
                  <span>{link.label}</span>
                </a>
              </li>
            )
          })
        }
      </ul>

      <div class="flex items-center gap-2 border-l border-border/60 pl-3">
        <ModeToggle client:load />
        <NavUserButton client:load />
      </div>
    </div>

    <!-- Mobile Navigation Toggle Bar (< lg) -->
    <div class="flex items-center gap-2 lg:hidden">
      <ModeToggle client:load />
      <NavUserButton client:load />
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        class="group relative flex size-9 cursor-pointer items-center justify-center border border-border bg-background/80 text-foreground transition-all duration-200 hover:border-primary hover:bg-primary/10 hover:text-primary focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:outline-none"
      >
        <span
          id="menu-open-icon"
          class="flex items-center justify-center transition-transform duration-300"
        >
          <HugeiconsIcon
            icon={Menu01Icon}
            className="size-5"
            aria-hidden="true"
          />
        </span>
        <span
          id="menu-close-icon"
          class="hidden items-center justify-center transition-transform duration-300"
        >
          <HugeiconsIcon
            icon={Cancel01Icon}
            className="size-5"
            aria-hidden="true"
          />
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Dropdown Panel -->
  <div
    id="mobile-nav-panel"
    class="hidden border-t border-border/60 bg-background/95 shadow-2xl backdrop-blur-2xl transition-all duration-300 ease-in-out lg:hidden"
  >
    <div class="space-y-4 px-4 py-5">
      <!-- Responsive Links Grid -->
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
        {
          navLinks.map((link) => {
            const active = isLinkActive(link.href)
            return (
              <a
                href={link.href}
                class:list={[
                  "group flex items-center justify-between p-2.5 transition-all duration-200 border",
                  active
                    ? "border-primary/50 bg-primary/15 text-primary font-medium"
                    : link.highlight
                      ? "border-primary/30 bg-primary/5 text-foreground hover:border-primary hover:bg-primary/10"
                      : "border-border/50 bg-card/40 text-muted-foreground hover:border-border hover:bg-muted/40 hover:text-foreground",
                ]}
              >
                <div class="flex items-center gap-2.5">
                  <div
                    class:list={[
                      "flex size-7 items-center justify-center border transition-colors",
                      active
                        ? "border-primary/40 bg-primary/20 text-primary"
                        : "border-border bg-background text-muted-foreground group-hover:border-primary/40 group-hover:text-primary",
                    ]}
                  >
                    <HugeiconsIcon
                      icon={link.icon}
                      className="size-3.5"
                      aria-hidden="true"
                    />
                  </div>
                  <span class="font-mono text-xs font-medium">
                    {link.label}
                  </span>
                </div>
                <span class="text-xs text-muted-foreground/50 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-primary">
                  →
                </span>
              </a>
            )
          })
        }
      </div>
    </div>
  </div>
</nav>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn")
    const panel = document.getElementById("mobile-nav-panel")
    const openIcon = document.getElementById("menu-open-icon")
    const closeIcon = document.getElementById("menu-close-icon")

    if (!btn || !panel) return

    // Prevent duplicate event binding
    if (btn.dataset.bound === "true") return
    btn.dataset.bound = "true"

    const openMenu = () => {
      panel.classList.remove("hidden")
      btn.setAttribute("aria-expanded", "true")
      openIcon?.classList.add("hidden")
      closeIcon?.classList.remove("hidden")
    }

    const closeMenu = () => {
      panel.classList.add("hidden")
      btn.setAttribute("aria-expanded", "false")
      openIcon?.classList.remove("hidden")
      closeIcon?.classList.add("hidden")
    }

    btn.addEventListener("click", (e) => {
      e.stopPropagation()
      const isOpen = !panel.classList.contains("hidden")
      if (isOpen) {
        closeMenu()
      } else {
        openMenu()
      }
    })

    // Close on navigation link click
    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu()
      })
    })

    // Close on Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.classList.contains("hidden")) {
        closeMenu()
      }
    })

    // Close on click outside
    document.addEventListener("click", (e) => {
      if (
        !panel.classList.contains("hidden") &&
        !panel.contains(e.target as Node) &&
        !btn.contains(e.target as Node)
      ) {
        closeMenu()
      }
    })

    // Auto-close on resize to lg (desktop)
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024 && !panel.classList.contains("hidden")) {
        closeMenu()
      }
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupMobileMenu)
  } else {
    setupMobileMenu()
  }
  document.addEventListener("astro:page-load", setupMobileMenu)
</script>
