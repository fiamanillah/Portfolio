# syntax=docker/dockerfile:1.4
# ==============================================================================
# Multi-Stage High Performance Dockerfile for Astro Frontend (apps/web)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Stage
# ------------------------------------------------------------------------------
FROM oven/bun:1-alpine AS builder

WORKDIR /app

# Accept build arguments for public environment variables
ARG PUBLIC_WEB_URL=https://fi.amanillah.com
ARG PUBLIC_API_URL=https://api-fi.amanillah.com
ARG PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEMAnAognjniSApt
ARG PUBLIC_GA_MEASUREMENT_ID=G-G8BDG57VX9

ENV PUBLIC_WEB_URL=$PUBLIC_WEB_URL \
    PUBLIC_API_URL=$PUBLIC_API_URL \
    PUBLIC_TURNSTILE_SITE_KEY=$PUBLIC_TURNSTILE_SITE_KEY \
    PUBLIC_GA_MEASUREMENT_ID=$PUBLIC_GA_MEASUREMENT_ID \
    NODE_ENV=production \
    DATABASE_URL="postgresql://postgres:postgres@localhost:5432/placeholder_db"

# 1. Install workspace dependencies (layer caching)
COPY package.json bun.lock turbo.json tsconfig.json ./
COPY packages/db/package.json ./packages/db/
COPY packages/env/package.json ./packages/env/
COPY packages/shared/package.json ./packages/shared/
COPY packages/ui/package.json ./packages/ui/
COPY packages/cache/package.json ./packages/cache/
COPY packages/logger/package.json ./packages/logger/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/dashboard/package.json ./apps/dashboard/

RUN --mount=type=cache,id=bun-cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

# 2. Copy source code (only packages required by Web to avoid cache invalidation from backend changes)
COPY packages/env/ ./packages/env/
COPY packages/shared/ ./packages/shared/
COPY packages/ui/ ./packages/ui/
COPY apps/web/ ./apps/web/

# 3. Build web application (Astro static build)
RUN cd apps/web && bun run build

# ------------------------------------------------------------------------------
# Stage 2: Ultra-Lean Production Nginx Server (<25MB)
# ------------------------------------------------------------------------------
FROM nginx:1.27-alpine-slim AS runner

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy high-performance Nginx configuration
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf

# Copy static assets generated by Astro
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Expose standard HTTP port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/health || exit 1

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
