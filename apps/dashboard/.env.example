# ==============================================================================
# Dashboard (Next.js 16) - Development Environment Variables
# ==============================================================================

# Backend API Endpoint URL (Publicly accessible from browser)
NEXT_PUBLIC_API_URL=http://localhost:3040

# Public Main Website URL (for cross-links & previews)
NEXT_PUBLIC_SITE_URL=http://localhost:4321

# Local Development Server Port
PORT=3001

# Environment
NODE_ENV=development
