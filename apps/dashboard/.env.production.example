# ==============================================================================
# Dashboard (Next.js 16) - Production Environment Variables
# Note: In Next.js, NEXT_PUBLIC_* variables are inlined at BUILD TIME.
# ==============================================================================

# Backend API Endpoint URL (Public HTTPS endpoint accessible from browser)
NEXT_PUBLIC_API_URL=https://api-fi.amanillah.com

# Public Main Website URL
NEXT_PUBLIC_SITE_URL=https://fi.amanillah.com

# Production Server Port (Inside container / process)
PORT=3001

# Production Host Binding (0.0.0.0 is required for Docker containers)
HOSTNAME=0.0.0.0

# Environment
NODE_ENV=production

# Disable Next.js Telemetry in Production
NEXT_TELEMETRY_DISABLED=1
