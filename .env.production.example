# ==============================================================================
# Portfolio Monorepo - Production Environment Variables (.env.production)
# ==============================================================================
# Use this template for Dokploy Compose / Docker Compose Production Deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Server & Environment
# ------------------------------------------------------------------------------
PORT=3040
NODE_ENV=production
REQUEST_TIMEOUT=30000

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL / Prisma)
# In Docker Compose, the database service is named `postgres`.
# ------------------------------------------------------------------------------
POSTGRES_USER=fiamanillah
POSTGRES_PASSWORD=GENERATE_A_SECURE_POSTGRES_PASSWORD
POSTGRES_DB=portfolio_db
DATABASE_URL=postgresql://fiamanillah:GENERATE_A_SECURE_POSTGRES_PASSWORD@postgres:5432/portfolio_db?schema=public
DB_LOGGING=false

# ------------------------------------------------------------------------------
# 3. Redis Cache Configuration
# In Docker Compose, the redis service is named `redis`.
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=portfolio:api:
REDIS_URL=redis://redis:6379
REDIS_DEFAULT_TTL=3600

# ------------------------------------------------------------------------------
# 4. Security, CORS & Authentication
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=https://fi.amanillah.com,https://admin.fi.amanillah.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Generate with: openssl rand -hex 64
JWT_SECRET=GENERATE_A_LONG_64_CHAR_RANDOM_HEX_SECRET_FOR_PRODUCTION
JWT_EXPIRES_IN=7d
JWT_ISSUER=portfolio-api

# ------------------------------------------------------------------------------
# 5. Default Admin Seed Credentials (used only if running `bun run db:seed`)
# ------------------------------------------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@fi.amanillah.com
DEFAULT_ADMIN_PASSWORD=GENERATE_A_STRONG_UNIQUE_PASSWORD

# ------------------------------------------------------------------------------
# 6. Public Domains & Service URLs (Production HTTPS)
# ------------------------------------------------------------------------------
PUBLIC_WEB_URL=https://fi.amanillah.com
PUBLIC_API_URL=https://api.fi.amanillah.com
PUBLIC_DASHBOARD_URL=https://admin.fi.amanillah.com
NEXT_PUBLIC_API_URL=https://api.fi.amanillah.com
NEXT_PUBLIC_SITE_URL=https://fi.amanillah.com

# ------------------------------------------------------------------------------
# 7. Email Delivery Stack (Plunk API)
# ------------------------------------------------------------------------------
PLUNK_SECRET_KEY=plunk_sk_live_YOUR_PRODUCTION_PLUNK_SECRET_KEY
PLUNK_API_URL=https://next-api.useplunk.com
PLUNK_TEMPLATE_ID=
PLUNK_CONFIRMATION_TEMPLATE_ID=

# ------------------------------------------------------------------------------
# 8. Email Routing & Domain Sender Identities
# ------------------------------------------------------------------------------
PERSONAL_EMAIL=fi@amanillah.com
DEFAULT_REPLY_TO_EMAIL=fi@amanillah.com
TRANSACTIONAL_FROM_EMAIL=hello@mail.amanillah.com
SYSTEM_FROM_EMAIL=system@mail.amanillah.com
AUTH_FROM_EMAIL=auth@mail.amanillah.com
BOOKING_FROM_EMAIL=bookings@mail.amanillah.com
NEWSLETTER_FROM_EMAIL=newsletter@newsletter.amanillah.com
BOOKING_NOTIFICATION_EMAIL=fi@amanillah.com

# ------------------------------------------------------------------------------
# 9. Anti-Bot Security (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=0x4AAAAAAAYourProductionTurnstileSecretKey
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAYourProductionTurnstileSiteKey

# ------------------------------------------------------------------------------
# 10. Contact Form Configuration
# ------------------------------------------------------------------------------
CONTACT_RECIPIENT_EMAIL=fi@amanillah.com
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_RATE_LIMIT_MAX=5

# ------------------------------------------------------------------------------
# 11. Logging Configuration
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log

# ------------------------------------------------------------------------------
# 12. Object Storage (Cloudflare R2)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=portfolio-assets
R2_PUBLIC_DOMAIN=https://assets.fi.amanillah.com
R2_REGION=auto
R2_ENDPOINT=
STORAGE_MAX_FILE_SIZE=52428800
STORAGE_PRESIGNED_EXPIRES_IN=900
STORAGE_ALLOWED_MIME_TYPES=

# ------------------------------------------------------------------------------
# 13. Google Calendar & Booking Engine Integration
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://api.fi.amanillah.com/booking/v1/google/callback
BOOKING_RATE_LIMIT_WINDOW_MS=3600000
BOOKING_RATE_LIMIT_MAX=10
